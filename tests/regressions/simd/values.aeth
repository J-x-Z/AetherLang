use simd::{f32x4_new,f32x4_splat,f32x4_add,f32x4_sub,f32x4_mul,f32x4_div,f32x4_sum,f32x4_dot,f32x4_extract,f32x4_load,f32x4_store,f32x4_eq,f32x4_ne,f32x4_lt,i32x4_all,i32x4_any,i32x4_new,i32x4_splat,i32x4_add,i32x4_mul,i32x4_sum,i32x4_extract,f64x2_new,f64x2_div,f64x2_sum,f64x2_extract,f64x2_gt,i64x2_all};
struct Holder { prefix: u8, vector: f32x4, suffix: u8 }
@repr(packed) struct Packed { prefix: u8, vector: f32x4, suffix: u8 }
fn identity<T>(value:T)->T {return value;}
@simd fn nan_mask(value:f32)->i32x4 {let vector:f32x4=f32x4_splat(value);return f32x4_ne(vector,vector);}
fn main()->i32 {
    let value:f32x4=f32x4_new(1.0,2.0,3.0,4.0);
    if f32x4_extract(value,0)!=(1.0 as f32) || f32x4_extract(value,3)!=(4.0 as f32) {return 1;}
    let plus:f32x4=f32x4_add(value,f32x4_splat(2.0));
    let difference:f32x4=f32x4_sub(plus,value);
    if !i32x4_all(f32x4_eq(difference,f32x4_splat(2.0))) {return 2;}
    let product:f32x4=f32x4_mul(value,plus);
    if f32x4_sum(product)!=(50.0 as f32) || f32x4_dot(value,value)!=(30.0 as f32) {return 3;}
    if !i32x4_all(f32x4_eq(f32x4_div(product,plus),value)) {return 4;}
    if !i32x4_any(f32x4_lt(value,f32x4_splat(2.0))) || i32x4_all(f32x4_lt(value,f32x4_splat(2.0))) {return 5;}
    let nan:f32=(0.0 as f32)/(0.0 as f32);
    if !i32x4_all(nan_mask(nan)) || i32x4_any(f32x4_eq(f32x4_splat(nan),value)) {return 6;}
    let ordered:f32x4=f32x4_new(100000000.0,1.0,-100000000.0,1.0);
    if f32x4_sum(ordered)!=(1.0 as f32) {return 7;}
    let vectors:[f32x4;2]=[value,plus];
    let holder:Holder=Holder{prefix:7,vector:identity(vectors[1]),suffix:9};
    let packed:Packed=Packed{prefix:11,vector:holder.vector,suffix:13};
    if f32x4_extract(packed.vector,3)!=(6.0 as f32) || packed.suffix!=(13 as u8) {return 8;}
    if size_of(f32x4)!=(16 as usize) || align_of(f32x4)!=(16 as usize) || size_of([f32x4;2])!=(32 as usize) || offset_of(Holder,vector)!=(16 as usize) || size_of(Packed)!=(18 as usize) {return 9;}
    let mut bytes:[u8;18]=[0;18];
    unsafe {
        let unaligned:*f32=((&mut bytes[0] as *u8)+1) as *f32;
        f32x4_store(unaligned,value);
        if !i32x4_all(f32x4_eq(f32x4_load(unaligned),value)) {return 10;}
    }
    if bytes[0]!=(0 as u8) || bytes[17]!=(0 as u8) {return 11;}
    let integers:i32x4=i32x4_new(2147483647,-1,3,5);
    let wrapped:i32x4=i32x4_add(integers,i32x4_new(1,2,4,6));
    if i32x4_extract(wrapped,0)!=((-2147483647 as i32)-1) || i32x4_extract(wrapped,3)!=(11 as i32) {return 12;}
    if i32x4_sum(i32x4_mul(i32x4_new(1,2,3,4),i32x4_new(5,6,7,8)))!=(70 as i32) {return 13;}
    let doubles:f64x2=f64x2_div(f64x2_new(4.0,9.0),f64x2_new(2.0,3.0));
    if f64x2_sum(doubles)!=5.0 || f64x2_extract(doubles,1)!=3.0 {return 14;}
    if !i64x2_all(f64x2_gt(doubles,f64x2_new(1.0,2.0))) {return 15;}
    if i32x4_extract(f32x4_eq(value,value),0)!=(-1 as i32) {return 16;}
    let inferred:f32x4=identity(__simd_f32x4_splat(7.0));
    if f32x4_extract(inferred,2)!=(7.0 as f32) {return 17;}
    if i32x4_extract(i32x4_mul(i32x4_splat(2147483647),i32x4_splat(2)),1)!=(-2 as i32) {return 18;}
    let mut operators:f32x4=-value+plus;
    operators *= f32x4_splat(3.0);
    if !i32x4_all(f32x4_eq(operators/f32x4_splat(2.0),f32x4_splat(3.0))) {return 19;}
    if i32x4_extract(-i32x4_splat((-2147483647 as i32)-1),0)!=((-2147483647 as i32)-1) {return 20;}
    return 0;
}
