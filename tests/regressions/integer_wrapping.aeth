fn quotient(n: i64) -> i64 { return if n > 0 { n / 2 } else { 3 }; }
fn main() -> i32 {
    let max: i64 = 9223372036854775807;
    let min: i64 = max + 1;
    if min >= 0 || min - 1 != max { return 1; }
    if -min != min || max * 2 != -2 { return 2; }
    let small: i8 = 127;
    if small + 1 != (-128 as i8) { return 3; }
    let medium: u16 = 65535;
    if medium * medium != (1 as u16) { return 4; }
    if (1 << 64) != 1 || (1 << 65) != 2 { return 5; }
    if (-8 >> 65) != -4 { return 6; }
    let tiny: u8 = 128;
    if (tiny >> (8 as u8)) != tiny { return 7; }
    if quotient(8) != 4 || quotient(-1) != 3 { return 8; }
    return 0;
}
