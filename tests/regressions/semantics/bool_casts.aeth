const ONE:u64=true as u64;
const EVEN:bool=2 as bool;
fn mask(x:u64)->u64{(x!=0) as u64}
fn truth(x:i64)->bool{x as bool}
fn floating(x:f64)->bool{x as bool}
fn main()->i32{
    if ONE!=1 || !EVEN || mask(0)!=0 || mask(2)!=1 {return 1;}
    if truth(0) || !truth(-2) || !truth(2) {return 2;}
    if floating(-0.0) || !floating(-0.5) || !floating(0.0/0.0) {return 3;}
    if (true as i64)!=1 || (true as f32)!=1.0 || (false as f64)!=0.0 {return 4;}
    return 0;
}
