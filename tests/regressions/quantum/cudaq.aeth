use quantum::{Circuit,QuantumState,QuantumGate,quantum_new,quantum_free,quantum_gate,quantum_simulate,quantum_state_free,quantum_expect,quantum_set_angle,Q_H,Q_X,Q_Y,Q_Z,Q_RX,Q_RY,Q_RZ,Q_CX,Q_CZ,Q_SWAP};
use quantum_cudaq::quantum_cudaq;
use result::Result;
extern "C" {fn printf(format:*u8,...)->i32;fn puts(text:*u8)->i32;}
fn near(a:f64,b:f64)->bool{let d:f64=a-b;return d<0.000000001&&d> -0.000000001;}
fn compare(c:*Circuit,expected_gpu:i32)->Result<i32,i32> {
 let cpu:*QuantumState=quantum_simulate(c,8)?;let mut error:[u8;512]=[0;512];let mut gpu:i32=-1;
 let sdk_result:Result<*QuantumState,i32>=quantum_cudaq(c,8,&mut error[0] as *u8,512,&mut gpu as *i32);
 let sdk:*QuantumState=match sdk_result {Result::Ok(s)=>s,Result::Err(e)=>{puts(&error[0] as *u8);quantum_state_free(cpu);return Result::Err(e);}};
 if gpu!=expected_gpu {return Result::Err(20);}
 let mut i:u64=0;
 while i<cpu.length {
  if !near(cpu.amplitudes[i].re,sdk.amplitudes[i].re)||!near(cpu.amplitudes[i].im,sdk.amplitudes[i].im){printf("amplitude %llu: (%g,%g) != (%g,%g)\n",i,cpu.amplitudes[i].re,cpu.amplitudes[i].im,sdk.amplitudes[i].re,sdk.amplitudes[i].im);return Result::Err(21);}
  i=i+1;
 }
 quantum_state_free(cpu);quantum_state_free(sdk);Result::Ok(0)
}
fn run(expected_gpu:i32)->Result<i32,i32>{
 if size_of(QuantumGate)!=24{return Result::Err(10);}
 let mut trial:i32=0;
 while trial<8 {
  let c:*Circuit=quantum_new(3)?;let angle:f64=0.13+(trial as f64)*0.271;
  quantum_gate(c,Q_X,0,0,0.0);quantum_gate(c,Q_H,1,0,0.0);quantum_gate(c,Q_RY,2,0,angle);
  quantum_gate(c,Q_CX,2,1,0.0);quantum_gate(c,Q_RZ,0,0,angle*1.17);quantum_gate(c,Q_CZ,0,2,0.0);
  quantum_gate(c,Q_Y,1,0,0.0);quantum_gate(c,Q_Z,2,0,0.0);quantum_gate(c,Q_RX,1,0,-angle);
  quantum_gate(c,Q_SWAP,0,2,0.0);compare(c,expected_gpu)?;quantum_free(c);trial=trial+1;
 }
 // Aether-owned optimization with actual CUDA-Q state evaluation at every step.
 let train:*Circuit=quantum_new(1)?;quantum_gate(train,Q_RY,0,0,0.71);
 let mut angle:f64=0.71;let mut step:i32=0;let mut error:[u8;512]=[0;512];let mut gpu:i32=0;
 while step<40 {
  quantum_set_angle(train,0,angle+1.5707963267948966);
  let high:*QuantumState=quantum_cudaq(train,2,&mut error[0] as *u8,512,&mut gpu as *i32)?;
  let hi:f64=quantum_expect(high,0,0)?;quantum_state_free(high);
  quantum_set_angle(train,0,angle-1.5707963267948966);
  let low:*QuantumState=quantum_cudaq(train,2,&mut error[0] as *u8,512,&mut gpu as *i32)?;
  let lo:f64=quantum_expect(low,0,0)?;quantum_state_free(low);
  angle=angle-0.2*(hi-lo)/2.0;step=step+1;
 }
 quantum_set_angle(train,0,angle);let end:*QuantumState=quantum_cudaq(train,2,&mut error[0] as *u8,512,&mut gpu as *i32)?;
 let energy:f64=quantum_expect(end,0,0)?;
 printf("cudaq on_gpu=%d circuits=8 optimizer_steps=%d energy=%.12f\n",gpu,step,energy);
 if energy> -0.99999 {return Result::Err(22);}
 quantum_state_free(end);quantum_free(train);Result::Ok(0)
}
fn main(argc:i32,argv:**u8)->i32 {
 let mut gpu:i32=0;if argc>1{gpu=1;}
 match run(gpu){Result::Ok(v)=>v,Result::Err(e)=>e}
}
