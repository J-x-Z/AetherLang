# Functions, precedence, mutation, nested loops, and boolean short circuit.
def square(x: int) -> int:
    return x * x

def main():
    total = 0
    for i in range(1, 101):
        total = total + square(i)
    if total != 338350:
        return 1
    i = 0
    sum = 0
    while i < 20:
        i = i + 1
        if i % 2 == 0:
            continue
        sum = sum + i
        if i == 9:
            break
    if sum != 25 or not total > 100:
        return 2
    if 2 + 3 * 4 != 14:
        return 3
    print(total)
    print(sum)
    return 0
