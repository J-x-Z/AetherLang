def main():
    words = [52, 9]
    words[0] |= 256
    words[0] ^= 16
    words[0] <<= 4
    words[0] >>= 4
    words[0] %= 19
    words[1] &= 3
    total = (words[0] << 1) | words[1]
    total += 9
    total -= 2
    total *= 3
    total /= 2
    if total != 33 or (12 & 6 ^ 1) != 5:
        return 1
    return 0
