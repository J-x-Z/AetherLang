use vec::*;
use option::*;
extern "C"{fn puts(s:*u8)->i32;}
type Pair=(i32,i64);
struct Wrapped{pair:Pair,tag:i8}
@repr(packed)struct PackedTuple{tag:u8,pair:(u32,u64)}
enum Package{Pair(Pair),Empty}
static SEED:Pair=(3,4);
static ZERO:(i32,(bool,i8));
fn identity<T>(x:T)->T{x}
fn first<A,B>(x:(A,B))->A{x.0}
fn shape<T,const N:usize>(value:(T,[u8;N]))->usize{N}
fn early()->i32{let never:(i32,i32)=({return 17;},{return 99;});100}
fn make(x:i32)->Pair{(x,x as i64+1)}
fn fractions()->(f32,f64){(1.25,2.5)}
fn bump(order:*i32,value:i32)->i32{*order=*order*10+value;value}
fn update(pair:&mut Pair){pair.0=30;pair.1=40;}
fn borrow_right(pair:&Pair)->&i64{&pair.1}
fn payload(p:Package)->i32{match p{Package::Pair(v)=>v.0,Package::Empty=>0}}
fn main()->i32{
 let mut order:i32=0;
 let sequence:(i32,i32,i32)=(bump(&mut order as *i32,1),bump(&mut order as *i32,2),bump(&mut order as *i32,3));
 if order!=123||sequence.0!=1||sequence.1!=2||sequence.2!=3{return 1;}
 let nested:(i8,(bool,u8),())=(-128,(true,255),());
 if nested.0!= -128||!nested.1.0||nested.1.1!=255{return 2;}
 let single:(i32,)=(9,);if single.0!=9||(9 as i32,true).0!=9||((7 as i32,),).0.0!=7{return 3;}
 let original:Pair=make(10);let mut copy:Pair=identity(original);update(&mut copy);
 if original.0!=10||original.1!=11||copy.0!=30||copy.1!=40{return 4;}
 if first(original)!=10||*borrow_right(&original)!=11{return 5;}
 let wrapped:Wrapped=Wrapped{pair:(7,8),tag:2};if payload(Package::Pair(wrapped.pair))!=7{return 6;}
 let mut array:[Pair;2]=[SEED,make(20)];array[1].0=21;if array[0].0!=3||array[1].0!=21||array[1].1!=21{return 7;}
 let mut bytes:[i32;2]=[1,2];let snapshots:([i32;2],[i32;2])=(bytes,{bytes[0]=99;bytes});
 if snapshots.0[0]!=1||snapshots.1[0]!=99||snapshots.0[1]!=2{return 8;}
 if make(24).0!=24||([31 as i32,32 as i32],).0[1]!=32{return 9;}
 if ZERO.0!=0||ZERO.1.0||ZERO.1.1!=0||size_of((i32,i32))!=8||align_of((i32,i32))!=4{return 10;}
 let real:(f32,f64)=fractions();if real.0 as f64+real.1!=3.75{return 11;}
 let mut values:Vec<Pair>=vec_new();if !vec_push(&mut values as *Vec<Pair>,original){return 12;}
 let read:Pair=option_or(vec_get(&values as *Vec<Pair>,0),(-1,-1));vec_free(&mut values as *Vec<Pair>);if read.0!=10||read.1!=11{return 13;}
 if early()!=17||shape((42,[0;3]))!=3{return 14;}
 let packed:PackedTuple=PackedTuple{tag:1,pair:(13,42)};
 if size_of(PackedTuple)!=17||offset_of(PackedTuple,pair)!=1||packed.pair.1!=42{return 15;}
 let zero:((),)=((),);let mut zeros:Vec<((),)>=vec_new();
 if size_of(((),))!=0||!vec_push(&mut zeros as *Vec<((),)>,identity(zero)){return 16;}
 vec_free(&mut zeros as *Vec<((),)>);
 puts("tuple-values=ok");return 0;
}
