struct Views{first:&i64,second:&i64}
enum Maybe{Some(&i64),None}
fn views(a:&i64,b:&i64)->Views{return Views{first:a,second:b};}
fn pick(value:Views)->&i64{return value.second;}
fn branch(flag:bool,a:&i64,b:&i64)->&i64{return if flag{a}else{b};}
fn empty()->Maybe{return Maybe::None;}
fn main()->i32{
 let a:i64=7;let b:i64=9;let pair:Views=views(&a,&b);let values:[&i64;2]=[pair.first,pick(pair)];
 if *values[0]!=7||*values[1]!=9{return 1;}
 let borrowed:&i64=&a;let nested:& &i64=&borrowed;if **nested!=7{return 2;}
 let captured:_=||->i64{*borrowed};if captured()!=7{return 3;}
 if *branch(false,&a,&b)!=9{return 4;}
 let unused:Maybe=empty();let value:Maybe=Maybe::Some(&a);let result:i64=match value{Maybe::Some(p)=>*p,Maybe::None=>3};if result!=7{return 5;}
 let count:i64=1;let mut mutable:_=||->i64{count+=1;count+*borrowed};if mutable()!=9||mutable()!=10{return 6;}
 let numbers:[i32;2]=[3,4];let reference:&[i32;2]=&numbers;
 if array_read(&reference)!=7{return 7;}
 let tuple:(i32,i64)=(13,29);let tuple_ref:&(i32,i64)=&tuple;
 if tuple_read(&tuple_ref)!=42{return 8;}
 let refs:(&i64,&i64)=tuple_refs(&a,&b);if *refs.0+*refs.1!=16{return 9;}
 let x:i64=99;let dispatch:_=|value:Maybe|->i64{match value{Maybe::Some(x)=>*x,Maybe::None=>x}};
 if dispatch(Maybe::Some(&a))!=7||dispatch(Maybe::None)!=99{return 10;}
 return 0;
}
fn array_read(value:& &[i32;2])->i32{return value[0]+value[1];}
fn tuple_read(value:& &(i32,i64))->i64{return value.0 as i64+value.1;}
fn tuple_refs(a:&i64,b:&i64)->(&i64,&i64){return (a,b);}
