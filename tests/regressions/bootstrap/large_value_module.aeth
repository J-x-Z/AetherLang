use snapshots::changed;

struct Packet { bytes:[u8;65536], tag:u8 }

fn packet(source:Packet)->Packet {
    return Packet{bytes:changed(source.bytes,29),tag:source.tag};
}

fn main()->i32 {
    let source:Packet=Packet{bytes:[5;65536],tag:7};
    let result:Packet=packet(source);
    if result.tag!=7 || result.bytes[65535]!=29 || source.bytes[65535]!=5 { return 1; }
    if changed(result.bytes,11)[65535]!=11 || result.bytes[65535]!=29 { return 2; }
    return 0;
}
