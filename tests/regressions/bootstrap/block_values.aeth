extern "C"{fn puts(s:*u8)->i32;}
struct Pair{x:i32,y:i64}
fn add(counter:*i32,delta:i32)->i32{*counter+=delta;*counter}
fn early(flag:bool)->i32{return if flag {return 7;}else{9};}
fn both(flag:bool)->i32{return if flag {return 11;}else{return 12;};}
fn exit_operand()->i32{return ({return 7;})/0;}
fn noop(){}
fn main()->i32{
 let mut counter:i32=0;
 let x:i32=if true{add(&counter,1)}else{add(&counter,100)};
 let y:i32={let local:i32=add(&counter,2);if local==3{local+4}else{100}};
 if x!=1||y!=7||counter!=3{return 1;}
 let pair:Pair=if false{Pair{x:1,y:2}}else{Pair{x:3,y:4}};
 let a:[i32;2]=if pair.x==3{[5,6]}else{[7,8]};
 if a[1]!=6||pair.y!=4{return 2;}
 let nested:i32=10+(if true{{let n:i32=5;n+2}}else{90});if nested!=17{return 3;}
 if exit_operand()!=7{return 7;}
 if early(true)!=7||early(false)!=9||both(true)!=11||both(false)!=12{return 4;}
 let mut i:i32=0;
 while i<4{ i+=1;let value:i32={if i==1{continue;}if i==4{break;}i};counter+=value;}
 if counter!=8||i!=4{return 5;}
 (if true{noop()}else{noop()});
 if align_of(Pair)!=8||align_of([Pair;0])!=8||size_of(Pair)!=16{return 6;}
 puts("block-values=ok");return 0;
}
