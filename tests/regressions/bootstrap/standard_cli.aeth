use args::{Args, args_init as construct, args_has_flag, args_positional}
use string::{alloc, dealloc, copy_into, append_into, equals}
extern "C" {fn printf(format:*u8,...)->i32;}
pub struct Pair {pub x:i32,pub y:i32}
fn next(value:*i32)->i32 {*value=*value+1;return *value;}
fn make(trace:*i32)->Pair {Pair{y:next(trace),x:next(trace)}}
fn truth(pair:Pair)->bool {pair.x==1 && pair.y==2}
fn answer(ok:bool)->i32 {if ok {Pair{x:40,y:2}.x+2} else {0}}
fn main(argc:i32,argv:**u8)->i32 {
 let mut command:Args=construct(argc,argv)
 if !args_has_flag(&command as *Args,"-v","--verbose") {return 1}
 let first:*u8=args_positional(&command as *Args,0)
 let second:*u8=args_positional(&command as *Args,1)
 if first==(0 as *u8) || second==(0 as *u8) {return 2}
 let buffer:*u8=alloc(64)
 if buffer==(0 as *u8) {return 3}
 if !copy_into(buffer,64,first) || !append_into(buffer,64,second) {dealloc(buffer);return 4}
 let ok:bool=equals(buffer,"hello world-literal")
 dealloc(buffer)
 if !ok {return 5}
 let mut trace:i32=0
 let pair:Pair=make(&mut trace as *i32)
 if pair.x!=2 || pair.y!=1 || trace!=2 {return 6}
 if truth(Pair{x:1,y:2}) {if answer(true)!=42 {return 7}}else{return 8}
 let x:i32=12;let y:i32=30
 let shorthand:Pair=Pair{x,y}
 if shorthand.x+shorthand.y!=42 {return 9}
 printf("standard-cli=ok\n")
 return 0
}
