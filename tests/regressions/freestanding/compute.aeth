#![no_std]
#![no_main]
struct Pair { a:i64, b:i64 }
extern "C" {
    @pure fn custom_add(a:i64,b:i64)->i64;
    @pure fn abs(value:i32)->i32;
}
#[no_mangle]
pub fn sum(n:u64)->u64 {
    let mut i:u64=0;
    let mut total:u64=0;
    while i<=n {total=total+i;i=i+1;}
    return total;
}
#[no_mangle]
pub fn copied_sum(value:*Pair)->i64 {
    let mut copy:Pair=*value;
    copy.a=copy.a+1;
    return custom_add(copy.a,copy.b);
}
#[no_mangle]
pub fn external_abs()->i32 { return abs(-7); }
#[no_mangle]
pub fn convert(value:f64)->i64 { return value as i64; }
#[no_mangle]
pub fn nan_result()->i64 {
    let zero:f64=0.0;
    return (zero/zero) as i64;
}
