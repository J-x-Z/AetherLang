type Pair = (i32, i64);
struct Wrapped { pair: Pair, tag: i8 }
enum Package { Pair(Pair), Empty }
static SEED: Pair = (3, 4);
static ZERO: (i32, (bool, i8));

fn identity<T>(value: T) -> T { value }
fn first<A, B>(value: (A, B)) -> A { value.0 }
fn make(value: i32) -> Pair { (value, value as i64 + 1) }
fn fractions() -> (f32, f64) { (1.25, 2.5) }
fn choose(flag: bool) -> Pair { if flag { (5, 6) } else { (7, 8) } }
fn bump(order: &mut i32, value: i32) -> i32 {
    *order = *order * 10 + value;
    value
}
fn update(pair: &mut Pair) { pair.0 = 30; pair.1 = 40; }
fn refs(left: &i32, right: &i32) -> (&i32, &i32) { (left, right) }
fn borrow_right(pair: &Pair) -> &i64 { &pair.1 }
fn temporary_ref(value: &i32) -> &i32 { (value,).0 }
fn payload(package: Package) -> i32 {
    match package { Package::Pair(pair) => pair.0, Package::Empty => 0 }
}
fn early() -> i32 {
    let never: (i32, i32) = ({ return 17; }, { return 99; });
    100
}

fn main() -> i32 {
    let mut order: i32 = 0;
    let ordered: (i32, i32, i32) = (bump(&mut order, 1), bump(&mut order, 2), bump(&mut order, 3));
    if order != 123 || ordered.0 != 1 || ordered.1 != 2 || ordered.2 != 3 { return 1; }
    let nested: (i8, (bool, u8), ()) = (-128, (true, 255), ());
    if nested.0 != -128 || !nested.1.0 || nested.1.1 != 255 { return 2; }
    let single: (i32,) = (9,);
    if single.0 != 9 || (9 as i32, true).0 != 9 || ((7 as i32,),).0.0 != 7 { return 3; }
    let original: Pair = make(10);
    let mut copy: Pair = identity(original);
    update(&mut copy);
    if original.0 != 10 || original.1 != 11 || copy.0 != 30 || copy.1 != 40 { return 4; }
    if first(original) != 10 || *borrow_right(&original) != 11 { return 5; }
    let wrapped: Wrapped = Wrapped { pair: choose(false), tag: 2 };
    if wrapped.pair.0 != 7 || wrapped.pair.1 != 8 || payload(Package::Pair(wrapped.pair)) != 7 { return 6; }
    let mut array: [Pair; 2] = [SEED, make(20)];
    array[1].0 = 21;
    if array[0].0 != 3 || array[0].1 != 4 || array[1].0 != 21 || array[1].1 != 21 { return 7; }
    let mut bytes: [i32; 2] = [1, 2];
    let snapshots: ([i32; 2], [i32; 2]) = (bytes, { bytes[0] = 99; bytes });
    if snapshots.0[0] != 1 || snapshots.1[0] != 99 || snapshots.0[1] != 2 { return 8; }
    let left: i32 = 50;
    let right: i32 = 60;
    let references: (&i32, &i32) = refs(&left, &right);
    if *references.0 != 50 || *references.1 != 60 { return 9; }
    let borrowed: &Pair = &original;
    let shared_twice: & &Pair = &borrowed;
    let nested_refs: ((&i32, &i32),) = (refs(&left, &right),);
    if shared_twice.1 != 11 || *nested_refs.0.1 != 60 { return 12; }
    let initialized: (i32, (i8, bool));
    initialized.0 = 13;
    initialized.1.0 = 14;
    initialized.1.1 = true;
    let copied_init: (i32, (i8, bool)) = initialized;
    if copied_init.0 != 13 || copied_init.1.0 != 14 || !copied_init.1.1 { return 13; }
    if make(24).0 != 24 || ([31 as i32, 32 as i32],).0[1] != 32 || *temporary_ref(&left) != 50 { return 14; }
    if ZERO.0 != 0 || ZERO.1.0 || ZERO.1.1 != 0 || early() != 17 { return 10; }
    if size_of((i32, i32)) != 8 || align_of((i32, i32)) != 4 { return 11; }
    let real: (f32, f64) = fractions();
    if real.0 as f64 + real.1 != 3.75 { return 15; }
    return 0;
}
