use binary_io::{fd_read_bytes, read_path_bytes, write_path_bytes};
use result::Result;
use vec::{Vec, vec_free};
use posix::{EBADF, EFBIG, ENOENT, EINVAL};
fn main(argc:i32, argv:**u8) -> i32 {
    if argc != 3 { return 1; }
    match fd_read_bytes(-1, 1) { Result::Err(code) => { if code != EBADF {return 2;} }, Result::Ok(_) => {return 3;}, };
    match read_path_bytes(argv[2], 5) { Result::Err(code) => { if code != ENOENT {return 4;} }, Result::Ok(_) => {return 5;}, };
    let mut data:Vec<u8> = match fd_read_bytes(0, 9000) { Result::Ok(v) => v, Result::Err(code) => {return code;}, };
    let n:u64 = data.len;
    match write_path_bytes(argv[1], data.data, n) { Result::Err(code) => {return code;}, Result::Ok(_) => (), };
    vec_free(&mut data as *Vec<u8>);
    match write_path_bytes(argv[1], 0 as *u8, 1) { Result::Err(code) => {if code != EINVAL {return 6;}}, Result::Ok(_) => {return 6;}, };
    let mut again:Vec<u8> = match read_path_bytes(argv[1], n) { Result::Ok(v) => v, Result::Err(code) => {return code;}, };
    if again.len != n {return 7;}
    if n > 0 {
        match read_path_bytes(argv[1], n-1) { Result::Err(code) => {if code != EFBIG {return 8;}}, Result::Ok(_) => {return 9;}, };
    }
    vec_free(&mut again as *Vec<u8>);
    return 0;
}
