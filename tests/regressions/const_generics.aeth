// One template controls real layout, array values, calls and returned values.
const WIDTH:usize=3;
struct Block<T,const N:usize>{ data:[T;N] }
struct Link<T,const N:usize>{ data:[T;N], next:*Link<T,N> }
enum Packet<T,const N:usize>{ Values([T;N]), Empty }
struct Flag<const B:bool>{ value:i32 }
struct Unsigned<const N:u64>{marker:u8}
struct Signed<const N:i64>{marker:u8}
fn unsigned_value<const N:u64>(value:Unsigned<N>)->u64{N}
fn signed_value<const N:i64>(value:Signed<N>)->i64{N}
fn length<T,const N:usize>(values:[T;N])->usize{N}
fn copy<T,const N:usize>(values:[T;N])->[T;N]{values}
fn sum<const N:usize>(values:[i64;N])->i64{
    let mut total:i64=0;
    let mut index:usize=0;
    while index<N{total=total+values[index];index=index+1;}
    total
}
type Pair<T>=Block<T,2>;
fn alias_first<T>(block:Pair<T>)->T{block.data[0]}
fn flag_value<const B:bool>(flag:Flag<B>)->bool{B}
fn first<T,const N:usize>(block:Block<T,N>)->T{block.data[0]}
fn padded<const N:usize>(data:[i64;N],padding:[i64;N+1])->usize{N}
fn main()->i32{
    let data:[i64;WIDTH]=[2,4,6];
    let block:Block<i64,{1+2}>=Block{data:copy(data)};
    let equivalent:Block<i64,WIDTH>=block;
    if first(equivalent)!=2{return 1;}
    if length(data)!=3 || sum(copy(data))!=12{return 2;}
    if size_of(Block<i64,3>)!=24 || size_of(Block<i64,4>)!=32{return 3;}
    let empty:[u8;0]=[];
    if length(empty)!=0{return 4;}
    let small:Block<u8,2>=Block{data:[7,9]};
    if first(small)!=7{return 5;}
    let packet:Packet<i64,3>=Packet::Values(data);
    let total:i64=match packet{Packet::Values(v)=>sum(v),Packet::Empty=>0};
    if total!=12{return 6;}
    let node:Link<i64,3>=Link{data:data,next:0 as *Link<i64,3>};
    if node.data[2]!=6{return 7;}
    if padded(data,[0,0,0,0])!=3{return 8;}
    let flag:Flag<{true}>=Flag{value:9};
    if flag.value!=9 || !flag_value(flag){return 9;}
    let inferred:Block<i64,2>=Block{data:[11,13]};
    if sum(inferred.data)!=24 || alias_first(inferred)!=11{return 10;}
    let unsigned:Unsigned<18446744073709551615>=Unsigned{marker:0};
    let signed:Signed<{-9223372036854775808}>=Signed{marker:0};
    if unsigned_value(unsigned)!=18446744073709551615{return 11;}
    if signed_value(signed)!=-9223372036854775808{return 12;}
    0
}
