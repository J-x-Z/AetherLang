use host::*;
// Versioned static registry wire formats. Tab-separated UTF-8, LF terminated;
// metadata is bounded and never interpreted as shell input or TOML manifests.

use vec::{Vec,vec_new,vec_push,vec_free};
use result::Result;
use text::utf8_valid;
use config::module_name_valid;
extern "C" { fn strcmp(a:*u8,b:*u8)->i32; fn strlen(text:*u8)->u64; fn strncmp(a:*u8,b:*u8,n:u64)->i32; fn malloc(n:u64)->*void; fn memcpy(out:*void,input:*void,n:u64)->*void; }
pub struct RegistryRow { pub a:*u8, pub b:*u8, pub c:*u8, pub d:*u8 }
pub struct RegistryTable { pub bytes:Vec<u8>, pub rows:Vec<RegistryRow> }
pub fn registry_copy(text:*u8)->*u8 {
    if text==(0 as *u8) { return 0 as *u8; }
    let size:u64=strlen(text)+1; let result:*u8=malloc(size) as *u8;
    if result!=(0 as *u8) { memcpy(result as *void,text as *void,size); }
    result
}
pub fn registry_table_free(table:*RegistryTable) { vec_free(&mut table.rows as *Vec<RegistryRow>); vec_free(&mut table.bytes as *Vec<u8>); }
pub fn registry_table_empty()->RegistryTable { RegistryTable{bytes:vec_new(),rows:vec_new()} }
pub fn registry_table_parse(bytes:Vec<u8>,header:*u8,columns:u64)->Result<RegistryTable,i32> {
    let mut table:RegistryTable=RegistryTable{bytes:bytes,rows:vec_new()};
    let length:u64=table.bytes.len;
    let mut ok:bool=columns>=1 && columns<=4 && length>0 && utf8_valid(table.bytes.data,length);
    let mut i:u64=0;
    while ok && i<length { if table.bytes.data[i]==0 || table.bytes.data[i]==13 { ok=false; } i+=1; }
    if ok { ok=table.bytes.data[length-1]==10; }
    if !ok || !vec_push(&mut table.bytes as *Vec<u8>,0 as u8) { registry_table_free(&mut table as *RegistryTable); return Result::Err(1); }
    i=0; while i<length && table.bytes.data[i]!=10 { i+=1; }
    table.bytes.data[i]=0;
    if strcmp(table.bytes.data,header)!=0 { registry_table_free(&mut table as *RegistryTable); return Result::Err(1); }
    i+=1;
    while i<length {
        let mut fields:[*u8;4]=[table.bytes.data+i,0 as *u8,0 as *u8,0 as *u8]; let mut count:u64=1;
        while i<length && table.bytes.data[i]!=10 {
            if table.bytes.data[i]==9 {
                table.bytes.data[i]=0;
                if count>=columns { ok=false; break; }
                fields[count]=table.bytes.data+i+1; count+=1;
            } else if table.bytes.data[i]<32 || table.bytes.data[i]==127 { ok=false; break; }
            i+=1;
        }
        if !ok || count!=columns || i>=length || table.rows.len>=4096 { registry_table_free(&mut table as *RegistryTable); return Result::Err(1); }
        table.bytes.data[i]=0; i+=1;
        let mut n:u64=0; while n<count { if fields[n][0]==0 { ok=false; } n+=1; }
        if !ok || !vec_push(&mut table.rows as *Vec<RegistryRow>,RegistryRow{a:fields[0],b:fields[1],c:fields[2],d:fields[3]}) { registry_table_free(&mut table as *RegistryTable); return Result::Err(1); }
    }
    Result::Ok(table)
}
pub fn registry_table_read(path:*u8,header:*u8,columns:u64)->Result<RegistryTable,i32> {
    let bytes:Vec<u8>=read_path_bytes(path,1048576)?;
    registry_table_parse(bytes,header,columns)
}
pub fn registry_version(version:*u8)->bool {
    if version==(0 as *u8) { return false; }
    let mut i:u64=0; let mut part:u64=0;
    while part<3 {
        let start:u64=i; let mut value:u64=0;
        while version[i]>=48 && version[i]<=57 {
            value=value*10+(version[i]-48) as u64; if value>4294967295 { return false; } i+=1;
        }
        if i==start || (i-start>1 && version[start]==48) { return false; }
        if part<2 { if version[i]!=46 { return false; } i+=1; }
        part+=1;
    }
    version[i]==0
}
pub fn registry_hash(hash:*u8)->bool {
    if hash==(0 as *u8) || strlen(hash)!=64 { return false; }
    let mut i:u64=0; while i<64 { let c:u8=hash[i]; if !((c>=48 && c<=57)||(c>=97 && c<=102)) { return false; } i+=1; } true
}
pub fn registry_url(url:*u8)->bool {
    if url==(0 as *u8) || strlen(url)>4096 { return false; }
    let mut i:u64=0;
    if strncmp(url,"http://",7)==0 { i=7; } else if strncmp(url,"https://",8)==0 { i=8; } else { return false; }
    if url[i]==0 || url[i]==47 { return false; }
    while url[i]!=0 {
        let c:u8=url[i];
        if c<=32 || c>=127 || c==92 || c==64 || c==63 || c==35 { return false; }
        i+=1;
    }
    url[i-1]!=47
}
// Files are relative, with no empty/dot/up-level components or reserved metadata.
pub fn registry_relative(path:*u8)->bool {
    if path!=0 as *u8 && !host_registry_path(path){return false;}
    if path==(0 as *u8) || path[0]==0 || strlen(path)>1024 || path[0]==47 || strncmp(path,".jxz-",5)==0 { return false; }
    let mut i:u64=0; let mut start:u64=0;
    loop {
        let c:u8=path[i];
        if c==0 || c==47 {
            let n:u64=i-start;
            if n==0 || (n==1 && path[start]==46) || (n==2 && path[start]==46 && path[start+1]==46) { return false; }
            if c==0 { break; } start=i+1;
        } else if c<32 || c==127 || c==92 { return false; }
        i+=1;
    }
    true
}
pub fn registry_index_valid(table:*RegistryTable)->bool {
    let mut i:u64=0;
    while i<table.rows.len {
        let row:RegistryRow=table.rows.data[i];
        if !module_name_valid(row.a) || !registry_version(row.b) || !registry_hash(row.c) { return false; }
        let mut j:u64=0; while j<i { if strcmp(table.rows.data[j].a,row.a)==0 && strcmp(table.rows.data[j].b,row.b)==0 { return false; } j+=1; }
        i+=1;
    }
    true
}
pub fn registry_manifest_valid(table:*RegistryTable)->bool {
    let mut i:u64=0; let mut manifest:bool=false;
    while i<table.rows.len {
        let row:RegistryRow=table.rows.data[i];
        if !registry_hash(row.a) || !registry_relative(row.b) { return false; }
        if strcmp(row.b,"Jxz.toml")==0 { manifest=true; }
        let mut j:u64=0;
        while j<i {
            let other:*u8=table.rows.data[j].b; let a:u64=strlen(other); let b:u64=strlen(row.b);
            if strcmp(other,row.b)==0 || (a<b && strncmp(other,row.b,a)==0 && row.b[a]==47) || (b<a && strncmp(other,row.b,b)==0 && other[b]==47) { return false; }
            j+=1;
        }
        i+=1;
    }
    manifest
}
pub fn registry_append(bytes:*Vec<u8>,text:*u8,separator:u8)->bool {
    let mut i:u64=0;
    while text[i]!=0 { if !vec_push(bytes,text[i]) { return false; } i+=1; }
    if separator!=0 { return vec_push(bytes,separator); }
    true
}
