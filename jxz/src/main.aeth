// JXZ local project driver. All build/configuration decisions live in AetherLang.
use build::{build_project, run_project, clean_project};
use init::{init_project};
use test::{run_tests};

extern "C" {
    fn puts(s: *u8) -> i32;
    fn strcmp(a: *u8, b: *u8) -> i32;
}

fn print_help() {
    puts("JXZ - AetherLang project driver\0" as *u8);
    puts("Usage: jxz <init [name]|build [--release]|run [-- args...]|test|clean>\0" as *u8);
    puts("AETHC selects the compiler; AETHER_BACKEND overrides its backend (llvm or c).\0" as *u8);
    puts("Local project commands currently require a 64-bit POSIX host.\0" as *u8);
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 { print_help(); return 0; }
    let command: *u8 = argv[1];
    if strcmp(command, "help\0" as *u8) == 0 || strcmp(command, "--help\0" as *u8) == 0 || strcmp(command, "-h\0" as *u8) == 0 {
        print_help(); return 0;
    }
    if strcmp(command, "version\0" as *u8) == 0 || strcmp(command, "--version\0" as *u8) == 0 {
        puts("jxz 0.3.0-dev.1\0" as *u8); return 0;
    }
    if strcmp(command, "init\0" as *u8) == 0 {
        if argc > 3 { print_help(); return 2; }
        if argc == 3 { return init_project(argv[2]); }
        return init_project("my_project\0" as *u8);
    }
    if strcmp(command, "build\0" as *u8) == 0 {
        let mut release: bool = false;
        if argc == 3 {
            if strcmp(argv[2], "--release\0" as *u8) != 0 { print_help(); return 2; }
            release = true;
        } else if argc > 3 { print_help(); return 2; }
        return build_project(release);
    }
    if strcmp(command, "run\0" as *u8) == 0 {
        let mut start: i32 = 1;
        if argc > 2 {
            if strcmp(argv[2], "--\0" as *u8) == 0 { start = 2; }
        }
        return run_project(argc - start, argv + start);
    }
    if strcmp(command, "test\0" as *u8) == 0 {
        if argc != 2 { print_help(); return 2; }
        return run_tests();
    }
    if strcmp(command, "clean\0" as *u8) == 0 {
        if argc != 2 { print_help(); return 2; }
        return clean_project();
    }
    if strcmp(command, "install\0" as *u8) == 0 || strcmp(command, "add\0" as *u8) == 0 || strcmp(command, "remove\0" as *u8) == 0 || strcmp(command, "update\0" as *u8) == 0 {
        puts("jxz: registry/dependency management is not implemented; no files changed\0" as *u8);
        return 2;
    }
    puts("jxz: unknown command (see jxz help)\0" as *u8);
    return 2;
}
