use host::*;
// The local project manifest has explicit ownership: every parsed string points
// into storage, which is released exactly once by config_free.

use vec::{Vec, vec_new, vec_push, vec_free};
use result::Result;
extern "C" {
    fn realloc(ptr: *void, size: u64) -> *void;
    fn free(ptr: *void);
    fn strcmp(a: *u8, b: *u8) -> i32;
    fn strncmp(a: *u8, b: *u8, count: u64) -> i32;
    fn strlen(s: *u8) -> u64;
    fn strerror(code: i32) -> *u8;
}

// Shared project diagnostics never write to stdout, which may carry LSP frames.
pub fn config_error(message: *u8) { host_error(message); }

pub struct Dependency { pub name: *u8, pub path: *u8, pub version: *u8 }

pub struct Config {
    pub name: *u8,
    pub version: *u8,
    pub src_dir: *u8,
    pub target_dir: *u8,
    pub main_file: *u8,
    pub module_paths: **u8,
    pub module_path_count: u64,
    pub link_objects: **u8,
    pub link_object_count: u64,
    pub dependencies: Vec<Dependency>,
    // Resolution owns these strings; parsed manifest strings still borrow storage.
    pub resolved_modules: Vec<*u8>,
    pub resolved_paths: Vec<*u8>,
    pub resolved_objects: Vec<*u8>,
    pub dependency_record: Vec<u8>,
    pub storage: Vec<u8>,
    pub valid: bool,
}

fn config_space(p: *u8) -> *u8 {
    let mut current: *u8 = p;
    while current[0] == 32 || current[0] == 9 || current[0] == 13 {
        current = current + 1;
    }
    return current;
}

// Decode one single-line TOML basic/literal string in place. The returned tail
// preserves delimiters for both scalar values and multiline path arrays.
fn config_string(text: *u8, tail: **u8) -> *u8 {
    let quote: u8 = text[0];
    if quote != 34 && quote != 39 { return 0 as *u8; }
    let start: *u8 = text + 1;
    let mut read: *u8 = start;
    let mut write: *u8 = start;
    while read[0] != 0 && read[0] != quote {
        let mut value: u8 = read[0];
        if value == 10 || value == 13 { return 0 as *u8; }
        read = read + 1;
        if value == 92 && quote == 34 {
            value = read[0];
            if value == 0 { return 0 as *u8; }
            read = read + 1;
            if value == 110 { value = 10; }
            else if value == 114 { value = 13; }
            else if value == 116 { value = 9; }
            else if value != 34 && value != 92 { return 0 as *u8; }
        }
        write[0] = value;
        write = write + 1;
    }
    if read[0] != quote { return 0 as *u8; }
    *tail = read + 1;
    write[0] = 0;
    return start;
}

// A value or table must end on this physical line, optionally with a comment.
// Return the next line (or the final NUL), and null only for trailing garbage.
fn config_line_tail(text: *u8) -> *u8 {
    let mut tail: *u8 = config_space(text);
    if tail[0] == 35 {
        while tail[0] != 0 && tail[0] != 10 { tail = tail + 1; }
    }
    if tail[0] == 10 { return tail + 1; }
    if tail[0] == 0 { return tail; }
    return 0 as *u8;
}

// Unlike scalar strings, array separators may span physical lines/comments.
fn config_array_space(text: *u8) -> *u8 {
    let mut cursor: *u8 = text;
    while true {
        cursor = config_space(cursor);
        if cursor[0] == 10 { cursor = cursor + 1; }
        else if cursor[0] == 35 {
            while cursor[0] != 0 && cursor[0] != 10 { cursor = cursor + 1; }
        } else { return cursor; }
    }
    return cursor;
}

struct ConfigPaths {
    items: **u8,
    count: u64,
    tail: *u8,
    valid: bool,
}

fn config_paths(text: *u8) -> ConfigPaths {
    let mut result: ConfigPaths = ConfigPaths {
        items: 0 as **u8, count: 0, tail: 0 as *u8, valid: false,
    };
    if text[0] != 91 { return result; }
    let mut cursor: *u8 = config_array_space(text + 1);
    let mut capacity: u64 = 0;
    while cursor[0] != 93 {
        let mut tail: *u8 = 0 as *u8;
        let value: *u8 = config_string(cursor, &tail as **u8);
        if !config_path_valid(value) { break; }
        if result.count == capacity {
            // The 1 MiB input bound limits the number of nonempty strings;
            // this additional bound also makes allocation arithmetic explicit.
            if capacity >= 1048576 { break; }
            let mut grown: u64 = 8;
            if capacity != 0 { grown = capacity * 2; }
            let items: **u8 = realloc(result.items as *void, grown * size_of(*u8) as u64) as **u8;
            if items == (0 as **u8) { break; }
            result.items = items;
            capacity = grown;
        }
        result.items[result.count] = value;
        result.count = result.count + 1;
        cursor = config_array_space(tail);
        if cursor[0] == 93 { break; }
        if cursor[0] != 44 { break; }
        cursor = config_array_space(cursor + 1);
    }
    if cursor[0] == 93 {
        result.tail = cursor + 1;
        result.valid = true;
        return result;
    }
    free(result.items as *void);
    result.items = 0 as **u8;
    result.count = 0;
    return result;
}

pub fn config_path_valid(path: *u8) -> bool {
    if path == (0 as *u8) { return false; }
    if path[0] == 0 { return false; }
    let mut i: u64 = 0;
    while path[i] != 0 {
        if path[i] < 32 || path[i] == 127 { return false; }
        i = i + 1;
    }
    return true;
}

pub fn package_name_valid(name: *u8) -> bool {
    if !config_path_valid(name) || !host_name_valid(name) { return false; }
    if strlen(name) > 255 { return false; }
    if strncmp(name, ".jxz-\0" as *u8, 5) == 0 { return false; }
    if strcmp(name, ".\0" as *u8) == 0 || strcmp(name, "..\0" as *u8) == 0 { return false; }
    let mut i: u64 = 0;
    while name[i] != 0 {
        if name[i] == 47 || name[i] == 92 { return false; }
        i = i + 1;
    }
    return true;
}

fn free_owned_paths(paths: *Vec<*u8>) {
    let mut i:u64=0;
    while i<paths.len { free(paths.data[i] as *void); i=i+1; }
    vec_free(paths);
}

pub fn config_free(cfg: *Config) {
    free(cfg.module_paths as *void);
    free(cfg.link_objects as *void);
    cfg.module_paths = 0 as **u8;
    cfg.module_path_count = 0;
    cfg.link_objects = 0 as **u8;
    cfg.link_object_count = 0;
    vec_free(&mut cfg.dependencies as *Vec<Dependency>);
    free_owned_paths(&mut cfg.resolved_modules as *Vec<*u8>);
    free_owned_paths(&mut cfg.resolved_paths as *Vec<*u8>);
    free_owned_paths(&mut cfg.resolved_objects as *Vec<*u8>);
    vec_free(&mut cfg.dependency_record as *Vec<u8>);
    vec_free(&mut cfg.storage as *Vec<u8>);
    cfg.valid = false;
}

pub fn config_load() -> Config { return config_load_at("Jxz.toml"); }

pub fn config_load_at(manifest:*u8) -> Config {
    let mut cfg: Config = Config {
        name: 0 as *u8,
        version: "0.1.0\0" as *u8,
        src_dir: "src\0" as *u8,
        target_dir: "target\0" as *u8,
        main_file: 0 as *u8,
        module_paths: 0 as **u8,
        module_path_count: 0,
        link_objects: 0 as **u8,
        link_object_count: 0,
        dependencies: vec_new(), resolved_modules: vec_new(), resolved_paths: vec_new(),
        resolved_objects: vec_new(), dependency_record: vec_new(),
        storage: vec_new(),
        valid: false,
    };
    cfg.storage = match read_path_bytes(manifest, 1048576) {
        Result::Ok(bytes) => bytes,
        Result::Err(code) => { config_error("jxz: cannot read Jxz.toml (1 MiB limit)"); config_error(manifest); config_error(strerror(code)); return cfg; },
    };
    let count: u64 = cfg.storage.len;
    if !vec_push(&mut cfg.storage as *Vec<u8>, 0 as u8) {
        config_error("jxz: cannot allocate manifest terminator");
        config_free(&mut cfg as *Config);
        return cfg;
    }
    let mut scan: u64 = 0;
    while scan < count {
        if cfg.storage.data[scan] == 0 { config_error("jxz: NUL in manifest\0" as *u8); config_free(&cfg as *Config); return cfg; }
        scan = scan + 1;
    }
    if !config_parse(&cfg as *Config) { config_free(&cfg as *Config); }
    return cfg;
}

// Import names are language identifiers, not arbitrary executable names.
pub fn module_name_valid(name:*u8)->bool {
    if name==(0 as *u8) || name[0]==0 { return false; }
    let mut i:u64=0;
    while name[i]!=0 {
        let c:u8=name[i];
        if !(c==95 || (c>=65 && c<=90) || (c>=97 && c<=122) || (i>0 && c>=48 && c<=57)) { return false; }
        i=i+1;
    }
    return i<=255;
}
fn config_dependency_value(text:*u8,tail:**u8,online:*bool)->*u8 {
    if text[0]==34 || text[0]==39 { *online=true; return config_string(text,tail); }
    if text[0]!=123 { return 0 as *u8; }
    let mut cursor:*u8=config_space(text+1);
    if strncmp(cursor,"path",4)==0 { cursor=config_space(cursor+4); }
    else if strncmp(cursor,"version",7)==0 { *online=true; cursor=config_space(cursor+7); }
    else { return 0 as *u8; }
    if cursor[0]!=61 { return 0 as *u8; }
    cursor=config_space(cursor+1);
    let path:*u8=config_string(cursor,tail);
    if !config_path_valid(path) { return 0 as *u8; }
    cursor=config_space(*tail);
    if cursor[0]==44 { cursor=config_space(cursor+1); }
    if cursor[0]!=125 { return 0 as *u8; }
    *tail=cursor+1;
    return path;
}

fn config_parse(cfg: *Config) -> bool {
    let mut line: *u8 = cfg.storage.data;
    let mut section: i32 = 0;
    let mut seen: i32 = 0;
    while line[0] != 0 {
        let start: *u8 = config_space(line);
        let mut next: *u8 = config_line_tail(start);
        if start[0] == 91 {
            let mut end: *u8 = start + 1;
            while end[0] != 0 && end[0] != 10 && end[0] != 93 { end = end + 1; }
            if end[0] != 93 { config_error("jxz: malformed section\0" as *u8); return false; }
            next = config_line_tail(end + 1);
            if next == (0 as *u8) { config_error("jxz: malformed section\0" as *u8); return false; }
            end[0] = 0;
            section = 0;
            if strcmp(start + 1, "package\0" as *u8) == 0 { section = 1; }
            if strcmp(start + 1, "build\0" as *u8) == 0 { section = 2; }
            if strcmp(start + 1, "dependencies\0" as *u8) == 0 { section = 3; }
            if section == 0 { config_error("jxz: unsupported manifest table; use [dependencies] name = { path = \"...\" }"); return false; }
        } else if start[0] != 0 && start[0] != 10 && start[0] != 35 {
            if section == 0 { config_error("jxz: top-level manifest keys are not supported\0" as *u8); return false; }
            let mut equal: *u8 = start;
            while equal[0] != 0 && equal[0] != 10 && equal[0] != 61 { equal = equal + 1; }
            if equal[0] != 61 { config_error("jxz: expected key = value\0" as *u8); return false; }
            let raw: *u8 = config_space(equal + 1);
            let mut end: *u8 = equal;
            while end != start {
                let prior: *u8 = end - 1;
                if prior[0] != 32 && prior[0] != 9 { break; }
                end = prior;
            }
            end[0] = 0;
            if section == 3 {
                let mut tail:*u8=0 as *u8;
                let mut online:bool=false;
                let value:*u8=config_dependency_value(raw,&tail as **u8,&mut online as *bool);
                if !module_name_valid(start) || !config_path_valid(value) {
                    config_error("jxz: dependencies require an identifier with { path = quoted-directory }, { version = quoted-x.y.z } or quoted-x.y.z");
                    return false;
                }
                let mut i:u64=0;
                while i<cfg.dependencies.len {
                    if strcmp(cfg.dependencies.data[i].name,start)==0 { config_error("jxz: duplicate dependency name"); return false; }
                    i=i+1;
                }
                if !vec_push(&mut cfg.dependencies as *Vec<Dependency>,Dependency{name:start,path:if online { 0 as *u8 } else { value },version:if online { value } else { 0 as *u8 }}) { return false; }
                line=config_line_tail(tail);
                if line==(0 as *u8) { config_error("jxz: trailing dependency garbage"); return false; }
                continue;
            }
            let mut field: i32 = 0;
            if section == 1 {
                if strcmp(start, "name\0" as *u8) == 0 { field = 1; }
                if strcmp(start, "version\0" as *u8) == 0 { field = 2; }
            }
            if section == 2 {
                if strcmp(start, "src\0" as *u8) == 0 { field = 4; }
                if strcmp(start, "target\0" as *u8) == 0 { field = 8; }
                if strcmp(start, "main\0" as *u8) == 0 { field = 16; }
                if strcmp(start, "module_paths\0" as *u8) == 0 { field = 32; }
                if strcmp(start, "link_objects\0" as *u8) == 0 { field = 64; }
            }
            if field == 0 {
                let metadata: bool = section == 1 && (strcmp(start, "edition\0" as *u8) == 0 || strcmp(start, "description\0" as *u8) == 0 || strcmp(start, "authors\0" as *u8) == 0 || strcmp(start, "license\0" as *u8) == 0 || strcmp(start, "repository\0" as *u8) == 0);
                if !metadata { config_error("jxz: unsupported manifest key\0" as *u8); return false; }
                // Existing metadata is ignored, and remains confined to one line.
                next = raw;
                while next[0] != 0 && next[0] != 10 { next = next + 1; }
                if next[0] == 10 { next = next + 1; }
            } else {
                if (seen & field) != 0 { config_error("jxz: duplicate manifest key\0" as *u8); return false; }
                seen = seen | field;
                let mut tail: *u8 = 0 as *u8;
                if field == 32 || field == 64 {
                    let paths: ConfigPaths = config_paths(raw);
                    if !paths.valid { config_error("jxz: expected an array of nonempty quoted paths\0" as *u8); return false; }
                    if field == 32 { cfg.module_paths = paths.items; cfg.module_path_count = paths.count; }
                    if field == 64 { cfg.link_objects = paths.items; cfg.link_object_count = paths.count; }
                    tail = paths.tail;
                } else {
                    let value: *u8 = config_string(raw, &tail as **u8);
                    if value == (0 as *u8) { config_error("jxz: expected a quoted string\0" as *u8); return false; }
                    if field == 1 { cfg.name = value; }
                    if field == 2 { cfg.version = value; }
                    if field == 4 { cfg.src_dir = value; }
                    if field == 8 { cfg.target_dir = value; }
                    if field == 16 { cfg.main_file = value; }
                }
                next = config_line_tail(tail);
                if next == (0 as *u8) { config_error("jxz: trailing manifest value garbage\0" as *u8); return false; }
            }
        }
        line = next;
    }
    if !package_name_valid(cfg.name) || !config_path_valid(cfg.src_dir) || !config_path_valid(cfg.target_dir) {
        config_error("jxz: invalid package name or build path\0" as *u8);
        return false;
    }
    if cfg.main_file != (0 as *u8) {
        if !config_path_valid(cfg.main_file) { config_error("jxz: invalid build.main\0" as *u8); return false; }
    }
    cfg.valid = true;
    return true;
}
