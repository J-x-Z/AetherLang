// The local project manifest has explicit ownership: every parsed string points
// into storage, which is released exactly once by config_free.
extern "C" {
    fn fopen(path: *u8, mode: *u8) -> *void;
    fn fclose(file: *void) -> i32;
    fn fread(buf: *void, size: u64, count: u64, file: *void) -> u64;
    fn fseek(file: *void, offset: i64, whence: i32) -> i32;
    fn ftell(file: *void) -> i64;
    fn malloc(size: u64) -> *void;
    fn free(ptr: *void);
    fn strcmp(a: *u8, b: *u8) -> i32;
    fn strncmp(a: *u8, b: *u8, count: u64) -> i32;
    fn strlen(s: *u8) -> u64;
    fn puts(s: *u8) -> i32;
    fn perror(s: *u8);
}

pub struct Config {
    pub name: *u8,
    pub version: *u8,
    pub src_dir: *u8,
    pub target_dir: *u8,
    pub main_file: *u8,
    pub storage: *u8,
    pub valid: bool,
}

fn config_space(p: *u8) -> *u8 {
    let mut current: *u8 = p;
    while current[0] == 32 || current[0] == 9 || current[0] == 13 {
        current = current + 1;
    }
    return current;
}

// Decode a single TOML basic/literal string in place; reject trailing garbage.
fn config_string(text: *u8) -> *u8 {
    let quote: u8 = text[0];
    if quote != 34 && quote != 39 { return 0 as *u8; }
    let start: *u8 = text + 1;
    let mut read: *u8 = start;
    let mut write: *u8 = start;
    while read[0] != 0 && read[0] != quote {
        let mut value: u8 = read[0];
        read = read + 1;
        if value == 92 && quote == 34 {
            value = read[0];
            if value == 0 { return 0 as *u8; }
            read = read + 1;
            if value == 110 { value = 10; }
            else if value == 114 { value = 13; }
            else if value == 116 { value = 9; }
            else if value != 34 && value != 92 { return 0 as *u8; }
        }
        write[0] = value;
        write = write + 1;
    }
    if read[0] != quote { return 0 as *u8; }
    let tail: *u8 = config_space(read + 1);
    if tail[0] != 0 && tail[0] != 35 { return 0 as *u8; }
    write[0] = 0;
    return start;
}

fn config_path_valid(path: *u8) -> bool {
    if path == (0 as *u8) { return false; }
    if path[0] == 0 { return false; }
    let mut i: u64 = 0;
    while path[i] != 0 {
        if path[i] < 32 { return false; }
        i = i + 1;
    }
    return true;
}

pub fn package_name_valid(name: *u8) -> bool {
    if !config_path_valid(name) { return false; }
    if strlen(name) > 255 { return false; }
    if strncmp(name, ".jxz-\0" as *u8, 5) == 0 { return false; }
    if strcmp(name, ".\0" as *u8) == 0 || strcmp(name, "..\0" as *u8) == 0 { return false; }
    let mut i: u64 = 0;
    while name[i] != 0 {
        if name[i] == 47 || name[i] == 92 { return false; }
        i = i + 1;
    }
    return true;
}

pub fn config_free(cfg: *Config) {
    free(cfg.storage as *void);
    cfg.storage = 0 as *u8;
    cfg.valid = false;
}

pub fn config_load() -> Config {
    let mut cfg: Config = Config {
        name: 0 as *u8,
        version: "0.1.0\0" as *u8,
        src_dir: "src\0" as *u8,
        target_dir: "target\0" as *u8,
        main_file: 0 as *u8,
        storage: 0 as *u8,
        valid: false,
    };
    let file: *void = fopen("Jxz.toml\0" as *u8, "rb\0" as *u8);
    if file == (0 as *void) {
        perror("jxz: Jxz.toml\0" as *u8);
        return cfg;
    }
    if fseek(file, 0, 2) != 0 { fclose(file); return cfg; }
    let size: i64 = ftell(file);
    if size < 0 || size > 1048576 {
        puts("jxz: manifest exceeds 1 MiB or cannot be read\0" as *u8);
        fclose(file);
        return cfg;
    }
    if fseek(file, 0, 0) != 0 { fclose(file); return cfg; }
    cfg.storage = malloc(size as u64 + 1) as *u8;
    if cfg.storage == (0 as *u8) { fclose(file); return cfg; }
    let count: u64 = fread(cfg.storage as *void, 1, size as u64, file);
    let closed: i32 = fclose(file);
    if count != size as u64 || closed != 0 {
        puts("jxz: cannot read complete manifest\0" as *u8);
        return cfg;
    }
    cfg.storage[count] = 0;
    let mut scan: u64 = 0;
    while scan < count {
        if cfg.storage[scan] == 0 { puts("jxz: NUL in manifest\0" as *u8); return cfg; }
        scan = scan + 1;
    }
    let mut line: *u8 = cfg.storage;
    let mut section: i32 = 0;
    let mut seen: i32 = 0;
    while line[0] != 0 {
        let mut next: *u8 = line;
        while next[0] != 0 && next[0] != 10 { next = next + 1; }
        if next[0] == 10 { next[0] = 0; next = next + 1; }
        let start: *u8 = config_space(line);
        if start[0] == 91 {
            let mut end: *u8 = start + 1;
            while end[0] != 0 && end[0] != 93 { end = end + 1; }
            if end[0] != 93 { puts("jxz: malformed section\0" as *u8); return cfg; }
            let tail: *u8 = config_space(end + 1);
            if tail[0] != 0 && tail[0] != 35 { puts("jxz: malformed section\0" as *u8); return cfg; }
            end[0] = 0;
            section = 0;
            if strcmp(start + 1, "package\0" as *u8) == 0 { section = 1; }
            if strcmp(start + 1, "build\0" as *u8) == 0 { section = 2; }
            if strcmp(start + 1, "dependencies\0" as *u8) == 0 { section = 3; }
        } else if start[0] != 0 && start[0] != 35 {
            if section == 3 { puts("jxz: dependency resolution is not implemented\0" as *u8); return cfg; }
            let mut equal: *u8 = start;
            while equal[0] != 0 && equal[0] != 61 { equal = equal + 1; }
            if equal[0] != 61 { puts("jxz: expected key = value\0" as *u8); return cfg; }
            let raw: *u8 = config_space(equal + 1);
            let mut end: *u8 = equal;
            while end != start {
                let prior: *u8 = end - 1;
                if prior[0] != 32 && prior[0] != 9 { break; }
                end = prior;
            }
            end[0] = 0;
            let mut field: i32 = 0;
            if section == 1 {
                if strcmp(start, "name\0" as *u8) == 0 { field = 1; }
                if strcmp(start, "version\0" as *u8) == 0 { field = 2; }
            }
            if section == 2 {
                if strcmp(start, "src\0" as *u8) == 0 { field = 4; }
                if strcmp(start, "target\0" as *u8) == 0 { field = 8; }
                if strcmp(start, "main\0" as *u8) == 0 { field = 16; }
            }
            if field != 0 {
                if (seen & field) != 0 { puts("jxz: duplicate manifest key\0" as *u8); return cfg; }
                seen = seen | field;
                let value: *u8 = config_string(raw);
                if value == (0 as *u8) { puts("jxz: expected a quoted string\0" as *u8); return cfg; }
                if field == 1 { cfg.name = value; }
                if field == 2 { cfg.version = value; }
                if field == 4 { cfg.src_dir = value; }
                if field == 8 { cfg.target_dir = value; }
                if field == 16 { cfg.main_file = value; }
            }
        }
        line = next;
    }
    if !package_name_valid(cfg.name) || !config_path_valid(cfg.src_dir) || !config_path_valid(cfg.target_dir) {
        puts("jxz: invalid package name or build path\0" as *u8);
        return cfg;
    }
    if cfg.main_file != (0 as *u8) {
        if !config_path_valid(cfg.main_file) { puts("jxz: invalid build.main\0" as *u8); return cfg; }
    }
    cfg.valid = true;
    return cfg;
}
