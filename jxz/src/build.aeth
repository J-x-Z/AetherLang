// The compiler owns backend selection and linking; JXZ owns project policy.
use config::{Config, config_load, config_free, package_name_valid};
use process::{process_run, environment_tool, path_join, make_directories};

extern "C" {
    fn malloc(size: u64) -> *void;
    fn free(ptr: *void);
    fn puts(s: *u8) -> i32;
    fn remove(path: *u8) -> i32;
    fn access(path: *u8, mode: i32) -> i32;
    fn rmdir(path: *u8) -> i32;
    fn perror(s: *u8);
    fn fopen(path: *u8, mode: *u8) -> *void;
    fn fclose(file: *void) -> i32;
    fn fputs(s: *u8, file: *void) -> i32;
    fn fgetc(file: *void) -> i32;
    fn ferror(file: *void) -> i32;
    fn strlen(s: *u8) -> u64;
}

pub fn compile_source(source: *u8, output: *u8, release: bool) -> i32 {
    let compiler: *u8 = environment_tool("AETHC\0" as *u8, "aethc\0" as *u8);
    let backend: *u8 = environment_tool("AETHER_BACKEND\0" as *u8, "\0" as *u8);
    let mut optimization: *u8 = "0\0" as *u8;
    if release { optimization = "2\0" as *u8; }
    let mut args: [*u8; 11] = [compiler, "build\0" as *u8,
        "-O\0" as *u8, optimization, "-o\0" as *u8, output,
        "--backend\0" as *u8, backend, "--\0" as *u8, source, 0 as *u8];
    if backend[0] == 0 {
        args[6] = "--\0" as *u8;
        args[7] = source;
        args[8] = 0 as *u8;
    }
    return process_run(&args[0] as **u8, 0 as *u8);
}

pub fn build_loaded(cfg: *Config, release: bool) -> i32 {
    if !make_directories(cfg.target_dir) { return 1; }
    let output: *u8 = path_join(cfg.target_dir, cfg.name);
    let mut source: *u8 = cfg.main_file;
    let mut owns_source: bool = false;
    if source == (0 as *u8) {
        source = path_join(cfg.src_dir, "main.aeth\0" as *u8);
        owns_source = true;
    }
    let mut status: i32 = 1;
    if source != (0 as *u8) && output != (0 as *u8) {
        puts("jxz: compiling\0" as *u8);
        puts(source);
        status = compile_source(source, output, release);
        if status == 0 {
            if !record_output(cfg.target_dir, cfg.name) { status = 1; }
        }
    }
    if owns_source { free(source as *void); }
    free(output as *void);
    return status;
}

pub fn build_project(release: bool) -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid { status = build_loaded(&cfg as *Config, release); }
    config_free(&cfg as *Config);
    return status;
}

pub fn run_project(argc: i32, argv: **u8) -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid {
        status = build_loaded(&cfg as *Config, false);
        if status == 0 {
            // Prefix relative output with ./ so execvp never searches PATH.
            let output: *u8 = path_join(cfg.target_dir, cfg.name);
            let mut executable: *u8 = output;
            if output != (0 as *u8) {
                if output[0] != 47 { executable = path_join(".\0" as *u8, output); }
                if executable != (0 as *u8) {
                    // argv points to a spare command/-- slot followed by user arguments.
                    let saved: *u8 = argv[0];
                    argv[0] = executable;
                    status = process_run(argv, 0 as *u8);
                    argv[0] = saved;
                } else { status = 1; }
                if executable != output { free(executable as *void); }
                free(output as *void);
            } else { status = 1; }
        }
    }
    config_free(&cfg as *Config);
    return status;
}

fn record_output(directory: *u8, name: *u8) -> bool {
    let path: *u8 = path_join(directory, ".jxz-output-name\0" as *u8);
    if path == (0 as *u8) { return false; }
    let file: *void = fopen(path, "wb\0" as *u8);
    free(path as *void);
    if file == (0 as *void) { return false; }
    let written: i32 = fputs(name, file);
    let closed: i32 = fclose(file);
    return written >= 0 && closed == 0;
}

fn clean_owned_output(directory: *u8) -> bool {
    let record: *u8 = path_join(directory, ".jxz-output-name\0" as *u8);
    if record == (0 as *u8) { return false; }
    if access(record, 0) != 0 { free(record as *void); return true; }
    let file: *void = fopen(record, "rb\0" as *u8);
    if file == (0 as *void) { free(record as *void); return false; }
    // Package output is a single filename; POSIX NAME_MAX is at most 255 here.
    let mut name: [u8; 257] = [0; 257];
    let mut count: u64 = 0;
    let mut byte: i32 = fgetc(file);
    while byte >= 0 && count < 256 {
        name[count] = byte as u8;
        count = count + 1;
        byte = fgetc(file);
    }
    let failed: i32 = ferror(file);
    let closed: i32 = fclose(file);
    let mut ok: bool = false;
    if byte < 0 && failed == 0 && closed == 0 && count < 256 {
        if package_name_valid(&name[0] as *u8) {
            ok = clean_file(directory, &name[0] as *u8);
        }
    }
    if ok { if remove(record) != 0 { ok = false; } }
    free(record as *void);
    return ok;
}

fn clean_file(directory: *u8, name: *u8) -> bool {
    let path: *u8 = path_join(directory, name);
    if path == (0 as *u8) { return false; }
    let mut ok: bool = true;
    if access(path, 0) == 0 {
        if remove(path) != 0 { perror(path); ok = false; }
    }
    free(path as *void);
    return ok;
}

pub fn clean_project() -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid {
        status = 0;
        if !clean_owned_output(cfg.target_dir) { status = 1; }
        if !clean_file(cfg.target_dir, ".jxz-test\0" as *u8) { status = 1; }
        if !clean_file(cfg.target_dir, ".jxz-test-list\0" as *u8) { status = 1; }
        // Only remove an empty directory: unrelated files and source C survive.
        rmdir(cfg.target_dir);
    }
    config_free(&cfg as *Config);
    return status;
}
