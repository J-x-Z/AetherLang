use host::*;
// The compiler owns backend selection and linking; JXZ owns project policy.
use config::{Config, config_load, config_free, package_name_valid, config_error};

use result::Result;
use output::{Publication, output_lock, output_unlock, output_compiler_inherits, output_recover, publication_prepare, publication_publish, publication_free};
use posix::ENOENT;
use vec::{Vec,vec_new,vec_push,vec_free};
use dependencies::{dependencies_resolve,dependencies_resolve_modules,dependencies_record,dependencies_remove};

extern "C" {
    fn malloc(size: u64) -> *void;
    fn free(ptr: *void);
    fn puts(s: *u8) -> i32;
    fn perror(s: *u8);
    fn fclose(file: *void) -> i32;
    fn fputs(s: *u8, file: *void) -> i32;
    fn fgetc(file: *void) -> i32;
    fn fputc(value: i32, file: *void) -> i32;
    fn strcmp(a: *u8, b: *u8) -> i32;
    fn ferror(file: *void) -> i32;
    fn strlen(s: *u8) -> u64;
    fn strerror(code: i32) -> *u8;
}

// Option/response-file-looking relative paths need an owned ./ prefix. Other
// paths are borrowed directly from the manifest, with no shell interpretation.
fn compiler_path_needs_prefix(path: *u8) -> bool {
    return path[0] == 45 || path[0] == 64;
}

fn compiler_path(path: *u8) -> *u8 {
    if compiler_path_needs_prefix(path) { return path_join(".\0" as *u8, path); }
    return path;
}

// Argument slots borrow configuration or literal strings. Only normalized paths
// are owned by this container; their cleanup never depends on option positions.
struct CompilerArgs { values: Vec<*u8>, owned: Vec<*u8> }
fn compiler_args_new() -> CompilerArgs { return CompilerArgs { values:vec_new(), owned:vec_new() }; }
fn compiler_args_free(args: *CompilerArgs) {
    let mut i:u64=0;
    while i<args.owned.len { free(args.owned.data[i] as *void); i=i+1; }
    vec_free(&mut args.owned as *Vec<*u8>);
    vec_free(&mut args.values as *Vec<*u8>);
}
fn compiler_arg(args:*CompilerArgs,value:*u8)->bool {
    return vec_push(&mut args.values as *Vec<*u8>,value);
}
fn compiler_option(args:*CompilerArgs,flag:*u8,value:*u8)->bool {
    return compiler_arg(args,flag) && compiler_arg(args,value);
}
fn compiler_path_option(args:*CompilerArgs,flag:*u8,path:*u8)->bool {
    let value:*u8=compiler_path(path);
    if value==(0 as *u8) { return false; }
    if value!=path {
        if !vec_push(&mut args.owned as *Vec<*u8>,value) { free(value as *void); return false; }
    }
    return compiler_option(args,flag,value);
}
fn compiler_begin(args:*CompilerArgs,command:*u8)->bool {
    return compiler_arg(args,environment_tool("AETHC","aethc")) && compiler_arg(args,command);
}
// All source-facing commands consume the exact same module search graph.
fn compiler_module_arguments(cfg:*Config,args:*CompilerArgs)->bool {
    let mut i:u64=0;
    while i<cfg.module_path_count {
        if !compiler_path_option(args,"-I",cfg.module_paths[i]) { return false; }
        i=i+1;
    }
    i=0;
    while i<cfg.resolved_modules.len {
        if !compiler_option(args,"--module",cfg.resolved_modules.data[i]) { return false; }
        i=i+1;
    }
    i=0;
    while i<cfg.resolved_paths.len {
        if !compiler_path_option(args,"-I",cfg.resolved_paths.data[i]) { return false; }
        i=i+1;
    }
    return true;
}
fn compiler_link_arguments(cfg:*Config,args:*CompilerArgs)->bool {
    let mut i:u64=0;
    while i<cfg.link_object_count {
        if !compiler_path_option(args,"--link-object",cfg.link_objects[i]) { return false; }
        i=i+1;
    }
    i=0;
    while i<cfg.resolved_objects.len {
        if !compiler_path_option(args,"--link-object",cfg.resolved_objects.data[i]) { return false; }
        i=i+1;
    }
    return true;
}

pub fn compile_source(cfg: *Config, source: *u8, output: *u8, release: bool, lock: *void) -> i32 {
    let mut args:CompilerArgs=compiler_args_new();
    let optimization:*u8=if release { "2" } else { "0" };
    let backend:*u8=environment_tool("AETHER_BACKEND", "");
    let mut ok:bool=compiler_begin(&mut args as *CompilerArgs,"build")
        && compiler_option(&mut args as *CompilerArgs,"-O",optimization)
        && compiler_option(&mut args as *CompilerArgs,"-o",output)
        && compiler_module_arguments(cfg,&mut args as *CompilerArgs)
        && compiler_link_arguments(cfg,&mut args as *CompilerArgs);
    if ok && backend[0]!=0 { ok=compiler_option(&mut args as *CompilerArgs,"--backend",backend); }
    if ok { ok=compiler_option(&mut args as *CompilerArgs,"--",source) && compiler_arg(&mut args as *CompilerArgs,0 as *u8); }
    if !ok { config_error("jxz: cannot allocate compiler arguments"); compiler_args_free(&mut args as *CompilerArgs); return 1; }
    if !output_compiler_inherits(lock, true) { compiler_args_free(&mut args as *CompilerArgs); return 1; }
    let mut status: i32 = process_run(args.values.data, 0 as *u8);
    if !output_compiler_inherits(lock, false) { status = 1; }
    compiler_args_free(&mut args as *CompilerArgs);
    return status;
}

pub fn language_server() -> i32 {
    let mut cfg:Config=config_load();
    let mut args:CompilerArgs=compiler_args_new();
    let mut status:i32=1;
    if cfg.valid {
        if dependencies_resolve_modules(&mut cfg as *Config) {
            let ok:bool=compiler_begin(&mut args as *CompilerArgs,"lsp")
                && compiler_module_arguments(&mut cfg as *Config,&mut args as *CompilerArgs)
                && compiler_arg(&mut args as *CompilerArgs,0 as *u8);
            if ok {
                status=host_execute(args.values.data);
            } else { config_error("jxz: cannot allocate language server arguments"); }
        } else { config_error("jxz: cannot resolve language server project"); }
    }
    compiler_args_free(&mut args as *CompilerArgs);
    config_free(&mut cfg as *Config);
    return status;
}

pub fn build_loaded(cfg: *Config, release: bool) -> i32 {
    if !dependencies_resolve(cfg) { return 1; }
    match make_directories_result(cfg.target_dir) {
        Result::Ok(_) => {},
        Result::Err(e) => { config_error(strerror(e)); return 1; },
    }
    let lock: *void = output_lock(cfg.target_dir);
    if lock == (0 as *void) { return 1; }
    if !dependencies_record(cfg,cfg.target_dir) { output_unlock(lock); return 1; }
    let program:*u8=host_program_name(cfg.name);
    let output: *u8 = if program!=0 as *u8{path_join(cfg.target_dir, program)}else{0 as *u8};
    let mut source: *u8 = cfg.main_file;
    let mut owns_source: bool = false;
    if source == (0 as *u8) {
        source = path_join(cfg.src_dir, "main.aeth\0" as *u8);
        owns_source = true;
    }
    let mut status: i32 = 1;
    if source != (0 as *u8) && output != (0 as *u8) {
        let resolved_source: *u8 = realpath(source, 0 as *u8);
        let resolved_output: *u8 = realpath(output, 0 as *u8);
        let same_source: bool = resolved_source != (0 as *u8) && resolved_output != (0 as *u8) && strcmp(resolved_source, resolved_output) == 0;
        free(resolved_source as *void); free(resolved_output as *void);
        if same_source { puts("jxz: output must not replace the input source\0" as *u8); }
        else {
            let mut transaction: Publication = publication_prepare(cfg.target_dir, program);
            if transaction.valid {
                puts("jxz: compiling\0" as *u8); puts(source);
                status = compile_source(cfg, source, transaction.staged, release, lock);
                if status == 0 { if !publication_publish(&transaction as *Publication) { status = 1; } }
                else { output_recover(cfg.target_dir); }
            }
            publication_free(&transaction as *Publication);
        }
    }
    if owns_source { free(source as *void); }
    free(output as *void);free(program as *void);
    if !output_unlock(lock) { status = 1; }
    return status;
}

pub fn build_project(release: bool) -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid { status = build_loaded(&cfg as *Config, release); }
    config_free(&cfg as *Config);
    return status;
}

pub fn run_project(argc: i32, argv: **u8) -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid {
        status = build_loaded(&cfg as *Config, false);
        if status == 0 {
            // Prefix relative output with ./ so execvp never searches PATH.
            let program:*u8=host_program_name(cfg.name);
            let output: *u8 = if program!=0 as *u8{path_join(cfg.target_dir, program)}else{0 as *u8};
            let mut executable: *u8 = output;
            if output != (0 as *u8) {
                if !host_absolute(output) { executable = path_join(".\0" as *u8, output); }
                if executable != (0 as *u8) {
                    // argv points to a spare command/-- slot followed by user arguments.
                    let saved: *u8 = argv[0];
                    argv[0] = executable;
                    status = process_run(argv, 0 as *u8);
                    argv[0] = saved;
                } else { status = 1; }
                if executable != output { free(executable as *void); }
                free(output as *void);
            } else { status = 1; }
            free(program as *void);
        }
    }
    config_free(&cfg as *Config);
    return status;
}

fn clean_owned_record(directory: *u8, filename: *u8, legacy: bool) -> bool {
    let record: *u8 = path_join(directory, filename);
    if record == (0 as *u8) { return false; }
    if access(record, 0) != 0 { free(record as *void); return true; }
    let file: *void = fopen(record, "rb\0" as *u8);
    if file == (0 as *void) { free(record as *void); return false; }
    let mut name: [u8; 257] = [0; 257];
    let mut count: u64 = 0;
    let mut ok: bool = true;
    let mut byte: i32 = fgetc(file);
    while byte >= 0 {
        if byte == 10 {
            name[count] = 0;
            if !package_name_valid(&name[0] as *u8) { ok = false; break; }
            if !clean_file(directory, &name[0] as *u8) { ok = false; }
            count = 0;
        } else {
            if count >= 255 || byte == 0 { ok = false; break; }
            name[count] = byte as u8;
            count = count + 1;
        }
        byte = fgetc(file);
    }
    let read_failed: bool = ferror(file) != 0;
    if read_failed { ok = false; }
    if fclose(file) != 0 { ok = false; }
    if count != 0 {
        // Migrate the previous single-output record; new records require newline.
        name[count] = 0;
        if legacy && byte < 0 && !read_failed && package_name_valid(&name[0] as *u8) {
            if !clean_file(directory, &name[0] as *u8) { ok = false; }
        } else { ok = false; }
    }
    if ok { if remove(record) != 0 { ok = false; } }
    free(record as *void);
    return ok;
}

fn clean_file(directory: *u8, name: *u8) -> bool {
    let path: *u8 = path_join(directory, name);
    if path == (0 as *u8) { return false; }
    let mut ok: bool = true;
    if access(path, 0) == 0 {
        if remove(path) != 0 { perror(path); ok = false; }
    }
    free(path as *void);
    return ok;
}

pub fn clean_project() -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid {
        if access(cfg.target_dir, 0) != 0 {
            let missing: bool = host_errno() == ENOENT;
            config_free(&cfg as *Config);
            return if missing { 0 } else { 1 };
        }
        let lock: *void = output_lock(cfg.target_dir);
        if lock == (0 as *void) { config_free(&cfg as *Config); return 1; }
        if !output_recover(cfg.target_dir) || !dependencies_remove(cfg.target_dir) { output_unlock(lock); config_free(&cfg as *Config); return 1; }
        status = 0;
        if !clean_owned_record(cfg.target_dir, ".jxz-outputs\0" as *u8, false) { status = 1; }
        if !clean_owned_record(cfg.target_dir, ".jxz-output-name\0" as *u8, true) { status = 1; }
        if !clean_file(cfg.target_dir, ".jxz-outputs.tmp\0" as *u8) { status = 1; }
        if !clean_file(cfg.target_dir, ".jxz-test\0" as *u8) { status = 1; }
        if !clean_file(cfg.target_dir, ".jxz-test-list\0" as *u8) { status = 1; }
        // Only remove an empty directory: unrelated files and source C survive.
        if !host_unlock_and_prune(cfg.target_dir,lock) { status = 1; }
    }
    config_free(&cfg as *Config);
    return status;
}
