// Initialize only absent files; never overwrite an existing source or manifest.
use config::{package_name_valid};
use process::{make_directories};
extern "C" {
    fn fopen(path: *u8, mode: *u8) -> *void;
    fn fclose(file: *void) -> i32;
    fn fputs(s: *u8, file: *void) -> i32;
    fn fputc(c: i32, file: *void) -> i32;
    fn ferror(file: *void) -> i32;
    fn access(path: *u8, mode: i32) -> i32;
    fn remove(path: *u8) -> i32;
    fn puts(s: *u8) -> i32;
    fn perror(s: *u8);
}

fn finish_file(file: *void) -> bool {
    let failed: i32 = ferror(file);
    let closed: i32 = fclose(file);
    return failed == 0 && closed == 0;
}

fn write_manifest(name: *u8) -> bool {
    let file: *void = fopen("Jxz.toml\0" as *u8, "wx\0" as *u8);
    if file == (0 as *void) { perror("Jxz.toml\0" as *u8); return false; }
    fputs("[package]\nname = \"\0" as *u8, file);
    let mut i: u64 = 0;
    while name[i] != 0 {
        let value: u8 = name[i];
        if value == 34 || value == 92 { fputc(92, file); }
        fputc(value as i32, file);
        i = i + 1;
    }
    fputs("\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[build]\nsrc = \"src\"\ntarget = \"target\"\n\0" as *u8, file);
    if !finish_file(file) { remove("Jxz.toml\0" as *u8); return false; }
    return true;
}

fn write_source() -> bool {
    let file: *void = fopen("src/main.aeth\0" as *u8, "wx\0" as *u8);
    if file == (0 as *void) { perror("src/main.aeth\0" as *u8); return false; }
    fputs("extern \"C\" { fn puts(s: *u8) -> i32; }\n\npub fn main() -> i32 {\n    puts(\"Hello, AetherLang!\\0\" as *u8);\n    return 0;\n}\n\0" as *u8, file);
    if !finish_file(file) { remove("src/main.aeth\0" as *u8); return false; }
    return true;
}

pub fn init_project(name: *u8) -> i32 {
    if !package_name_valid(name) { puts("jxz: invalid package name\0" as *u8); return 2; }
    if access("Jxz.toml\0" as *u8, 0) == 0 || access("src/main.aeth\0" as *u8, 0) == 0 {
        puts("jxz: initialization would overwrite Jxz.toml or src/main.aeth\0" as *u8);
        return 1;
    }
    if !make_directories("src\0" as *u8) || !make_directories("tests\0" as *u8) { return 1; }
    if !write_source() { return 1; }
    if !write_manifest(name) { remove("src/main.aeth\0" as *u8); return 1; }
    if access(".gitignore\0" as *u8, 0) != 0 {
        let file: *void = fopen(".gitignore\0" as *u8, "wx\0" as *u8);
        if file != (0 as *void) {
            fputs("/target/\n\0" as *u8, file);
            if !finish_file(file) { puts("jxz: could not finish .gitignore\0" as *u8); return 1; }
        }
    }
    puts("jxz: initialized current directory; use jxz build or jxz run\0" as *u8);
    return 0;
}
