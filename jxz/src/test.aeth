use vec::{Vec,vec_free};extern "C"{fn fwrite(data:*void,size:u64,n:u64,file:*void)->u64;}
use host::*;
// Discover NUL-delimited paths through the selected host implementation. Compilation,
// execution, status aggregation and resource ownership are AetherLang code.
use config::{Config, config_load, config_free};

use result::Result;
use dependencies::{dependencies_resolve,dependencies_record};
use build::{compile_source};
use output::{output_lock, output_unlock, output_recover, output_compiler_inherits};
extern "C" {
    fn fclose(file: *void) -> i32;
    fn fgetc(file: *void) -> i32;
    fn ferror(file: *void) -> i32;
    fn malloc(size: u64) -> *void;
    fn realloc(ptr: *void, size: u64) -> *void;
    fn free(ptr: *void);
    fn puts(s: *u8) -> i32;
    fn strerror(code: i32) -> *u8;
}

fn test_discover(list:*u8,lock:*void)->i32{return host_discover(list,lock);}

fn test_execute(cfg: *Config, file: *void, executable: *u8, lock: *void) -> i32 {
    let mut capacity: u64 = 256;
    let mut path: *u8 = malloc(capacity) as *u8;
    if path == (0 as *u8) { return 1; }
    let mut length: u64 = 0;
    let mut failed: bool = false;
    let mut total: i32 = 0;
    let mut byte: i32 = fgetc(file);
    while byte >= 0 {
        if length + 1 >= capacity {
            capacity = capacity * 2;
            let grown: *u8 = realloc(path as *void, capacity) as *u8;
            if grown == (0 as *u8) { free(path as *void); return 1; }
            path = grown;
        }
        path[length] = byte as u8;
        if byte == 0 {
            if length > 0 {
                total = total + 1;
                puts(path);
                // Never run a previous executable after a compile/link error.
                remove(executable);
                let compiled: i32 = compile_source(cfg, path, executable, false, lock);
                if compiled == 0 {
                    let mut args: [*u8; 2] = [executable, 0 as *u8];
                    if process_run(&args[0] as **u8, 0 as *u8) != 0 { failed = true; }
                } else { failed = true; }
                remove(executable);
            }
            length = 0;
        } else { length = length + 1; }
        byte = fgetc(file);
    }
    if ferror(file) != 0 || length != 0 { failed = true; }
    free(path as *void);
    if total == 0 { puts("jxz: no test_*.aeth files found\0" as *u8); }
    if failed { puts("jxz: tests failed\0" as *u8); return 1; }
    puts("jxz: tests passed\0" as *u8);
    return 0;
}

pub fn run_tests() -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid {
        if !dependencies_resolve(&mut cfg as *Config) { config_free(&mut cfg as *Config); return 1; }
        match dir_probe("tests") {
            Result::Ok(found) => {
                if !found {
                    puts("jxz: no tests directory");
                    config_free(&cfg as *Config);
                    return 0;
                }
            },
            Result::Err(code) => {
                host_error("jxz: cannot open tests directory");host_error(strerror(code));
                config_free(&cfg as *Config);
                return 1;
            },
        };
        if make_directories(cfg.target_dir) {
            let lock: *void = output_lock(cfg.target_dir);
            if lock == (0 as *void) { config_free(&cfg as *Config); return 1; }
            if !output_recover(cfg.target_dir) { output_unlock(lock); config_free(&cfg as *Config); return 1; }
            if !dependencies_record(&mut cfg as *Config,cfg.target_dir) { output_unlock(lock); config_free(&mut cfg as *Config); return 1; }
            let list: *u8 = path_join(cfg.target_dir, ".jxz-test-list\0" as *u8);
            let output: *u8 = path_join(cfg.target_dir, ".jxz-test\0" as *u8);
            let mut executable: *u8 = output;
            if output != (0 as *u8) {
                if !host_absolute(output) { executable = path_join(".\0" as *u8, output); }
            }
            if list != (0 as *u8) && executable != (0 as *u8) {
                if test_discover(list, lock) == 0 {
                    let file: *void = fopen(list, "rb\0" as *u8);
                    if file != (0 as *void) {
                        status = test_execute(&cfg as *Config, file, executable, lock);
                        if fclose(file) != 0 { status = 1; }
                    }
                } else { puts("jxz: test discovery failed\0" as *u8); }
            }
            if list != (0 as *u8) { remove(list); }
            free(list as *void);
            if executable != output { free(executable as *void); }
            free(output as *void);
            if !output_unlock(lock) { status = 1; }
        }
    }
    config_free(&cfg as *Config);
    return status;
}
