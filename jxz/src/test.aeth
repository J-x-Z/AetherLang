// Discover NUL-delimited paths with the host's find utility. Compilation,
// execution, status aggregation and resource ownership are AetherLang code.
use config::{Config, config_load, config_free};
use process::{process_run, path_join, make_directories, directory_exists};
use build::{compile_source};
extern "C" {
    fn fopen(path: *u8, mode: *u8) -> *void;
    fn fclose(file: *void) -> i32;
    fn fgetc(file: *void) -> i32;
    fn ferror(file: *void) -> i32;
    fn malloc(size: u64) -> *void;
    fn realloc(ptr: *void, size: u64) -> *void;
    fn free(ptr: *void);
    fn remove(path: *u8) -> i32;
    fn puts(s: *u8) -> i32;
}

fn test_discover(list: *u8) -> i32 {
    let mut args: [*u8; 9] = ["find\0" as *u8, "tests\0" as *u8,
        "-type\0" as *u8, "f\0" as *u8, "-name\0" as *u8,
        "test_*.aeth\0" as *u8, "-print0\0" as *u8, 0 as *u8, 0 as *u8];
    return process_run(&args[0] as **u8, list);
}

fn test_execute(file: *void, executable: *u8) -> i32 {
    let mut capacity: u64 = 256;
    let mut path: *u8 = malloc(capacity) as *u8;
    if path == (0 as *u8) { return 1; }
    let mut length: u64 = 0;
    let mut failed: bool = false;
    let mut total: i32 = 0;
    let mut byte: i32 = fgetc(file);
    while byte >= 0 {
        if length + 1 >= capacity {
            capacity = capacity * 2;
            let grown: *u8 = realloc(path as *void, capacity) as *u8;
            if grown == (0 as *u8) { free(path as *void); return 1; }
            path = grown;
        }
        path[length] = byte as u8;
        if byte == 0 {
            if length > 0 {
                total = total + 1;
                puts(path);
                // Never run a previous executable after a compile/link error.
                remove(executable);
                let compiled: i32 = compile_source(path, executable, false);
                if compiled == 0 {
                    let mut args: [*u8; 2] = [executable, 0 as *u8];
                    if process_run(&args[0] as **u8, 0 as *u8) != 0 { failed = true; }
                } else { failed = true; }
                remove(executable);
            }
            length = 0;
        } else { length = length + 1; }
        byte = fgetc(file);
    }
    if ferror(file) != 0 || length != 0 { failed = true; }
    free(path as *void);
    if total == 0 { puts("jxz: no test_*.aeth files found\0" as *u8); }
    if failed { puts("jxz: tests failed\0" as *u8); return 1; }
    puts("jxz: tests passed\0" as *u8);
    return 0;
}

pub fn run_tests() -> i32 {
    let mut cfg: Config = config_load();
    let mut status: i32 = 1;
    if cfg.valid {
        if !directory_exists("tests\0" as *u8) {
            puts("jxz: no tests directory\0" as *u8);
            config_free(&cfg as *Config);
            return 0;
        }
        if make_directories(cfg.target_dir) {
            let list: *u8 = path_join(cfg.target_dir, ".jxz-test-list\0" as *u8);
            let output: *u8 = path_join(cfg.target_dir, ".jxz-test\0" as *u8);
            let mut executable: *u8 = output;
            if output != (0 as *u8) {
                if output[0] != 47 { executable = path_join(".\0" as *u8, output); }
            }
            if list != (0 as *u8) && executable != (0 as *u8) {
                if test_discover(list) == 0 {
                    let file: *void = fopen(list, "rb\0" as *u8);
                    if file != (0 as *void) {
                        status = test_execute(file, executable);
                        if fclose(file) != 0 { status = 1; }
                    }
                }
            }
            if list != (0 as *u8) { remove(list); }
            free(list as *void);
            if executable != output { free(executable as *void); }
            free(output as *void);
        }
    }
    config_free(&cfg as *Config);
    return status;
}
