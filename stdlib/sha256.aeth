// Streaming SHA-256 as specified by FIPS 180-4. All arithmetic is modulo 2^32.
pub struct Sha256 { words:[u32;8], pending:[u8;64], used:u64, bytes:u64 }
pub fn sha256_new()->Sha256 {
    Sha256{words:[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19],
        pending:[0;64],used:0,bytes:0}
}
fn rotr(x:u32,n:u32)->u32 {(x>>n)|(x<<(32-n))}
fn compress(s:*Sha256,input:*u8) {
    let constants:[u32;64]=[
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
    let mut w:[u32;64]=[0;64];
    for i in 0..16 {
        let j:i64=4*i;
        w[i]=((input[j] as u32)<<24)|((input[j+1] as u32)<<16)|((input[j+2] as u32)<<8)|(input[j+3] as u32);
    }
    for i in 16..64 {
        let x:u32=w[i-15];let y:u32=w[i-2];
        w[i]=w[i-16]+(rotr(x,7)^rotr(x,18)^(x>>3))+w[i-7]+(rotr(y,17)^rotr(y,19)^(y>>10));
    }
    let mut a:u32=s.words[0];let mut b:u32=s.words[1];let mut c:u32=s.words[2];let mut d:u32=s.words[3];
    let mut e:u32=s.words[4];let mut f:u32=s.words[5];let mut g:u32=s.words[6];let mut h:u32=s.words[7];
    for i in 0..64 {
        let one:u32=h+(rotr(e,6)^rotr(e,11)^rotr(e,25))+((e&f)^((~e)&g))+constants[i]+w[i];
        let two:u32=(rotr(a,2)^rotr(a,13)^rotr(a,22))+((a&b)^(a&c)^(b&c));
        h=g;g=f;f=e;e=d+one;d=c;c=b;b=a;a=one+two;
    }
    s.words[0]+=a;s.words[1]+=b;s.words[2]+=c;s.words[3]+=d;
    s.words[4]+=e;s.words[5]+=f;s.words[6]+=g;s.words[7]+=h;
}
// An unrepresentable bit length or a missing nonempty input leaves state intact.
pub fn sha256_update(s:*Sha256,data:*u8,length:u64)->bool {
    if s==0 as *Sha256 || (length>0 && data==0 as *u8) || length>2305843009213693951-s.bytes {return false;}
    s.bytes+=length;
    let mut i:u64=0;
    while i<length {
        if s.used==0 && length-i>=64 {compress(s,&data[i] as *u8);i+=64;}
        else {
            s.pending[s.used]=data[i];s.used+=1;i+=1;
            if s.used==64 {compress(s,&s.pending[0] as *u8);s.used=0;}
        }
    }
    true
}
// Finalization takes a copy so the caller may continue the original stream.
pub fn sha256_digest(state:Sha256)->[u8;32] {
    let mut s:Sha256=state;
    s.pending[s.used]=128;s.used+=1;
    if s.used>56 {
        while s.used<64 {s.pending[s.used]=0;s.used+=1;}
        compress(&mut s as *Sha256,&s.pending[0] as *u8);s.used=0;
    }
    while s.used<56 {s.pending[s.used]=0;s.used+=1;}
    let bits:u64=s.bytes*8;
    for i in 0..8 {s.pending[63-i]=(bits>>(i as u64*8)) as u8;}
    compress(&mut s as *Sha256,&s.pending[0] as *u8);
    let mut out:[u8;32]=[0;32];
    for i in 0..32 {out[i]=(s.words[i/4]>>((3-i%4) as u32*8)) as u8;}
    out
}
