// Native Metal compute. Returned handles own one reference. Buffer contents are borrowed.
pub type MTLDevice = *void;
pub type MTLCommandQueue = *void;
pub type MTLCommandBuffer = *void;
pub type MTLComputeCommandEncoder = *void;
pub type MTLBuffer = *void;
pub type MTLComputePipelineState = *void;
pub type MTLLibrary = *void;
pub type MTLFunction = *void;

extern "C" {
    fn MTLCreateSystemDefaultDevice() -> MTLDevice;
    fn aether_mtl_create_command_queue(device: MTLDevice) -> MTLCommandQueue;
    fn aether_mtl_create_command_buffer(queue: MTLCommandQueue) -> MTLCommandBuffer;
    fn aether_mtl_create_buffer(device: MTLDevice, length: u64) -> MTLBuffer;
    fn aether_mtl_buffer_contents(buffer: MTLBuffer) -> *void;
    fn aether_mtl_create_library(device: MTLDevice, source: *u8) -> MTLLibrary;
    fn aether_mtl_get_function(library: MTLLibrary, name: *u8) -> MTLFunction;
    fn aether_mtl_create_pipeline(device: MTLDevice, func: MTLFunction) -> MTLComputePipelineState;
    fn aether_mtl_create_compute_encoder(buffer: MTLCommandBuffer) -> MTLComputeCommandEncoder;
    fn aether_mtl_set_pipeline(encoder: MTLComputeCommandEncoder, pipeline: MTLComputePipelineState);
    fn aether_mtl_set_buffer(encoder: MTLComputeCommandEncoder, buffer: MTLBuffer, index: u32);
    fn aether_mtl_dispatch_threads(encoder: MTLComputeCommandEncoder, width: u32, height: u32, depth: u32);
    fn aether_mtl_end_encoding(encoder: MTLComputeCommandEncoder);
    fn aether_mtl_commit(buffer: MTLCommandBuffer);
    fn aether_mtl_wait_until_completed(buffer: MTLCommandBuffer);
    fn aether_mtl_device() -> MTLDevice;
    fn aether_mtl_release(handle: *void);
    fn aether_mtl_completed(command: MTLCommandBuffer) -> bool;
    fn aether_mtl_command_status(command: MTLCommandBuffer) -> i32;
    fn aether_mtl_command_error(command: MTLCommandBuffer) -> i64;
    fn aether_mtl_registry_id(device: MTLDevice) -> u64;
    fn aether_mtl_dispatch_1d(encoder: MTLComputeCommandEncoder, pipeline: MTLComputePipelineState, count: u32) -> bool;
}

pub struct MetalContext { pub device: MTLDevice, pub queue: MTLCommandQueue }

pub fn metal_init() -> MetalContext {
    let device: MTLDevice = aether_mtl_device();
    let queue: MTLCommandQueue = aether_mtl_create_command_queue(device);
    if queue == 0 as *void {
        aether_mtl_release(device);
        return MetalContext { device: 0 as *void, queue: 0 as *void };
    }
    MetalContext { device: device, queue: queue }
}
pub fn metal_close(ctx: *MetalContext) {
    aether_mtl_release(ctx.queue);
    aether_mtl_release(ctx.device);
    ctx.queue = 0 as *void;
    ctx.device = 0 as *void;
}
pub fn metal_create_buffer(ctx: *MetalContext, size: u64) -> MTLBuffer {
    aether_mtl_create_buffer(ctx.device, size)
}
pub fn metal_sync(command: MTLCommandBuffer) -> bool {
    if command == 0 as *void { return false; }
    aether_mtl_commit(command);
    aether_mtl_wait_until_completed(command);
    aether_mtl_completed(command)
}
