// Scalar f32 DAGs. Migration: node creation/evaluation return Result; IDs are
// u64 indices. graph_free is explicit. Do not copy live Graph owners.
// Inputs must refer to existing nodes, so cycles cannot be constructed through
// this API. Evaluation is iterative and visits only the requested dependencies.
// exp/log use the system math library; link with --link-library m on POSIX.
use vec::{Vec, vec_new, vec_push, vec_free};
use result::Result;
extern "C" { fn expf(value: f32) -> f32; fn logf(value: f32) -> f32; }
const GRAPH_MEMORY: i32 = 1;
const GRAPH_NODE: i32 = 2;
const GRAPH_VARIABLE: i32 = 3;
const GRAPH_UNSET: i32 = 4;
const GRAPH_DOMAIN: i32 = 5;
struct Node { op: i32, value: f32, left: u64, right: u64, ready: bool, needed: bool }
pub struct Graph { nodes: Vec<Node> }
pub fn graph_new() -> Graph { let nodes: Vec<Node> = vec_new(); Graph { nodes: nodes } }
pub fn graph_free(graph: *Graph) { vec_free(&graph.nodes as *Vec<Node>); }
fn record(graph: *Graph, op: i32, value: f32, left: u64, right: u64) -> Result<u64, i32> {
    let id: u64 = graph.nodes.len;
    let node: Node = Node { op: op, value: value, left: left, right: right, ready: op == 0, needed: false };
    if !vec_push(&graph.nodes as *Vec<Node>, node) { return Result::Err(GRAPH_MEMORY); }
    Result::Ok(id)
}
fn finite(value: f32) -> bool { value - value == 0.0 }
pub fn const_node(graph: *Graph, value: f32) -> Result<u64, i32> {
    if !finite(value) { return Result::Err(GRAPH_DOMAIN); }
    record(graph, 0, value, 0, 0)
}
pub fn var_node(graph: *Graph) -> Result<u64, i32> { record(graph, 1, 0.0, 0, 0) }
pub fn graph_reset(graph: *Graph) {
    let mut index: u64 = 0;
    while index < graph.nodes.len { if graph.nodes.data[index].op >= 2 { graph.nodes.data[index].ready = false; } index += 1; }
}
pub fn set_var(graph: *Graph, id: u64, value: f32) -> Result<(), i32> {
    if id >= graph.nodes.len { return Result::Err(GRAPH_NODE); }
    if graph.nodes.data[id].op != 1 { return Result::Err(GRAPH_VARIABLE); }
    if !finite(value) { return Result::Err(GRAPH_DOMAIN); }
    graph.nodes.data[id].value = value; graph.nodes.data[id].ready = true;
    graph_reset(graph);
    Result::Ok(())
}
fn binary(graph: *Graph, left: u64, right: u64, op: i32) -> Result<u64, i32> {
    if left >= graph.nodes.len || right >= graph.nodes.len { return Result::Err(GRAPH_NODE); }
    record(graph, op, 0.0, left, right)
}
fn unary(graph: *Graph, input: u64, op: i32) -> Result<u64, i32> {
    if input >= graph.nodes.len { return Result::Err(GRAPH_NODE); }
    record(graph, op, 0.0, input, input)
}
pub fn add_op(graph: *Graph, a: u64, b: u64) -> Result<u64, i32> { binary(graph, a, b, 2) }
pub fn sub_op(graph: *Graph, a: u64, b: u64) -> Result<u64, i32> { binary(graph, a, b, 3) }
pub fn mul_op(graph: *Graph, a: u64, b: u64) -> Result<u64, i32> { binary(graph, a, b, 4) }
pub fn div_op(graph: *Graph, a: u64, b: u64) -> Result<u64, i32> { binary(graph, a, b, 5) }
pub fn neg_op(graph: *Graph, a: u64) -> Result<u64, i32> { unary(graph, a, 6) }
pub fn exp_op(graph: *Graph, a: u64) -> Result<u64, i32> { unary(graph, a, 7) }
pub fn log_op(graph: *Graph, a: u64) -> Result<u64, i32> { unary(graph, a, 8) }
pub fn relu_op(graph: *Graph, a: u64) -> Result<u64, i32> { unary(graph, a, 9) }
pub fn sigmoid_op(graph: *Graph, a: u64) -> Result<u64, i32> { unary(graph, a, 10) }
pub fn eval(graph: *Graph, output: u64) -> Result<f32, i32> {
    if output >= graph.nodes.len { return Result::Err(GRAPH_NODE); }
    let mut index: u64 = 0;
    while index <= output { graph.nodes.data[index].needed = false; index += 1; }
    graph.nodes.data[output].needed = true;
    index = output + 1;
    while index > 0 {
        index -= 1;
        let node: Node = graph.nodes.data[index];
        if node.needed && !node.ready && node.op >= 2 {
            graph.nodes.data[node.left].needed = true;
            if node.op <= 5 { graph.nodes.data[node.right].needed = true; }
        }
    }
    index = 0;
    while index <= output {
        let node: Node = graph.nodes.data[index];
        if node.needed && !node.ready {
            if node.op == 1 { return Result::Err(GRAPH_UNSET); }
            let left: f32 = graph.nodes.data[node.left].value;
            let right: f32 = graph.nodes.data[node.right].value;
            let mut value: f32 = 0.0;
            if node.op == 2 { value = left + right; }
            else if node.op == 3 { value = left - right; }
            else if node.op == 4 { value = left * right; }
            else if node.op == 5 { if right == 0.0 { return Result::Err(GRAPH_DOMAIN); } value = left / right; }
            else if node.op == 6 { value = -left; }
            else if node.op == 7 { value = expf(left); }
            else if node.op == 8 { if left <= 0.0 { return Result::Err(GRAPH_DOMAIN); } value = logf(left); }
            else if node.op == 9 { value = if left > 0.0 { left } else { 0.0 }; }
            else if node.op == 10 { if left >= 0.0 { value = 1.0 / (1.0 + expf(-left)); } else { let e: f32 = expf(left); value = e / (1.0 + e); } }
            else { return Result::Err(GRAPH_NODE); }
            if !finite(value) { return Result::Err(GRAPH_DOMAIN); }
            graph.nodes.data[index].value = value; graph.nodes.data[index].ready = true;
        }
        index += 1;
    }
    Result::Ok(graph.nodes.data[output].value)
}
