// CPU f64 tensors, rank 0..4, with explicit owning handles.
// Every constructor/view returns one owned handle: free it exactly once.
// Pointer copies are borrowed aliases, not new owners. Views retain storage,
// so releasing the parent handle does not invalidate a view. Mutations through
// views are shared. tensor_clone makes an independent contiguous copy.
// Shape/stride/offset fields are library invariants; callers must not edit them.
use result::Result;
extern "C" {
    fn malloc(size: u64) -> *void;
    fn free(pointer: *void);
    @pure fn tanh(value: f64) -> f64;
}

const TENSOR_SHAPE: i32 = 1;
const TENSOR_ALLOC: i32 = 2;
const TENSOR_BOUNDS: i32 = 3;
const TENSOR_OVERFLOW: i32 = 4;

struct Storage { data: *f64, count: u64, owners: u64 }
pub struct Tensor {
    storage: *Storage,
    rank: u64,
    shape: [u64; 4],
    strides: [u64; 4],
    offset: u64,
    len: u64,
}

pub fn tensor_zeros(rank: u64, shape: *u64) -> Result<*Tensor, i32> {
    if rank > 4 { return Result::Err(TENSOR_SHAPE); }
    if rank > 0 && shape == 0 as *u64 { return Result::Err(TENSOR_SHAPE); }
    let mut dims: [u64; 4] = [1, 1, 1, 1];
    let mut strides: [u64; 4] = [0, 0, 0, 0];
    let mut len: u64 = 1;
    let mut i: u64 = rank;
    // Bound each extent even for empty shapes; no wrapping layout products.
    while i > 0 {
        i -= 1;
        let d: u64 = shape[i];
        if d > 1152921504606846975 { return Result::Err(TENSOR_OVERFLOW); }
        if d != 0 && len > 1152921504606846975 / d { return Result::Err(TENSOR_OVERFLOW); }
        dims[i] = d;
        strides[i] = len;
        len *= d;
    }
    let storage: *Storage = malloc(size_of(Storage) as u64) as *Storage;
    if storage == 0 as *Storage { return Result::Err(TENSOR_ALLOC); }
    let mut data: *f64 = 0 as *f64;
    if len > 0 {
        data = malloc(len * 8) as *f64;
        if data == 0 as *f64 { free(storage as *void); return Result::Err(TENSOR_ALLOC); }
    }
    let tensor: *Tensor = malloc(size_of(Tensor) as u64) as *Tensor;
    if tensor == 0 as *Tensor {
        free(data as *void); free(storage as *void); return Result::Err(TENSOR_ALLOC);
    }
    *storage = Storage { data: data, count: len, owners: 1 };
    *tensor = Tensor { storage: storage, rank: rank, shape: dims, strides: strides, offset: 0, len: len };
    i = 0;
    while i < len { data[i] = 0.0; i += 1; }
    Result::Ok(tensor)
}

pub fn tensor_free(tensor: *Tensor) {
    if tensor == 0 as *Tensor { return; }
    let storage: *Storage = tensor.storage;
    storage.owners -= 1;
    if storage.owners == 0 { free(storage.data as *void); free(storage as *void); }
    free(tensor as *void);
}

// Logical row-major indexing works for every supported non-contiguous view.
fn physical(tensor: *Tensor, index: u64) -> u64 {
    let mut cursor: u64 = index;
    let mut offset: u64 = tensor.offset;
    let mut axis: u64 = tensor.rank;
    while axis > 0 {
        axis -= 1;
        offset += (cursor % tensor.shape[axis]) * tensor.strides[axis];
        cursor /= tensor.shape[axis];
    }
    offset
}
pub fn tensor_get(tensor: *Tensor, index: u64) -> Result<f64, i32> {
    if tensor == 0 as *Tensor { return Result::Err(TENSOR_BOUNDS); }
    if index >= tensor.len { return Result::Err(TENSOR_BOUNDS); }
    Result::Ok(tensor.storage.data[physical(tensor, index)])
}
pub fn tensor_set(tensor: *Tensor, index: u64, value: f64) -> Result<(), i32> {
    if tensor == 0 as *Tensor { return Result::Err(TENSOR_BOUNDS); }
    if index >= tensor.len { return Result::Err(TENSOR_BOUNDS); }
    tensor.storage.data[physical(tensor, index)] = value;
    Result::Ok(())
}
pub fn tensor_len(tensor: *Tensor) -> u64 { tensor.len }
pub fn tensor_rank(tensor: *Tensor) -> u64 { tensor.rank }
pub fn tensor_dim(tensor: *Tensor, axis: u64) -> Result<u64, i32> {
    if axis >= tensor.rank { return Result::Err(TENSOR_BOUNDS); }
    Result::Ok(tensor.shape[axis])
}
pub fn tensor_from_data(rank: u64, shape: *u64, data: *f64) -> Result<*Tensor, i32> {
    let tensor: *Tensor = tensor_zeros(rank, shape)?;
    if tensor.len > 0 && data == 0 as *f64 { tensor_free(tensor); return Result::Err(TENSOR_BOUNDS); }
    let mut i: u64 = 0;
    while i < tensor.len { tensor.storage.data[i] = data[i]; i += 1; }
    Result::Ok(tensor)
}
pub fn tensor_clone(tensor: *Tensor) -> Result<*Tensor, i32> {
    let copy: *Tensor = tensor_zeros(tensor.rank, &tensor.shape[0] as *u64)?;
    let mut i: u64 = 0;
    while i < tensor.len { copy.storage.data[i] = tensor.storage.data[physical(tensor, i)]; i += 1; }
    Result::Ok(copy)
}
fn view(tensor: *Tensor) -> Result<*Tensor, i32> {
    if tensor.storage.owners == 9223372036854775807 { return Result::Err(TENSOR_OVERFLOW); }
    let result: *Tensor = malloc(size_of(Tensor) as u64) as *Tensor;
    if result == 0 as *Tensor { return Result::Err(TENSOR_ALLOC); }
    *result = *tensor;
    tensor.storage.owners += 1;
    Result::Ok(result)
}
pub fn tensor_transpose(tensor: *Tensor) -> Result<*Tensor, i32> {
    if tensor.rank != 2 { return Result::Err(TENSOR_SHAPE); }
    let result: *Tensor = view(tensor)?;
    result.shape[0] = tensor.shape[1]; result.shape[1] = tensor.shape[0];
    result.strides[0] = tensor.strides[1]; result.strides[1] = tensor.strides[0];
    Result::Ok(result)
}
// Half-open [start,end), positive step only. Empty slices are valid.
pub fn tensor_slice(tensor: *Tensor, axis: u64, start: u64, end: u64, step: u64) -> Result<*Tensor, i32> {
    if axis >= tensor.rank || step == 0 { return Result::Err(TENSOR_SHAPE); }
    if start > end || end > tensor.shape[axis] { return Result::Err(TENSOR_BOUNDS); }
    if tensor.strides[axis] != 0 && step > 9223372036854775807 / tensor.strides[axis] {
        return Result::Err(TENSOR_OVERFLOW);
    }
    let mut extent: u64 = 0;
    if end > start { extent = 1 + (end - start - 1) / step; }
    let result: *Tensor = view(tensor)?;
    if tensor.shape[axis] != 0 { result.len = tensor.len / tensor.shape[axis] * extent; }
    result.shape[axis] = extent;
    result.strides[axis] = tensor.strides[axis] * step;
    // Empty views never dereference storage; keep a representable base offset.
    if result.len > 0 { result.offset += start * tensor.strides[axis]; }
    Result::Ok(result)
}
pub fn tensor_same_shape(a: *Tensor, b: *Tensor) -> bool {
    if a.rank != b.rank { return false; }
    let mut axis: u64 = 0;
    while axis < a.rank { if a.shape[axis] != b.shape[axis] { return false; } axis += 1; }
    true
}
fn binary(a: *Tensor, b: *Tensor, op: i32) -> Result<*Tensor, i32> {
    if !tensor_same_shape(a, b) { return Result::Err(TENSOR_SHAPE); }
    let out: *Tensor = tensor_zeros(a.rank, &a.shape[0] as *u64)?;
    let mut i: u64 = 0;
    while i < a.len {
        let x: f64 = a.storage.data[physical(a, i)]; let y: f64 = b.storage.data[physical(b, i)];
        let mut value: f64 = x + y;
        if op == 1 { value = x - y; }
        if op == 2 { value = x * y; }
        out.storage.data[i] = value;
        i += 1;
    }
    Result::Ok(out)
}
pub fn tensor_add(a: *Tensor, b: *Tensor) -> Result<*Tensor, i32> { binary(a, b, 0) }
pub fn tensor_sub(a: *Tensor, b: *Tensor) -> Result<*Tensor, i32> { binary(a, b, 1) }
pub fn tensor_mul(a: *Tensor, b: *Tensor) -> Result<*Tensor, i32> { binary(a, b, 2) }
pub fn tensor_tanh(a: *Tensor) -> Result<*Tensor, i32> {
    let out: *Tensor = tensor_zeros(a.rank, &a.shape[0] as *u64)?;
    let mut i: u64 = 0;
    while i < a.len { out.storage.data[i] = tanh(a.storage.data[physical(a, i)]); i += 1; }
    Result::Ok(out)
}
pub fn tensor_sum(a: *Tensor) -> Result<*Tensor, i32> {
    let out: *Tensor = tensor_zeros(0, 0 as *u64)?;
    let mut sum: f64 = 0.0; let mut i: u64 = 0;
    while i < a.len { sum += a.storage.data[physical(a, i)]; i += 1; }
    out.storage.data[0] = sum;
    Result::Ok(out)
}
pub fn tensor_matmul(a: *Tensor, b: *Tensor) -> Result<*Tensor, i32> {
    if a.rank != 2 || b.rank != 2 { return Result::Err(TENSOR_SHAPE); }
    if a.shape[1] != b.shape[0] { return Result::Err(TENSOR_SHAPE); }
    let shape: [u64; 2] = [a.shape[0], b.shape[1]];
    let out: *Tensor = tensor_zeros(2, &shape[0] as *u64)?;
    let mut row: u64 = 0;
    while row < a.shape[0] {
        let mut col: u64 = 0;
        while col < b.shape[1] {
            let mut sum: f64 = 0.0; let mut k: u64 = 0;
            while k < a.shape[1] {
                sum += a.storage.data[a.offset + row * a.strides[0] + k * a.strides[1]] *
                       b.storage.data[b.offset + k * b.strides[0] + col * b.strides[1]];
                k += 1;
            }
            out.storage.data[row * b.shape[1] + col] = sum;
            col += 1;
        }
        row += 1;
    }
    Result::Ok(out)
}
