pub fn f64x2_store(pointer: *f64, value: f64x2) -> () { unsafe { __simd_f64x2_store(pointer, value); } }
pub fn f64x2_eq(a: f64x2, b: f64x2) -> i64x2 { return __simd_f64x2_eq(a, b); }
pub fn f64x2_ne(a: f64x2, b: f64x2) -> i64x2 { return __simd_f64x2_ne(a, b); }
pub fn f64x2_lt(a: f64x2, b: f64x2) -> i64x2 { return __simd_f64x2_lt(a, b); }
pub fn f64x2_le(a: f64x2, b: f64x2) -> i64x2 { return __simd_f64x2_le(a, b); }
pub fn f64x2_gt(a: f64x2, b: f64x2) -> i64x2 { return __simd_f64x2_gt(a, b); }
pub fn f64x2_ge(a: f64x2, b: f64x2) -> i64x2 { return __simd_f64x2_ge(a, b); }

pub fn i32x4_new(x0: i32, x1: i32, x2: i32, x3: i32) -> i32x4 { return __simd_i32x4_new(x0, x1, x2, x3); }
