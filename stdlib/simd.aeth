pub fn i32x4_sub(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_sub(a, b); }
pub fn i32x4_mul(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_mul(a, b); }
