// Portable fixed-width SIMD. Lanes are ordered from zero in constructor order.
// Floating arithmetic follows IEEE semantics; reductions add lanes left to right.
// Comparisons return integer masks: true=-1, false=0; all/any test nonzero lanes.
// Loads/stores permit unaligned addresses and copy exactly one vector.
// Callers of pointer operations must provide valid memory for every lane.

pub fn f32x4_new(x0: f32, x1: f32, x2: f32, x3: f32) -> f32x4 { return __simd_f32x4_new(x0, x1, x2, x3); }
pub fn f32x4_splat(value: f32) -> f32x4 { return __simd_f32x4_splat(value); }
pub fn f32x4_add(a: f32x4, b: f32x4) -> f32x4 { return __simd_f32x4_add(a, b); }
pub fn f32x4_sub(a: f32x4, b: f32x4) -> f32x4 { return __simd_f32x4_sub(a, b); }
pub fn f32x4_mul(a: f32x4, b: f32x4) -> f32x4 { return __simd_f32x4_mul(a, b); }
pub fn f32x4_div(a: f32x4, b: f32x4) -> f32x4 { return __simd_f32x4_div(a, b); }
pub fn f32x4_sum(value: f32x4) -> f32 { return __simd_f32x4_sum(value); }
pub fn f32x4_extract(value: f32x4, lane: usize) -> f32 { return __simd_f32x4_extract(value, lane); }
pub fn f32x4_load(pointer: *f32) -> f32x4 { unsafe { return __simd_f32x4_load(pointer); } }
pub fn f32x4_store(pointer: *f32, value: f32x4) -> () { unsafe { __simd_f32x4_store(pointer, value); } }
pub fn f32x4_eq(a: f32x4, b: f32x4) -> i32x4 { return __simd_f32x4_eq(a, b); }
pub fn f32x4_ne(a: f32x4, b: f32x4) -> i32x4 { return __simd_f32x4_ne(a, b); }
pub fn f32x4_lt(a: f32x4, b: f32x4) -> i32x4 { return __simd_f32x4_lt(a, b); }
pub fn f32x4_le(a: f32x4, b: f32x4) -> i32x4 { return __simd_f32x4_le(a, b); }
pub fn f32x4_gt(a: f32x4, b: f32x4) -> i32x4 { return __simd_f32x4_gt(a, b); }
pub fn f32x4_ge(a: f32x4, b: f32x4) -> i32x4 { return __simd_f32x4_ge(a, b); }

