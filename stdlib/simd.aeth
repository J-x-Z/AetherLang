pub fn f64x2_add(a: f64x2, b: f64x2) -> f64x2 { return __simd_f64x2_add(a, b); }
pub fn f64x2_sub(a: f64x2, b: f64x2) -> f64x2 { return __simd_f64x2_sub(a, b); }
pub fn f64x2_mul(a: f64x2, b: f64x2) -> f64x2 { return __simd_f64x2_mul(a, b); }
pub fn f64x2_div(a: f64x2, b: f64x2) -> f64x2 { return __simd_f64x2_div(a, b); }
pub fn f64x2_sum(value: f64x2) -> f64 { return __simd_f64x2_sum(value); }
pub fn f64x2_extract(value: f64x2, lane: usize) -> f64 { return __simd_f64x2_extract(value, lane); }
