pub fn i32x4_extract(value: i32x4, lane: usize) -> i32 { return __simd_i32x4_extract(value, lane); }
pub fn i32x4_load(pointer: *i32) -> i32x4 { unsafe { return __simd_i32x4_load(pointer); } }
pub fn i32x4_store(pointer: *i32, value: i32x4) -> () { unsafe { __simd_i32x4_store(pointer, value); } }
pub fn i32x4_eq(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_eq(a, b); }
pub fn i32x4_ne(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_ne(a, b); }
pub fn i32x4_lt(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_lt(a, b); }
pub fn i32x4_le(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_le(a, b); }
pub fn i32x4_gt(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_gt(a, b); }
pub fn i32x4_ge(a: i32x4, b: i32x4) -> i32x4 { return __simd_i32x4_ge(a, b); }
pub fn i32x4_all(value: i32x4) -> bool { return __simd_i32x4_all(value); }
pub fn i32x4_any(value: i32x4) -> bool { return __simd_i32x4_any(value); }

pub fn i64x2_new(x0: i64, x1: i64) -> i64x2 { return __simd_i64x2_new(x0, x1); }
pub fn i64x2_splat(value: i64) -> i64x2 { return __simd_i64x2_splat(value); }
pub fn i64x2_add(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_add(a, b); }
pub fn i64x2_sub(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_sub(a, b); }
pub fn i64x2_mul(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_mul(a, b); }
pub fn i64x2_sum(value: i64x2) -> i64 { return __simd_i64x2_sum(value); }
pub fn i64x2_extract(value: i64x2, lane: usize) -> i64 { return __simd_i64x2_extract(value, lane); }
pub fn i64x2_load(pointer: *i64) -> i64x2 { unsafe { return __simd_i64x2_load(pointer); } }
pub fn i64x2_store(pointer: *i64, value: i64x2) -> () { unsafe { __simd_i64x2_store(pointer, value); } }
pub fn i64x2_eq(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_eq(a, b); }
pub fn i64x2_ne(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_ne(a, b); }
pub fn i64x2_lt(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_lt(a, b); }
pub fn i64x2_le(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_le(a, b); }
pub fn i64x2_gt(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_gt(a, b); }
pub fn i64x2_ge(a: i64x2, b: i64x2) -> i64x2 { return __simd_i64x2_ge(a, b); }
pub fn i64x2_all(value: i64x2) -> bool { return __simd_i64x2_all(value); }
pub fn i64x2_any(value: i64x2) -> bool { return __simd_i64x2_any(value); }

pub fn f32x4_dot(a: f32x4, b: f32x4) -> f32 {
    let product: f32x4 = f32x4_mul(a, b);
    return f32x4_sum(product);
}
