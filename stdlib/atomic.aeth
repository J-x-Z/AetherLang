// Typed atomic operations. Default operations are sequentially consistent.
// Explicit intrinsics require compile-time orders; named wrappers below retain
// that guarantee. All pointers must refer to aligned, live storage of the width.
const ORDER_RELAXED: i32 = 0;
const ORDER_ACQUIRE: i32 = 1;
const ORDER_RELEASE: i32 = 2;
const ORDER_ACQ_REL: i32 = 3;
const ORDER_SEQ_CST: i32 = 4;

pub fn atomic_load_u8(pointer: *u8) -> u8 { __atomic_load_u8(pointer) }
pub fn atomic_load_u8_relaxed(pointer: *u8) -> u8 { __atomic_load_u8_explicit(pointer, 0) }
pub fn atomic_load_u8_acquire(pointer: *u8) -> u8 { __atomic_load_u8_explicit(pointer, 1) }
pub fn atomic_store_u8(pointer: *u8, value: u8) { __atomic_store_u8(pointer, value) }
pub fn atomic_store_u8_relaxed(pointer: *u8, value: u8) { __atomic_store_u8_explicit(pointer, value, 0) }
pub fn atomic_store_u8_release(pointer: *u8, value: u8) { __atomic_store_u8_explicit(pointer, value, 2) }
pub fn atomic_add_u8(pointer: *u8, value: u8) -> u8 { __atomic_fetch_add_u8(pointer, value) }
pub fn atomic_add_u8_relaxed(pointer: *u8, value: u8) -> u8 { __atomic_fetch_add_u8_explicit(pointer, value, 0) }
pub fn atomic_add_u8_acquire(pointer: *u8, value: u8) -> u8 { __atomic_fetch_add_u8_explicit(pointer, value, 1) }
pub fn atomic_add_u8_release(pointer: *u8, value: u8) -> u8 { __atomic_fetch_add_u8_explicit(pointer, value, 2) }
pub fn atomic_add_u8_acq_rel(pointer: *u8, value: u8) -> u8 { __atomic_fetch_add_u8_explicit(pointer, value, 3) }
pub fn atomic_sub_u8(pointer: *u8, value: u8) -> u8 { __atomic_fetch_sub_u8(pointer, value) }
pub fn atomic_sub_u8_relaxed(pointer: *u8, value: u8) -> u8 { __atomic_fetch_sub_u8_explicit(pointer, value, 0) }
pub fn atomic_sub_u8_acquire(pointer: *u8, value: u8) -> u8 { __atomic_fetch_sub_u8_explicit(pointer, value, 1) }
pub fn atomic_sub_u8_release(pointer: *u8, value: u8) -> u8 { __atomic_fetch_sub_u8_explicit(pointer, value, 2) }
pub fn atomic_sub_u8_acq_rel(pointer: *u8, value: u8) -> u8 { __atomic_fetch_sub_u8_explicit(pointer, value, 3) }
pub fn atomic_cas_u8(pointer: *u8, expected: u8, desired: u8) -> bool { __atomic_compare_exchange_u8(pointer, expected, desired) }
pub fn atomic_cas_u8_relaxed(pointer: *u8, expected: u8, desired: u8) -> bool { __atomic_compare_exchange_u8_explicit(pointer, expected, desired, 0, 0) }
pub fn atomic_cas_u8_acquire(pointer: *u8, expected: u8, desired: u8) -> bool { __atomic_compare_exchange_u8_explicit(pointer, expected, desired, 1, 0) }
pub fn atomic_cas_u8_release(pointer: *u8, expected: u8, desired: u8) -> bool { __atomic_compare_exchange_u8_explicit(pointer, expected, desired, 2, 0) }
pub fn atomic_cas_u8_acq_rel(pointer: *u8, expected: u8, desired: u8) -> bool { __atomic_compare_exchange_u8_explicit(pointer, expected, desired, 3, 1) }
pub fn atomic_inc_u8(pointer: *u8) -> u8 { atomic_add_u8(pointer, 1) }
pub fn atomic_dec_u8(pointer: *u8) -> u8 { atomic_sub_u8(pointer, 1) }

