pub fn memory_fence() { __atomic_thread_fence() }
pub fn memory_fence_acquire() { __atomic_thread_fence_explicit(1) }
pub fn memory_fence_release() { __atomic_thread_fence_explicit(2) }
pub fn memory_fence_acq_rel() { __atomic_thread_fence_explicit(3) }
// Compatibility name: this now emits a full seq_cst fence (stronger than the
// old compiler-only intent), with identical behavior on both backends.
pub fn compiler_barrier() { __atomic_thread_fence() }

pub struct Spinlock { locked: u32 }
pub fn spinlock_init(lock: *Spinlock) { atomic_store_u32_relaxed(&(*lock).locked as *u32, 0); }
pub fn spinlock_acquire(lock: *Spinlock) {
    while !atomic_cas_u32_acquire(&(*lock).locked as *u32, 0, 1) {}
}
pub fn spinlock_release(lock: *Spinlock) { atomic_store_u32_release(&(*lock).locked as *u32, 0); }
pub fn spinlock_try_acquire(lock: *Spinlock) -> bool { atomic_cas_u32_acquire(&(*lock).locked as *u32, 0, 1) }
