// Explicit allocation and ownership. Migration: arena_*/stack_* functions
// replace the old Allocator/Drop impls; there is no implicit destruction.
// Do not copy live owners. arena_from_raw/stack_from_raw borrow their storage;
// freeing these handles never frees the borrowed bytes. Individual allocations
// are invalidated by reset/free. Checked allocation sizes must be nonzero.
use result::Result;
use vec::{Vec, vec_new, vec_push, vec_free};
extern "C" {
    fn malloc(size: u64) -> *void; fn free(pointer: *void);
    fn memcpy(destination: *void, source: *void, size: u64) -> *void;
}
const ALLOC_ARGUMENT: i32 = 1;
const ALLOC_MEMORY: i32 = 2;
const ALLOC_CAPACITY: i32 = 3;
const ALLOC_ORDER: i32 = 4;
const MAX_BYTES: u64 = 9223372036854775807;
fn valid_alignment(alignment: u64) -> bool {
    alignment != 0 && alignment <= MAX_BYTES && (alignment & (alignment - 1)) == 0
}
// Raw compatibility functions retain libc's malloc/free contract.
pub fn global_alloc(size: u64) -> *u8 { malloc(size) as *u8 }
pub fn global_dealloc(pointer: *u8) { free(pointer as *void); }

// Aligned allocations store the original malloc pointer in a preceding header.
// Only alloc_deallocate can release these pointers; do not pass them to free.
pub fn alloc_allocate(size: u64, alignment: u64) -> Result<*u8, i32> {
    if size == 0 || !valid_alignment(alignment) { return Result::Err(ALLOC_ARGUMENT); }
    let align: u64 = if alignment < align_of(*void) as u64 { align_of(*void) as u64 } else { alignment };
    let header: u64 = size_of(*void) as u64;
    if align > MAX_BYTES - header || size > MAX_BYTES - header - (align - 1) { return Result::Err(ALLOC_CAPACITY); }
    let allocation: *void = malloc(size + header + align - 1);
    if allocation == (0 as *void) { return Result::Err(ALLOC_MEMORY); }
    let start: u64 = (allocation as u64) + header;
    let address: u64 = start + (align - start % align) % align;
    *((address - header) as **void) = allocation;
    Result::Ok(address as *u8)
}
pub fn alloc_deallocate(pointer: *u8) {
    if pointer != (0 as *u8) { free(*(((pointer as u64) - size_of(*void) as u64) as **void)); }
}
// Failure preserves the old allocation. old_size must be its actual size.
pub fn alloc_reallocate(pointer: *u8, old_size: u64, new_size: u64, alignment: u64) -> Result<*u8, i32> {
    if pointer == (0 as *u8) || old_size == 0 { return Result::Err(ALLOC_ARGUMENT); }
    let next: *u8 = alloc_allocate(new_size, alignment)?;
    let count: u64 = if old_size < new_size { old_size } else { new_size };
    memcpy(next as *void, pointer as *void, count);
    alloc_deallocate(pointer);
    Result::Ok(next)
}

pub struct ArenaAllocator { base: *u8, pos: u64, capacity: u64, owned: bool }
pub fn arena_new(capacity: u64) -> Result<ArenaAllocator, i32> {
    if capacity == 0 || capacity > MAX_BYTES { return Result::Err(ALLOC_ARGUMENT); }
    let base: *u8 = malloc(capacity) as *u8;
    if base == (0 as *u8) { return Result::Err(ALLOC_MEMORY); }
    Result::Ok(ArenaAllocator { base: base, pos: 0, capacity: capacity, owned: true })
}
pub fn arena_from_raw(base: *u8, capacity: u64) -> Result<ArenaAllocator, i32> {
    if base == (0 as *u8) || capacity == 0 || capacity > MAX_BYTES || (base as u64) > 18446744073709551615 - capacity { return Result::Err(ALLOC_ARGUMENT); }
    Result::Ok(ArenaAllocator { base: base, pos: 0, capacity: capacity, owned: false })
}
pub fn arena_free(arena: *ArenaAllocator) {
    if arena.owned { free(arena.base as *void); }
    arena.base = 0 as *u8; arena.pos = 0; arena.capacity = 0; arena.owned = false;
}
pub fn arena_reset(arena: *ArenaAllocator) { arena.pos = 0; }
pub fn arena_used(arena: *ArenaAllocator) -> u64 { arena.pos }
pub fn arena_remaining(arena: *ArenaAllocator) -> u64 { arena.capacity - arena.pos }
pub fn arena_allocate(arena: *ArenaAllocator, size: u64, alignment: u64) -> Result<*u8, i32> {
    if size == 0 || !valid_alignment(alignment) || arena.base == (0 as *u8) { return Result::Err(ALLOC_ARGUMENT); }
    let address: u64 = (arena.base as u64) + arena.pos;
    let padding: u64 = (alignment - address % alignment) % alignment;
    let remaining: u64 = arena.capacity - arena.pos;
    if padding > remaining || size > remaining - padding { return Result::Err(ALLOC_CAPACITY); }
    let result: *u8 = arena.base + arena.pos + padding;
    arena.pos = arena.pos + padding + size;
    Result::Ok(result)
}
pub fn arena_reallocate(arena: *ArenaAllocator, pointer: *u8, old_size: u64, new_size: u64, alignment: u64) -> Result<*u8, i32> {
    let address: u64 = pointer as u64; let base: u64 = arena.base as u64;
    if address < base || address - base > arena.pos || old_size > arena.pos - (address - base) { return Result::Err(ALLOC_ARGUMENT); }
    let next: *u8 = arena_allocate(arena, new_size, alignment)?;
    let count: u64 = if old_size < new_size { old_size } else { new_size };
    memcpy(next as *void, pointer as *void, count);
    Result::Ok(next)
}

struct StackAllocation { pointer: *u8, size: u64, previous: u64, alignment: u64 }
pub struct StackAllocator { arena: ArenaAllocator, allocations: Vec<StackAllocation> }
pub fn stack_new(capacity: u64) -> Result<StackAllocator, i32> {
    let arena: ArenaAllocator = arena_new(capacity)?;
    let allocations: Vec<StackAllocation> = vec_new();
    Result::Ok(StackAllocator { arena: arena, allocations: allocations })
}
pub fn stack_from_raw(base: *u8, capacity: u64) -> Result<StackAllocator, i32> {
    let arena: ArenaAllocator = arena_from_raw(base, capacity)?;
    let allocations: Vec<StackAllocation> = vec_new();
    Result::Ok(StackAllocator { arena: arena, allocations: allocations })
}
pub fn stack_free(stack: *StackAllocator) { arena_free(&stack.arena as *ArenaAllocator); vec_free(&stack.allocations as *Vec<StackAllocation>); }
pub fn stack_reset(stack: *StackAllocator) { arena_reset(&stack.arena as *ArenaAllocator); stack.allocations.len = 0; }
pub fn stack_used(stack: *StackAllocator) -> u64 { stack.arena.pos }
pub fn stack_allocate(stack: *StackAllocator, size: u64, alignment: u64) -> Result<*u8, i32> {
    let previous: u64 = stack.arena.pos;
    let pointer: *u8 = arena_allocate(&stack.arena as *ArenaAllocator, size, alignment)?;
    let allocation: StackAllocation = StackAllocation { pointer: pointer, size: size, previous: previous, alignment: alignment };
    if !vec_push(&stack.allocations as *Vec<StackAllocation>, allocation) { stack.arena.pos = previous; return Result::Err(ALLOC_MEMORY); }
    Result::Ok(pointer)
}
pub fn stack_deallocate(stack: *StackAllocator, pointer: *u8, size: u64, alignment: u64) -> Result<(), i32> {
    if stack.allocations.len == 0 { return Result::Err(ALLOC_ORDER); }
    let last: StackAllocation = stack.allocations.data[stack.allocations.len - 1];
    if pointer != last.pointer || size != last.size || alignment != last.alignment { return Result::Err(ALLOC_ORDER); }
    stack.arena.pos = last.previous; stack.allocations.len -= 1;
    Result::Ok(())
}
// Reallocation is allowed only for the exact top allocation, with unchanged
// alignment. Both growth and shrink update the saved extent without underflow.
pub fn stack_reallocate(stack: *StackAllocator, pointer: *u8, old_size: u64, new_size: u64, alignment: u64) -> Result<*u8, i32> {
    if new_size == 0 { return Result::Err(ALLOC_ARGUMENT); }
    if stack.allocations.len == 0 { return Result::Err(ALLOC_ORDER); }
    let index: u64 = stack.allocations.len - 1;
    let last: StackAllocation = stack.allocations.data[index];
    if pointer != last.pointer || old_size != last.size || alignment != last.alignment { return Result::Err(ALLOC_ORDER); }
    let offset: u64 = (pointer as u64) - (stack.arena.base as u64);
    if new_size > stack.arena.capacity - offset { return Result::Err(ALLOC_CAPACITY); }
    stack.arena.pos = offset + new_size; stack.allocations.data[index].size = new_size;
    Result::Ok(pointer)
}
