// Volatile memory access for mapped registers. Volatile preserves each access;
// it is not inter-thread synchronization. Use atomic for shared thread data.
// The caller supplies a live, aligned mapping and its correct register width.
// Migration: x86 port_in/port_out are isolated in module x86io.

pub fn mmio_read_u8(address: *u8) -> u8 { __volatile_read_u8(address) }
pub fn mmio_write_u8(address: *u8, value: u8) { __volatile_write_u8(address, value); }
pub fn mmio_read_u16(address: *u16) -> u16 { __volatile_read_u16(address) }
pub fn mmio_write_u16(address: *u16, value: u16) { __volatile_write_u16(address, value); }
pub fn mmio_read_u32(address: *u32) -> u32 { __volatile_read_u32(address) }
pub fn mmio_write_u32(address: *u32, value: u32) { __volatile_write_u32(address, value); }
pub fn mmio_read_u64(address: *u64) -> u64 { __volatile_read_u64(address) }
pub fn mmio_write_u64(address: *u64, value: u64) { __volatile_write_u64(address, value); }

// Portable CPU memory-order fences. Device-specific mapping/cache attributes
// and platform bus protocols remain the caller's responsibility.
pub fn memory_barrier() { __atomic_thread_fence() }
pub fn read_barrier() { __atomic_thread_fence_explicit(1) }
pub fn write_barrier() { __atomic_thread_fence_explicit(2) }
