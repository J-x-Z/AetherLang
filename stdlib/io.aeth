// Checked text output and compatibility names for the single fs.File lifecycle.
use fs::{File as FsFile, file_open_read, file_open_write, file_close, file_is_open};
extern "C" {
    fn puts(s: *u8) -> i32;
    fn printf(fmt: *u8, ...) -> i32;
    fn fflush(file: *void) -> i32;
}

pub type File = FsFile;

pub fn print(s: *u8) -> bool { return printf("%s\0" as *u8, s) >= 0; }
pub fn println(s: *u8) -> bool { return puts(s) >= 0; }
pub fn print_int(n: i64) -> bool { return printf("%lld\0" as *u8, n) >= 0; }
pub fn println_int(n: i64) -> bool { return printf("%lld\n\0" as *u8, n) >= 0; }
pub fn flush() -> bool { return fflush(0 as *void) == 0; }
pub fn open_read(path: *u8) -> File { return file_open_read(path); }
pub fn open_write(path: *u8) -> File { return file_open_write(path); }
pub fn close(file: *File) -> i32 { if file_close(file) { return 0; } return -1; }
pub fn is_valid(file: *File) -> bool { return file_is_open(file); }
