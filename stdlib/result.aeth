// A success value or an error, each with its actual concrete payload type.
// Migration: Option is in module option; result_* functions replace the old
// unimplemented generic methods.
// Match both variants, or use ? inside a function returning Result<T, E>.
// ? propagates the same error type E; it does not invent error conversions.
use option::Option;

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub fn result_is_ok<T, E>(value: Result<T, E>) -> bool {
    match value {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}

pub fn result_or<T, E>(value: Result<T, E>, fallback: T) -> T {
    match value {
        Result::Ok(item) => item,
        Result::Err(_) => fallback,
    }
}

pub fn result_ok<T, E>(value: Result<T, E>) -> Option<T> {
    match value {
        Result::Ok(item) => Option::Some(item),
        Result::Err(_) => Option::None,
    }
}

pub fn result_err<T, E>(value: Result<T, E>) -> Option<E> {
    match value {
        Result::Ok(_) => Option::None,
        Result::Err(error) => Option::Some(error),
    }
}
