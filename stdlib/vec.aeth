// Growable contiguous storage with explicit ownership and fallible allocation.
// Migration: use Vec<T> and vec_* free functions, replacing the former
// nonfunctional Vec<T, Allocator>/generic impl API. Free exactly once through
// vec_free; do not copy a live Vec. Element values have no implicit destructor.
// get/set copy values; resource-owning elements remain the caller's responsibility.
extern "C" {
    fn malloc(size: usize) -> *void;
    fn realloc(pointer: *void, size: usize) -> *void;
    fn free(pointer: *void);
    fn memcpy(destination: *void, source: *void, size: usize) -> *void;
}
use option::Option;

pub struct Vec<T> {
    data: *T,
    len: u64,
    capacity: u64,
}

pub fn vec_new<T>() -> Vec<T> {
    Vec { data: 0 as *T, len: 0, capacity: 0 }
}

// malloc/realloc guarantee fundamental alignment, including u64. Larger
// alignments use an interior pointer; the original allocation is stored in the
// preceding pointer-sized header. This keeps Vec's public field layout intact
// and uses the same portable C allocator/free pair on every target.
fn vec_release_storage<T>(data: *T) {
    if size_of(T) == 0 || data == (0 as *T) { return; }
    if align_of(T) > align_of(u64) {
        let header: **void = ((data as u64) - size_of(*void) as u64) as **void;
        free(*header);
    } else { free(data as *void); }
}

// Preserve the u64 logical capacity API while bounding each actual allocation
// by the target's signed address space, before converting byte counts to size_t.
fn vec_capacity_limit(size: u64, alignment: u64) -> u64 {
    if size == 0 { return 9223372036854775807; }
    let max_bytes: u64 = (((-1 as isize) as usize) >> 1) as u64;
    if alignment > align_of(u64) as u64 {
        let header_size: u64 = size_of(*void) as u64;
        if alignment > max_bytes - header_size { return 0; }
        return (max_bytes - (header_size + alignment - 1)) / size;
    }
    max_bytes / size
}

// Preserve the original buffer, length and capacity if allocation fails.
// Bound byte counts by signed address space before multiplying.
pub fn vec_reserve<T>(vector: *Vec<T>, capacity: u64) -> bool {
    if capacity <= vector.capacity { return true; }
    let element_size: u64 = size_of(T) as u64;
    if element_size == 0 {
        // Zero-sized values need a logical capacity but no allocation. The
        // aligned non-null sentinel is never read or written by Unit accesses.
        vector.data = align_of(T) as *T;
        vector.capacity = capacity;
        return true;
    }
    if capacity > vec_capacity_limit(size_of(T) as u64, align_of(T) as u64) { return false; }
    let alignment: u64 = align_of(T) as u64;
    if alignment > align_of(u64) as u64 {
        let header_size: u64 = size_of(*void) as u64;
        let overhead: u64 = header_size + alignment - 1;
        let allocation: *void = malloc((capacity * element_size + overhead) as usize);
        if allocation == (0 as *void) { return false; }
        let start: u64 = (allocation as u64) + header_size;
        let padding: u64 = (alignment - start % alignment) % alignment;
        let data: *T = (start + padding) as *T;
        let header: **void = ((data as u64) - header_size) as **void;
        *header = allocation;
        if vector.len != 0 { memcpy(data as *void, vector.data as *void, (vector.len * element_size) as usize); }
        vec_release_storage(vector.data);
        vector.data = data;
        vector.capacity = capacity;
        return true;
    }
    let data: *T = realloc(vector.data as *void, (capacity * element_size) as usize) as *T;
    if data == 0 as *T { return false; }
    vector.data = data;
    vector.capacity = capacity;
    true
}

pub fn vec_push<T>(vector: *Vec<T>, value: T) -> bool {
    let max_len: u64 = vec_capacity_limit(size_of(T) as u64, align_of(T) as u64);
    if vector.len >= max_len { return false; }
    let required: u64 = vector.len + 1;
    if required > vector.capacity {
        let mut capacity: u64 = if max_len < 4 { required } else { 4 };
        if vector.capacity > 0 {
            if vector.capacity > max_len / 2 { capacity = required; }
            else { capacity = vector.capacity * 2; }
        }
        if !vec_reserve(vector, capacity) { return false; }
    }
    vector.data[vector.len] = value;
    vector.len = required;
    true
}

pub fn vec_get<T>(vector: *Vec<T>, index: u64) -> Option<T> {
    if index >= vector.len { return Option::None; }
    Option::Some(vector.data[index])
}

pub fn vec_set<T>(vector: *Vec<T>, index: u64, value: T) -> bool {
    if index >= vector.len { return false; }
    vector.data[index] = value;
    true
}

pub fn vec_pop<T>(vector: *Vec<T>) -> Option<T> {
    if vector.len == 0 { return Option::None; }
    vector.len = vector.len - 1;
    Option::Some(vector.data[vector.len])
}

// Invalidate after release; calling again on the same Vec is harmless.
pub fn vec_free<T>(vector: *Vec<T>) {
    vec_release_storage(vector.data);
    vector.data = 0 as *T;
    vector.len = 0;
    vector.capacity = 0;
}
