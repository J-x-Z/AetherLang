// CUDA runtime/cuBLAS host ABI. Link -lcudart -lcublas on a CUDA host.
// Raw calls remain available; these bindings do not compile GPU kernels.
// Migration: cuda_malloc/free become cuda_buffer_new/free; stream/BLAS
// constructors and operations now return Result instead of pointers/bools.
// Construct Dim3 with a struct literal. Wrap raw statuses with cuda_status or
// cublas_status when using raw memory/event calls. Do not
// copy live owners; release explicitly. A failed release retains its owner so
// the caller can inspect the CUDA context/error before deciding how to recover.
// Stream destruction is asynchronous: synchronize before reusing host memory.
// API: https://docs.nvidia.com/cuda/cuda-runtime-api/group__CUDART__MEMORY.html
//      https://docs.nvidia.com/cuda/cublas/index.html (column-major, host scalars)
use result::Result;
pub type CudaError = i32;
pub type CudaStream = *u8;
pub type CudaEvent = *u8;
pub type CudaDevicePtr = *u8;
pub type CublasHandle = *u8;
const CUDA_SUCCESS:i32=0;
const CUDA_ERROR_INVALID_VALUE:i32=1;
const CUDA_ERROR_OUT_OF_MEMORY:i32=2;
const CUDA_ERROR_NOT_INITIALIZED:i32=3;
const CUDA_ERROR_NO_DEVICE:i32=100;
const CUDA_MEMCPY_HOST_TO_HOST:i32=0;
const CUDA_MEMCPY_HOST_TO_DEVICE:i32=1;
const CUDA_MEMCPY_DEVICE_TO_HOST:i32=2;
const CUDA_MEMCPY_DEVICE_TO_DEVICE:i32=3;
const CUBLAS_OP_N:i32=0;
const CUBLAS_OP_T:i32=1;
const CUBLAS_POINTER_MODE_HOST:i32=0;
const GPU_CUDA:i32=1;
const GPU_CUBLAS:i32=2;
extern "C" {
 fn cudaGetDeviceCount(count:*i32)->CudaError;
 fn cudaSetDevice(device:i32)->CudaError;
 fn cudaGetDevice(device:*i32)->CudaError;
 fn cudaDeviceSynchronize()->CudaError;
 fn cudaDeviceReset()->CudaError;
 fn cudaMalloc(pointer:*CudaDevicePtr,size:u64)->CudaError;
 fn cudaFree(pointer:CudaDevicePtr)->CudaError;
 fn cudaMemcpy(destination:*u8,source:*u8,size:u64,kind:i32)->CudaError;
 fn cudaMemcpyAsync(destination:*u8,source:*u8,size:u64,kind:i32,stream:CudaStream)->CudaError;
 fn cudaMemset(pointer:CudaDevicePtr,value:i32,size:u64)->CudaError;
 fn cudaMallocHost(pointer:**u8,size:u64)->CudaError;
 fn cudaFreeHost(pointer:*u8)->CudaError;
 fn cudaStreamCreate(stream:*CudaStream)->CudaError;
 fn cudaStreamDestroy(stream:CudaStream)->CudaError;
 fn cudaStreamSynchronize(stream:CudaStream)->CudaError;
 fn cudaEventCreate(event:*CudaEvent)->CudaError;
 fn cudaEventDestroy(event:CudaEvent)->CudaError;
 fn cudaEventRecord(event:CudaEvent,stream:CudaStream)->CudaError;
 fn cudaEventSynchronize(event:CudaEvent)->CudaError;
 fn cudaEventElapsedTime(ms:*f32,start:CudaEvent,end:CudaEvent)->CudaError;
 fn cudaGetLastError()->CudaError;
 fn cudaGetErrorString(error:CudaError)->*u8;
 fn cublasCreate_v2(handle:*CublasHandle)->i32;
 fn cublasDestroy_v2(handle:CublasHandle)->i32;
 fn cublasSetStream_v2(handle:CublasHandle,stream:CudaStream)->i32;
 fn cublasSetPointerMode_v2(handle:CublasHandle,mode:i32)->i32;
 fn cublasSgemm_v2(handle:CublasHandle,transa:i32,transb:i32,m:i32,n:i32,k:i32,
  alpha:*f32,a:*f32,lda:i32,b:*f32,ldb:i32,beta:*f32,c:*f32,ldc:i32)->i32;
 fn cublasDgemm_v2(handle:CublasHandle,transa:i32,transb:i32,m:i32,n:i32,k:i32,
  alpha:*f64,a:*f64,lda:i32,b:*f64,ldb:i32,beta:*f64,c:*f64,ldc:i32)->i32;
}
pub struct GpuError { domain:i32,code:i32 }
pub struct CudaBuffer { data:CudaDevicePtr,bytes:u64 }
pub struct OwnedCudaStream { raw:CudaStream }
pub struct OwnedCublasHandle { raw:CublasHandle }
#[repr(C)]
pub struct Dim3 { x:u32,y:u32,z:u32 }
pub fn cuda_status(code:i32)->Result<(),GpuError> {
 if code!=CUDA_SUCCESS {return Result::Err(GpuError{domain:GPU_CUDA,code:code});}
 Result::Ok(())
}
pub fn cublas_status(code:i32)->Result<(),GpuError> {
 if code!=0 {return Result::Err(GpuError{domain:GPU_CUBLAS,code:code});}
 Result::Ok(())
}
pub fn cuda_device_count()->Result<i32,GpuError> {
 let mut count:i32=0;cuda_status(cudaGetDeviceCount(&count as *i32))?;Result::Ok(count)
}
pub fn cuda_set_device(device:i32)->Result<(),GpuError> {cuda_status(cudaSetDevice(device))}
pub fn cuda_sync()->Result<(),GpuError> {cuda_status(cudaDeviceSynchronize())}
pub fn cuda_buffer_new(bytes:u64)->Result<CudaBuffer,GpuError> {
 if bytes==0 {return Result::Err(GpuError{domain:GPU_CUDA,code:CUDA_ERROR_INVALID_VALUE});}
 let mut pointer:CudaDevicePtr=0 as CudaDevicePtr;
 cuda_status(cudaMalloc(&pointer as *CudaDevicePtr,bytes))?;
 Result::Ok(CudaBuffer{data:pointer,bytes:bytes})
}
pub fn cuda_buffer_free(buffer:*CudaBuffer)->Result<(),GpuError> {
 if buffer.data==(0 as CudaDevicePtr) {return Result::Ok(());}
 cuda_status(cudaFree(buffer.data))?;buffer.data=0 as CudaDevicePtr;buffer.bytes=0;Result::Ok(())
}
pub fn cuda_copy_to_device(buffer:*CudaBuffer,source:*u8,bytes:u64)->Result<(),GpuError> {
 if bytes>buffer.bytes || (bytes>0 && (source==(0 as *u8) || buffer.data==(0 as CudaDevicePtr))) {
  return Result::Err(GpuError{domain:GPU_CUDA,code:CUDA_ERROR_INVALID_VALUE});
 }
 if bytes==0 {return Result::Ok(());}
 cuda_status(cudaMemcpy(buffer.data,source,bytes,CUDA_MEMCPY_HOST_TO_DEVICE))
}
pub fn cuda_copy_to_host(destination:*u8,buffer:*CudaBuffer,bytes:u64)->Result<(),GpuError> {
 if bytes>buffer.bytes || (bytes>0 && (destination==(0 as *u8) || buffer.data==(0 as CudaDevicePtr))) {
  return Result::Err(GpuError{domain:GPU_CUDA,code:CUDA_ERROR_INVALID_VALUE});
 }
 if bytes==0 {return Result::Ok(());}
 cuda_status(cudaMemcpy(destination,buffer.data,bytes,CUDA_MEMCPY_DEVICE_TO_HOST))
}
pub fn cuda_stream_create()->Result<OwnedCudaStream,GpuError> {
 let mut stream:CudaStream=0 as CudaStream;
 cuda_status(cudaStreamCreate(&stream as *CudaStream))?;Result::Ok(OwnedCudaStream{raw:stream})
}
pub fn cuda_stream_destroy(stream:*OwnedCudaStream)->Result<(),GpuError> {
 if stream.raw==(0 as CudaStream) {return Result::Ok(());}
 cuda_status(cudaStreamDestroy(stream.raw))?;stream.raw=0 as CudaStream;Result::Ok(())
}
pub fn cuda_stream_sync(stream:*OwnedCudaStream)->Result<(),GpuError> {cuda_status(cudaStreamSynchronize(stream.raw))}
pub fn cublas_create()->Result<OwnedCublasHandle,GpuError> {
 let mut handle:CublasHandle=0 as CublasHandle;
 cublas_status(cublasCreate_v2(&handle as *CublasHandle))?;Result::Ok(OwnedCublasHandle{raw:handle})
}
pub fn cublas_destroy(handle:*OwnedCublasHandle)->Result<(),GpuError> {
 if handle.raw==(0 as CublasHandle) {return Result::Ok(());}
 cublas_status(cublasDestroy_v2(handle.raw))?;handle.raw=0 as CublasHandle;Result::Ok(())
}
