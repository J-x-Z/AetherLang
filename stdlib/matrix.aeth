// Matrix convenience API backed by tensor's shared storage and algorithms.
// Migration: old Matrix4x4/Vec3/Vec4 f32 routines are replaced by rank-2 f64
// Tensor handles. These aliases do not create a second allocation engine.
use result::Result;
pub use tensor::{Tensor as Matrix, tensor_free as matrix_free,
    tensor_get as matrix_get, tensor_set as matrix_set,
    tensor_matmul as matrix_mul, tensor_transpose as matrix_transpose};
use tensor::{Tensor, tensor_zeros};
pub fn matrix_zeros(rows: u64, columns: u64) -> Result<*Matrix, i32> {
    let shape: [u64; 2] = [rows, columns];
    tensor_zeros(2, &shape[0] as *u64)
}
