// Streaming CSV fields from an open binary C FILE. The caller owns the file
// and reusable field Vec. Decoded fields are NUL-terminated with len excluding NUL.
use vec::{Vec,vec_push};
extern "C"{fn fgetc(stream:*void)->i32;fn ferror(stream:*void)->i32;}
pub const CSV_EOF:i32=0;pub const CSV_MORE:i32=1;pub const CSV_END_RECORD:i32=2;
pub const CSV_SYNTAX:i32=-1;pub const CSV_IO:i32=-2;pub const CSV_MEMORY:i32=-3;
pub struct CsvReader{stream:*void,limit:u64,after_comma:bool,status:i32}
pub fn csv_reader(stream:*void,max_field_bytes:u64)->CsvReader{
    CsvReader{stream:stream,limit:max_field_bytes,after_comma:false,status:CSV_MORE}
}
fn fail(r:*CsvReader,code:i32)->i32{r.status=code;return code;}
pub fn csv_field(r:*CsvReader,field:*Vec<u8>)->i32{
    field.len=0;if r.status<=0{return r.status;}
    let mut value:i32=fgetc(r.stream);
    if value<0 && ferror(r.stream)!=0{return fail(r,CSV_IO);}
    if value<0 && !r.after_comma{return fail(r,CSV_EOF);}
    let mut quoted:bool=value==34;
    if quoted{value=fgetc(r.stream);}
    let mut status:i32=CSV_END_RECORD;
    loop{
        if value<0{
            if ferror(r.stream)!=0{return fail(r,CSV_IO);}
            if quoted{return fail(r,CSV_SYNTAX);}
            r.status=CSV_EOF;break;
        }
        if quoted && value==34{
            value=fgetc(r.stream);
            if value!=34{
                quoted=false;
                if value>=0 && value!=44 && value!=10 && value!=13{return fail(r,CSV_SYNTAX);}
                continue;
            }
        }else if !quoted{
            if value==34{return fail(r,CSV_SYNTAX);}
            if value==44{status=CSV_MORE;break;}
            if value==10{break;}
            if value==13{
                let next:i32=fgetc(r.stream);
                if next<0 && ferror(r.stream)!=0{return fail(r,CSV_IO);}
                if next!=10{return fail(r,CSV_SYNTAX);}break;
            }
        }
        if value==0{return fail(r,CSV_SYNTAX);}
        if field.len>=r.limit || !vec_push(field,value as u8){return fail(r,CSV_MEMORY);}
        value=fgetc(r.stream);
    }
    if !vec_push(field,0 as u8){return fail(r,CSV_MEMORY);}field.len-=1;
    r.after_comma=status==CSV_MORE;return status;
}
