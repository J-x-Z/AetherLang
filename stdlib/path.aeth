// POSIX byte paths. The caller owns the allocation returned by a successful join.
use fs::dir_exists;
use result::Result;
use posix::{EINVAL, ENOMEM, EEXIST, EFBIG};

extern "C" {
    fn strlen(s: *u8) -> usize;
    fn malloc(size: usize) -> *void;
    fn free(ptr: *void);
    fn memcpy(dest: *void, src: *void, size: usize) -> *void;
    fn mkdir(path: *u8, mode: u32) -> i32;
    fn access(path: *u8, mode: i32) -> i32;
    fn strerror(code: i32) -> *u8;
    fn dprintf(fd: i32, format: *u8, ...) -> i32;
}

pub fn path_join_checked(directory: *u8, name: *u8) -> Result<*u8,i32> {
    if directory == 0 as *u8 || name == 0 as *u8 { return Result::Err(EINVAL); }
    let a: usize = strlen(directory);
    let b: usize = strlen(name);
    let max: usize = (0 as usize) - (1 as usize);
    if b > max - 2 || a > max - 2 - b { return Result::Err(EFBIG); }
    let joined: *u8 = malloc(a + b + 2) as *u8;
    if joined == 0 as *u8 { return Result::Err(ENOMEM); }
    memcpy(joined as *void, directory as *void, a);
    joined[a] = 47;
    memcpy((joined + a + 1) as *void, name as *void, b + 1);
    Result::Ok(joined)
}

pub fn path_join(directory: *u8, name: *u8) -> *u8 {
    match path_join_checked(directory, name) {
        Result::Ok(p) => p,
        Result::Err(_) => 0 as *u8,
    }
}

pub fn directory_exists(path: *u8) -> bool { dir_exists(path) }

// Two writable sentinel bytes follow the final component. A slash requires
// directory lookup without opening the directory for enumeration.
fn ensure_component(copy: *u8, end: usize) -> Result<(),i32> {
    let saved: u8 = copy[end];
    copy[end] = 0;
    let created: i32 = mkdir(copy, 493);
    let code: i32 = if created != 0 { __errno_get() } else { 0 };
    copy[end] = saved;
    if created == 0 { return Result::Ok(()); }
    if code != EEXIST { return Result::Err(code); }
    let next: u8 = copy[end + 1];
    copy[end] = 47;
    copy[end + 1] = 0;
    let exists: i32 = access(copy, 0);
    let probe: i32 = if exists != 0 { __errno_get() } else { 0 };
    copy[end] = saved;
    copy[end + 1] = next;
    if exists != 0 { return Result::Err(probe); }
    Result::Ok(())
}

pub fn make_directories_result(path: *u8) -> Result<(),i32> {
    if path == 0 as *u8 || path[0] == 0 { return Result::Err(EINVAL); }
    let length: usize = strlen(path);
    let max: usize = (0 as usize) - (1 as usize);
    if length > max - 2 { return Result::Err(EFBIG); }
    let copy: *u8 = malloc(length + 2) as *u8;
    if copy == 0 as *u8 { return Result::Err(ENOMEM); }
    memcpy(copy as *void, path as *void, length + 1);
    copy[length + 1] = 0;
    let mut i: usize = 1;
    while i <= length {
        if (copy[i] == 47 || copy[i] == 0) && copy[i - 1] != 47 {
            match ensure_component(copy, i) {
                Result::Ok(_) => {},
                Result::Err(e) => {
                    free(copy as *void);
                    return Result::Err(e);
                },
            }
        }
        i += 1;
    }
    free(copy as *void);
    Result::Ok(())
}

pub fn make_directories(path: *u8) -> bool {
    match make_directories_result(path) {
        Result::Ok(_) => true,
        Result::Err(e) => {
            if path != 0 as *u8 { dprintf(2, "%s: %s\n", path, strerror(e)); }
            false
        },
    }
}
