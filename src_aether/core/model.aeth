 ty:*BootType,aux:*BootType,decl:*BootNode,left:*BootNode,right:*BootNode,
 third:*BootNode,body:*BootNode,params:*BootNode,next:*BootNode,owner:*BootModule,lookup:*BootModule,llvm_value:i32,generics:*BootNode,origin:*BootNode
}
