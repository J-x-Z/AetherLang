// Shared model of the independently loaded Core compiler modules. Source loading,
// imports, lexing, parsing, checking and C emission all run in Aether.
extern "C" {
 fn malloc(size:u64)->*void; fn free(pointer:*void);
 fn memset(pointer:*void,value:i32,size:u64)->*void;
 fn memcpy(dest:*void,source:*void,size:u64)->*void;
 fn strlen(text:*u8)->u64; fn strcmp(a:*u8,b:*u8)->i32;
 fn fopen(path:*u8,mode:*u8)->*void; fn fclose(file:*void)->i32;
 fn fread(data:*u8,size:u64,count:u64,file:*void)->u64;
 fn fwrite(data:*u8,size:u64,count:u64,file:*void)->u64;
 fn fseek(file:*void,offset:i64,whence:i32)->i32; fn ftell(file:*void)->i64;
 fn ferror(file:*void)->i32; fn remove(path:*u8)->i32;
 fn printf(format:*u8,...)->i32; fn fprintf(file:*void,format:*u8,...)->i32;
 fn fputs(text:*u8,file:*void)->i32; fn fputc(value:i32,file:*void)->i32;
}
pub const BT_EOF:i32=0; pub const BT_IDENT:i32=1; pub const BT_INT:i32=2;
pub const BT_FLOAT:i32=3; pub const BT_STRING:i32=4;
pub const BT_ARROW:i32=256; pub const BT_EQ:i32=257; pub const BT_NE:i32=258;
pub const BT_LE:i32=259; pub const BT_GE:i32=260; pub const BT_AND:i32=261;
pub const BT_OR:i32=262; pub const BT_SHL:i32=263; pub const BT_SHR:i32=264;
pub const BT_ELLIPSIS:i32=265;
// Compound assignment tokens encode their underlying binary operator.
pub const BT_ASSIGN_BASE:i32=512;
// Primitive type kinds; pointer/struct types are interned in BootContext.types.
pub const BY_VOID:i32=0; pub const BY_BOOL:i32=1; pub const BY_I8:i32=2; pub const BY_U8:i32=3;
pub const BY_I16:i32=4; pub const BY_U16:i32=5; pub const BY_I32:i32=6; pub const BY_U32:i32=7;
pub const BY_I64:i32=8; pub const BY_U64:i32=9; pub const BY_F32:i32=10; pub const BY_F64:i32=11;
pub const BY_PTR:i32=12; pub const BY_STRUCT:i32=13; pub const BY_ARRAY:i32=14; pub const BY_ALIAS:i32=15;
// Node fields by kind:
// PROGRAM: body=top-level list. STRUCT: name, body=FIELD list, ty.
// FN: name, params=PARAM list, ty=return type, body=BLOCK or null (extern).
// BLOCK: body=statement list. LET: name,ty annotation,left=initializer.
// IF: left=condition,body=then BLOCK,third=else BLOCK/IF. WHILE: left,body.
// RETURN/EXPR: left=expression. ASSIGN: left=place,right=value (statement only).
// CALL: name,params=argument list,decl=FN after resolution.
// BINARY: op=token kind,left,right. UNARY: op=ASCII - ! ~ * &,left.
// FIELD: left=base,name,decl=FIELD after resolution. INDEX: left=base,right=index.
// CAST: left=expr,ty=destination. SIZEOF: aux=queried type, ty=i64 after checking.
// INT/FLOAT/STRING/IDENT/BOOL: token/text (BOOL.value=0/1), IDENT.decl=binding.
// Struct literals and implicit coercions are intentionally outside Core v1.
pub const BN_PROGRAM:i32=1; pub const BN_STRUCT:i32=2; pub const BN_FIELD:i32=3;
pub const BN_FN:i32=4; pub const BN_PARAM:i32=5; pub const BN_BLOCK:i32=6;
pub const BN_LET:i32=7; pub const BN_IF:i32=8; pub const BN_WHILE:i32=9;
pub const BN_RETURN:i32=10; pub const BN_BREAK:i32=11; pub const BN_CONTINUE:i32=12;
pub const BN_EXPR:i32=13; pub const BN_ASSIGN:i32=14; pub const BN_CALL:i32=15;
pub const BN_BINARY:i32=16; pub const BN_UNARY:i32=17; pub const BN_MEMBER:i32=18;
pub const BN_INDEX:i32=19; pub const BN_CAST:i32=20; pub const BN_SIZEOF:i32=21;
pub const BN_INT:i32=22; pub const BN_FLOAT:i32=23; pub const BN_STRING:i32=24;
pub const BN_IDENT:i32=25; pub const BN_BOOL:i32=26; pub const BN_CONST:i32=27;
pub const BN_STRUCT_VALUE:i32=28; pub const BN_ARRAY:i32=29; pub const BN_REPEAT:i32=30; pub const BN_ALIAS:i32=31;
pub const BN_VALUE:i32=32; pub const BN_YIELD:i32=33; pub const BN_ALIGNOF:i32=34; pub const BN_UNIT:i32=35;
// flags: bit 0 mutable binding, bit 1 foreign function, bit 2 variadic, bit 3 public declaration.
pub struct BootArena { next:*BootArena, reserved:u64 }
pub struct BootToken { kind:i32,text:*u8,length:u64,line:i32,column:i32,path:*u8,next:*BootToken }
pub struct BootType { kind:i32,id:i32,name:*u8,inner:*BootType,fields:*BootNode,next:*BootType,complete:bool,emitted:i32,owner:*BootModule,extent:u64,layout_size:u64,layout_align:u64 }
pub struct BootNode {
 kind:i32,id:i32,op:i32,flags:i32,tree_depth:i32,value:i64,name:*u8,token:*BootToken,
 ty:*BootType,aux:*BootType,decl:*BootNode,left:*BootNode,right:*BootNode,
 third:*BootNode,body:*BootNode,params:*BootNode,next:*BootNode,owner:*BootModule,lookup:*BootModule,llvm_value:i32
}
pub struct BootBinding { name:*u8,node:*BootNode,depth:i32,next:*BootBinding }
pub struct BootContext {
 arena:*BootArena,allocated:u64,source:*u8,length:u64,path:*u8,
 tokens:*BootToken,cursor:*BootToken,types:*BootType,program:*BootNode,
 failed:bool,next_id:i32,depth:i32,bindings:*BootBinding,
 function:*BootNode,loop_depth:i32,output:*void,c_namespace:i32,
 module:*BootModule,root_module:*BootModule,modules:*BootModule,modules_tail:*BootModule,
 module_count:i32,source_total:u64,roots:*BootRoot,mapped:*BootMappedModule,
 llvm_serial:i32,llvm_block:i32,llvm_break:i32,llvm_continue:i32,llvm_terminated:bool,parse_condition:bool,
 value_type:*BootType,value_target:*BootNode,llvm_yield:i32
}

pub struct BootImport { alias:*u8,symbol:*u8,target:*BootModule,wildcard:bool,token:*BootToken,next:*BootImport }
pub struct BootModule { id:i32,path:*u8,directory:*u8,source:*u8,length:u64,tokens:*BootToken,items:*BootNode,imports:*BootImport,state:i32,next:*BootModule }
pub struct BootRoot { path:*u8,next:*BootRoot }

pub struct BootMappedModule { name:*u8, path:*u8, next:*BootMappedModule }
