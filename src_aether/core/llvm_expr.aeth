use model::*;
use runtime::*;
use llvm_common::*;
pub fn ll_place(ctx:*BootContext,node:*BootNode)->i32{
 let id:i32=ll_id(ctx);
 if node.kind==BN_IDENT{ll_begin(ctx,id);fprintf(ctx.output,"getelementptr i8, ptr %%v%d, i64 0\n",node.decl.id);return id;}
 if node.kind==BN_UNARY&&node.op==42{return ll_expr(ctx,node.left);}
 if node.kind==BN_MEMBER{
  let mut base:i32=0;let mut ty:*BootType=node.left.ty;
  if ty.kind==BY_PTR{base=ll_expr(ctx,node.left);ty=ty.inner;}else{base=ll_place(ctx,node.left);}
  ll_begin(ctx,id);ll_text(ctx,"getelementptr ");ll_type(ctx,ty);
  fprintf(ctx.output,", ptr %%r%d, i32 0, i32 %d\n",base,ll_field_index(ty,node.decl));return id;
 }
 if node.kind==BN_INDEX{
  let mut pointer:i32=0;
  if node.left.ty.kind==BY_ARRAY{pointer=ll_place(ctx,node.left);}else{pointer=ll_expr(ctx,node.left);}
  let index:i32=ll_expr(ctx,node.right);let wide:i32=ll_cast(ctx,index,node.right.ty,boot_type(ctx,BY_I64));
  if node.left.ty.kind==BY_ARRAY{ll_array_bound(ctx,wide,node.left.ty.extent);}
  ll_begin(ctx,id);ll_text(ctx,"getelementptr ");
  if node.left.ty.kind==BY_ARRAY{ll_type(ctx,node.left.ty);fprintf(ctx.output,", ptr %%r%d, i64 0, i64 %%r%d\n",pointer,wide);}
  else{ll_type(ctx,node.ty);fprintf(ctx.output,", ptr %%r%d, i64 %%r%d\n",pointer,wide);}return id;
 }

 boot_error(ctx,node.token,"LLVM expression has no address");return 0;
}
pub fn ll_expr(ctx:*BootContext,node:*BootNode)->i32{
 if ctx.failed||node==(0 as *BootNode){return 0;}
 let value:i32=ll_expr_inner(ctx,node);node.llvm_value=value;return value;
}
fn ll_literal_expr(ctx:*BootContext,node:*BootNode)->i32{
 let id:i32=ll_id(ctx);ll_begin(ctx,id);ll_text(ctx,"select i1 true, ");ll_type(ctx,node.ty);ll_text(ctx," ");ll_literal(ctx,node,node.ty);
 ll_text(ctx,", ");ll_type(ctx,node.ty);ll_text(ctx," ");ll_literal(ctx,node,node.ty);ll_text(ctx,"\n");return id;
}
fn ll_expr_inner(ctx:*BootContext,node:*BootNode)->i32{
 if node.kind==BN_UNIT{return ll_unit(ctx);}
 if node.kind==BN_INT||node.kind==BN_FLOAT||node.kind==BN_BOOL{return ll_literal_expr(ctx,node);}
 let id:i32=ll_id(ctx);
 if node.kind==BN_STRING{ll_begin(ctx,id);fprintf(ctx.output,"getelementptr [%llu x i8], ptr @a%d_str%d, i64 0, i64 0\n",node.token.length+1,ctx.c_namespace,node.id);return id;}
 if node.kind==BN_IDENT{
  if node.decl.kind==BN_CONST{ll_begin(ctx,id);ll_text(ctx,"load ");ll_type(ctx,node.ty);fprintf(ctx.output,", ptr @a%d_c%d\n",ctx.c_namespace,node.decl.id);return id;}
  return ll_load(ctx,node.ty,ll_place(ctx,node));
 }
 if node.kind==BN_ARRAY||node.kind==BN_REPEAT{return ll_array_value(ctx,node);}
 if node.kind==BN_INDEX&&node.left.ty.kind==BY_ARRAY&&!boot_place_form(node.left){
  let value:i32=ll_expr(ctx,node.left);ll_text(ctx,"  store ");ll_value(ctx,node.left.ty,value);fprintf(ctx.output,", ptr %%arr%d\n",node.id);
  let index:i32=ll_expr(ctx,node.right);let wide:i32=ll_cast(ctx,index,node.right.ty,boot_type(ctx,BY_I64));ll_array_bound(ctx,wide,node.left.ty.extent);
  ll_begin(ctx,id);ll_text(ctx,"getelementptr ");ll_type(ctx,node.left.ty);fprintf(ctx.output,", ptr %%arr%d, i64 0, i64 %%r%d\n",node.id,wide);return ll_load(ctx,node.ty,id);
 }
 if node.kind==BN_STRUCT_VALUE{
  let mut field:*BootNode=node.params;let mut value:i32=0;
  if field==(0 as *BootNode){ll_begin(ctx,id);ll_text(ctx,"select i1 true, ");ll_type(ctx,node.ty);ll_text(ctx," zeroinitializer, ");ll_type(ctx,node.ty);ll_text(ctx," zeroinitializer\n");return id;}
  while field!=(0 as *BootNode){
   let element:i32=ll_expr(ctx,field.left);let next:i32=ll_id(ctx);ll_begin(ctx,next);ll_text(ctx,"insertvalue ");ll_type(ctx,node.ty);ll_text(ctx," ");
   if value==0{ll_text(ctx,"poison");}else{ll_reg(ctx,value);}ll_text(ctx,", ");ll_value(ctx,field.ty,element);fprintf(ctx.output,", %d\n",ll_field_index(node.ty,field.decl));value=next;field=field.next;
  }return value;
 }
 if node.kind==BN_ERRNO {
  let location:i32=ll_id(ctx);ll_begin(ctx,location);fprintf(ctx.output,"call ptr @%s()\n",ctx.errno_name);
  ll_begin(ctx,id);fprintf(ctx.output,"load i32, ptr %%r%d\n",location);return id;
 }
 if node.kind==BN_ALIGNOF{ll_begin(ctx,id);fprintf(ctx.output,"add i64 0, %llu\n",node.aux.layout_align);return id;}
 if node.kind==BN_VALUE{
  let saved:*BootNode=ctx.value_target;let saved_yield:i32=ctx.llvm_yield;
  ctx.value_target=node;ctx.llvm_yield=ll_id(ctx);let finish:i32=ctx.llvm_yield;ll_statement(ctx,node.body);
  if !ctx.llvm_terminated{if node.ty.kind==BY_VOID{ll_jump(ctx,finish);}else{ll_text(ctx,"  unreachable\n");}}ll_label(ctx,finish);
  ctx.value_target=saved;ctx.llvm_yield=saved_yield;if node.ty.kind==BY_VOID{return ll_unit(ctx);}
  ll_begin(ctx,id);ll_text(ctx,"load ");ll_type(ctx,node.ty);fprintf(ctx.output,", ptr %%yield%d\n",node.id);return id;
 }
 if node.kind==BN_SIZEOF{
  let address:i32=ll_id(ctx);ll_begin(ctx,address);ll_text(ctx,"getelementptr ");ll_type(ctx,node.aux);ll_text(ctx,", ptr null, i64 1\n");
  ll_begin(ctx,id);fprintf(ctx.output,"ptrtoint ptr %%r%d to i64\n",address);return id;
 }
 if node.kind==BN_MEMBER&&node.left.ty.kind==BY_STRUCT{
  let value:i32=ll_expr(ctx,node.left);ll_begin(ctx,id);ll_text(ctx,"extractvalue ");ll_value(ctx,node.left.ty,value);fprintf(ctx.output,", %d\n",ll_field_index(node.left.ty,node.decl));return id;
 }
 if node.kind==BN_MEMBER||node.kind==BN_INDEX||(node.kind==BN_UNARY&&node.op==42){return ll_load(ctx,node.ty,ll_place(ctx,node));}
 if node.kind==BN_UNARY&&node.op==38{return ll_place(ctx,node.left);}
 if node.kind==BN_UNARY{
  let value:i32=ll_expr(ctx,node.left);ll_begin(ctx,id);
  if node.op==45{
   if ll_float(node.ty){ll_text(ctx,"fneg ");ll_value(ctx,node.ty,value);}
   else{ll_text(ctx,"sub ");ll_type(ctx,node.ty);fprintf(ctx.output," 0, %%r%d",value);}
  }else{ll_text(ctx,"xor ");ll_value(ctx,node.ty,value);if node.op==33{ll_text(ctx,", true");}else{ll_text(ctx,", -1");}}
  ll_text(ctx,"\n");return id;
 }
 if node.kind==BN_CAST{return ll_cast(ctx,ll_expr(ctx,node.left),node.left.ty,node.ty);}
 if node.kind==BN_CALL{return ll_call(ctx,node);}
 if node.kind==BN_BINARY{return ll_binary(ctx,node);}
 boot_error(ctx,node.token,"unsupported LLVM expression");return 0;
}
fn ll_call(ctx:*BootContext,node:*BootNode)->i32{
 let mut arg:*BootNode=node.params;let mut param:*BootNode=node.decl.params;
 while arg!=(0 as *BootNode){
  let value:i32=ll_expr(ctx,arg);
  if param==(0 as *BootNode){
   if arg.ty.kind==BY_F32{arg.llvm_value=ll_cast(ctx,value,arg.ty,boot_type(ctx,BY_F64));}
   else{if arg.ty.kind!=BY_PTR&&!ll_float(arg.ty)&&ll_bits(arg.ty)<32{arg.llvm_value=ll_cast(ctx,value,arg.ty,boot_type(ctx,BY_I32));}}
  }else{param=param.next;}arg=arg.next;
 }
 let id:i32=ll_id(ctx);
 if node.ty.kind!=BY_VOID{ll_begin(ctx,id);}else{ll_text(ctx,"  ");}
 ll_text(ctx,"call ");if (node.decl.flags&2)!=0{ll_attr(ctx,node.ty);}ll_return_type(ctx,node.ty);ll_text(ctx," ");
 if (node.decl.flags&4)!=0{
  ll_text(ctx,"(");param=node.decl.params;while param!=(0 as *BootNode){ll_type(ctx,param.ty);ll_text(ctx,", ");param=param.next;}ll_text(ctx,"...) ");
 }
 ll_function(ctx,node.decl);ll_text(ctx,"(");arg=node.params;param=node.decl.params;
 while arg!=(0 as *BootNode){
  let mut ty:*BootType=arg.ty;
  if param==(0 as *BootNode){
   if ty.kind==BY_F32{ty=boot_type(ctx,BY_F64);}else{if ty.kind!=BY_PTR&&!ll_float(ty)&&ll_bits(ty)<32{ty=boot_type(ctx,BY_I32);}}
  }
  ll_type(ctx,ty);ll_text(ctx," ");if param!=(0 as *BootNode)&&(node.decl.flags&2)!=0{ll_attr(ctx,ty);}ll_reg(ctx,arg.llvm_value);
  if param!=(0 as *BootNode){param=param.next;}arg=arg.next;if arg!=(0 as *BootNode){ll_text(ctx,", ");}
 }
 ll_text(ctx,")\n");if node.ty.kind==BY_VOID{return ll_unit(ctx);}return id;
}
fn ll_division_guard(ctx:*BootContext,ty:*BootType,a:i32,b:i32){
 let zero:i32=ll_id(ctx);ll_begin(ctx,zero);ll_text(ctx,"icmp eq ");ll_value(ctx,ty,b);ll_text(ctx,", 0\n");
 let mut invalid:i32=zero;
 if ll_signed(ty){
  let minimum:i32=ll_id(ctx);ll_begin(ctx,minimum);ll_text(ctx,"icmp eq ");ll_value(ctx,ty,a);ll_text(ctx,", ");ll_integer(ctx,((1 as u64)<<((ll_bits(ty)-1) as u64)) as i64,ty);ll_text(ctx,"\n");
  let minus:i32=ll_id(ctx);ll_begin(ctx,minus);ll_text(ctx,"icmp eq ");ll_value(ctx,ty,b);ll_text(ctx,", -1\n");
  let overflow:i32=ll_id(ctx);ll_begin(ctx,overflow);fprintf(ctx.output,"and i1 %%r%d, %%r%d\n",minimum,minus);
  invalid=ll_id(ctx);ll_begin(ctx,invalid);fprintf(ctx.output,"or i1 %%r%d, %%r%d\n",zero,overflow);
 }
 let fail:i32=ll_id(ctx);let next:i32=ll_id(ctx);ll_branch(ctx,invalid,fail,next);ll_label(ctx,fail);
 ll_text(ctx,"  call void @llvm.trap()\n  unreachable\n");ll_label(ctx,next);
}
fn ll_binary(ctx:*BootContext,node:*BootNode)->i32{
 let a:i32=ll_expr(ctx,node.left);let op:i32=node.op;let ty:*BootType=node.left.ty;
 let id:i32=ll_id(ctx);
 if op==BT_AND||op==BT_OR{
  let before:i32=ctx.llvm_block;let evaluate:i32=ll_id(ctx);let merge:i32=ll_id(ctx);
  if op==BT_AND{ll_branch(ctx,a,evaluate,merge);}else{ll_branch(ctx,a,merge,evaluate);}
  ll_label(ctx,evaluate);let right:i32=ll_expr(ctx,node.right);let after:i32=ctx.llvm_block;ll_jump(ctx,merge);ll_label(ctx,merge);
  ll_begin(ctx,id);fprintf(ctx.output,"phi i1 [ %%r%d, %%b%d ], [ %%r%d, %%b%d ]\n",a,before,right,after);return id;
 }
 let b:i32=ll_expr(ctx,node.right);return ll_binary_values(ctx,node,a,b);
}
pub fn ll_binary_values(ctx:*BootContext,node:*BootNode,a:i32,right:i32)->i32{
 let op:i32=node.op;let ty:*BootType=node.left.ty;let id:i32=ll_id(ctx);let mut b:i32=right;
 if ty.kind==BY_PTR&&(op==43||op==45){
  b=ll_cast(ctx,b,node.right.ty,boot_type(ctx,BY_I64));
  if op==45{let negative:i32=ll_id(ctx);ll_begin(ctx,negative);fprintf(ctx.output,"sub i64 0, %%r%d\n",b);b=negative;}
  ll_begin(ctx,id);ll_text(ctx,"getelementptr ");ll_type(ctx,ty.inner);fprintf(ctx.output,", ptr %%r%d, i64 %%r%d\n",a,b);return id;
 }
 let float:bool=ll_float(ty);let signed:bool=ll_signed(ty);
 if !float&&(op==47||op==37){ll_division_guard(ctx,ty,a,b);}
 if op==BT_SHL||op==BT_SHR{
  let masked:i32=ll_id(ctx);ll_begin(ctx,masked);ll_text(ctx,"and ");ll_value(ctx,ty,b);fprintf(ctx.output,", %d\n",ll_bits(ty)-1);b=masked;
 }
 let mut operation:*u8=0 as *u8;
 if op==BT_EQ{if float{operation="fcmp oeq";}else{operation="icmp eq";}}
 if op==BT_NE{if float{operation="fcmp une";}else{operation="icmp ne";}}
 if op==60{if float{operation="fcmp olt";}else{if signed{operation="icmp slt";}else{operation="icmp ult";}}}
 if op==62{if float{operation="fcmp ogt";}else{if signed{operation="icmp sgt";}else{operation="icmp ugt";}}}
 if op==BT_LE{if float{operation="fcmp ole";}else{if signed{operation="icmp sle";}else{operation="icmp ule";}}}
 if op==BT_GE{if float{operation="fcmp oge";}else{if signed{operation="icmp sge";}else{operation="icmp uge";}}}
 if op==43{if float{operation="fadd";}else{operation="add";}}
 if op==45{if float{operation="fsub";}else{operation="sub";}}
 if op==42{if float{operation="fmul";}else{operation="mul";}}
 if op==47{if float{operation="fdiv";}else{if signed{operation="sdiv";}else{operation="udiv";}}}
 if op==37{if signed{operation="srem";}else{operation="urem";}}
 if op==38{operation="and";}if op==124{operation="or";}if op==94{operation="xor";}
 if op==BT_SHL{operation="shl";}if op==BT_SHR{if signed{operation="ashr";}else{operation="lshr";}}
 if operation==(0 as *u8){boot_error(ctx,node.token,"unsupported LLVM binary operation");return 0;}
 ll_begin(ctx,id);fprintf(ctx.output,"%s ",operation);ll_value(ctx,ty,a);fprintf(ctx.output,", %%r%d\n",b);return id;
}

fn ll_array_bound(ctx:*BootContext,index:i32,count:u64){
 let valid:i32=ll_id(ctx);ll_begin(ctx,valid);fprintf(ctx.output,"icmp ult i64 %%r%d, %llu\n",index,count);
 let next:i32=ll_id(ctx);let fail:i32=ll_id(ctx);ll_branch(ctx,valid,next,fail);ll_label(ctx,fail);ll_text(ctx,"  call void @llvm.trap()\n  unreachable\n");ll_label(ctx,next);
}
fn ll_array_value(ctx:*BootContext,node:*BootNode)->i32{
 if node.kind==BN_REPEAT{
  let value:i32=ll_expr(ctx,node.left);let before:i32=ctx.llvm_block;
  let header:i32=ll_id(ctx);let body:i32=ll_id(ctx);let finish:i32=ll_id(ctx);let index:i32=ll_id(ctx);let advanced:i32=ll_id(ctx);
  ll_jump(ctx,header);ll_label(ctx,header);ll_begin(ctx,index);fprintf(ctx.output,"phi i64 [ 0, %%b%d ], [ %%r%d, %%b%d ]\n",before,advanced,body);
  let valid:i32=ll_id(ctx);ll_begin(ctx,valid);fprintf(ctx.output,"icmp ult i64 %%r%d, %llu\n",index,node.ty.extent);ll_branch(ctx,valid,body,finish);ll_label(ctx,body);
  let place:i32=ll_id(ctx);ll_begin(ctx,place);ll_text(ctx,"getelementptr ");ll_type(ctx,node.ty);fprintf(ctx.output,", ptr %%arr%d, i64 0, i64 %%r%d\n",node.id,index);
  ll_store(ctx,node.ty.inner,value,place);ll_begin(ctx,advanced);fprintf(ctx.output,"add i64 %%r%d, 1\n",index);ll_jump(ctx,header);ll_label(ctx,finish);
 }else{
  let mut item:*BootNode=node.params;let mut index:u64=0;
  while item!=(0 as *BootNode){
   let value:i32=ll_expr(ctx,item);let place:i32=ll_id(ctx);ll_begin(ctx,place);ll_text(ctx,"getelementptr ");ll_type(ctx,node.ty);fprintf(ctx.output,", ptr %%arr%d, i64 0, i64 %llu\n",node.id,index);
   ll_store(ctx,node.ty.inner,value,place);index=index+1;item=item.next;
  }
 }
 let result:i32=ll_id(ctx);ll_begin(ctx,result);ll_text(ctx,"load ");ll_type(ctx,node.ty);fprintf(ctx.output,", ptr %%arr%d\n",node.id);return result;
}

// Statements and expressions recurse through value blocks in one emission module.
pub fn ll_statement(ctx:*BootContext,node:*BootNode){
 if ctx.failed||node==(0 as *BootNode)||ctx.llvm_terminated{return;}
 if node.kind==BN_BLOCK{let mut item:*BootNode=node.body;while item!=(0 as *BootNode)&&!ctx.llvm_terminated{ll_statement(ctx,item);item=item.next;}return;}
 if node.kind==BN_LET{
  let value:i32=ll_expr(ctx,node.left);ll_text(ctx,"  store ");ll_value(ctx,node.ty,value);fprintf(ctx.output,", ptr %%v%d\n",node.id);return;
 }
 if node.kind==BN_ASSIGN{
  let place:i32=ll_place(ctx,node.left);let mut previous:i32=0;if node.op!=0{previous=ll_load(ctx,node.left.ty,place);}
  let mut value:i32=ll_expr(ctx,node.right);if node.op!=0{value=ll_binary_values(ctx,node,previous,value);}
  ll_store(ctx,node.left.ty,value,place);return;
 }
 if node.kind==BN_YIELD{
  let value:i32=ll_expr(ctx,node.left);if node.left.ty.kind!=BY_VOID{ll_text(ctx,"  store ");ll_value(ctx,node.left.ty,value);fprintf(ctx.output,", ptr %%yield%d\n",ctx.value_target.id);}ll_jump(ctx,ctx.llvm_yield);return;
 }
 if node.kind==BN_EXPR{ll_expr(ctx,node.left);return;}
 if node.kind==BN_RETURN{
  if node.left==(0 as *BootNode){ll_text(ctx,"  ret void\n");}else{let value:i32=ll_expr(ctx,node.left);if node.left.ty.kind==BY_VOID{ll_text(ctx,"  ret void\n");}else{ll_text(ctx,"  ret ");ll_value(ctx,node.left.ty,value);ll_text(ctx,"\n");}}
  ctx.llvm_terminated=true;return;
 }
 if node.kind==BN_IF{
  let condition:i32=ll_expr(ctx,node.left);let yes:i32=ll_id(ctx);let no:i32=ll_id(ctx);let merge:i32=ll_id(ctx);
  ll_branch(ctx,condition,yes,no);ll_label(ctx,yes);ll_statement(ctx,node.body);if !ctx.llvm_terminated{ll_jump(ctx,merge);}
  ll_label(ctx,no);ll_statement(ctx,node.third);if !ctx.llvm_terminated{ll_jump(ctx,merge);}ll_label(ctx,merge);return;
 }
 if node.kind==BN_WHILE{
  let condition_label:i32=ll_id(ctx);let body:i32=ll_id(ctx);let finish:i32=ll_id(ctx);
  let old_break:i32=ctx.llvm_break;let old_continue:i32=ctx.llvm_continue;ctx.llvm_break=finish;ctx.llvm_continue=condition_label;
  ll_jump(ctx,condition_label);ll_label(ctx,condition_label);let condition:i32=ll_expr(ctx,node.left);ll_branch(ctx,condition,body,finish);
  ll_label(ctx,body);ll_statement(ctx,node.body);if !ctx.llvm_terminated{ll_jump(ctx,condition_label);}ll_label(ctx,finish);
  ctx.llvm_break=old_break;ctx.llvm_continue=old_continue;return;
 }
 if node.kind==BN_BREAK{ll_jump(ctx,ctx.llvm_break);return;}
 if node.kind==BN_CONTINUE{ll_jump(ctx,ctx.llvm_continue);return;}
 boot_error(ctx,node.token,"unsupported LLVM statement");
}
