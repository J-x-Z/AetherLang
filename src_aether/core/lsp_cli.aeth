// Structured CLI diagnostics and workspace symbols share the LSP's source facts.
use model::*;use runtime::*;use lsp_model::*;use lsp_buffer::*;use lsp_index::*;use lsp_analysis::*;
fn lc_location(out:*LspBuffer,ctx:*BootContext,token:*BootToken){
 if token==0 as *BootToken{ls_text(out,"null");return;}let span:LspSourceSpan=ls_source_span(ctx,token);let range:LspRange=span.range;
 ls_text(out,"{\"file\":");ls_cstring(out,token.path);ls_text(out,",\"start\":");ls_number(out,span.start as i64);ls_text(out,",\"end\":");ls_number(out,span.end as i64);
 ls_text(out,",\"line\":");ls_number(out,token.line as i64);ls_text(out,",\"column\":");ls_number(out,span.scalar_column as i64);ls_text(out,",\"end_line\":");ls_number(out,(range.end_line+1) as i64);ls_text(out,",\"end_column\":");ls_number(out,span.end_scalar_column as i64);ls_text(out,",\"utf16_column\":");ls_number(out,range.column as i64);ls_text(out,",\"end_utf16_column\":");ls_number(out,range.end_column as i64);ls_char(out,125);
}
pub fn boot_json_diagnostic(ctx:*BootContext)->bool{
 let out:*LspBuffer=ls_buffer_new();if out==0 as *LspBuffer{return false;}ls_text(out,"{\"code\":\"CORE\",\"severity\":\"error\",\"message\":");let mut message:*u8=ctx.diagnostic_message;if message==0 as *u8{message="compiler failed";}ls_cstring(out,message);ls_text(out,",\"location\":");lc_location(out,ctx,ctx.diagnostic_token);ls_text(out,"}\n");let ok:bool=!out.failed&&ls_write_all(2,out.data,out.length);ls_buffer_free(out);return ok;
}
fn lc_kind(node:*BootNode)->*u8{if node.kind==BN_FN{return "function";}if node.kind==BN_STRUCT{return "struct";}if node.kind==BN_ENUM{return "enum";}if node.kind==BN_VARIANT{return "variant";}if node.kind==BN_FIELD{return "field";}if node.kind==BN_PARAM{return "parameter";}if node.kind==BN_CONST{return "constant";}if node.kind==BN_STATIC{return "static";}if node.kind==BN_ALIAS{return "type";}return "variable";}
fn lc_find(first:*LspSymbol,decl:*BootNode)->*LspSymbol{let mut item:*LspSymbol=first;while item!=0 as *LspSymbol{if ls_same_symbol(item.decl,decl){return item;}item=item.next;}return 0 as *LspSymbol;}
pub fn boot_symbols(ctx:*BootContext)->bool{
 let arena:*BootContext=boot_context_new(0 as *u8,0,"symbols");if arena==0 as *BootContext{return false;}arena.quiet=true;
 let index:*LspIndex=ls_index(arena,ctx);let out:*LspBuffer=ls_buffer_new();if arena.failed||out==0 as *LspBuffer{boot_context_free(arena);ls_buffer_free(out);return false;}
 let mut symbols:*LspSymbol=0 as *LspSymbol;let mut entry:*LspOccurrence=index.first;let mut count:i64=0;
 while entry!=0 as *LspOccurrence&&!arena.failed{
  if lc_find(symbols,entry.decl)==0 as *LspSymbol{let symbol:*LspSymbol=boot_alloc(arena,(size_of(LspSymbol) as u64)) as *LspSymbol;if !arena.failed{symbol.id=count;count=count+1;symbol.decl=entry.decl;symbol.token=ls_name_token(entry.decl);symbol.next=symbols;symbols=symbol;}}
  entry=entry.next;
 }
 ls_text(out,"{\"symbols\":[");let mut symbol:*LspSymbol=symbols;let mut first:bool=true;
 while symbol!=0 as *LspSymbol{
  if symbol.token!=0 as *BootToken{if !first{ls_char(out,44);}first=false;ls_text(out,"{\"id\":");ls_number(out,symbol.id);ls_text(out,",\"name\":");ls_string(out,symbol.token.text,symbol.token.length);ls_text(out,",\"kind\":");ls_cstring(out,lc_kind(symbol.decl));ls_text(out,",\"type_name\":");let signature:*LspBuffer=ls_buffer_new();if signature==0 as *LspBuffer{out.failed=true;}else{ls_signature(signature,symbol.decl);ls_string(out,signature.data,signature.length);ls_buffer_free(signature);}ls_text(out,",\"definition\":");lc_location(out,ctx,symbol.token);ls_char(out,125);}symbol=symbol.next;
 }
 ls_text(out,"],\"references\":[");entry=index.first;first=true;
 while entry!=0 as *LspOccurrence{if !entry.definition{let target:*LspSymbol=lc_find(symbols,entry.decl);if target!=0 as *LspSymbol{if !first{ls_char(out,44);}first=false;ls_text(out,"{\"symbol\":");ls_number(out,target.id);ls_text(out,",\"location\":");lc_location(out,ctx,entry.token);ls_char(out,125);}}entry=entry.next;}
 ls_text(out,"]}\n");let ok:bool=!arena.failed&&!out.failed&&ls_write_all(1,out.data,out.length);ls_buffer_free(out);boot_context_free(arena);return ok;
}

// Plain CLI diagnostics share the captured source location with JSON/LSP, but
// never contaminate generated output or commands that are piped to another tool.
pub fn boot_plain_diagnostic(ctx:*BootContext)->bool{
 let out:*LspBuffer=ls_buffer_new();if out==0 as *LspBuffer{return false;}
 let token:*BootToken=ctx.diagnostic_token;let mut path:*u8=ctx.path;let mut line:i32=1;let mut column:i32=1;
 if token!=0 as *BootToken{let span:LspSourceSpan=ls_source_span(ctx,token);line=token.line;column=span.scalar_column;if token.path!=0 as *u8{path=token.path;}}
 ls_text(out,path);ls_char(out,58);ls_number(out,line as i64);ls_char(out,58);ls_number(out,column as i64);ls_text(out,": ");
 ls_text(out,ctx.diagnostic_message);ls_char(out,10);let ok:bool=!out.failed&&ls_write_all(2,out.data,out.length);ls_buffer_free(out);return ok;
}
