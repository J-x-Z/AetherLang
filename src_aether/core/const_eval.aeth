use model::*;
use runtime::*;
// Canonical typed constants are shared by array dimensions, generic arguments
// and ordinary const declarations. Every arithmetic operation is checked.
pub fn ce_integer(ty:*BootType)->bool{return ty!=0 as *BootType&&ty.kind>=BY_I8&&ty.kind<=BY_U64;}
fn ce_signed(ty:*BootType)->bool{return ce_integer(ty)&&(ty.kind&1)==0;}
fn ce_bits(ty:*BootType)->u64{if ty.kind<=BY_U8{return 8;}if ty.kind<=BY_U16{return 16;}if ty.kind<=BY_U32{return 32;}return 64;}
fn ce_mask(ty:*BootType)->u64{let width:u64=ce_bits(ty);if width==64{return 18446744073709551615;}return ((1 as u64)<<width)-1;}
fn ce_i64(value:u64,ty:*BootType)->i64{let shift:u64=64-ce_bits(ty);return ((value<<shift) as i64)>>(shift as i64);}
pub fn ce_value(ctx:*BootContext,ty:*BootType,value:u64)->*BootType{
 let mut old:*BootType=ctx.types;
 while old!=0 as *BootType{if old.kind==BY_CONST_VALUE&&old.inner==ty&&old.extent==value{return old;}old=old.next;}
 let item:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;if item==0 as *BootType{return item;}
 item.kind=BY_CONST_VALUE;item.inner=ty;item.extent=value;item.id=boot_id(ctx);item.complete=true;item.next=ctx.types;ctx.types=item;return item;
}
pub fn ce_expression(ctx:*BootContext,node:*BootNode)->*BootType{
 let ty:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;if ty==0 as *BootType{return ty;}
 ty.kind=BY_CONST_EXPR;ty.expression=node;ty.id=boot_id(ctx);ty.next=ctx.types;ctx.types=ty;return ty;
}
pub fn ce_binding(formal:*BootType,bindings:*BootTypeBinding)->*BootType{
 let mut item:*BootTypeBinding=bindings;while item!=0 as *BootTypeBinding{if item.formal==formal{if item.actual!=0 as *BootType&&item.actual.kind==BY_CONST_VALUE{return item.actual;}return 0 as *BootType;}item=item.next;}return 0 as *BootType;
}
fn ce_error(ctx:*BootContext,node:*BootNode,text:*u8)->*BootType{boot_error(ctx,node.token,text);return 0 as *BootType;}
extern "C" {fn strtod(text:*u8,end:**u8)->f64;}
pub fn ce_float(ty:*BootType)->bool{return ty!=0 as *BootType&&(ty.kind==BY_F32||ty.kind==BY_F64);}
pub fn ce_decode_float(bits:u64)->f64{
 let mut number:f64=0.0;memcpy(&mut number as *f64 as *void,&bits as *u64 as *void,8);return number;
}
fn ce_float_value(ctx:*BootContext,node:*BootNode,ty:*BootType,value:f64)->*BootType{
 let mut rounded:f64=value;if ty.kind==BY_F32{rounded=(value as f32) as f64;}
 if rounded-rounded!=0.0{return ce_error(ctx,node,"non-finite floating-point constant");}
 let mut bits:u64=0;memcpy(&mut bits as *u64 as *void,&rounded as *f64 as *void,8);
 return ce_value(ctx,ty,bits);
}
fn ce_float_to_int(value:f64,ty:*BootType)->u64{
 if ty.kind==BY_I8{return (value as i8) as u64;}
 if ty.kind==BY_I16{return (value as i16) as u64;}
 if ty.kind==BY_I32{return (value as i32) as u64;}
 if ty.kind==BY_I64{return (value as i64) as u64;}
 if ty.kind==BY_U8{return (value as u8) as u64;}
 if ty.kind==BY_U16{return (value as u16) as u64;}
 if ty.kind==BY_U32{return (value as u32) as u64;}
 return value as u64;
}
fn ce_float_binary(ctx:*BootContext,node:*BootNode,ty:*BootType,a:f64,b:f64)->*BootType{
 let op:i32=node.op;let boolean:*BootType=boot_type(ctx,BY_BOOL);
 if op==60{return ce_value(ctx,boolean,(a<b) as u64);}
 if op==62{return ce_value(ctx,boolean,(a>b) as u64);}
 if op==BT_EQ{return ce_value(ctx,boolean,(a==b) as u64);}
 if op==BT_NE{return ce_value(ctx,boolean,(a!=b) as u64);}
 if op==BT_LE{return ce_value(ctx,boolean,(a<=b) as u64);}
 if op==BT_GE{return ce_value(ctx,boolean,(a>=b) as u64);}
 if op==43{return ce_float_value(ctx,node,ty,a+b);}
 if op==45{return ce_float_value(ctx,node,ty,a-b);}
 if op==42{return ce_float_value(ctx,node,ty,a*b);}
 if op==47{return ce_float_value(ctx,node,ty,a/b);}
 return ce_error(ctx,node,"invalid floating-point constant operation");
}
fn ce_literal(node:*BootNode)->bool{return node.kind==BN_INT||node.kind==BN_FLOAT||node.kind==BN_BOOL||(node.kind==BN_UNARY&&node.op==45&&ce_literal(node.left));}
pub fn ce_eval(ctx:*BootContext,node:*BootNode,bindings:*BootTypeBinding,expected:*BootType,depth:i32)->*BootType{
 if ctx.failed||node==0 as *BootNode{return 0 as *BootType;}
 if depth>256{return ce_error(ctx,node,"cyclic or excessively deep constant expression");}
 if node.kind==BN_CONST_VALUE{return ce_value(ctx,node.ty,node.value as u64);}
 if node.kind==BN_BOOL{return ce_value(ctx,boot_type(ctx,BY_BOOL),node.value as u64);}
 if node.kind==BN_FLOAT{
  let mut ty:*BootType=expected;if !ce_float(ty){ty=boot_type(ctx,BY_F64);}
  return ce_float_value(ctx,node,ty,strtod(node.token.text,0 as **u8));
 }
 if node.kind==BN_INT{
  let mut ty:*BootType=expected;if !ce_integer(ty){ty=boot_type(ctx,BY_I64);}
  let mut limit:u64=ce_mask(ty);if ce_signed(ty){limit=limit>>1;}
  let mut value:u64=0;if !boot_integer_value(ctx,node.token,limit,&mut value as *u64){return 0 as *BootType;}return ce_value(ctx,ty,value);
 }
 if node.kind==BN_IDENT{
  if node.aux!=0 as *BootType&&node.aux.kind==BY_CONST_VALUE{return node.aux;}
  if node.aux!=0 as *BootType&&node.aux.kind==BY_CONST_PARAMETER{return ce_binding(node.aux,bindings);}
  let saved:*BootModule=ctx.module;ctx.module=node.owner;let declaration:*BootNode=boot_lookup(ctx,node.name,node.lookup,node.token);ctx.module=saved;
  if declaration==0 as *BootNode||declaration.kind!=BN_CONST{return ce_error(ctx,node,"constant expression requires a declared constant");}
  let mut declared:*BootType=declaration.ty;let mut chain:i32=0;while declared.kind==BY_ALIAS{chain=chain+1;if chain>256{return ce_error(ctx,node,"cyclic constant type alias");}declared=declared.inner;}
  let value:*BootType=ce_eval(ctx,declaration.left,bindings,declared,depth+1);
  if value!=0 as *BootType&&value.inner!=declared{return ce_error(ctx,node,"constant type mismatch");}return value;
 }
 if node.kind==BN_CAST{
  let mut hint:*BootType=0 as *BootType;if node.left.kind==BN_INT&&node.ty.kind==BY_U64{hint=node.ty;}
  let value:*BootType=ce_eval(ctx,node.left,bindings,hint,depth+1);if value==0 as *BootType{return value;}
  if ce_float(value.inner){
   let number:f64=ce_decode_float(value.extent);
   if ce_float(node.ty){return ce_float_value(ctx,node,node.ty,number);}
   if node.ty.kind==BY_BOOL{return ce_value(ctx,node.ty,(number!=0.0) as u64);}
   if ce_integer(node.ty){return ce_value(ctx,node.ty,ce_float_to_int(number,node.ty)&ce_mask(node.ty));}
   return ce_error(ctx,node,"numeric constant cast required");
  }
  if ce_float(node.ty){
   let mut number:f64=value.extent as f64;if ce_signed(value.inner){number=ce_i64(value.extent,value.inner) as f64;}
   return ce_float_value(ctx,node,node.ty,number);
  }
  if !ce_integer(value.inner)&&value.inner.kind!=BY_BOOL{return ce_error(ctx,node,"integer or bool constant cast required");}
  if node.ty.kind==BY_BOOL{return ce_value(ctx,node.ty,(value.extent!=0) as u64);}
  if !ce_integer(node.ty){return ce_error(ctx,node,"integer or bool constant cast required");}
  let mut bits:u64=value.extent;if ce_signed(value.inner){bits=ce_i64(bits,value.inner) as u64;}return ce_value(ctx,node.ty,bits&ce_mask(node.ty));
 }
 if node.kind==BN_UNARY{
  if node.op==45&&node.left.kind==BN_INT{
   let mut ty:*BootType=expected;if !ce_integer(ty){ty=boot_type(ctx,BY_I64);}
   let mut maximum:u64=(ce_mask(ty)>>1)+1;if !ce_signed(ty){maximum=0;}
   let mut magnitude:u64=0;if !boot_integer_value(ctx,node.left.token,maximum,&mut magnitude as *u64){return 0 as *BootType;}
   return ce_value(ctx,ty,((0 as u64)-magnitude)&ce_mask(ty));
  }
  let value:*BootType=ce_eval(ctx,node.left,bindings,expected,depth+1);if value==0 as *BootType{return value;}
  if node.op==33&&value.inner.kind==BY_BOOL{return ce_value(ctx,value.inner,1-value.extent);}
  if ce_float(value.inner)&&node.op==45{return ce_float_value(ctx,node,value.inner,-ce_decode_float(value.extent));}
  if !ce_integer(value.inner){return ce_error(ctx,node,"invalid constant unary operand");}
  if node.op==126{return ce_value(ctx,value.inner,ce_mask(value.inner)^value.extent);}
  if node.op==45{
   if (!ce_signed(value.inner)&&value.extent!=0)||(ce_signed(value.inner)&&value.extent==(ce_mask(value.inner)>>1)+1){return ce_error(ctx,node,"constant negation overflows its type");}
   return ce_value(ctx,value.inner,((0 as u64)-value.extent)&ce_mask(value.inner));
  }
 }
 if node.kind==BN_BINARY{
  if node.op==BT_AND||node.op==BT_OR{
   let left:*BootType=ce_eval(ctx,node.left,bindings,boot_type(ctx,BY_BOOL),depth+1);if left==0 as *BootType{return left;}
   if left.inner.kind!=BY_BOOL{return ce_error(ctx,node,"logical constant operands must be bool");}
   if (node.op==BT_AND&&left.extent==0)||(node.op==BT_OR&&left.extent!=0){return left;}
   let right:*BootType=ce_eval(ctx,node.right,bindings,boot_type(ctx,BY_BOOL),depth+1);if right!=0 as *BootType&&right.inner.kind!=BY_BOOL{return ce_error(ctx,node,"logical constant operands must be bool");}return right;
  }
  let mut a:*BootType=0 as *BootType;let mut b:*BootType=0 as *BootType;
  if ce_literal(node.left)&&!ce_literal(node.right){b=ce_eval(ctx,node.right,bindings,expected,depth+1);if ctx.failed{return b;}let mut hint:*BootType=expected;if b!=0 as *BootType{hint=b.inner;}a=ce_eval(ctx,node.left,bindings,hint,depth+1);}
  else{
   a=ce_eval(ctx,node.left,bindings,expected,depth+1);if ctx.failed{return a;}
   let mut hint:*BootType=expected;if a!=0 as *BootType{hint=a.inner;}b=ce_eval(ctx,node.right,bindings,hint,depth+1);
  }
  if a==0 as *BootType||b==0 as *BootType{return 0 as *BootType;}
  if a.inner!=b.inner{return ce_error(ctx,node,"constant binary type mismatch");}
  return ce_binary(ctx,node,a,b);
 }
 return ce_error(ctx,node,"expression is not a scalar compile-time constant");
}
fn ce_binary(ctx:*BootContext,node:*BootNode,left:*BootType,right:*BootType)->*BootType{
 let ty:*BootType=left.inner;let a:u64=left.extent;let b:u64=right.extent;let op:i32=node.op;
 if ce_float(ty){return ce_float_binary(ctx,node,ty,ce_decode_float(a),ce_decode_float(b));}
 if op==BT_EQ{return ce_value(ctx,boot_type(ctx,BY_BOOL),(a==b) as u64);}if op==BT_NE{return ce_value(ctx,boot_type(ctx,BY_BOOL),(a!=b) as u64);}
 if ty.kind==BY_BOOL{
  if op==BT_AND{return ce_value(ctx,ty,((a!=0)&&(b!=0)) as u64);}if op==BT_OR{return ce_value(ctx,ty,((a!=0)||(b!=0)) as u64);}
  return ce_error(ctx,node,"invalid boolean constant operation");
 }
 if !ce_integer(ty){return ce_error(ctx,node,"integer constant operands required");}
 let mask:u64=ce_mask(ty);let x:i64=ce_i64(a,ty);let y:i64=ce_i64(b,ty);let signed:bool=ce_signed(ty);let mut value:u64=0;
 if op==60||op==62||op==BT_LE||op==BT_GE{
  let mut less:bool=a<b;let mut equal:bool=a==b;if signed{less=x<y;}
  let mut result:bool=less;if op==62{result=!less&&!equal;}if op==BT_LE{result=less||equal;}if op==BT_GE{result=!less;}
  return ce_value(ctx,boot_type(ctx,BY_BOOL),result as u64);
 }
 if op==38{return ce_value(ctx,ty,a&b);}if op==124{return ce_value(ctx,ty,a|b);}if op==94{return ce_value(ctx,ty,a^b);}
 let maximum:i64=(mask>>1) as i64;let minimum:i64=-maximum-1;
 if op==43{
  if signed{if (y>0&&x>maximum-y)||(y<0&&x<minimum-y){return ce_error(ctx,node,"constant addition overflows its type");}}
  else{if b>mask-a{return ce_error(ctx,node,"constant addition overflows its type");}}value=a+b;
 }else if op==45{
  if signed{if (y<0&&x>maximum+y)||(y>0&&x<minimum+y){return ce_error(ctx,node,"constant subtraction overflows its type");}}
  else{if b>a{return ce_error(ctx,node,"constant subtraction overflows its type");}}value=a-b;
 }else if op==42{
  let mut magnitude_a:u64=a;let mut magnitude_b:u64=b;let mut negative:bool=false;let mut limit:u64=mask;
  if signed{negative=(x<0)!=(y<0);if x<0{magnitude_a=(0 as u64)-(x as u64);}if y<0{magnitude_b=(0 as u64)-(y as u64);}limit=mask>>1;if negative{limit=limit+1;}}
  if magnitude_b!=0&&magnitude_a>limit/magnitude_b{return ce_error(ctx,node,"constant multiplication overflows its type");}
  value=magnitude_a*magnitude_b;if negative{value=(0 as u64)-value;}
 }else if op==47||op==37{
  if b==0{return ce_error(ctx,node,"constant division by zero");}
  if signed{if x==minimum&&y==-1{return ce_error(ctx,node,"constant division overflows its type");}if op==47{value=(x/y) as u64;}else{value=(x%y) as u64;}}
  else{if op==47{value=a/b;}else{value=a%b;}}
 }else if op==BT_SHL||op==BT_SHR{
  if b>=ce_bits(ty){return ce_error(ctx,node,"constant shift count is outside its type width");}
  if op==BT_SHR{if signed{value=(x>>(b as i64)) as u64;}else{value=a>>b;}}
  else{
   let mut magnitude:u64=a;let mut limit:u64=mask;if signed{limit=mask>>1;if x<0{magnitude=(0 as u64)-(x as u64);limit=limit+1;}}
   if magnitude>(limit>>b){return ce_error(ctx,node,"constant shift overflows its type");}value=a<<b;
  }
 }else{return ce_error(ctx,node,"unsupported integer constant operation");}
 return ce_value(ctx,ty,value&mask);
}

pub fn ce_substitute(ctx:*BootContext,source:*BootNode,bindings:*BootTypeBinding)->*BootNode{
 if source==0 as *BootNode{return source;}
 let node:*BootNode=boot_alloc(ctx,size_of(BootNode) as u64) as *BootNode;if node==0 as *BootNode{return node;}memcpy(node as *void,source as *void,size_of(BootNode) as u64);node.id=boot_id(ctx);node.next=0 as *BootNode;
 if node.kind==BN_IDENT&&node.aux!=0 as *BootType&&node.aux.kind==BY_CONST_PARAMETER{
  let value:*BootType=ce_binding(node.aux,bindings);if value!=0 as *BootType{node.kind=BN_CONST_VALUE;node.ty=value.inner;node.value=value.extent as i64;node.aux=0 as *BootType;}
 }
 node.left=ce_substitute(ctx,source.left,bindings);node.right=ce_substitute(ctx,source.right,bindings);return node;
}
pub fn ce_length(ctx:*BootContext,value:*BootType,token:*BootToken)->u64{
 if !ce_integer(value.inner)|| (ce_signed(value.inner)&&ce_i64(value.extent,value.inner)<0)||value.extent>9223372036854775807{boot_error(ctx,token,"array length requires a nonnegative integer within the addressable range");return 0;}
 return value.extent;
}

pub fn ce_checked_unsigned(ctx:*BootContext,ty:*BootType,value:u64,token:*BootToken)->*BootType{
 if !ce_integer(ty){boot_error(ctx,token,"array extent cannot infer a non-integer const parameter");return 0 as *BootType;}
 let mut maximum:u64=ce_mask(ty);if ce_signed(ty){maximum=maximum>>1;}
 if value>maximum{boot_error(ctx,token,"inferred const argument is outside its type range");return 0 as *BootType;}return ce_value(ctx,ty,value);
}
