// One typed inventory for low-level memory intrinsics. Orders are compile-time
// values; raw atomic storage must be live and naturally aligned. Volatile may
// access packed storage but supplies no inter-thread synchronization.
use model::*;
use runtime::*;
use const_eval::*;

// Encoded identity: operation * 100 + element kind * 10 + explicit-order bit.
pub fn bm_id(name:*u8)->i32 {
 if strcmp(name,"__atomic_thread_fence")==0{return 830;}
 if strcmp(name,"__atomic_thread_fence_explicit")==0{return 831;}
 let mut op:i32=1;
 while op<=7 {
  let mut prefix:*u8="__volatile_read_";
  if op==2{prefix="__volatile_write_";}if op==3{prefix="__atomic_load_";}
  if op==4{prefix="__atomic_store_";}if op==5{prefix="__atomic_fetch_add_";}
  if op==6{prefix="__atomic_fetch_sub_";}if op==7{prefix="__atomic_compare_exchange_";}
  let length:u64=strlen(prefix);
  if strncmp(name,prefix,length)==0 {
   let tail:*u8=name+length;let mut kind:i32=BY_U8;
   while kind<=BY_U64 {
    let mut word:*u8="u8";let mut explicit:*u8="u8_explicit";
    if kind==BY_U16{word="u16";explicit="u16_explicit";}
    if kind==BY_U32{word="u32";explicit="u32_explicit";}
    if kind==BY_U64{word="u64";explicit="u64_explicit";}
    if strcmp(tail,word)==0{return op*100+kind*10;}
    if op>=3&&strcmp(tail,explicit)==0{return op*100+kind*10+1;}
    kind=kind+2;
   }
  }
  op=op+1;
 }
 return 0;
}
fn bm_param(ctx:*BootContext,ty:*BootType,token:*BootToken)->*BootNode {
 let node:*BootNode=boot_node(ctx,BN_PARAM,token);
 if !ctx.failed{node.name="@memory_argument";node.ty=ty;}
 return node;
}
pub fn bm_signature(ctx:*BootContext,name:*u8,token:*BootToken)->*BootNode {
 let id:i32=bm_id(name);if id==0{return 0 as *BootNode;}
 let op:i32=id/100;let element:*BootType=boot_type(ctx,(id/10)%10);
 let f:*BootNode=boot_node(ctx,BN_FN,token);if ctx.failed{return 0 as *BootNode;}
 f.name=name;f.op=op;f.aux=element;f.value=(id%10) as i64;f.ty=boot_type(ctx,BY_VOID);
 if op==1||op==2{f.effect_bits=4;}else if op==3{f.effect_bits=1;}
 else if op==4{f.effect_bits=2;}else{f.effect_bits=3;}
 if op==1||op==3||op==5||op==6{f.ty=element;}
 if op==7{f.ty=boot_type(ctx,BY_BOOL);}
 let mut count:i32=1;if op==2||op==4||op==5||op==6{count=2;}
 if op==7{count=3;}if op==8{count=0;}
 let mut last:*BootNode=0 as *BootNode;let mut i:i32=0;
 while i<count&&!ctx.failed {
  let mut ty:*BootType=element;if i==0{ty=boot_ptr_type(ctx,element);}
  let p:*BootNode=bm_param(ctx,ty,token);if ctx.failed{return 0 as *BootNode;}if last==0 as *BootNode{f.params=p;}else{last.next=p;}last=p;i=i+1;
 }
 if id%10==1 {
  let p:*BootNode=bm_param(ctx,boot_type(ctx,BY_I32),token);
  if ctx.failed{return 0 as *BootNode;}
  if last==0 as *BootNode{f.params=p;}else{last.next=p;}last=p;
  if op==7{last.next=bm_param(ctx,boot_type(ctx,BY_I32),token);if ctx.failed{return 0 as *BootNode;}}
 }
 return f;
}
fn bm_constant(ctx:*BootContext,node:*BootNode)->bool {
 if node.kind==BN_INT||node.kind==BN_CONST_VALUE{return true;}
 if node.kind==BN_IDENT&&node.decl!=0 as *BootNode&&node.decl.kind==BN_CONST{return true;}
 if node.kind==BN_UNARY||node.kind==BN_CAST{return bm_constant(ctx,node.left);}
 if node.kind==BN_BINARY{return bm_constant(ctx,node.left)&&bm_constant(ctx,node.right);}
 boot_error(ctx,node.token,"memory order must be a compile-time integer constant");return false;
}
fn bm_order(ctx:*BootContext,node:*BootNode)->i32 {
 if !bm_constant(ctx,node){return -1;}
 let value:*BootType=ce_eval(ctx,node,0 as *BootTypeBinding,boot_type(ctx,BY_I32),0);
 if ctx.failed{return -1;}
 if value.extent>4{boot_error(ctx,node.token,"memory order must be between 0 and 4");return -1;}
 return value.extent as i32;
}
pub fn bm_lower(ctx:*BootContext,node:*BootNode,signature:*BootNode)->*BootType {
 let op:i32=signature.op;let mut count:i32=1;
 if op==2||op==4||op==5||op==6{count=2;}if op==7{count=3;}if op==8{count=0;}
 let mut arg:*BootNode=node.params;let mut last:*BootNode=0 as *BootNode;let mut i:i32=0;
 while i<count{last=arg;arg=arg.next;i=i+1;}
 let mut success:i32=4;let mut failure:i32=4;
 if signature.value!=0 {
  success=bm_order(ctx,arg);if ctx.failed{return 0 as *BootType;}failure=success;
  if op==7{failure=bm_order(ctx,arg.next);if ctx.failed{return 0 as *BootType;}}
 }
 if (op==3&&(success==2||success==3))||(op==4&&(success==1||success==3))||(op==8&&success==0) {
  boot_error(ctx,node.token,"memory order is not valid for this operation");return 0 as *BootType;
 }
 if op==7 {
  let mut allowed:bool=failure==0;
  if success==1||success==3{allowed=allowed||failure==1;}
  if success==4{allowed=allowed||failure==1||failure==4;}
  if !allowed{boot_error(ctx,node.token,"compare-exchange failure order must not release or exceed success order");return 0 as *BootType;}
 }
 // Ordering expressions are compile-time metadata, never runtime operands.
 if last!=0 as *BootNode{last.next=0 as *BootNode;}else{node.params=0 as *BootNode;}
 node.kind=BN_MEMORY;node.op=op;node.aux=signature.aux;node.ty=signature.ty;
 node.value=(success+failure*8) as i64;node.host_effect=signature.effect_bits;node.decl=0 as *BootNode;
 return node.ty;
}
pub fn bm_c_order(order:i32)->*u8 {
 if order==0{return "__ATOMIC_RELAXED";}if order==1{return "__ATOMIC_ACQUIRE";}
 if order==2{return "__ATOMIC_RELEASE";}if order==3{return "__ATOMIC_ACQ_REL";}return "__ATOMIC_SEQ_CST";
}
pub fn bm_ll_order(order:i32)->*u8 {
 if order==0{return "monotonic";}if order==1{return "acquire";}
 if order==2{return "release";}if order==3{return "acq_rel";}return "seq_cst";
}
