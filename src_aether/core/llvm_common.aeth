use model::*;
use native_abi::boot_abi_needed;
use runtime::*;
extern "C" {fn strtod(text:*u8,end:**u8)->f64;}
// Direct opaque-pointer LLVM IR utilities. No LLVM/Rust emitter is invoked.
pub fn ll_text(ctx:*BootContext,text:*u8){fputs(text,ctx.output);}
pub fn ll_id(ctx:*BootContext)->i32{ctx.llvm_serial=ctx.llvm_serial+1;return ctx.llvm_serial;}
pub fn ll_type(ctx:*BootContext,ty:*BootType){
 if ty.kind==BY_OWN{ll_type(ctx,ty.inner);return;}
 if ty.kind==BY_VOID {ll_text(ctx,"{}");return;}
 if boot_indirect(ty) {ll_text(ctx,"ptr");return;}
 if ty.kind==BY_ARRAY{fprintf(ctx.output,"[%llu x ",ty.extent);ll_type(ctx,ty.inner);ll_text(ctx,"]");return;}
 if ty.kind==BY_STRUCT||ty.kind==BY_ENUM {fprintf(ctx.output,"%%a%d_s%d",ctx.c_namespace,ty.id);return;}
 if ty.kind==BY_F32 {ll_text(ctx,"float");return;}if ty.kind==BY_F64 {ll_text(ctx,"double");return;}
 fprintf(ctx.output,"i%d",ll_bits(ty));
}
pub fn ll_return_type(ctx:*BootContext,ty:*BootType){if ty.kind==BY_VOID{ll_text(ctx,"void");}else{ll_type(ctx,ty);}}
pub fn ll_unit(ctx:*BootContext)->i32{let id:i32=ll_id(ctx);ll_begin(ctx,id);ll_text(ctx,"select i1 true, {} zeroinitializer, {} zeroinitializer\n");return id;}
pub fn ll_bits(ty:*BootType)->i32{
 if ty.kind==BY_BOOL{return 1;}if ty.kind==BY_I8||ty.kind==BY_U8{return 8;}
 if ty.kind==BY_I16||ty.kind==BY_U16{return 16;}if ty.kind==BY_I32||ty.kind==BY_U32{return 32;}return 64;
}
pub fn ll_float(ty:*BootType)->bool{return ty.kind==BY_F32||ty.kind==BY_F64;}
pub fn ll_signed(ty:*BootType)->bool{return ty.kind>=BY_I8&&ty.kind<=BY_I64&&(ty.kind&1)==0;}
pub fn ll_reg(ctx:*BootContext,id:i32){fprintf(ctx.output,"%%r%d",id);}
pub fn ll_begin(ctx:*BootContext,id:i32){fprintf(ctx.output,"  %%r%d = ",id);}
pub fn ll_value(ctx:*BootContext,ty:*BootType,id:i32){ll_type(ctx,ty);ll_text(ctx," ");ll_reg(ctx,id);}
pub fn ll_function(ctx:*BootContext,node:*BootNode){
 if boot_c_symbol(node) && ((node.flags&BF_EXPORT)==0 || !boot_abi_needed(node)){fprintf(ctx.output,"@%s",node.name);}else{fprintf(ctx.output,"@a%d_f%d",ctx.c_namespace,node.id);}
}
pub fn ll_attr(ctx:*BootContext,ty:*BootType){
 if ty.kind==BY_BOOL||ty.kind==BY_U8||ty.kind==BY_U16{ll_text(ctx,"zeroext ");}
 if ty.kind==BY_I8||ty.kind==BY_I16{ll_text(ctx,"signext ");}
}
pub fn ll_label(ctx:*BootContext,id:i32){fprintf(ctx.output,"b%d:\n",id);ctx.llvm_block=id;ctx.llvm_terminated=false;}
pub fn ll_jump(ctx:*BootContext,id:i32){fprintf(ctx.output,"  br label %%b%d\n",id);ctx.llvm_terminated=true;}
pub fn ll_branch(ctx:*BootContext,condition:i32,yes:i32,no:i32){
 fprintf(ctx.output,"  br i1 %%r%d, label %%b%d, label %%b%d\n",condition,yes,no);ctx.llvm_terminated=true;
}
pub fn ll_integer(ctx:*BootContext,value:i64,ty:*BootType){
 let bits:i32=ll_bits(ty);let mut number:u64=value as u64;
 if bits<64{number=number&(((1 as u64)<<(bits as u64))-1);}fprintf(ctx.output,"%llu",number);
}
fn ll_float_value(node:*BootNode)->f64{
 if node.kind==BN_UNARY{return -ll_float_value(node.left);}
 return strtod(node.token.text,0 as **u8);
}
pub fn ll_literal(ctx:*BootContext,node:*BootNode,ty:*BootType){
 if ll_float(ty){
  let mut value:f64=ll_float_value(node);if ty.kind==BY_F32{value=(value as f32) as f64;}
  let mut bits:u64=0;memcpy(&mut bits as *u64 as *void,&value as *f64 as *void,8);
  fprintf(ctx.output,"0x%016llX",bits);return;
 }
 ll_integer(ctx,node.value,ty);
}
pub fn ll_load(ctx:*BootContext,ty:*BootType,pointer:i32)->i32{
 if ty.kind==BY_VOID{return ll_unit(ctx);}
 let id:i32=ll_id(ctx);ll_begin(ctx,id);ll_text(ctx,"load ");ll_type(ctx,ty);fprintf(ctx.output,", ptr %%r%d, align 1\n",pointer);return id;
}
pub fn ll_store(ctx:*BootContext,ty:*BootType,value:i32,pointer:i32){
 if ty.kind==BY_VOID{return;}
 ll_text(ctx,"  store ");ll_value(ctx,ty,value);fprintf(ctx.output,", ptr %%r%d, align 1\n",pointer);
}
pub fn ll_field_index(ty:*BootType,field:*BootNode)->i32{
 let mut index:i32=0;let mut item:*BootNode=ty.fields;
 while item!=(0 as *BootNode){if item==field{return index;}index=index+1;item=item.next;}return -1;
}
pub fn ll_cast(ctx:*BootContext,value:i32,source:*BootType,target:*BootType)->i32{
 if source==target||(target.kind==BY_OWN&&target.inner==source)||(source.kind==BY_OWN&&source.inner==target){return value;}
 let a:i32=source.kind;let b:i32=target.kind;let id:i32=ll_id(ctx);
 if boot_indirect(source)&&boot_indirect(target){return value;}
 if b==BY_BOOL{
  ll_begin(ctx,id);if ll_float(source){ll_text(ctx,"fcmp une ");}else{ll_text(ctx,"icmp ne ");}
  ll_value(ctx,source,value);if ll_float(source){ll_text(ctx,", 0.0\n");}else{ll_text(ctx,", 0\n");}return id;
 }
 if b==BY_PTR {
  let wide:i32=ll_cast(ctx,value,source,boot_type(ctx,BY_U64));ll_begin(ctx,id);fprintf(ctx.output,"inttoptr i64 %%r%d to ptr\n",wide);return id;
 }
 if a==BY_PTR{ll_begin(ctx,id);fprintf(ctx.output,"ptrtoint ptr %%r%d to ",value);ll_type(ctx,target);ll_text(ctx,"\n");return id;}
 if ll_float(source)&&!ll_float(target){
  ll_begin(ctx,id);ll_text(ctx,"call ");ll_type(ctx,target);
  if ll_signed(target){ll_text(ctx," @llvm.fptosi.sat.");}else{ll_text(ctx," @llvm.fptoui.sat.");}
  fprintf(ctx.output,"i%d.f%d(",ll_bits(target),if_float_bits(source));ll_value(ctx,source,value);ll_text(ctx,")\n");return id;
 }
 let mut operation:*u8=0 as *u8;
 if ll_float(source)&&ll_float(target){if b==BY_F64{operation="fpext";}else{operation="fptrunc";}}
 else{if ll_float(target){if ll_signed(source){operation="sitofp";}else{operation="uitofp";}}
 else{if ll_bits(source)==ll_bits(target){return value;}
 if ll_bits(source)>ll_bits(target){operation="trunc";}else{if ll_signed(source){operation="sext";}else{operation="zext";}}}}
 ll_begin(ctx,id);fprintf(ctx.output,"%s ",operation);ll_value(ctx,source,value);ll_text(ctx," to ");ll_type(ctx,target);ll_text(ctx,"\n");return id;
}
pub fn if_float_bits(ty:*BootType)->i32{if ty.kind==BY_F32{return 32;}return 64;}
pub fn ll_globals(ctx:*BootContext,node:*BootNode){
 let mut item:*BootNode=node;
 while item!=(0 as *BootNode)&&!ctx.failed{
  if item.kind==BN_STRING{
   fprintf(ctx.output,"@a%d_str%d = private unnamed_addr constant [%llu x i8] c\"",ctx.c_namespace,item.id,item.token.length+1);
   let mut i:u64=0;while i<item.token.length{fprintf(ctx.output,"\\%02X",item.token.text[i] as u32);i=i+1;}
   ll_text(ctx,"\\00\"\n");
  }
  ll_globals(ctx,item.left);ll_globals(ctx,item.right);ll_globals(ctx,item.third);ll_globals(ctx,item.body);ll_globals(ctx,item.params);item=item.next;
 }
}
pub fn ll_abi_width(ty:*BootType)->u64{return ty.layout_size+(8-ty.layout_size%8)%8;}
pub fn ll_abi_alloc(ctx:*BootContext,ty:*BootType,id:i32,role:*u8){fprintf(ctx.output,"  %%abi%s%d = alloca [%llu x i8], align 8\n",role,id,ll_abi_width(ty));}
pub fn ll_allocas(ctx:*BootContext,node:*BootNode){
 let mut item:*BootNode=node;
 while item!=(0 as *BootNode){
  if item.kind==BN_CALL && (item.decl.flags&2)!=0 && boot_abi_needed(item.decl){
   if item.ty.kind==BY_STRUCT{ll_abi_alloc(ctx,item.ty,item.id,"ret");}
   let mut p:*BootNode=item.params;while p!=0 as *BootNode{if p.ty.kind==BY_STRUCT{ll_abi_alloc(ctx,p.ty,p.id,"arg");}p=p.next;}
  }
  if item.kind==BN_LET||item.kind==BN_PARAM{fprintf(ctx.output,"  %%v%d = alloca ",item.id);ll_type(ctx,item.ty);ll_text(ctx,"\n");}
  if (item.kind==BN_STRUCT_VALUE && item.ty.union_layout) || (item.kind==BN_MEMBER && item.left.ty.kind==BY_STRUCT && item.left.ty.union_layout){
   let mut ty:*BootType=item.ty;if item.kind==BN_MEMBER{ty=item.left.ty;}
   fprintf(ctx.output,"  %%union%d = alloca ",item.id);ll_type(ctx,ty);ll_text(ctx,"\n");
  }
  if item.kind==BN_VALUE&&item.ty.kind!=BY_VOID{fprintf(ctx.output,"  %%yield%d = alloca ",item.id);ll_type(ctx,item.ty);ll_text(ctx,"\n");}
  if item.kind==BN_ENUM_VALUE||item.kind==BN_ENUM_FIELD{
   let mut enum_type:*BootType=item.ty;if item.kind==BN_ENUM_FIELD{enum_type=item.left.ty;}
   fprintf(ctx.output,"  %%enum%d = alloca ",item.id);ll_type(ctx,enum_type);ll_text(ctx,"\n");
  }
  if item.kind==BN_ARRAY||item.kind==BN_REPEAT||(item.kind==BN_INDEX&&item.left.ty.kind==BY_ARRAY&&!boot_place_form(item.left)){
   let mut ty:*BootType=item.ty;if item.kind==BN_INDEX{ty=item.left.ty;}fprintf(ctx.output,"  %%arr%d = alloca ",item.id);ll_type(ctx,ty);ll_text(ctx,"\n");
  }
  ll_allocas(ctx,item.left);ll_allocas(ctx,item.right);ll_allocas(ctx,item.body);ll_allocas(ctx,item.third);ll_allocas(ctx,item.params);item=item.next;
 }
}
