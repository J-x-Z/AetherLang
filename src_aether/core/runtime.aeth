use model::*;
pub fn boot_error(ctx:*BootContext,token:*BootToken,message:*u8) {
 if ctx.failed {return;}
 ctx.failed=true;
 let mut line:i32=1;let mut column:i32=1;
 let mut path:*u8=ctx.path;
 if token!=0 as *BootToken {line=token.line;column=token.column;if token.path!=(0 as *u8) {path=token.path;}}
 printf("%s:%d:%d: %s\n",path,line,column,message);
}
pub fn boot_alloc(ctx:*BootContext,size:u64)->*void {
 if ctx.failed {return 0 as *void;}
 let total:u64=size+(size_of(BootArena) as u64);
 if size>536870912 || total>536870912-ctx.allocated {
  boot_error(ctx,ctx.cursor,"compiler arena limit (512 MiB) exceeded");return 0 as *void;
 }
 let allocation:*BootArena=malloc(total) as *BootArena;
 if allocation==0 as *BootArena {boot_error(ctx,ctx.cursor,"out of memory");return 0 as *void;}
 allocation.next=ctx.arena;ctx.arena=allocation;ctx.allocated=ctx.allocated+total;
 let payload:*u8=(allocation as *u8)+(size_of(BootArena) as u64);
 memset(payload as *void,0,size);return payload as *void;
}
pub fn boot_copy(ctx:*BootContext,text:*u8,length:u64)->*u8 {
 if length>33554432 {boot_error(ctx,ctx.cursor,"text exceeds 32 MiB limit");return 0 as *u8;}
 let copy:*u8=boot_alloc(ctx,length+1) as *u8;
 if copy==0 as *u8 {return copy;}
 memcpy(copy as *void,text as *void,length);copy[length]=0;return copy;
}
pub fn boot_id(ctx:*BootContext)->i32 {
 ctx.next_id=ctx.next_id+1;return ctx.next_id;
}
pub fn boot_node(ctx:*BootContext,kind:i32,token:*BootToken)->*BootNode {
 let node:*BootNode=boot_alloc(ctx,size_of(BootNode) as u64) as *BootNode;
 if node==0 as *BootNode {return node;}
 node.kind=kind;node.id=boot_id(ctx);node.token=token;node.owner=ctx.module;return node;
}
pub fn boot_type(ctx:*BootContext,kind:i32)->*BootType {
 let mut ty:*BootType=ctx.types;
 while ty!=0 as *BootType {if ty.kind==kind {return ty;}ty=ty.next;}
 let created:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;
 if created==0 as *BootType {return created;}
 created.kind=kind;created.id=boot_id(ctx);created.complete=true;
 created.next=ctx.types;ctx.types=created;return created;
}
pub fn boot_ptr_type(ctx:*BootContext,inner:*BootType)->*BootType {
 let mut ty:*BootType=ctx.types;
 while ty!=0 as *BootType {if ty.kind==BY_PTR && ty.inner==inner {return ty;}ty=ty.next;}
 let created:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;
 if created==0 as *BootType {return created;}
 created.kind=BY_PTR;created.id=boot_id(ctx);created.inner=inner;created.complete=true;
 created.next=ctx.types;ctx.types=created;return created;
}
pub fn boot_named_type(ctx:*BootContext,name:*u8)->*BootType {
 let mut ty:*BootType=ctx.types;
 while ty!=0 as *BootType {if (ty.kind==BY_STRUCT||ty.kind==BY_ALIAS||ty.kind==BY_TEMPLATE) && ty.base==(0 as *BootType) && ty.owner==ctx.module && strcmp(ty.name,name)==0 {return ty;}ty=ty.next;}
 let created:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;
 if created==0 as *BootType {return created;}
 created.kind=BY_STRUCT;created.id=boot_id(ctx);created.name=name;created.owner=ctx.module;
 created.next=ctx.types;ctx.types=created;return created;
}
pub fn boot_context_new(source:*u8,length:u64,path:*u8)->*BootContext {
 let ctx:*BootContext=malloc(size_of(BootContext) as u64) as *BootContext;
 if ctx==0 as *BootContext {return ctx;}
 memset(ctx as *void,0,size_of(BootContext) as u64);
 ctx.source=source;ctx.length=length;ctx.path=path;
 return ctx;
}
pub fn boot_context_free(ctx:*BootContext) {
 if ctx==0 as *BootContext {return;}
 let mut item:*BootArena=ctx.arena;
 while item!=0 as *BootArena {let next:*BootArena=item.next;free(item as *void);item=next;}
 free(ctx as *void);
}

pub fn boot_module_item(module:*BootModule,name:*u8)->*BootNode {
 if module==(0 as *BootModule) { return 0 as *BootNode; }
 let mut item:*BootNode=module.items;
 while item!=(0 as *BootNode) { if item.owner==module && item.origin==(0 as *BootNode) && strcmp(item.name,name)==0 { return item; } item=item.next; }
 return 0 as *BootNode;
}
pub fn boot_exported(item:*BootNode)->bool { return item!=(0 as *BootNode) && (item.flags&10)!=0; }
pub fn boot_import_module(ctx:*BootContext,name:*u8,token:*BootToken)->*BootModule {
 if ctx.module!=(0 as *BootModule) {
  let mut import:*BootImport=ctx.module.imports;
  while import!=(0 as *BootImport) {
   if import.symbol==(0 as *u8) && strcmp(import.alias,name)==0 { return import.target; }
   import=import.next;
  }
 }
 boot_error(ctx,token,"unknown imported module");return 0 as *BootModule;
}
pub fn boot_imported(ctx:*BootContext,name:*u8,token:*BootToken)->*BootNode {
 if ctx.module==(0 as *BootModule) { return 0 as *BootNode; }
 let mut import:*BootImport=ctx.module.imports;let mut found:*BootNode=0 as *BootNode;
 while import!=(0 as *BootImport) {
  let mut item:*BootNode=0 as *BootNode;
  if import.wildcard { item=boot_module_item(import.target,name); }
  else { if import.symbol!=(0 as *u8) && strcmp(import.alias,name)==0 { item=boot_module_item(import.target,import.symbol); } }
  if boot_exported(item) {
   if found!=(0 as *BootNode) && found!=item && !boot_foreign_same(found,item) { boot_error(ctx,token,"ambiguous imported name");return 0 as *BootNode; }
   found=item;
  }
  import=import.next;
 }
 return found;
}
pub fn boot_lookup(ctx:*BootContext,name:*u8,module:*BootModule,token:*BootToken)->*BootNode {
 if module!=(0 as *BootModule) {
  let item:*BootNode=boot_module_item(module,name);
  if !boot_exported(item) { boot_error(ctx,token,"unknown or private imported name");return 0 as *BootNode; }
  return item;
 }
 if ctx.module==(0 as *BootModule) {
  let mut item:*BootNode=ctx.program.body;
  while item!=(0 as *BootNode) { if item.origin==(0 as *BootNode)&&strcmp(item.name,name)==0 { return item; } item=item.next; }
  return 0 as *BootNode;
 }
 let local:*BootNode=boot_module_item(ctx.module,name);
 if local!=(0 as *BootNode) { return local; }
 return boot_imported(ctx,name,token);
}
pub fn boot_resolve_type(ctx:*BootContext,name:*u8,module:*BootModule,token:*BootToken)->*BootType {
 if module==(0 as *BootModule){let mut parameter:*BootNode=ctx.type_parameters;while parameter!=(0 as *BootNode){if strcmp(parameter.name,name)==0{return parameter.ty;}parameter=parameter.next;}}
 if module!=(0 as *BootModule) {
  let item:*BootNode=boot_lookup(ctx,name,module,token);
  if item==(0 as *BootNode) { return 0 as *BootType; }
  if item.kind!=BN_STRUCT && item.kind!=BN_ALIAS {boot_error(ctx,token,"imported name is not a type");return 0 as *BootType;}
  return item.ty;
 }
 let imported:*BootNode=boot_imported(ctx,name,token);
 if ctx.failed {return 0 as *BootType;}
 if imported!=(0 as *BootNode) {
  if imported.kind!=BN_STRUCT && imported.kind!=BN_ALIAS {boot_error(ctx,token,"imported name is not a type");return 0 as *BootType;}
  return imported.ty;
 }
 return boot_named_type(ctx,name);
}

pub fn boot_zero_initializer(node:*BootNode)->bool{
 if node==0 as *BootNode{return true;}
 if node.kind==BN_INT || node.kind==BN_BOOL{return node.value==0;}
 if node.kind==BN_REPEAT{return node.ty.extent==0 || boot_zero_initializer(node.left);}
 return node.kind==BN_UNIT;
}
pub fn boot_c_symbol(node:*BootNode)->bool{return (node.flags&(2|BF_EXPORT))!=0;}
pub fn boot_symbol_definition(ctx:*BootContext,node:*BootNode)->*BootNode{
 let mut item:*BootNode=ctx.program.body;
 while item!=0 as *BootNode{
  if (item.flags&BF_EXPORT)!=0 && strcmp(item.name,node.name)==0{return item;}
  item=item.next;
 }
 return 0 as *BootNode;
}
pub fn boot_foreign_same(a:*BootNode,b:*BootNode)->bool {
 if a.kind!=b.kind || !boot_c_symbol(a) || !boot_c_symbol(b){return false;}
 if a.kind==BN_STATIC{return strcmp(a.name,b.name)==0 && a.ty==b.ty && (a.flags&1)==(b.flags&1);}
 if a.kind!=BN_FN{return false;}
 if strcmp(a.name,b.name)!=0 || a.ty!=b.ty || (a.flags&4)!=(b.flags&4) {return false;}
 let mut left:*BootNode=a.params;let mut right:*BootNode=b.params;
 while left!=(0 as *BootNode) && right!=(0 as *BootNode) {if left.ty!=right.ty {return false;}left=left.next;right=right.next;}
 return left==(0 as *BootNode) && right==(0 as *BootNode);
}

pub fn boot_integer_value(ctx:*BootContext,token:*BootToken,maximum:u64,output:*u64)->bool{
 let text:*u8=token.text;
 let mut base:u64=10;let mut index:u64=0;
 if text[0]==48 && (text[1]==120 || text[1]==88) { base=16;index=2; }
 let mut value:u64=0;
 while text[index]!=0 {
  let byte:i32=text[index] as i32;
  let mut digit:i32=byte-48;
  if byte>=65 && byte<=70 { digit=byte-65+10; }
  if byte>=97 && byte<=102 { digit=byte-97+10; }
  if digit<0 || (digit as u64)>=base { boot_error(ctx,token,"invalid integer literal");return false; }
  let unsigned:u64=digit as u64;
  if value>maximum/base || (value==maximum/base && unsigned>maximum%base) {
   boot_error(ctx,token,"integer literal is outside its type range");return false;
  }
  value=value*base+unsigned;index=index+1;
 }
 *output=value;return true;
}

pub fn boot_place_form(node:*BootNode)->bool{
 if node.kind==BN_IDENT{return node.decl!=(0 as *BootNode)&&node.decl.kind!=BN_CONST;}
 if node.kind==BN_UNARY&&node.op==42{return true;}
 if node.kind==BN_MEMBER||node.kind==BN_INDEX{if node.left.ty.kind==BY_PTR{return true;}return boot_place_form(node.left);}
 return false;
}
