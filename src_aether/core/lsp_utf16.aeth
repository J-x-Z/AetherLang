use model::*;
// Return consumed UTF-8 bytes, or zero for an invalid/incomplete scalar.
pub fn ls_utf8(text:*u8,length:u64,index:u64,scalar:*i32)->u64{
 if index>=length{return 0;}let first:i32=text[index] as i32;if first<128{*scalar=first;return 1;}
 let mut count:u64=0;let mut value:i32=0;let mut minimum:i32=0;
 if first>=194&&first<=223{count=2;value=first&31;minimum=128;}
 else if first>=224&&first<=239{count=3;value=first&15;minimum=2048;}
 else if first>=240&&first<=244{count=4;value=first&7;minimum=65536;}else{return 0;}
 if count>length-index{return 0;}let mut i:u64=1;
 while i<count{let next:i32=text[index+i] as i32;if next<128||next>191{return 0;}value=(value<<6)|(next&63);i=i+1;}
 if value<minimum||value>1114111||(value>=55296&&value<=57343){return 0;}*scalar=value;return count;
}
pub fn ls_utf8_write(out:*u8,value:i32)->u64{
 if value<128{out[0]=value as u8;return 1;}
 if value<2048{out[0]=(192|(value>>6)) as u8;out[1]=(128|(value&63)) as u8;return 2;}
 if value<65536{out[0]=(224|(value>>12)) as u8;out[1]=(128|((value>>6)&63)) as u8;out[2]=(128|(value&63)) as u8;return 3;}
 out[0]=(240|(value>>18)) as u8;out[1]=(128|((value>>12)&63)) as u8;out[2]=(128|((value>>6)&63)) as u8;out[3]=(128|(value&63)) as u8;return 4;
}
pub fn ls_byte_position(text:*u8,length:u64,line:i64,column:i64)->u64{
 if line<0||column<0{return 0;}let mut at:u64=0;let mut row:i64=0;
 while at<length&&row<line{if text[at]==10{row=row+1;}at=at+1;}
 let mut units:i64=0;
 while at<length&&text[at]!=10&&units<column{
  let mut scalar:i32=0;let mut count:u64=ls_utf8(text,length,at,&mut scalar as *i32);if count==0{count=1;scalar=65533;}
  let mut width:i64=1;if scalar>65535{width=2;}if units+width>column{break;}units=units+width;at=at+count;
 }
 return at;
}
// Decode one source segment and advance both scalar and UTF-16 coordinates.
pub fn ls_count_columns(text:*u8,length:u64,begin:u64,end:u64,scalars:*i32,units:*i32){
 let mut at:u64=begin;
 while at<length&&at<end&&text[at]!=10{
  let mut scalar:i32=0;let mut count:u64=ls_utf8(text,length,at,&mut scalar as *i32);
  if count==0{count=1;scalar=65533;}
  if at+count>end{break;}
  *scalars=*scalars+1;*units=*units+1;if scalar>65535{*units=*units+1;}at=at+count;
 }
}
