// Windows selection of the shared native host API.
use model::*;use runtime::*;
pub use windows_api::{realpath,fopen,fseek,ftell,fdopen,close,read,write,remove,rename,access,opendir,closedir,mkstemp};
use windows_api::{win_arguments,win_arguments_free,win_environment,win_absolute,win_run_tool,win_valid_image,_errno};
pub fn platform_windows()->bool{return true;}
pub fn platform_path_separator()->u8{return 59;}
pub fn platform_slash(byte:u8)->bool{return byte==47||byte==92;}
pub fn platform_executable_suffix()->*u8{return ".exe";}
pub fn platform_env(ctx:*BootContext,name:*u8)->*u8{let value:*u8=win_environment(name);if value==0 as *u8{return value;}let copy:*u8=boot_copy(ctx,value,strlen(value));free(value as *void);return copy;}
pub fn platform_arguments(argc:i32,argv:**u8,count:*i32)->**u8{return win_arguments(count);}
pub fn platform_arguments_free(count:i32,args:**u8){win_arguments_free(count,args);}
pub fn platform_info(ctx:*BootContext)->*u8{let info:*u8=boot_alloc(ctx,2048) as *u8;if ctx.failed{return info;}memcpy(info as *void,"Windows" as *void,8);memcpy((info+1024) as *void,"x86_64" as *void,7);return info;}
pub fn platform_absolute(path:*u8)->*u8{return win_absolute(path);}
pub fn platform_run_tool(args:**u8)->bool{
 let ok:bool=win_run_tool(args);if !ok{let message:*u8="aether-core: host compiler could not start, wait, or complete successfully\n";write(2,message,strlen(message));}return ok;
}
pub fn platform_valid_image(path:*u8,object:bool)->bool{return win_valid_image(path,object);}
extern "C"{fn perror(text:*u8);}

pub fn platform_errno()->i32{return *_errno();}
