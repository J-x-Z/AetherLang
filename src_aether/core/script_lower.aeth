 }
 if node.kind==BN_MEMBER&&node.left.kind==BN_IDENT&&bs_local(state,node.left.name)==0 as *BootScriptLocal{
  let mut import:*BootImport=ctx.module.imports;while import!=0 as *BootImport{if import.symbol==0 as *u8&&strcmp(import.alias,node.left.name)==0{node.lookup=import.target;node.kind=BN_IDENT;node.left=0 as *BootNode;return true;}import=import.next;}
 }
 if !bs_prepare_expr(state,node.left)||!bs_prepare_expr(state,node.right){return false;}
