fn bs_meet(state:*BootScriptState,other:*BootScriptAssigned){
 let mut local:*BootScriptLocal=state.locals;while local!=0 as *BootScriptLocal{let mut item:*BootScriptAssigned=other;let mut assigned:bool=false;while item!=0 as *BootScriptAssigned{if item.local==local{assigned=item.assigned;}item=item.next;}local.assigned=local.assigned&&assigned;local=local.next;}
}
fn bs_foreign_printf(ctx:*BootContext,token:*BootToken)->*BootModule{
 // A separate compiler-owned lookup namespace prevents user names such as
 // printf from capturing a generated print operation. It has the real C ABI.
 let module:*BootModule=boot_alloc(ctx,size_of(BootModule) as u64) as *BootModule;
 let function:*BootNode=boot_node(ctx,BN_FN,token);let param:*BootNode=boot_node(ctx,BN_PARAM,token);if ctx.failed{return 0 as *BootModule;}
 module.id=boot_id(ctx);module.path=token.path;function.owner=module;function.name="printf";function.flags=6;function.ty=boot_type(ctx,BY_I32);function.params=param;param.name="format";param.ty=boot_ptr_type(ctx,boot_type(ctx,BY_U8));module.items=function;
 function.next=ctx.program.body;ctx.program.body=function;return module;
}
fn bs_prepare_expr(state:*BootScriptState,node:*BootNode)->bool{
 let ctx:*BootContext=state.context;if node==0 as *BootNode||ctx.failed{return !ctx.failed;}
 if node.kind==BN_CLOSURE{
  let child:*BootScriptState=boot_alloc(ctx,size_of(BootScriptState) as u64) as *BootScriptState;if ctx.failed{return false;}child.context=ctx;child.function=state.function;child.locals=state.locals;
  let saved:*BootBinding=ctx.bindings;let mut parameter:*BootNode=node.params;
  while parameter!=0 as *BootNode&&!ctx.failed{
   let local:*BootScriptLocal=boot_alloc(ctx,size_of(BootScriptLocal) as u64) as *BootScriptLocal;let binding:*BootBinding=boot_alloc(ctx,size_of(BootBinding) as u64) as *BootBinding;if ctx.failed{return false;}
   local.name=parameter.name;local.ty=parameter.ty;local.parameter=parameter;local.assigned=true;local.next=child.locals;child.locals=local;
   binding.name=parameter.name;binding.node=parameter;binding.next=ctx.bindings;ctx.bindings=binding;parameter=parameter.next;
  }
