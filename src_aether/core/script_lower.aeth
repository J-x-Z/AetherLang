}
fn bs_bind(state:*BootScriptState,name:*u8,ty:*BootType,token:*BootToken,param:*BootNode)->*BootScriptLocal{
 let ctx:*BootContext=state.context;let old:*BootScriptLocal=bs_local(state,name);
 if old!=0 as *BootScriptLocal{if old.ty!=ty{boot_error(ctx,token,"Script local keeps its first inferred type");}return old;}
 let local:*BootScriptLocal=boot_alloc(ctx,size_of(BootScriptLocal) as u64) as *BootScriptLocal;
 let binding:*BootBinding=boot_alloc(ctx,size_of(BootBinding) as u64) as *BootBinding;if ctx.failed{return 0 as *BootScriptLocal;}
 local.name=name;local.ty=ty;local.token=token;local.parameter=param;
 if param==0 as *BootNode{local.parameter=boot_node(ctx,BN_LET,token);if ctx.failed{return 0 as *BootScriptLocal;}local.parameter.name=name;local.parameter.ty=ty;local.parameter.flags=1;}
 local.next=state.locals;state.locals=local;binding.name=name;binding.node=local.parameter;binding.next=ctx.bindings;ctx.bindings=binding;return local;
