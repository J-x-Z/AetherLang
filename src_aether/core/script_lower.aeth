extern "C" {fn snprintf(buffer:*u8,size:u64,format:*u8,...)->i32;}
fn bs_local(state:*BootScriptState,name:*u8)->*BootScriptLocal{
 let mut local:*BootScriptLocal=state.locals;while local!=0 as *BootScriptLocal{if strcmp(local.name,name)==0{return local;}local=local.next;}return 0 as *BootScriptLocal;
}
fn bs_literal(ctx:*BootContext,kind:i32,text:*u8,origin:*BootToken)->*BootNode{
 let token:*BootToken=boot_alloc(ctx,size_of(BootToken) as u64) as *BootToken;if ctx.failed{return 0 as *BootNode;}
 token.text=text;token.length=strlen(text);token.line=origin.line;token.column=origin.column;token.path=origin.path;token.kind=BT_INT;
 if kind==BN_FLOAT{token.kind=BT_FLOAT;}if kind==BN_STRING{token.kind=BT_STRING;}
 let node:*BootNode=boot_node(ctx,kind,token);if !ctx.failed{node.name=text;}return node;
}
fn bs_identifier(ctx:*BootContext,name:*u8,token:*BootToken)->*BootNode{let node:*BootNode=boot_node(ctx,BN_IDENT,token);if !ctx.failed{node.name=name;}return node;}
fn bs_zero(ctx:*BootContext,ty:*BootType,token:*BootToken)->*BootNode{
 if ty.kind==BY_STRUCT{
  let node:*BootNode=boot_node(ctx,BN_STRUCT_VALUE,token);if ctx.failed{return node;}node.ty=ty;let mut field:*BootNode=ty.fields;let mut tail:*BootNode=0 as *BootNode;
  while field!=0 as *BootNode&&!ctx.failed{let value:*BootNode=boot_node(ctx,BN_FIELD,token);if ctx.failed{return 0 as *BootNode;}value.name=field.name;value.left=bs_zero(ctx,field.ty,token);if tail==0 as *BootNode{node.params=value;}else{tail.next=value;}tail=value;field=field.next;}return node;
 }
 if ty.kind==BY_ARRAY{let node:*BootNode=boot_node(ctx,BN_REPEAT,token);if ctx.failed{return node;}node.value=ty.extent as i64;node.left=bs_zero(ctx,ty.inner,token);return node;}
 if ty.kind==BY_PTR{let node:*BootNode=boot_node(ctx,BN_CAST,token);if ctx.failed{return node;}node.ty=ty;node.left=bs_literal(ctx,BN_INT,"0",token);return node;}
 if ty.kind==BY_BOOL{return bs_literal(ctx,BN_BOOL,"false",token);}
 if ty.kind==BY_F32||ty.kind==BY_F64{return bs_literal(ctx,BN_FLOAT,"0.0",token);}
