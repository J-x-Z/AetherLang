fn bs_snapshot(state:*BootScriptState)->*BootScriptAssigned{
 let mut head:*BootScriptAssigned=0 as *BootScriptAssigned;let mut local:*BootScriptLocal=state.locals;
 while local!=0 as *BootScriptLocal&&!state.context.failed{let item:*BootScriptAssigned=boot_alloc(state.context,size_of(BootScriptAssigned) as u64) as *BootScriptAssigned;if state.context.failed{return head;}item.local=local;item.assigned=local.assigned;item.next=head;head=item;local=local.next;}return head;
}
fn bs_restore(state:*BootScriptState,saved:*BootScriptAssigned){
 let mut local:*BootScriptLocal=state.locals;while local!=0 as *BootScriptLocal{local.assigned=false;local=local.next;}
 let mut item:*BootScriptAssigned=saved;while item!=0 as *BootScriptAssigned{item.local.assigned=item.assigned;item=item.next;}
