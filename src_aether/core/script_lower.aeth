 if node.kind==BN_EXPR{bs_typed(state,node.left,0 as *BootType);return false;}
 boot_error(ctx,node.token,"unsupported self-hosted Script statement");return false;
}
pub fn boot_script_lower(ctx:*BootContext)->bool{
 let mut candidate:*BootNode=ctx.program.body;let mut found:bool=false;
 while candidate!=0 as *BootNode{if (candidate.flags&BS_FUNCTION)!=0{found=true;}candidate=candidate.next;}
 if !found{return true;}
 if !boot_normalize(ctx){return false;}
 let mut function:*BootNode=ctx.program.body;
 while function!=0 as *BootNode&&!ctx.failed{
  if function.kind==BN_FN&&(function.flags&BS_FUNCTION)!=0{
   ctx.module=function.owner;ctx.function=function;ctx.bindings=0 as *BootBinding;ctx.depth=0;
   let state:*BootScriptState=boot_alloc(ctx,size_of(BootScriptState) as u64) as *BootScriptState;if ctx.failed{return false;}state.context=ctx;state.function=function;
   let mut parameter:*BootNode=function.params;
   while parameter!=0 as *BootNode&&!ctx.failed{let local:*BootScriptLocal=bs_bind(state,parameter.name,parameter.ty,parameter.token,parameter);if !ctx.failed{local.assigned=true;}parameter=parameter.next;}
   let exits:bool=bs_statement(state,function.body);if ctx.failed{return false;}
   if strcmp(function.name,"main")==0&&!exits{
    let ret:*BootNode=boot_node(ctx,BN_RETURN,function.token);if ctx.failed{return false;}ret.left=bs_literal(ctx,BN_INT,"0",function.token);let mut tail:*BootNode=function.body.body;
    if tail==0 as *BootNode{function.body.body=ret;}else{while tail.next!=0 as *BootNode{tail=tail.next;}tail.next=ret;}
   }
   let mut local:*BootScriptLocal=state.locals;
   while local!=0 as *BootScriptLocal&&!ctx.failed{
    if local.parameter.kind==BN_LET{let decl:*BootNode=local.parameter;decl.left=bs_zero(ctx,local.ty,local.token);decl.next=function.body.body;function.body.body=decl;}
    local=local.next;
   }
   function.flags=function.flags&255;ctx.bindings=0 as *BootBinding;ctx.function=0 as *BootNode;
  }
  function=function.next;
 }
 return !ctx.failed;
}
