}
fn bs_for(state:*BootScriptState,node:*BootNode)->bool{
 let ctx:*BootContext=state.context;let call:*BootNode=node.left;
 if call.kind!=BN_CALL||call.left!=0 as *BootNode||strcmp(call.name,"range")!=0||call.params==0 as *BootNode{boot_error(ctx,node.token,"Script for requires range(stop) or range(start, stop)");return false;}
 if boot_lookup(ctx,"range",0 as *BootModule,node.token)!=0 as *BootNode||bs_local(state,"range")!=0 as *BootScriptLocal{boot_error(ctx,node.token,"Script range loop cannot call a shadowed range");return false;}
 let mut start:*BootNode=call.params;let mut end:*BootNode=start.next;
 if end==0 as *BootNode{end=start;start=bs_literal(ctx,BN_INT,"0",node.token);}else{if end.next!=0 as *BootNode{boot_error(ctx,node.token,"range takes one or two endpoints");return false;}start.next=0 as *BootNode;}
 let a:*BootType=bs_typed(state,start,0 as *BootType);let b:*BootType=bs_typed(state,end,0 as *BootType);if ctx.failed{return false;}
 if a.kind!=BY_I64||b!=a{boot_error(ctx,node.token,"Script range endpoints must be int");return false;}
 let before:*BootScriptAssigned=bs_snapshot(state);let local:*BootScriptLocal=bs_bind(state,node.name,a,node.token,0 as *BootNode);if ctx.failed{return false;}local.assigned=true;
 state.loop_depth=state.loop_depth+1;bs_statement(state,node.body);state.loop_depth=state.loop_depth-1;bs_restore(state,before);if ctx.failed{return false;}
 let iterator:*BootNode=boot_node(ctx,BN_LET,node.token);let limit:*BootNode=boot_node(ctx,BN_LET,node.token);let iteration:*BootNode=boot_node(ctx,BN_WHILE,node.token);let condition:*BootNode=boot_node(ctx,BN_BINARY,node.token);if ctx.failed{return false;}
 iterator.name=bs_fresh(ctx,node.token);iterator.ty=a;iterator.flags=1;iterator.left=start;iterator.next=limit;
 limit.name=bs_fresh(ctx,node.token);limit.ty=a;limit.left=end;limit.next=iteration;
 condition.op=60;condition.left=bs_identifier(ctx,iterator.name,node.token);condition.right=bs_identifier(ctx,limit.name,node.token);iteration.left=condition;iteration.body=node.body;
 let set:*BootNode=bs_assignment(ctx,node.name,bs_identifier(ctx,iterator.name,node.token),node.token);
 let increment:*BootNode=bs_assignment(ctx,iterator.name,bs_literal(ctx,BN_INT,"1",node.token),node.token);if ctx.failed{return false;}increment.op=43;
 set.next=increment;increment.next=iteration.body.body;iteration.body.body=set;node.kind=BN_BLOCK;node.body=iterator;node.left=0 as *BootNode;return true;
}
// Return true only if every normal path exits. Assignment meet discards the
// already-exited branch; a loop never establishes assignment after zero trips.
fn bs_statement(state:*BootScriptState,node:*BootNode)->bool{
 let ctx:*BootContext=state.context;if node==0 as *BootNode||ctx.failed{return false;}
 if node.kind==BN_BLOCK{let mut item:*BootNode=node.body;let mut exits:bool=false;while item!=0 as *BootNode&&!ctx.failed{let this_exit:bool=bs_statement(state,item);exits=exits||this_exit;item=item.next;}return exits;}
 if node.kind==BN_ASSIGN{
  if node.left.kind==BN_IDENT{
   let local:*BootScriptLocal=bs_local(state,node.left.name);
   if node.op!=0&&(local==0 as *BootScriptLocal||!local.assigned){boot_error(ctx,node.token,"compound assignment requires an assigned Script local");return false;}
   let actual:*BootType=bs_typed(state,node.right,0 as *BootType);if ctx.failed{return false;}
   if actual.kind==BY_VOID{boot_error(ctx,node.token,"Script cannot bind a void value");return false;}
   let binding:*BootScriptLocal=bs_bind(state,node.left.name,actual,node.token,0 as *BootNode);if ctx.failed{return false;}binding.assigned=true;
  }else{bs_typed(state,node.left,0 as *BootType);bs_typed(state,node.right,0 as *BootType);}return false;
 }
 if node.kind==BN_IF{
  let condition:*BootType=bs_typed(state,node.left,0 as *BootType);if ctx.failed{return false;}if condition.kind!=BY_BOOL{boot_error(ctx,node.token,"Script condition must be bool");return false;}
  let before:*BootScriptAssigned=bs_snapshot(state);let then_exit:bool=bs_statement(state,node.body);let after:*BootScriptAssigned=bs_snapshot(state);bs_restore(state,before);
  let else_exit:bool=bs_statement(state,node.third);if then_exit{}else if else_exit{bs_restore(state,after);}else{bs_meet(state,after);}return then_exit&&else_exit;
 }
 if node.kind==BN_WHILE{
  let condition:*BootType=bs_typed(state,node.left,0 as *BootType);if ctx.failed{return false;}if condition.kind!=BY_BOOL{boot_error(ctx,node.token,"Script condition must be bool");return false;}
  let before:*BootScriptAssigned=bs_snapshot(state);state.loop_depth=state.loop_depth+1;bs_statement(state,node.body);state.loop_depth=state.loop_depth-1;bs_restore(state,before);return false;
 }
 if node.kind==BS_FOR{bs_for(state,node);return false;}
 if node.kind==BN_RETURN{
  if node.left!=0 as *BootNode{
   let actual:*BootType=bs_typed(state,node.left,0 as *BootType);if ctx.failed{return true;}
   if strcmp(state.function.name,"main")==0&&state.function.ty.kind==BY_I32&&actual.kind==BY_I64{let cast:*BootNode=boot_node(ctx,BN_CAST,node.token);if ctx.failed{return true;}cast.ty=state.function.ty;cast.left=node.left;node.left=cast;}
  }
