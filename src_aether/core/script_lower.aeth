fn bs_assignment(ctx:*BootContext,name:*u8,value:*BootNode,token:*BootToken)->*BootNode{
 let node:*BootNode=boot_node(ctx,BN_ASSIGN,token);if !ctx.failed{node.left=bs_identifier(ctx,name,token);node.right=value;}return node;
}
fn bs_fresh(ctx:*BootContext,token:*BootToken)->*u8{
