 }
 if node.kind==BN_IDENT{
  let local:*BootScriptLocal=bs_local(state,node.name);if local!=0 as *BootScriptLocal&&!local.assigned{boot_error(ctx,node.token,"Script variable may be used before assignment");return false;}return true;
 }
 if node.kind==BN_CALL{
  if node.left==0 as *BootNode&&node.lookup==0 as *BootModule&&node.name!=0 as *u8&&bs_local(state,node.name)!=0 as *BootScriptLocal{node.left=bs_identifier(ctx,node.name,node.token);}
  if node.left!=0 as *BootNode&&(node.flags&131072)==0{
   if !bs_prepare_expr(state,node.left){return false;}let mut argument:*BootNode=node.params;while argument!=0 as *BootNode{if !bs_prepare_expr(state,argument){return false;}argument=argument.next;}return true;
  }
  if node.left!=0 as *BootNode{
   if node.left.kind==BN_IDENT&&bs_local(state,node.left.name)==0 as *BootScriptLocal{
    let mut imported:*BootImport=ctx.module.imports;
    while imported!=0 as *BootImport{if imported.symbol==0 as *u8&&strcmp(imported.alias,node.left.name)==0{node.lookup=imported.target;}imported=imported.next;}
    if node.lookup!=0 as *BootModule{node.left=0 as *BootNode;}
   }
   if node.left!=0 as *BootNode{
    if !bs_prepare_expr(state,node.left){return false;}
    let mut argument:*BootNode=node.params;while argument!=0 as *BootNode{if !bs_prepare_expr(state,argument){return false;}argument=argument.next;}
    node.kind=BN_METHOD_CALL;return true;
   }
  }
  let mut argument:*BootNode=node.params;while argument!=0 as *BootNode{if !bs_prepare_expr(state,argument){return false;}argument=argument.next;}
  let declared:*BootNode=boot_lookup(ctx,node.name,node.lookup,node.token);if ctx.failed{return false;}
  if node.lookup==0 as *BootModule&&declared==0 as *BootNode&&bs_local(state,node.name)==0 as *BootScriptLocal&&strcmp(node.name,"repeat")==0{
   let value:*BootNode=node.params;
   if value==0 as *BootNode||value.next==0 as *BootNode||value.next.next!=0 as *BootNode||value.next.kind!=BN_INT{boot_error(ctx,node.token,"self-hosted Script repeat requires a value and nonnegative literal extent");return false;}
   let mut extent:u64=0;if !boot_integer_value(ctx,value.next.token,18446744073709551615,&mut extent as *u64){return false;}
   value.next=0 as *BootNode;node.kind=BN_REPEAT;node.left=value;node.params=0 as *BootNode;node.value=extent as i64;return true;
  }
  if node.lookup==0 as *BootModule&&declared==0 as *BootNode&&bs_local(state,node.name)==0 as *BootScriptLocal&&strcmp(node.name,"print")==0{
   if node.params==0 as *BootNode||node.params.next!=0 as *BootNode{boot_error(ctx,node.token,"Script print takes one argument");return false;}
   let actual:*BootType=boot_check_expr(ctx,node.params,0 as *BootType);if ctx.failed{return false;}
   let mut format:*u8=0 as *u8;
   if actual.kind==BY_I64{format="%lld\n";}else if actual.kind==BY_F64||actual.kind==BY_F32{format="%g\n";}else if actual.kind==BY_BOOL{format="%d\n";}else if actual.kind==BY_PTR&&actual.inner.kind==BY_U8{format="%s\n";}
   if format==0 as *u8{boot_error(ctx,node.token,"Script print supports int, float, bool or str");return false;}
   let text:*BootNode=bs_literal(ctx,BN_STRING,format,node.token);if ctx.failed{return false;}text.next=node.params;node.params=text;node.name="printf";node.lookup=bs_foreign_printf(ctx,node.token);return !ctx.failed;
  }
