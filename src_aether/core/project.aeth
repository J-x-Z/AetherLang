use host_platform::*;
// Native source graph loading. Imports precede declarations; imported files are
// read, lexed and parsed by this compiler, never concatenated by an external tool.
use model::*;
use runtime::*;
use lexer::boot_lex;
use parser::*;
use script_lexer::boot_script_lex;
use script_parser::boot_script_parse;
use script_lower::boot_script_lower;
use async_lower::boot_async_lower;
use script_model::{BS_INDENT,BS_DEDENT};

fn boot_project_word(token:*BootToken,word:*u8)->bool {
 return token!=(0 as *BootToken) && token.kind==BT_IDENT && strcmp(token.text,word)==0;
}
fn boot_project_name(ctx:*BootContext,token:*BootToken)->bool {
 if token==(0 as *BootToken) || token.kind!=BT_IDENT || boot_p_reserved(token.text) {boot_error(ctx,token,"expected an import identifier");return false;}
 return true;
}
pub fn boot_project_join(ctx:*BootContext,directory:*u8,name:*u8,suffix:*u8)->*u8 {
 let a:u64=strlen(directory);let b:u64=strlen(name);let c:u64=strlen(suffix);
 if a+b+c>8192 {boot_error(ctx,ctx.cursor,"module path exceeds 8192 bytes");return 0 as *u8;}
 let path:*u8=boot_alloc(ctx,a+b+c+2) as *u8;if path==(0 as *u8) {return path;}
 memcpy(path as *void,directory as *void,a);path[a]=47;
 memcpy((path+a+1) as *void,name as *void,b);
 memcpy((path+a+b+1) as *void,suffix as *void,c);path[a+b+c+1]=0;return path;
}
fn boot_script_path(path:*u8)->bool{let n:u64=strlen(path);return n>=4&&strcmp(path+(n-4),".ath")==0;}
fn boot_source_realpath(ctx:*BootContext,path:*u8)->*u8{
 let resolved:*u8=realpath(path,0 as *u8);if resolved!=0 as *u8{return resolved;}
 let doc:*BootOverlay=boot_overlay(ctx,path);if doc==0 as *BootOverlay{return 0 as *u8;}
 let n:u64=strlen(path);let copy:*u8=malloc(n+1) as *u8;
 if copy!=0 as *u8{memcpy(copy as *void,path as *void,n+1);}return copy;
}
fn boot_project_candidate(ctx:*BootContext,directory:*u8,name:*u8)->*u8 {
 let path:*u8=boot_project_join(ctx,directory,name,".aeth");if path==(0 as *u8) {return path;}
 let mut resolved:*u8=boot_source_realpath(ctx,path);
 if resolved==(0 as *u8) {
  let nested:*u8=boot_project_join(ctx,directory,name,"/mod.aeth");if nested==(0 as *u8) {return nested;}
  resolved=boot_source_realpath(ctx,nested);
 }
 if resolved==(0 as *u8) {
  let script:*u8=boot_project_join(ctx,directory,name,".ath");if ctx.failed{return 0 as *u8;}resolved=boot_source_realpath(ctx,script);
 }
 if resolved==(0 as *u8) {return resolved;}
 let result:*u8=boot_copy(ctx,resolved,strlen(resolved));free(resolved as *void);return result;
}
fn boot_project_find(ctx:*BootContext,module:*BootModule,name:*u8,token:*BootToken)->*u8 {
 let mut binding:*BootMappedModule=ctx.mapped;
 while binding!=0 as *BootMappedModule {
  if strcmp(binding.name,name)==0 {
   let flat:*u8=boot_project_join(ctx,module.directory,name,".aeth");
   let nested:*u8=boot_project_join(ctx,module.directory,name,"/mod.aeth");
   let script:*u8=boot_project_join(ctx,module.directory,name,".ath");
   if ctx.failed {return 0 as *u8;}
   if !boot_map_compatible(ctx,script,binding.path,token) || !boot_map_compatible(ctx,flat,binding.path,token) || !boot_map_compatible(ctx,nested,binding.path,token){return 0 as *u8;}
   return binding.path;
  }
  binding=binding.next;
 }
 let local:*u8=boot_project_candidate(ctx,module.directory,name);if local!=(0 as *u8) || ctx.failed {return local;}
 let mut root:*BootRoot=ctx.roots;
 while root!=(0 as *BootRoot) {
  let path:*u8=boot_project_candidate(ctx,root.path,name);if path!=(0 as *u8) || ctx.failed {return path;}
  root=root.next;
 }
 boot_error(ctx,token,"imported module not found in source directory or -I roots");return 0 as *u8;
}
pub fn boot_project_root(ctx:*BootContext,path:*u8)->bool {
 let resolved:*u8=realpath(path,0 as *u8);
 if resolved==(0 as *u8) {boot_error(ctx,0 as *BootToken,"cannot resolve -I root");return false;}
 let root:*BootRoot=boot_alloc(ctx,size_of(BootRoot) as u64) as *BootRoot;
 if root==(0 as *BootRoot) {free(resolved as *void);return false;}
 root.path=boot_copy(ctx,resolved,strlen(resolved));free(resolved as *void);if root.path==(0 as *u8) {return false;}
 if ctx.roots==(0 as *BootRoot) {ctx.roots=root;}
 else {let mut last:*BootRoot=ctx.roots;while last.next!=(0 as *BootRoot) {last=last.next;}last.next=root;}
 return true;
}
fn boot_project_read(ctx:*BootContext,module:*BootModule,token:*BootToken)->bool {
 let snapshot:*BootOverlay=boot_overlay(ctx,module.path);
 if snapshot!=0 as *BootOverlay{
  if snapshot.length>33554432-ctx.source_total{boot_error(ctx,token,"source graph must be at most 32 MiB");return false;}
  module.length=snapshot.length;module.source=boot_copy(ctx,snapshot.text,snapshot.length);
  if ctx.failed{return false;}ctx.source_total=ctx.source_total+module.length;return true;
 }

 let file:*void=fopen(module.path,"rb");if file==(0 as *void) {boot_error(ctx,token,"cannot open module source");return false;}
 if fseek(file,0,2)!=0 {fclose(file);boot_error(ctx,token,"cannot seek module source");return false;}
 let measured:i64=ftell(file);
 if measured<0 || measured>33554432 || (measured as u64)>33554432-ctx.source_total {fclose(file);boot_error(ctx,token,"source graph must be at most 32 MiB");return false;}
 if fseek(file,0,0)!=0 {fclose(file);boot_error(ctx,token,"cannot rewind module source");return false;}
 module.length=measured as u64;module.source=boot_alloc(ctx,module.length+1) as *u8;
 if module.source==(0 as *u8) {fclose(file);return false;}
 let count:u64=fread(module.source as *void,1,module.length,file);let failed:i32=ferror(file);let closed:i32=fclose(file);
 if count!=module.length || failed!=0 || closed!=0 {boot_error(ctx,token,"cannot completely read module source");return false;}
 module.source[module.length]=0;ctx.source_total=ctx.source_total+module.length;return true;
}
fn boot_project_context(ctx:*BootContext,module:*BootModule) {
 ctx.module=module;ctx.path=module.path;ctx.source=module.source;ctx.length=module.length;ctx.tokens=module.tokens;
}
fn boot_project_load(ctx:*BootContext,path:*u8,depth:i32,token:*BootToken)->*BootModule {
 if depth>64 {boot_error(ctx,token,"module import depth exceeds 64");return 0 as *BootModule;}
 let mut found:*BootModule=ctx.modules;
 while found!=(0 as *BootModule) {
  if !found.inline_module && strcmp(found.path,path)==0 {if found.state==1 {boot_error(ctx,token,"cyclic module import");return 0 as *BootModule;}return found;}
  found=found.next;
 }
 if ctx.module_count>=256 {boot_error(ctx,token,"source graph exceeds 256 modules");return 0 as *BootModule;}
 let module:*BootModule=boot_alloc(ctx,size_of(BootModule) as u64) as *BootModule;if module==(0 as *BootModule) {return module;}
 module.path=path;module.state=1;ctx.module_count=ctx.module_count+1;module.id=ctx.module_count;
 let mut length:u64=strlen(path);while length>0 && path[length-1]!=47 {length=length-1;}
 if length>1 {length=length-1;}module.directory=boot_copy(ctx,path,length);
 if ctx.modules==(0 as *BootModule) {ctx.modules=module;ctx.root_module=module;}else{ctx.modules_tail.next=module;}ctx.modules_tail=module;
 if !boot_project_read(ctx,module,token) {return 0 as *BootModule;}
 boot_project_context(ctx,module);
 let script:bool=boot_script_path(path);
 if script{if !boot_script_lex(ctx){return 0 as *BootModule;}}else{if !boot_lex(ctx){return 0 as *BootModule;}}module.tokens=ctx.tokens;
 return boot_expand_module(ctx,module,script,depth);
}
fn boot_declare_modules(ctx:*BootContext,module:*BootModule,depth:i32)->bool{
 let mut current:*BootToken=module.tokens;let mut previous:*BootToken=0 as *BootToken;let mut braces:i32=0;
 while current.kind!=BT_EOF && !ctx.failed{
  let mut keyword:*BootToken=current;let public:bool=boot_project_word(current,"pub");
  if public{keyword=current.next;}
  if braces!=0 || !boot_project_word(keyword,"mod"){
   if current.kind==123{braces=braces+1;}else if current.kind==125 && braces>0{braces=braces-1;}
   previous=current;current=current.next;continue;
  }
  let origin:*BootToken=keyword;let name:*BootToken=keyword.next;
  if !boot_project_name(ctx,name){return false;}
  let mut child:*BootModule=0 as *BootModule;let mut next:*BootToken=name.next;
  if next.kind==59{
   let path:*u8=boot_project_find(ctx,module,name.text,origin);if ctx.failed{return false;}
   child=boot_project_load(ctx,path,depth+1,origin);if ctx.failed{return false;}next=next.next;
  }else if next.kind==123{
   let mut binding:*BootMappedModule=ctx.mapped;while binding!=0 as *BootMappedModule{
    if strcmp(binding.name,name.text)==0{boot_error(ctx,name,"explicit module conflicts with inline module");return false;}binding=binding.next;
   }
   if depth>=64 || ctx.module_count>=256{boot_error(ctx,name,"module graph limit exceeded");return false;}
   let start:*BootToken=next.next;let mut end:*BootToken=start;let mut nesting:i32=1;
   while end.kind!=BT_EOF{
    if end.kind==123{nesting=nesting+1;}else if end.kind==125{nesting=nesting-1;if nesting==0{break;}}
    end=end.next;
   }
   if end.kind!=125{boot_error(ctx,origin,"unterminated inline module");return false;}
   next=end.next;end.kind=BT_EOF;end.next=0 as *BootToken;
   child=boot_alloc(ctx,size_of(BootModule) as u64) as *BootModule;if ctx.failed{return false;}
   ctx.module_count=ctx.module_count+1;child.id=ctx.module_count;child.inline_module=true;child.path=module.path;child.directory=module.directory;
   child.source=module.source;child.length=module.length;child.tokens=start;child.state=1;
   ctx.modules_tail.next=child;ctx.modules_tail=child;boot_project_context(ctx,child);
   child=boot_expand_module(ctx,child,false,depth+1);if ctx.failed{return false;}
  }else{boot_error(ctx,next,"expected ';' or an inline module body");return false;}
  boot_project_context(ctx,module);
  if !boot_project_import(ctx,module,child,name.text,0 as *u8,false,public,origin){return false;}
  if previous==0 as *BootToken{module.tokens=next;}else{previous.next=next;}current=next;
 }
 return !ctx.failed;
}
fn boot_expand_module(ctx:*BootContext,module:*BootModule,script:bool,depth:i32)->*BootModule {
 if !script && !boot_declare_modules(ctx,module,depth){return 0 as *BootModule;}
 let mut cursor:*BootToken=module.tokens;let mut previous_token:*BootToken=0 as *BootToken;let mut braces:i32=0;
 while cursor.kind!=BT_EOF {
  let public:bool=braces==0 && boot_project_word(cursor,"pub") && boot_project_word(cursor.next,"use");
  if public{cursor=cursor.next;}
  if braces!=0||!boot_project_word(cursor,"use"){
   if cursor.kind==123||(script&&cursor.kind==BS_INDENT){braces=braces+1;}else{if (cursor.kind==125||(script&&cursor.kind==BS_DEDENT))&&braces>0{braces=braces-1;}}
   previous_token=cursor;cursor=cursor.next;continue;
  }
  let original:*BootToken=cursor;cursor=cursor.next;
  if !boot_project_name(ctx,cursor){return 0 as *BootModule;}
  let name:*u8=cursor.text;cursor=cursor.next;
  let mut selected:bool=false;let mut grouped:bool=false;
  if cursor.kind==58{
   selected=true;cursor=cursor.next;if cursor.kind!=58{boot_error(ctx,cursor,"expected :: in import");return 0 as *BootModule;}cursor=cursor.next;
   if cursor.kind==123{grouped=true;cursor=cursor.next;}
  }
  let mut target:*BootModule=boot_child_module(module,name,false);
  if target==0 as *BootModule{
   let target_path:*u8=boot_project_find(ctx,module,name,original);if ctx.failed{return 0 as *BootModule;}
   target=boot_project_load(ctx,target_path,depth+1,original);if ctx.failed{return 0 as *BootModule;}
  }
  while selected && !grouped && cursor.kind==BT_IDENT && cursor.next.kind==58{
   target=boot_child_module(target,cursor.text,true);if target==0 as *BootModule{boot_error(ctx,cursor,"unknown or private nested module");return 0 as *BootModule;}
   cursor=cursor.next;if cursor.next.kind!=58{boot_error(ctx,cursor,"expected :: after module");return 0 as *BootModule;}cursor=cursor.next.next;
   if cursor.kind==123{grouped=true;cursor=cursor.next;}
  }
  boot_project_context(ctx,module);ctx.cursor=original;
  let mut complete:bool=false;
  while !complete{
   if grouped&&cursor.kind==125{cursor=cursor.next;break;}
   let mut alias:*u8=name;let mut symbol:*u8=0 as *u8;let mut wildcard:bool=false;
   if selected{
    if cursor.kind==42{wildcard=true;cursor=cursor.next;}
    else{if !boot_project_name(ctx,cursor){return 0 as *BootModule;}symbol=cursor.text;alias=symbol;cursor=cursor.next;}
   }
   if boot_project_word(cursor,"as"){
    if wildcard{boot_error(ctx,cursor,"wildcard import cannot have an alias");return 0 as *BootModule;}
    cursor=cursor.next;if !boot_project_name(ctx,cursor){return 0 as *BootModule;}alias=cursor.text;cursor=cursor.next;
   }
   if !boot_project_import(ctx,module,target,alias,symbol,wildcard,public,original){return 0 as *BootModule;}
   if !grouped{complete=true;}else{
    if cursor.kind==44{cursor=cursor.next;}
    else{if cursor.kind==125{cursor=cursor.next;complete=true;}else{boot_error(ctx,cursor,"expected ',' or '}' after grouped import");return 0 as *BootModule;}}
   }
  }
  if cursor.kind==59{cursor=cursor.next;}
  if previous_token==(0 as *BootToken){module.tokens=cursor;}else{previous_token.next=cursor;}
 }
 ctx.tokens=module.tokens;ctx.cursor=module.tokens;
 if script{if !boot_script_parse(ctx){return 0 as *BootModule;}}else{if !boot_parse(ctx){return 0 as *BootModule;}}module.items=ctx.program.body;module.state=2;return module;
}
pub fn boot_project(ctx:*BootContext,path:*u8)->bool {
 let canonical:*u8=boot_source_realpath(ctx,path);if canonical==(0 as *u8) {boot_error(ctx,0 as *BootToken,"cannot resolve input source");return false;}
 let owned:*u8=boot_copy(ctx,canonical,strlen(canonical));free(canonical as *void);if owned==(0 as *u8) {return false;}
 let root:*BootModule=boot_project_load(ctx,owned,0,0 as *BootToken);if root==(0 as *BootModule) {return false;}
 boot_project_context(ctx,root);ctx.cursor=root.tokens;
 let program:*BootNode=boot_node(ctx,BN_PROGRAM,root.tokens);if program==(0 as *BootNode) {return false;}
 let mut module:*BootModule=ctx.modules;let mut tail:*BootNode=0 as *BootNode;
 while module!=(0 as *BootModule) {
  if module.items!=(0 as *BootNode) {
   if tail==(0 as *BootNode) {program.body=module.items;}else{tail.next=module.items;}
   tail=module.items;while tail.next!=(0 as *BootNode) {tail=tail.next;}
  }
  module=module.next;
 }
 ctx.program=program;return boot_script_lower(ctx)&&boot_async_lower(ctx);
}
pub fn boot_project_output(ctx:*BootContext,path:*u8)->bool {
 let canonical:*u8=realpath(path,0 as *u8);if canonical==(0 as *u8) {return true;}
 let mut module:*BootModule=ctx.modules;let mut same:bool=false;
 while module!=(0 as *BootModule) {if strcmp(canonical,module.path)==0 {same=true;}module=module.next;}
 free(canonical as *void);
 if same {boot_error(ctx,0 as *BootToken,"output must not replace any module source");return false;}
 return true;
}

fn boot_project_import(ctx:*BootContext,module:*BootModule,initial_target:*BootModule,alias:*u8,initial_symbol:*u8,wildcard:bool,exported:bool,token:*BootToken)->bool{
 let mut target:*BootModule=initial_target;let mut symbol:*u8=initial_symbol;
 let mut previous:*BootImport=module.imports;let mut tail:*BootImport=0 as *BootImport;
 while previous!=(0 as *BootImport){if strcmp(previous.alias,alias)==0{boot_error(ctx,token,"duplicate import binding");return false;}tail=previous;previous=previous.next;}
 if symbol!=0 as *u8 {
  let child:*BootModule=boot_child_module(target,symbol,true);
  if child!=0 as *BootModule{target=child;symbol=0 as *u8;}
  else if boot_public_item(ctx,target,symbol,token)==0 as *BootNode{boot_error(ctx,token,"unknown or private imported name");return false;}
 }
 if exported && (wildcard || symbol!=0 as *u8){module.has_reexports=true;}
 let import:*BootImport=boot_alloc(ctx,size_of(BootImport) as u64) as *BootImport;if import==(0 as *BootImport){return false;}
 import.alias=alias;import.symbol=symbol;import.target=target;import.wildcard=wildcard;import.exported=exported;import.token=token;
 if tail==(0 as *BootImport){module.imports=import;}else{tail.next=import;}return true;
}

// Exact JXZ package bindings do not expose sibling files as search roots.
fn boot_map_compatible(ctx:*BootContext,candidate:*u8,path:*u8,token:*BootToken)->bool {
 let actual:*u8=realpath(candidate,0 as *u8);
 if actual==0 as *u8 {return true;}
 let same:bool=strcmp(actual,path)==0;free(actual as *void);
 if !same {boot_error(ctx,token,"explicit module conflicts with local module");}
 return same;
}
fn boot_aether_path(path:*u8)->bool {
 let n:u64=strlen(path);return (n>5 && strcmp(path+(n-5),".aeth")==0)||boot_script_path(path);
}
pub fn boot_project_map(ctx:*BootContext,spec:*u8)->bool {
 let mut i:u64=0;
 while spec[i]!=0 && spec[i]!=61 {
  let ch:u8=spec[i];
  if !((ch>=65 && ch<=90)||(ch>=97 && ch<=122)||ch==95||(i>0 && ch>=48 && ch<=57)) {
   boot_error(ctx,ctx.cursor,"invalid explicit module name");return false;
  }
  i=i+1;
 }
 if i==0 || spec[i]!=61 {boot_error(ctx,ctx.cursor,"--module requires NAME=FILE.aeth");return false;}
 let name:*u8=boot_copy(ctx,spec,i);if ctx.failed{return false;}
 if boot_p_reserved(name){boot_error(ctx,ctx.cursor,"reserved explicit module name");return false;}
 let mut previous:*BootMappedModule=ctx.mapped;
 while previous!=0 as *BootMappedModule {
  if strcmp(previous.name,name)==0 {boot_error(ctx,ctx.cursor,"duplicate explicit module");return false;}
  previous=previous.next;
 }
 let filename:*u8=spec+i+1;
 if !boot_aether_path(filename){boot_error(ctx,ctx.cursor,"explicit module requires a .aeth or .ath source file");return false;}
 let real:*u8=realpath(filename,0 as *u8);
 if real==0 as *u8 {boot_error(ctx,ctx.cursor,"cannot resolve explicit module");return false;}
 let binding:*BootMappedModule=boot_alloc(ctx,size_of(BootMappedModule) as u64) as *BootMappedModule;
 if binding==0 as *BootMappedModule {free(real as *void);return false;}
 let valid:bool=boot_aether_path(real);binding.path=boot_copy(ctx,real,strlen(real));free(real as *void);
 if !valid || ctx.failed {boot_error(ctx,ctx.cursor,"explicit module must resolve to .aeth");return false;}
 binding.name=name;binding.next=ctx.mapped;ctx.mapped=binding;return true;
}
