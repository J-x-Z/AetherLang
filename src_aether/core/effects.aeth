// Function effect bounds are checked on the resolved call graph. A field access
// reads its pointer-valued base, but taking a local field's address is pure.
use model::*;
use runtime::*;
pub const FX_READ:i32=1; pub const FX_WRITE:i32=2; pub const FX_IO:i32=4;
pub const FX_ALLOC:i32=8; pub const FX_PANIC:i32=16; pub const FX_ALL:i32=31;
pub fn boot_effect_name(name:*u8)->i32{
 if strcmp(name,"read")==0 || strcmp(name,"reads")==0{return FX_READ;}
 if strcmp(name,"write")==0 || strcmp(name,"writes")==0{return FX_WRITE;}
 if strcmp(name,"io")==0{return FX_IO;}if strcmp(name,"alloc")==0 || strcmp(name,"allocs")==0{return FX_ALLOC;}
 if strcmp(name,"panic")==0 || strcmp(name,"panics")==0{return FX_PANIC;}
 if strcmp(name,"pure")==0{return 0;}return -1;
}
fn boot_known_effect(name:*u8)->i32{
 if strcmp(name,"puts")==0 || strcmp(name,"println")==0 || strcmp(name,"print")==0 || strcmp(name,"print_i64")==0 || strcmp(name,"println_i64")==0{return FX_IO;}
 if strcmp(name,"malloc")==0 || strcmp(name,"free")==0 || strcmp(name,"alloc")==0{return FX_ALLOC;}
 if strcmp(name,"atof")==0 || strcmp(name,"strcmp")==0{return FX_READ;}
 if strcmp(name,"exit")==0 || strcmp(name,"assert")==0{return FX_PANIC;}return 0;
}
fn boot_effect_edge(ctx:*BootContext,source:*BootNode,target:*BootNode){
 let mut edge:*BootCallEdge=source.calls;
 while edge!=0 as *BootCallEdge{if edge.callee==target{return;}edge=edge.next;}
 edge=boot_alloc(ctx,size_of(BootCallEdge) as u64) as *BootCallEdge;
 if !ctx.failed{edge.callee=target;edge.next=source.calls;source.calls=edge;}
}
fn boot_external_place(node:*BootNode)->bool{
 if node.kind==BN_IDENT{return node.decl!=0 as *BootNode && node.decl.kind==BN_STATIC;}
 if node.kind==BN_UNARY{return node.op==42;}
 if node.kind==BN_INDEX || node.kind==BN_MEMBER{return boot_indirect(node.left.ty) || boot_external_place(node.left);}
 return false;
}
fn boot_effect_walk(ctx:*BootContext,function:*BootNode,node:*BootNode,access:i32){
 if node==0 as *BootNode || ctx.failed{return;}
 if boot_external_place(node){function.effect_bits=function.effect_bits|access;}
 if node.kind==BN_HALT{function.effect_bits=function.effect_bits|FX_PANIC;}
 if node.kind==BN_MEMORY{function.effect_bits=function.effect_bits|node.host_effect;}
 if node.kind==BN_ERRNO{function.effect_bits=function.effect_bits|FX_READ;}
 if node.kind==BN_CALL && node.decl!=0 as *BootNode{if node.host_effect!=0{function.effect_bits=function.effect_bits|node.host_effect;}else{boot_effect_edge(ctx,function,node.decl);}}
 let mut left_access:i32=FX_READ;
 if node.kind==BN_ASSIGN{left_access=FX_WRITE;if node.op!=0{left_access=FX_READ|FX_WRITE;}}
 if node.kind==BN_UNARY && node.op==38{left_access=0;}
 if (node.kind==BN_INDEX || node.kind==BN_MEMBER) && !boot_indirect(node.left.ty){left_access=0;}
 boot_effect_walk(ctx,function,node.left,left_access);boot_effect_walk(ctx,function,node.right,FX_READ);
 boot_effect_walk(ctx,function,node.third,FX_READ);
 let mut p:*BootNode=node.params;while p!=0 as *BootNode{boot_effect_walk(ctx,function,p,FX_READ);p=p.next;}
 p=node.body;while p!=0 as *BootNode{boot_effect_walk(ctx,function,p,FX_READ);p=p.next;}
}
pub fn boot_check_effects(ctx:*BootContext)->bool{
 let mut f:*BootNode=ctx.program.body;let mut check:bool=false;
 while f!=0 as *BootNode{
  if f.kind==BN_FN && f.generics==0 as *BootNode && (f.flags&2)==0 && f.effect_explicit{check=true;break;}f=f.next;
 }
 if !check{return true;}
 f=ctx.program.body;
 while f!=0 as *BootNode && !ctx.failed{
  if f.kind==BN_FN && f.generics==0 as *BootNode{
   if (f.flags&2)!=0{
    let known:i32=boot_known_effect(f.name);
    f.effect_bits=f.effect_limit|known;
    let definition:*BootNode=boot_symbol_definition(ctx,f);
    if definition!=0 as *BootNode{boot_effect_edge(ctx,f,definition);}
    else if !f.effect_explicit && known==0{f.effect_bits=FX_ALL;}
    let mut other:*BootNode=ctx.program.body;
    while other!=0 as *BootNode{
     if other!=f && (other.flags&2)!=0 && other.kind==BN_FN && strcmp(other.name,f.name)==0{boot_effect_edge(ctx,f,other);}
     other=other.next;
    }
   }else{if (f.flags&BF_VOLATILE)!=0{f.effect_bits=f.effect_bits|FX_READ|FX_WRITE;}boot_effect_walk(ctx,f,f.body,FX_READ);}
  }
  f=f.next;
 }
 let mut changed:bool=true;
 while changed && !ctx.failed{
  changed=false;f=ctx.program.body;
  while f!=0 as *BootNode{
   let mut bits:i32=f.effect_bits;let mut edge:*BootCallEdge=f.calls;
   while edge!=0 as *BootCallEdge{bits=bits|edge.callee.effect_bits;edge=edge.next;}
   if bits!=f.effect_bits{f.effect_bits=bits;changed=true;}f=f.next;
  }
 }
 f=ctx.program.body;
 while f!=0 as *BootNode{
  if f.kind==BN_FN && (f.flags&2)==0 && f.effect_explicit && (f.effect_bits&(~f.effect_limit))!=0{
   boot_error(ctx,f.token,"function exceeds its declared effect upper bound");return false;
  }
  f=f.next;
 }
 return !ctx.failed;
}
