use model::*;
use runtime::*;
use emitter::{boot_choose_namespace,boot_storage_name};
use llvm_common::*;
use llvm_expr::ll_statement;
fn ll_foreign_valid(ctx:*BootContext,node:*BootNode)->bool{
 if node.ty.kind==BY_STRUCT || node.ty.kind==BY_ARRAY {boot_error(ctx,node.token,"Core LLVM foreign aggregate return ABI is not implemented");return false;}
 let mut param:*BootNode=node.params;while param!=(0 as *BootNode){
  if param.ty.kind==BY_STRUCT || param.ty.kind==BY_ARRAY {boot_error(ctx,param.token,"Core LLVM foreign aggregate parameter ABI is not implemented");return false;}param=param.next;
 }return true;
}
fn ll_signature(ctx:*BootContext,node:*BootNode){
 let foreign:bool=(node.flags&2)!=0;
 if foreign{ll_text(ctx,"declare ");}else if boot_c_symbol(node){ll_text(ctx,"define ");}else{ll_text(ctx,"define internal ");}
 if boot_c_symbol(node){ll_attr(ctx,node.ty);}
 ll_return_type(ctx,node.ty);ll_text(ctx," ");ll_function(ctx,node);ll_text(ctx,"(");let mut param:*BootNode=node.params;
 while param!=(0 as *BootNode){
  ll_type(ctx,param.ty);ll_text(ctx," ");if boot_c_symbol(node){ll_attr(ctx,param.ty);}if !foreign{fprintf(ctx.output,"%%arg%d",param.id);}
  param=param.next;if param!=(0 as *BootNode){ll_text(ctx,", ");}
 }
 if (node.flags&4)!=0{ll_text(ctx,", ...");}ll_text(ctx,")");
}
fn ll_intrinsics(ctx:*BootContext){
 ll_text(ctx,"declare void @llvm.trap()\n");let mut width:i32=8;
 while width<=64{
  fprintf(ctx.output,"declare i%d @llvm.fptosi.sat.i%d.f32(float)\n",width,width);
  fprintf(ctx.output,"declare i%d @llvm.fptoui.sat.i%d.f32(float)\n",width,width);
  fprintf(ctx.output,"declare i%d @llvm.fptosi.sat.i%d.f64(double)\n",width,width);
  fprintf(ctx.output,"declare i%d @llvm.fptoui.sat.i%d.f64(double)\n",width,width);width=width*2;
 }
}
fn ll_global_place(ctx:*BootContext,node:*BootNode){
 if node.kind==BN_IDENT{ll_text(ctx,"@");boot_storage_name(ctx,node.decl);return;}
 ll_text(ctx,"getelementptr (");ll_type(ctx,node.left.ty);ll_text(ctx,", ptr ");ll_global_place(ctx,node.left);
 if node.kind==BN_MEMBER{fprintf(ctx.output,", i32 0, i32 %d)",ll_field_index(node.left.ty,node.decl));}
 else{fprintf(ctx.output,", i32 0, i64 %llu)",node.right.value as u64);}
}
fn ll_initializer(ctx:*BootContext,node:*BootNode){
 if boot_zero_initializer(node){ll_text(ctx,"zeroinitializer");return;}
 if node.kind==BN_CAST{if node.left.ty.kind==BY_PTR{ll_initializer(ctx,node.left);}else{ll_text(ctx,"null");}return;}
 if node.kind==BN_STRING{fprintf(ctx.output,"@a%d_str%d",ctx.c_namespace,node.id);return;}
 if node.kind==BN_UNARY && node.op==38{ll_global_place(ctx,node.left);return;}
 if node.kind==BN_STRUCT_VALUE{
  ll_text(ctx,"{");let mut field:*BootNode=node.ty.fields;
  while field!=0 as *BootNode{
   let mut init:*BootNode=node.params;while init.decl!=field{init=init.next;}
   ll_type(ctx,field.ty);ll_text(ctx," ");ll_initializer(ctx,init.left);
   field=field.next;if field!=0 as *BootNode{ll_text(ctx,",");}
  }
  ll_text(ctx,"}");return;
 }
 if node.kind==BN_ARRAY || node.kind==BN_REPEAT{
  ll_text(ctx,"[");let mut i:u64=0;let mut value:*BootNode=node.params;
  while i<node.ty.extent{if i!=0{ll_text(ctx,",");}ll_type(ctx,node.ty.inner);ll_text(ctx," ");
   if node.kind==BN_REPEAT{ll_initializer(ctx,node.left);}else{ll_initializer(ctx,value);value=value.next;}i=i+1;
  }
  ll_text(ctx,"]");return;
 }
 if ll_float(node.ty){ll_literal(ctx,node,node.ty);}else{ll_integer(ctx,node.value,node.ty);}
}
fn ll_storage(ctx:*BootContext,item:*BootNode){
 let foreign:bool=(item.flags&2)!=0;
 if foreign{
  if boot_symbol_definition(ctx,item)!=0 as *BootNode{return;}
  let mut prior:*BootNode=ctx.program.body;
  while prior!=item{if prior.kind==BN_STATIC && (prior.flags&2)!=0 && strcmp(prior.name,item.name)==0{return;}prior=prior.next;}
 }
 ll_text(ctx,"@");boot_storage_name(ctx,item);ll_text(ctx," = ");
 if foreign{ll_text(ctx,"external ");}else if !boot_c_symbol(item) && (item.flags&8)==0{ll_text(ctx,"internal ");}
 if (item.flags&1)==0{ll_text(ctx,"constant ");}else{ll_text(ctx,"global ");}
 ll_type(ctx,item.ty);if !foreign{ll_text(ctx," ");ll_initializer(ctx,item.left);}ll_text(ctx,"\n");
}
pub fn boot_llvm_supported(ctx:*BootContext)->bool {
 let mut item:*BootNode=ctx.program.body;
 while item!=0 as *BootNode {
  if item.kind==BN_FN && boot_c_symbol(item) && !ll_foreign_valid(ctx,item){return false;}
  item=item.next;
 }
 return true;
}
pub fn boot_emit_llvm(ctx:*BootContext)->bool{
 if ctx.failed||ctx.program==(0 as *BootNode)||ctx.output==(0 as *void){return false;}
 if !boot_choose_namespace(ctx){return false;}
 let mut item:*BootNode=ctx.program.body;
 ll_text(ctx,"; Aether Core direct LLVM IR (64-bit host ABI)\n");ll_intrinsics(ctx);
 if ctx.uses_errno && !ctx.errno_declared {fprintf(ctx.output,"declare ptr @%s()\n",ctx.errno_name);}
 let mut ty:*BootType=ctx.types;
 while ty!=(0 as *BootType){
  if ty.kind==BY_STRUCT{
   ll_type(ctx,ty);ll_text(ctx," = type { ");let mut field:*BootNode=ty.fields;
   while field!=(0 as *BootNode){ll_type(ctx,field.ty);field=field.next;if field!=(0 as *BootNode){ll_text(ctx,", ");}}
   ll_text(ctx," }\n");
  }ty=ty.next;
 }
 ll_globals(ctx,ctx.program.body);item=ctx.program.body;
 while item!=(0 as *BootNode){
  if item.kind==BN_STATIC{ll_storage(ctx,item);}
  if item.kind==BN_CONST{
   fprintf(ctx.output,"@a%d_c%d = private constant ",ctx.c_namespace,item.id);ll_type(ctx,item.ty);ll_text(ctx," ");
   if ll_float(item.ty){ll_literal(ctx,item.left,item.ty);}else{ll_integer(ctx,item.value,item.ty);}ll_text(ctx,"\n");
  }
  if item.kind==BN_FN&&(item.flags&2)!=0{
   let mut previous:*BootNode=ctx.program.body;let mut duplicate:bool=false;
   while previous!=item{if previous.kind==BN_FN&&(previous.flags&2)!=0&&strcmp(previous.name,item.name)==0{duplicate=true;}previous=previous.next;}
   if !duplicate && boot_symbol_definition(ctx,item)==0 as *BootNode{ll_signature(ctx,item);ll_text(ctx,"\n");}
  }item=item.next;
 }
 item=ctx.program.body;
 while item!=(0 as *BootNode)&&!ctx.failed{
  if item.kind==BN_FN&&(item.flags&2)==0&&item.generics==(0 as *BootNode){
   ctx.llvm_serial=0;ctx.llvm_break=0;ctx.llvm_continue=0;ll_signature(ctx,item);ll_text(ctx," {\n");ll_label(ctx,0);
   ll_allocas(ctx,item.params);ll_allocas(ctx,item.body);
   let mut param:*BootNode=item.params;while param!=(0 as *BootNode){ll_text(ctx,"  store ");ll_type(ctx,param.ty);fprintf(ctx.output," %%arg%d, ptr %%v%d\n",param.id,param.id);param=param.next;}
   ll_statement(ctx,item.body);
   if !ctx.llvm_terminated{if item.ty.kind==BY_VOID{ll_text(ctx,"  ret void\n");}else{ll_text(ctx,"  unreachable\n");}}
   ll_text(ctx,"}\n");
  }item=item.next;
 }
 item=ctx.program.body;
 while item!=(0 as *BootNode){
  if item.kind==BN_FN&&(item.flags&2)==0&&!ctx.no_main&&item.owner==ctx.root_module&&strcmp(item.name,"main")==0{
   ll_text(ctx,"define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  ");if item.ty.kind!=BY_VOID{ll_text(ctx,"%result = ");}
   ll_text(ctx,"call ");ll_return_type(ctx,item.ty);ll_text(ctx," ");ll_function(ctx,item);ll_text(ctx,"(");if item.params!=(0 as *BootNode){ll_text(ctx,"i32 %argc, ptr %argv");}ll_text(ctx,")\n");
   if item.ty.kind==BY_VOID{ll_text(ctx,"  ret i32 0\n}");}else{ll_text(ctx,"  ret i32 %result\n}");}ll_text(ctx,"\n");
  }item=item.next;
 }
 if ferror(ctx.output)!=0{boot_error(ctx,ctx.cursor,"failed writing LLVM IR");}return !ctx.failed;
}
