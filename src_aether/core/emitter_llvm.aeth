use model::*;
use runtime::*;
use emitter::{boot_choose_namespace,boot_storage_name};
use llvm_common::*;
use llvm_expr::ll_statement;
use native_abi::*;
use llvm_native::*;
fn ll_signature(ctx:*BootContext,node:*BootNode){
 let foreign:bool=(node.flags&2)!=0;let native_scalar:bool=boot_c_symbol(node) && !boot_abi_needed(node);
 if foreign{ll_text(ctx,"declare ");}else if native_scalar{ll_text(ctx,"define ");}else{ll_text(ctx,"define internal ");}
 let irq:bool=(node.flags&BF_INTERRUPT)!=0;
 if irq{ll_text(ctx,"x86_intrcc ");}
 if native_scalar{ll_attr(ctx,node.ty);}
 ll_return_type(ctx,node.ty);ll_text(ctx," ");ll_function(ctx,node);ll_text(ctx,"(");let mut param:*BootNode=node.params;
 while param!=(0 as *BootNode){
  ll_type(ctx,param.ty);ll_text(ctx," ");
  if irq && param==node.params{ll_text(ctx,"byval(");ll_type(ctx,param.ty.inner);ll_text(ctx,") ");}
  if native_scalar{ll_attr(ctx,param.ty);}if !foreign{fprintf(ctx.output,"%%arg%d",param.id);}
  param=param.next;if param!=(0 as *BootNode){ll_text(ctx,", ");}
 }
 if (node.flags&4)!=0{ll_text(ctx,", ...");}ll_text(ctx,")");
 if irq{ll_text(ctx," noinline noimplicitfloat \"target-features\"=\"-sse,-sse2,-mmx,-x87,-avx,-avx2\"");}
}
fn ll_intrinsics(ctx:*BootContext){
 ll_text(ctx,"declare void @llvm.trap()\n");let mut width:i32=8;
 while width<=64{
  fprintf(ctx.output,"declare i%d @llvm.fptosi.sat.i%d.f32(float)\n",width,width);
  fprintf(ctx.output,"declare i%d @llvm.fptoui.sat.i%d.f32(float)\n",width,width);
  fprintf(ctx.output,"declare i%d @llvm.fptosi.sat.i%d.f64(double)\n",width,width);
  fprintf(ctx.output,"declare i%d @llvm.fptoui.sat.i%d.f64(double)\n",width,width);width=width*2;
 }
}
fn ll_global_place(ctx:*BootContext,node:*BootNode){
 if node.kind==BN_IDENT{ll_text(ctx,"@");boot_storage_name(ctx,node.decl);return;}
 ll_text(ctx,"getelementptr (i8, ptr ");ll_global_place(ctx,node.left);
 let mut offset:u64=0;if node.kind==BN_MEMBER{offset=node.decl.value as u64;}else{offset=(node.right.value as u64)*node.ty.layout_size;}
 fprintf(ctx.output,", i64 %llu)",offset);
}
fn ll_initializer(ctx:*BootContext,node:*BootNode){
 if boot_zero_initializer(node){ll_text(ctx,"zeroinitializer");return;}
 if node.kind==BN_CAST{if boot_indirect(node.left.ty){ll_initializer(ctx,node.left);}else{ll_text(ctx,"null");}return;}
 if node.kind==BN_STRING{fprintf(ctx.output,"@a%d_str%d",ctx.c_namespace,node.id);return;}
 if node.kind==BN_UNARY && node.op==38{ll_global_place(ctx,node.left);return;}
 if node.kind==BN_STRUCT_VALUE{
  if node.ty.packed{ll_text(ctx,"<{");}else{ll_text(ctx,"{");}let mut field:*BootNode=node.ty.fields;
  while field!=0 as *BootNode{
   let mut init:*BootNode=node.params;while init.decl!=field{init=init.next;}
   ll_type(ctx,field.ty);ll_text(ctx," ");ll_initializer(ctx,init.left);
   field=field.next;if field!=0 as *BootNode{ll_text(ctx,",");}
  }
  if node.ty.packed{ll_text(ctx,"}>");}else{ll_text(ctx,"}");}return;
 }
 if node.kind==BN_ARRAY || node.kind==BN_REPEAT{
  ll_text(ctx,"[");let mut i:u64=0;let mut value:*BootNode=node.params;
  while i<node.ty.extent{if i!=0{ll_text(ctx,",");}ll_type(ctx,node.ty.inner);ll_text(ctx," ");
   if node.kind==BN_REPEAT{ll_initializer(ctx,node.left);}else{ll_initializer(ctx,value);value=value.next;}i=i+1;
  }
  ll_text(ctx,"]");return;
 }
 if ll_float(node.ty){ll_literal(ctx,node,node.ty);}else{ll_integer(ctx,node.value,node.ty);}
}
// An initialized union can contain a pointer relocation or an aggregate. Emit
// a byte-compatible packed constant with the active member's actual LLVM type.
// Opaque pointers let subsequent loads use the declared language record type.
fn ll_has_union(ty:*BootType)->bool{
 if ty.kind==BY_ARRAY{return ll_has_union(ty.inner);}
 if ty.kind!=BY_STRUCT{return false;}if ty.union_layout{return true;}
 let mut f:*BootNode=ty.fields;while f!=0 as *BootNode{if ll_has_union(f.ty){return true;}f=f.next;}return false;
}
fn ll_padding(ctx:*BootContext,count:u64,values:bool){
 fprintf(ctx.output,"[%llu x i8]",count);if values{ll_text(ctx," zeroinitializer");}
}
fn ll_physical_member(ctx:*BootContext,node:*BootNode,values:bool){
 ll_physical_init(ctx,node,false);
 if values{ll_text(ctx," ");ll_physical_init(ctx,node,true);}
}
fn ll_physical_init(ctx:*BootContext,node:*BootNode,values:bool){
 let ty:*BootType=node.ty;
 if !ll_has_union(ty) || boot_zero_initializer(node){
  if values{ll_initializer(ctx,node);}else{ll_type(ctx,ty);}return;
 }
 ll_text(ctx,"<{");let mut at:u64=0;let mut any:bool=false;
 if ty.kind==BY_ARRAY{
  let mut n:u64=0;let mut el:*BootNode=node.params;
  while n<ty.extent{
   if any{ll_text(ctx,", ");}any=true;
   if node.kind==BN_REPEAT{ll_physical_member(ctx,node.left,values);}else{ll_physical_member(ctx,el,values);el=el.next;}
   n=n+1;
  }
  at=ty.layout_size;
 }else{
  let mut f:*BootNode=ty.fields;if ty.union_layout{f=node.params.decl;}
  while f!=0 as *BootNode{
   if any{ll_text(ctx,", ");}any=true;
   let offset:u64=f.value as u64;
   if offset>at{ll_padding(ctx,offset-at,values);ll_text(ctx,", ");}
   let mut entry:*BootNode=node.params;while entry.decl!=f{entry=entry.next;}
   ll_physical_member(ctx,entry.left,values);at=offset+f.ty.layout_size;
   if ty.union_layout{break;}f=f.next;
  }
 }
 if at<ty.layout_size{if any{ll_text(ctx,", ");}ll_padding(ctx,ty.layout_size-at,values);}
 ll_text(ctx,"}>");
}
fn ll_storage(ctx:*BootContext,item:*BootNode){
 let foreign:bool=(item.flags&2)!=0;
 if foreign{
  if boot_symbol_definition(ctx,item)!=0 as *BootNode{return;}
  let mut prior:*BootNode=ctx.program.body;
  while prior!=item{if prior.kind==BN_STATIC && (prior.flags&2)!=0 && strcmp(prior.name,item.name)==0{return;}prior=prior.next;}
 }
 ll_text(ctx,"@");boot_storage_name(ctx,item);ll_text(ctx," = ");
 if foreign{ll_text(ctx,"external ");}else if !boot_c_symbol(item) && (item.flags&8)==0{ll_text(ctx,"internal ");}
 if (item.flags&1)==0{ll_text(ctx,"constant ");}else{ll_text(ctx,"global ");}
 if !foreign && item.left!=0 as *BootNode && ll_has_union(item.ty){
  ll_physical_init(ctx,item.left,false);ll_text(ctx," ");ll_physical_init(ctx,item.left,true);
  fprintf(ctx.output,", align %llu\n",item.ty.layout_align);return;
 }
 ll_type(ctx,item.ty);if !foreign{ll_text(ctx," ");ll_initializer(ctx,item.left);}ll_text(ctx,"\n");
}
pub fn boot_llvm_supported(ctx:*BootContext)->bool {
 let mut item:*BootNode=ctx.program.body;
 while item!=0 as *BootNode {
  if item.kind==BN_FN && boot_abi_needed(item) && !boot_abi_target(ctx,item){return false;}
  item=item.next;
 }
 return true;
}
pub fn boot_emit_llvm(ctx:*BootContext)->bool{
 if ctx.failed||ctx.program==(0 as *BootNode)||ctx.output==(0 as *void){return false;}
 if !boot_choose_namespace(ctx){return false;}
 let mut item:*BootNode=ctx.program.body;
 if ctx.bare_x86_64{
  ll_text(ctx,BARE_TRIPLE_LINE);ll_text(ctx,"\n");
  ll_text(ctx,BARE_LAYOUT_LINE);ll_text(ctx,"\n");
 }else{ll_text(ctx,"; Aether Core direct LLVM IR (64-bit host ABI)\n");}
 ll_intrinsics(ctx);
 if ctx.uses_errno && !ctx.errno_declared {fprintf(ctx.output,"declare ptr @%s()\n",ctx.errno_name);}
 let mut ty:*BootType=ctx.types;
 while ty!=(0 as *BootType){
  if ty.kind==BY_ENUM{
   ll_type(ctx,ty);fprintf(ctx.output," = type { i32, [%llu x ",ty.extent);ll_type(ctx,ty.inner);ll_text(ctx,"] }\n");
  }
  if ty.kind==BY_STRUCT{
   ll_type(ctx,ty);
   if ty.union_layout{fprintf(ctx.output," = type { [%llu x i%llu] }\n",ty.layout_size/ty.layout_align,ty.layout_align*8);ty=ty.next;continue;}
   if ty.packed{ll_text(ctx," = type <{ ");}else{ll_text(ctx," = type { ");}let mut field:*BootNode=ty.fields;
   while field!=(0 as *BootNode){ll_type(ctx,field.ty);field=field.next;if field!=(0 as *BootNode){ll_text(ctx,", ");}}
   if ty.packed{ll_text(ctx," }>\n");}else{ll_text(ctx," }\n");}
  }ty=ty.next;
 }
 ll_globals(ctx,ctx.program.body);item=ctx.program.body;
 while item!=(0 as *BootNode){
  if item.kind==BN_STATIC{ll_storage(ctx,item);}
  if item.kind==BN_CONST{
   fprintf(ctx.output,"@a%d_c%d = private constant ",ctx.c_namespace,item.id);ll_type(ctx,item.ty);ll_text(ctx," ");
   if item.left.kind==BN_STRING{ll_initializer(ctx,item.left);}else if ll_float(item.ty){ll_literal(ctx,item.left,item.ty);}else{ll_integer(ctx,item.value,item.ty);}ll_text(ctx,"\n");
  }
  if item.kind==BN_FN&&(item.flags&2)!=0{
   let mut previous:*BootNode=ctx.program.body;let mut duplicate:bool=false;
   while previous!=item{if previous.kind==BN_FN&&(previous.flags&2)!=0&&strcmp(previous.name,item.name)==0{duplicate=true;}previous=previous.next;}
   if !duplicate && boot_symbol_definition(ctx,item)==0 as *BootNode{
    if boot_abi_needed(item){let sig:*BootNativeSignature=boot_abi_signature(ctx,item);if ctx.failed{return false;}ll_text(ctx,"declare ");ll_native_declaration(ctx,item,sig);}
    else{ll_signature(ctx,item);}ll_text(ctx,"\n");
   }
  }item=item.next;
 }
 item=ctx.program.body;
 while item!=(0 as *BootNode)&&!ctx.failed{
  if item.kind==BN_FN&&(item.flags&2)==0&&item.generics==(0 as *BootNode){
   ctx.function=item;ctx.llvm_serial=0;ctx.llvm_break=0;ctx.llvm_continue=0;ll_signature(ctx,item);ll_definition_attrs(ctx);ll_text(ctx," {\n");ll_label(ctx,0);
   ll_allocas(ctx,item.params);ll_allocas(ctx,item.body);
   let mut param:*BootNode=item.params;while param!=(0 as *BootNode){if param.ty.kind!=BY_VOID{ll_store_op(ctx);ll_type(ctx,param.ty);fprintf(ctx.output," %%arg%d, ptr %%v%d\n",param.id,param.id);}param=param.next;}
   ll_statement(ctx,item.body);
   if !ctx.llvm_terminated{if item.ty.kind==BY_VOID{ll_return_void(ctx);}else{ll_text(ctx,"  unreachable\n");}}
   ll_text(ctx,"}\n");if (item.flags&BF_EXPORT)!=0 && boot_abi_needed(item){ll_export_wrapper(ctx,item);}
  }item=item.next;
 }
 item=ctx.program.body;
 while item!=(0 as *BootNode){
  if item.kind==BN_FN&&(item.flags&2)==0&&!ctx.no_main&&item.owner==ctx.root_module&&strcmp(item.name,"main")==0{
   ll_text(ctx,"define i32 @main(i32 %argc, ptr %argv)");ll_definition_attrs(ctx);ll_text(ctx," {\nentry:\n  ");if item.ty.kind!=BY_VOID{ll_text(ctx,"%result = ");}
   ll_text(ctx,"call ");ll_return_type(ctx,item.ty);ll_text(ctx," ");ll_function(ctx,item);ll_text(ctx,"(");if item.params!=(0 as *BootNode){ll_text(ctx,"i32 %argc, ptr %argv");}ll_text(ctx,")\n");
   if item.ty.kind==BY_VOID{ll_text(ctx,"  ret i32 0\n}");}else{ll_text(ctx,"  ret i32 %result\n}");}ll_text(ctx,"\n");
  }item=item.next;
 }
 if ferror(ctx.output)!=0{boot_error(ctx,ctx.cursor,"failed writing LLVM IR");}return !ctx.failed;
}
