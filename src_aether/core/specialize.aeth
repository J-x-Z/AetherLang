use model::*;
use runtime::*;
use type_model::*;
use const_eval::*;
// Concrete substitutions are identities in the shared type graph, never hashes
// or default machine integers. Bodies are cloned and checked with those facts.
pub fn boot_infer_type(ctx:*BootContext,formal:*BootType,actual:*BootType,bindings:*BootTypeBinding,token:*BootToken,depth:i32)->bool{
 if ctx.failed{return false;}if depth>256{boot_error(ctx,token,"generic inference nesting exceeds 256");return false;}
 if formal.kind==BY_ALIAS{return boot_infer_type(ctx,formal.inner,actual,bindings,token,depth+1);}
 if formal.kind==BY_PARAMETER||formal.kind==BY_CONST_PARAMETER{
  if formal.kind==BY_CONST_PARAMETER&&(actual.kind!=BY_CONST_VALUE||actual.inner!=formal.inner){boot_error(ctx,token,"const argument type mismatch");return false;}
  let mut binding:*BootTypeBinding=bindings;
  while binding!=(0 as *BootTypeBinding){
   if binding.formal==formal{if binding.actual==(0 as *BootType){binding.actual=actual;return true;}if binding.actual==actual{return true;}boot_error(ctx,token,"conflicting generic type arguments");return false;}binding=binding.next;
  }
  boot_error(ctx,token,"unbound generic type parameter");return false;
 }
 if (boot_indirect(formal)||formal.kind==BY_OWN)&&formal.kind==actual.kind{return boot_infer_type(ctx,formal.inner,actual.inner,bindings,token,depth+1);}
 if formal.kind==BY_ARRAY&&actual.kind==BY_ARRAY{
  if !boot_infer_type(ctx,formal.inner,actual.inner,bindings,token,depth+1){return false;}
  if actual.expression!=0 as *BootNode{return true;}
  if formal.expression!=0 as *BootNode{
   let expression:*BootNode=formal.expression;
   if expression.kind==BN_IDENT&&expression.aux!=0 as *BootType&&expression.aux.kind==BY_CONST_PARAMETER{
    let value:*BootType=ce_checked_unsigned(ctx,expression.aux.inner,actual.extent,token);if ctx.failed{return false;}return boot_infer_type(ctx,expression.aux,value,bindings,token,depth+1);
   }
   let value:*BootType=ce_eval(ctx,expression,bindings,0 as *BootType,0);if ctx.failed{return false;}
   if value==0 as *BootType{return true;}if ce_length(ctx,value,token)==actual.extent&&!ctx.failed{return true;}
  }else{if formal.extent==actual.extent{return true;}}
  boot_error(ctx,token,"generic array length mismatch");return false;
 }
 if formal.kind==BY_CONST_EXPR&&actual.kind==BY_CONST_VALUE{
  let value:*BootType=ce_eval(ctx,formal.expression,bindings,actual.inner,0);if ctx.failed{return false;}if value==0 as *BootType||value==actual{return true;}boot_error(ctx,token,"generic const value mismatch");return false;
 }
 if formal.kind==BY_STRUCT&&formal.is_tuple&&actual.kind==BY_STRUCT&&actual.is_tuple{
  let mut a:*BootNode=formal.fields;let mut b:*BootNode=actual.fields;
  while a!=0 as *BootNode&&b!=0 as *BootNode{if !boot_infer_type(ctx,a.ty,b.ty,bindings,token,depth+1){return false;}a=a.next;b=b.next;}
  if a!=0 as *BootNode||b!=0 as *BootNode{boot_error(ctx,token,"generic tuple arity mismatch");return false;}return true;
 }
 if formal.kind==BY_APPLICATION&&actual.base==formal.base{
  let mut left:*BootTypeArgument=formal.arguments;let mut right:*BootTypeArgument=actual.arguments;
  while left!=(0 as *BootTypeArgument)&&right!=(0 as *BootTypeArgument){if !boot_infer_type(ctx,left.ty,right.ty,bindings,token,depth+1){return false;}left=left.next;right=right.next;}
  if left==(0 as *BootTypeArgument)&&right==(0 as *BootTypeArgument){return true;}
 }
 let mut normalized:*BootType=boot_substitute_type(ctx,formal,bindings,depth+1,token);normalized=boot_normal_type(ctx,normalized,depth+1,token);
 if normalized==actual{return true;}boot_error(ctx,token,"generic argument type mismatch");return false;
}
pub fn boot_generic_hint(ctx:*BootContext,formal:*BootType,bindings:*BootTypeBinding,token:*BootToken)->*BootType{
 let mut ty:*BootType=boot_substitute_type(ctx,formal,bindings,0,token);if ctx.failed{return 0 as *BootType;}
 ty=boot_normal_type(ctx,ty,0,token);if boot_type_concrete(ty,0){return ty;}
 if ty!=0 as *BootType&&((ty.kind==BY_ARRAY&&boot_type_concrete(ty.inner,0))||(ty.kind==BY_STRUCT&&ty.is_tuple)){return ty;}return 0 as *BootType;
}
fn boot_clone_nodes(ctx:*BootContext,source:*BootNode,bindings:*BootTypeBinding)->*BootNode{
 let mut old:*BootNode=source;let mut first:*BootNode=0 as *BootNode;let mut tail:*BootNode=0 as *BootNode;
 while old!=(0 as *BootNode)&&!ctx.failed{
  let node:*BootNode=boot_clone_node(ctx,old,bindings);if node==(0 as *BootNode){return first;}
  if tail==(0 as *BootNode){first=node;}else{tail.next=node;}tail=node;old=old.next;
 }return first;
}
fn boot_clone_node(ctx:*BootContext,source:*BootNode,bindings:*BootTypeBinding)->*BootNode{
 let node:*BootNode=boot_alloc(ctx,size_of(BootNode) as u64) as *BootNode;if node==(0 as *BootNode){return node;}
 memcpy(node as *void,source as *void,size_of(BootNode) as u64);node.id=boot_id(ctx);node.next=0 as *BootNode;node.decl=0 as *BootNode;node.llvm_value=0;
 node.ty=boot_substitute_type(ctx,source.ty,bindings,0,source.token);node.aux=boot_substitute_type(ctx,source.aux,bindings,0,source.token);
 if node.kind==BN_IDENT&&node.aux!=0 as *BootType&&node.aux.kind==BY_CONST_VALUE{node.kind=BN_CONST_VALUE;node.ty=node.aux.inner;node.value=node.aux.extent as i64;}
 node.left=boot_clone_nodes(ctx,source.left,bindings);node.right=boot_clone_nodes(ctx,source.right,bindings);node.third=boot_clone_nodes(ctx,source.third,bindings);
 node.body=boot_clone_nodes(ctx,source.body,bindings);node.params=boot_clone_nodes(ctx,source.params,bindings);
 return node;
}
pub fn boot_function_instance(ctx:*BootContext,source:*BootNode,bindings:*BootTypeBinding,token:*BootToken)->*BootNode{
 let mut args:*BootTypeArgument=0 as *BootTypeArgument;let mut tail:*BootTypeArgument=0 as *BootTypeArgument;let mut binding:*BootTypeBinding=bindings;
 while binding!=(0 as *BootTypeBinding){
  if !boot_type_concrete(binding.actual,0){boot_error(ctx,token,"cannot infer all generic type arguments");return 0 as *BootNode;}
  let arg:*BootTypeArgument=boot_type_argument(ctx,binding.actual);if ctx.failed{return 0 as *BootNode;}
  if tail==(0 as *BootTypeArgument){args=arg;}else{tail.next=arg;}tail=arg;binding=binding.next;
 }
 let mut existing:*BootInstance=ctx.instances;
 while existing!=(0 as *BootInstance){if existing.source==source&&boot_type_arguments_same(existing.arguments,args){return existing.function;}existing=existing.next;}
 ctx.instance_count=ctx.instance_count+1;if ctx.instance_count>4096{boot_error(ctx,token,"generic function instance limit exceeds 4096");return 0 as *BootNode;}
 let function:*BootNode=boot_clone_node(ctx,source,bindings);if ctx.failed{return 0 as *BootNode;}
 function.generics=0 as *BootNode;function.origin=source;
 let instance:*BootInstance=boot_alloc(ctx,size_of(BootInstance) as u64) as *BootInstance;if ctx.failed{return 0 as *BootNode;}
 instance.source=source;instance.arguments=args;instance.function=function;instance.next=ctx.instances;ctx.instances=instance;
 let mut last:*BootNode=ctx.program.body;while last.next!=(0 as *BootNode){last=last.next;}last.next=function;
 return function;
}
