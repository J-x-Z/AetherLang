 if subject.kind==BY_OWN{boot_error(ctx,node.token,"owned match requires projection-aware move patterns");return 0 as *BootType;}
 let saved_value:*BootType=ctx.value_type;ctx.value_type=expected;
 let temporary:*BootNode=boot_node(ctx,BN_LET,node.token);if ctx.failed{return 0 as *BootType;}temporary.ty=subject;temporary.left=node.left;
 let mut arm:*BootNode=node.params;
 while arm!=0 as *BootNode&&!ctx.failed{
  let saved:*BootBinding=ctx.bindings;ctx.depth=ctx.depth+1;
  if !boot_check_pattern(ctx,arm.left,subject,boot_enum_reference(ctx,temporary),arm,0){break;}
  let mut prior:*BootNode=node.params;
  while prior!=arm{
   if prior.right==0 as *BootNode&&pm_covers(prior.left,arm.left,0){
    if pm_irrefutable(prior.left){boot_error(ctx,arm.token,"unreachable match arm after wildcard");}
    else if prior.left.op==PM_VARIANT{boot_error(ctx,arm.token,"unreachable duplicate enum pattern");}
