   }prior=prior.next;
  }
  if arm.right!=0 as *BootNode{let guard:*BootType=boot_check_expr(ctx,arm.right,boot_type(ctx,BY_BOOL));if !ctx.failed{boot_expect(ctx,arm.right,guard,boot_type(ctx,BY_BOOL));}}
