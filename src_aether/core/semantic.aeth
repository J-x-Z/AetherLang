fn boot_check_closure(ctx:*BootContext,function:*BootNode)->bool{
 let saved_function:*BootNode=ctx.function;let saved_bindings:*BootBinding=ctx.bindings;let saved_depth:i32=ctx.depth;let saved_loop:i32=ctx.loop_depth;
 let saved_value:*BootType=ctx.value_type;let saved_target:*BootNode=ctx.value_target;let saved_unsafe:i32=ctx.unsafe_depth;
 ctx.function=function;ctx.bindings=0 as *BootBinding;ctx.depth=0;ctx.loop_depth=0;ctx.value_type=0 as *BootType;ctx.value_target=0 as *BootNode;ctx.unsafe_depth=0;
 let mut parameter:*BootNode=function.params;
 while parameter!=0 as *BootNode&&!ctx.failed{if !boot_type_valid(ctx,parameter.ty,parameter.token,false)||!boot_bind(ctx,parameter){break;}parameter=parameter.next;}
 if !ctx.failed{boot_check_statement(ctx,function.body);}
