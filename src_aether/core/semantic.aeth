  let scope:*BootNode=boot_node(ctx,BN_BLOCK,arm.token);let mut first:*BootNode=0 as *BootNode;let mut end:*BootNode=0 as *BootNode;let mut binding:*BootNode=arm.params;
  while binding!=0 as *BootNode{let next:*BootNode=binding.next;binding.next=0 as *BootNode;if strcmp(binding.name,"_")!=0{if end==0 as *BootNode{first=binding;}else{end.next=binding;}end=binding;}binding=next;}
  let mut body:*BootNode=arm.body;
  if arm.right!=0 as *BootNode{body=boot_node(ctx,BN_IF,arm.token);if ctx.failed{return 0 as *BootType;}body.left=arm.right;body.body=boot_enum_block(ctx,arm.body);}
  if end==0 as *BootNode{first=body;}else{end.next=body;}scope.body=first;
  let mut statement:*BootNode=scope;
  if arm.next!=0 as *BootNode&&!pm_irrefutable(arm.left){statement=boot_node(ctx,BN_IF,arm.token);if ctx.failed{return 0 as *BootType;}statement.left=pm_test(ctx,arm.left,boot_enum_reference(ctx,temporary));statement.body=scope;}
  last.next=statement;last=statement;arm=arm.next;
 }
