 ctx.function=saved_function;ctx.bindings=saved_bindings;ctx.depth=saved_depth;ctx.loop_depth=saved_loop;ctx.value_type=saved_value;ctx.value_target=saved_target;ctx.unsafe_depth=saved_unsafe;
 return !ctx.failed;
}

fn boot_check_tuple(ctx:*BootContext,node:*BootNode,expected:*BootType)->*BootType{
 let mut wanted:*BootNode=0 as *BootNode;if expected!=0 as *BootType&&expected.kind==BY_STRUCT&&expected.is_tuple{wanted=expected.fields;}
 let contextual:bool=wanted!=0 as *BootNode;let mut value:*BootNode=node.params;let mut fields:*BootNode=0 as *BootNode;let mut tail:*BootNode=0 as *BootNode;let mut index:u64=0;
 while value!=0 as *BootNode&&!ctx.failed{
  if contextual&&wanted==0 as *BootNode{boot_error(ctx,node.token,"tuple initializer arity mismatch");return 0 as *BootType;}
  let mut hint:*BootType=0 as *BootType;if wanted!=0 as *BootNode&&(boot_type_concrete(wanted.ty,0)||(wanted.ty.kind==BY_ARRAY&&boot_type_concrete(wanted.ty.inner,0))||(wanted.ty.kind==BY_STRUCT&&wanted.ty.is_tuple)){hint=wanted.ty;}
  let actual:*BootType=boot_check_expr(ctx,value,hint);if ctx.failed{return 0 as *BootType;}
  if hint!=0 as *BootType&&boot_type_concrete(hint,0)&&!boot_expect(ctx,value,actual,hint){return 0 as *BootType;}
  let field:*BootNode=tp_field(ctx,actual,index,value.token);if ctx.failed{return 0 as *BootType;}field.left=value;let next:*BootNode=value.next;value.next=0 as *BootNode;
  if tail==0 as *BootNode{fields=field;}else{tail.next=field;}tail=field;value=next;index=index+1;if wanted!=0 as *BootNode{wanted=wanted.next;}
