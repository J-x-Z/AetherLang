use model::*;
use runtime::*;
use type_model::*;
use specialize::*;
use const_eval::*;
use tuple_model::*;
use pattern_model::*;
use methods::*;
use borrow::boot_borrow_check;
use owned::boot_own_lower;
use effects::boot_check_effects;
use enum_model::*;
use closures::*;
// Core v1 type and scope checker, executed by every bootstrap stage.
// Raw pointers remain an explicit manual memory boundary; safe references
// retain separate types and are validated by the independent borrow pass.
extern "C" { fn strtod(text:*u8,end:**u8)->f64; }
struct BootTypeTrail { ty:*BootType, parent:*BootTypeTrail }
fn boot_integer(ty:*BootType)->bool {
 return ty!=(0 as *BootType) && ty.kind>=BY_I8 && ty.kind<=BY_U64;
}
fn boot_float(ty:*BootType)->bool { return ty!=(0 as *BootType) && (ty.kind==BY_F32 || ty.kind==BY_F64); }
fn boot_numeric(ty:*BootType)->bool { return boot_integer(ty) || boot_float(ty); }
fn boot_signed(ty:*BootType)->bool {
 return ty.kind==BY_I8 || ty.kind==BY_I16 || ty.kind==BY_I32 || ty.kind==BY_I64;
}
fn boot_find_binding(ctx:*BootContext,name:*u8,token:*BootToken)->*BootNode {
 let mut binding:*BootBinding=ctx.bindings;
 while binding!=(0 as *BootBinding) {
  if strcmp(binding.name,name)==0 { return binding.node; }
  binding=binding.next;
 }
 let item:*BootNode=boot_lookup(ctx,name,0 as *BootModule,token);
 if item!=(0 as *BootNode) && (item.kind==BN_CONST || item.kind==BN_STATIC) { return item; }
 return 0 as *BootNode;
}
fn boot_bind(ctx:*BootContext,node:*BootNode)->bool {
 if ctx.function!=0 as *BootNode&&node.name!=0 as *u8{
  let mut source:*BootNode=ctx.function;if source.origin!=0 as *BootNode{source=source.origin;}
  let mut generic:*BootNode=source.generics;while generic!=0 as *BootNode{if generic.ty.kind==BY_CONST_PARAMETER&&strcmp(generic.name,node.name)==0{boot_error(ctx,node.token,"local binding shadows a const generic parameter");return false;}generic=generic.next;}
 }
 let mut prior:*BootBinding=ctx.bindings;
 while prior!=(0 as *BootBinding) && prior.depth==ctx.depth {
  if strcmp(prior.name,node.name)==0 { boot_error(ctx,node.token,"duplicate binding in scope");return false; }
  prior=prior.next;
 }
 let binding:*BootBinding=boot_alloc(ctx,size_of(BootBinding) as u64) as *BootBinding;
 if binding==(0 as *BootBinding) { return false; }
 binding.name=node.name;binding.node=node;binding.depth=ctx.depth;
 binding.next=ctx.bindings;ctx.bindings=binding;return true;
}
fn boot_type_shape(ctx:*BootContext,ty:*BootType,token:*BootToken,abstract:bool,depth:i32)->bool{
 if ty==(0 as *BootType){boot_error(ctx,token,"missing type");return false;}
 if depth>256{boot_error(ctx,token,"type validation nesting exceeds 256");return false;}
 if abstract&&boot_type_concrete(ty,0){return boot_type_valid(ctx,ty,token,true);}
 if ty.kind==BY_INFER{boot_error(ctx,token,"inferred type is restricted to a concrete closure local");return false;}
 if ty.kind==BY_CONST_PARAMETER||ty.kind==BY_CONST_VALUE||ty.kind==BY_CONST_EXPR{boot_error(ctx,token,"const argument is not a value type");return false;}
 if ty.kind==BY_PARAMETER{if abstract{return true;}boot_error(ctx,token,"unresolved generic parameter");return false;}
 if ty.kind==BY_TEMPLATE{boot_error(ctx,token,"generic type requires explicit arguments or an initializer context");return false;}
 if ty.kind==BY_APPLICATION{
  if !abstract{boot_error(ctx,token,"unresolved generic type arguments");return false;}
  let mut arg:*BootTypeArgument=ty.arguments;while arg!=(0 as *BootTypeArgument){if arg.ty.kind!=BY_CONST_PARAMETER&&arg.ty.kind!=BY_CONST_VALUE&&arg.ty.kind!=BY_CONST_EXPR{if !boot_type_shape(ctx,arg.ty,token,true,depth+1){return false;}}arg=arg.next;}return true;
 }
 if ty.checked&&!abstract{return true;}
 if (ty.kind==BY_STRUCT||ty.kind==BY_ENUM)&&!ty.complete{boot_error(ctx,token,"unknown struct type");return false;}
 if !abstract{ty.checked=true;}
 if boot_indirect(ty)||ty.kind==BY_OWN{return boot_type_shape(ctx,ty.inner,token,abstract,depth+1);}
 if ty.kind==BY_ARRAY{
  if !boot_type_shape(ctx,ty.inner,token,abstract,depth+1){return false;}
  if abstract{return true;}return boot_layout(ctx,ty,0,token);
 }
 if ty.kind==BY_ENUM{
  let mut variant:*BootNode=ty.fields;
  while variant!=0 as *BootNode{let payload:*BootType=boot_enum_payload(ctx,variant);if ctx.failed||!boot_type_shape(ctx,payload,variant.token,abstract,depth+1){return false;}variant=variant.next;}
  if !abstract{if !boot_struct_finite(ctx,ty,0 as *BootTypeTrail,token){return false;}return boot_layout(ctx,ty,0,token);}return true;
 }
 if ty.kind==BY_STRUCT{
  let mut field:*BootNode=ty.fields;while field!=(0 as *BootNode){if !boot_type_shape(ctx,field.ty,field.token,abstract,depth+1){return false;}field=field.next;}
  if !abstract{if !boot_struct_finite(ctx,ty,0 as *BootTypeTrail,token){return false;}return boot_layout(ctx,ty,0,token);}
 }
 return true;
}
fn boot_type_valid(ctx:*BootContext,ty:*BootType,token:*BootToken,allow_void:bool)->bool {
 return boot_type_shape(ctx,ty,token,false,0);
}

fn boot_struct_finite(ctx:*BootContext,ty:*BootType,trail:*BootTypeTrail,token:*BootToken)->bool {
 if ty.kind==BY_ARRAY{return boot_struct_finite(ctx,ty.inner,trail,token);}
 if ty.kind!=BY_STRUCT&&ty.kind!=BY_ENUM { return true; }
 let mut prior:*BootTypeTrail=trail;
 while prior!=(0 as *BootTypeTrail) {
  if prior.ty==ty { boot_error(ctx,token,"recursive struct needs a pointer indirection");return false; }
  prior=prior.parent;
 }
 let here:*BootTypeTrail=boot_alloc(ctx,size_of(BootTypeTrail) as u64) as *BootTypeTrail;
 if here==(0 as *BootTypeTrail) { return false; }
 here.ty=ty;here.parent=trail;
 let mut field:*BootNode=ty.fields;
 while field!=(0 as *BootNode) {
  let mut member:*BootType=field.ty;if ty.kind==BY_ENUM{member=boot_enum_payload(ctx,field);}
  if ctx.failed||!boot_struct_finite(ctx,member,here,field.token) { return false; }
  field=field.next;
 }
 return true;
}
fn boot_integer_literal(ctx:*BootContext,node:*BootNode,ty:*BootType,negative:bool)->bool {
 let mut maximum:u64=9223372036854775807;
 if ty.kind==BY_I8 { maximum=127; }
 if ty.kind==BY_U8 { maximum=255; }
 if ty.kind==BY_I16 { maximum=32767; }
 if ty.kind==BY_U16 { maximum=65535; }
 if ty.kind==BY_I32 { maximum=2147483647; }
 if ty.kind==BY_U32 { maximum=4294967295; }
 if ty.kind==BY_U64 { maximum=0;maximum=maximum-1; }
 if negative {
  if !boot_signed(ty) { boot_error(ctx,node.token,"negative literal requires a signed integer type");return false; }
  maximum=maximum+1;
 }
 let mut value:u64=0;
 if !boot_integer_value(ctx,node.token,maximum,&mut value as *u64){return false;}
 node.value=value as i64;node.ty=ty;return true;
}
fn boot_literal_number(node:*BootNode)->bool {
 if node.kind==BN_INT || node.kind==BN_FLOAT { return true; }
 return node.kind==BN_UNARY && node.op==45 && (node.left.kind==BN_INT || node.left.kind==BN_FLOAT);
}
fn boot_expect(ctx:*BootContext,node:*BootNode,actual:*BootType,expected:*BootType)->bool {
 if actual!=expected { boot_error(ctx,node.token,"type mismatch");return false; }
 return true;
}
// A writable pointer target is independent of whether the pointer binding can
// itself be reassigned. Direct aggregate fields inherit binding mutability.
fn boot_place_writable(ctx:*BootContext,node:*BootNode)->bool {
 if node.kind==BN_IDENT {
  if node.decl==(0 as *BootNode) { boot_error(ctx,node.token,"unresolved assignment target");return false; }
  if node.decl.kind==BN_CONST || (node.decl.flags&1)==0 {
   boot_error(ctx,node.token,"cannot assign to immutable binding");return false;
  }
  return true;
 }
 if node.kind==BN_MEMBER {
  if node.left.ty.kind==BY_PTR||node.left.ty.kind==BY_MUTREF { return true; }
  if node.left.ty.kind==BY_REF {boot_error(ctx,node.token,"cannot mutate through shared reference");return false;}
  return boot_place_writable(ctx,node.left);
 }
 if node.kind==BN_INDEX{if node.left.ty.kind==BY_ARRAY{return boot_place_writable(ctx,node.left);}return true;}
 if node.kind==BN_UNARY && node.op==42 {
  if node.left.ty.kind==BY_REF{boot_error(ctx,node.token,"cannot mutate through shared reference");return false;}return true;
 }
 boot_error(ctx,node.token,"expected an assignable place");return false;
}
fn boot_place_addressable(ctx:*BootContext,node:*BootNode)->bool {
 if node.kind==BN_IDENT {
  if node.decl.kind==BN_CONST { boot_error(ctx,node.token,"constant has no addressable storage");return false; }
  return true;
 }
 if node.kind==BN_MEMBER {
  if boot_indirect(node.left.ty) { return true; }
  return boot_place_addressable(ctx,node.left);
 }
 if node.kind==BN_INDEX{if node.left.ty.kind==BY_ARRAY{return boot_place_addressable(ctx,node.left);}return true;}
 if node.kind==BN_UNARY && node.op==42 {return true;}
 boot_error(ctx,node.token,"address requires a place");return false;
}
pub fn boot_check_expr(ctx:*BootContext,node:*BootNode,expected:*BootType)->*BootType {
 let actual:*BootType=boot_check_expr_inner(ctx,node,expected);
 // Shared reborrowing preserves the origin while restricting permissions; it
 // never changes the declaration's own canonical type or creates a raw pointer.
 if !ctx.failed&&actual!=0 as *BootType&&expected!=0 as *BootType&&actual.kind==BY_MUTREF&&expected.kind==BY_REF&&actual.inner==expected.inner{
  node.ty=expected;return expected;
 }
 return actual;
}
fn boot_check_expr_inner(ctx:*BootContext,node:*BootNode,expected:*BootType)->*BootType {
 if ctx.failed || node==(0 as *BootNode) { return 0 as *BootType; }
 if node.kind==BN_CLOSURE{
  let function:*BootNode=boot_closure_prepare(ctx,node);if ctx.failed||!boot_check_closure(ctx,function){return 0 as *BootType;}
  if !boot_type_valid(ctx,node.ty,node.token,false){return 0 as *BootType;}return boot_check_expr(ctx,node,expected);
 }
 if node.kind==BN_METHOD_CALL{
  let actual:*BootType=boot_check_expr(ctx,node.left,0 as *BootType);if ctx.failed{return 0 as *BootType;}
  let mut base:*BootType=actual;if boot_indirect(base){base=base.inner;}
  if base.kind==BY_STRUCT{
   let mut field:*BootNode=base.fields;while field!=0 as *BootNode{
    if strcmp(field.name,node.name)==0&&field.ty.callable!=0 as *BootNode{
     let value:*BootNode=boot_node(ctx,BN_MEMBER,node.token);if ctx.failed{return 0 as *BootType;}value.name=node.name;value.left=node.left;node.left=value;node.kind=BN_CALL;return boot_check_expr(ctx,node,expected);
    }field=field.next;
   }
  }
  if !boot_method_call(ctx,node,actual){return 0 as *BootType;}
  return boot_check_expr(ctx,node,expected);
 }
 if node.kind==BN_ENUM_VALUE&&!node.ty.is_enum{
  if (node.flags&8192)==0{boot_error(ctx,node.token,"associated method requires a call with parentheses");return 0 as *BootType;}
  if !boot_method_associated(ctx,node){return 0 as *BootType;}
  return boot_check_expr(ctx,node,expected);
 }
 let kind:i32=node.kind;
 if kind==BN_CONST_VALUE{return node.ty;}
 if kind==BN_TUPLE{return boot_check_tuple(ctx,node,expected);}
 if kind==BN_VALUE&&(node.flags&4096)!=0{return node.ty;}
 if kind==BN_ENUM_VALUE{return boot_check_enum_value(ctx,node,expected);}
 if kind==BN_MATCH{return boot_check_match(ctx,node,expected);}
 if kind==BN_TRY{return boot_check_try(ctx,node);}
 if kind==BN_INT {
  let mut ty:*BootType=expected;
  if !boot_integer(ty) { ty=boot_type(ctx,BY_I64); }
  if !boot_integer_literal(ctx,node,ty,false) { return 0 as *BootType; }
  return ty;
 }
 if kind==BN_FLOAT {
  let mut ty:*BootType=expected;if !boot_float(ty) { ty=boot_type(ctx,BY_F64); }
  let parsed:f64=strtod(node.token.text,0 as **u8);
  let difference:f64=parsed-parsed;
  if difference!=0.0 || (ty.kind==BY_F32 && parsed>3.4028234663852886e38) {
   boot_error(ctx,node.token,"floating literal is outside its type range");return 0 as *BootType;
  }
  node.ty=ty;return ty;
 }
 if kind==BN_UNIT{node.ty=boot_type(ctx,BY_VOID);return node.ty;}
 if kind==BN_BOOL { node.ty=boot_type(ctx,BY_BOOL);return node.ty; }
 if kind==BN_STRING { node.ty=boot_ptr_type(ctx,boot_type(ctx,BY_U8));return node.ty; }
 if kind==BN_IDENT {
  if node.lookup!=(0 as *BootModule) {
   node.decl=boot_lookup(ctx,node.name,node.lookup,node.token);
   if node.decl!=(0 as *BootNode) && node.decl.kind!=BN_CONST && node.decl.kind!=BN_STATIC {boot_error(ctx,node.token,"imported name does not denote a value");return 0 as *BootType;}
  } else {node.decl=boot_find_binding(ctx,node.name,node.token);}
  if node.decl==(0 as *BootNode) { boot_error(ctx,node.token,"unknown value name");return 0 as *BootType; }
  node.ty=node.decl.ty;return node.ty;
 }
 if kind==BN_VALUE{
  let saved:*BootType=ctx.value_type;ctx.value_type=expected;boot_check_statement(ctx,node.body);
  let mut result:*BootType=ctx.value_type;ctx.value_type=saved;if ctx.failed{return 0 as *BootType;}
  if (boot_flow(node.body)&1)!=0{
   if result!=(0 as *BootType)&&result.kind!=BY_VOID{boot_error(ctx,node.token,"value block may finish without yielding a value");return 0 as *BootType;}result=boot_type(ctx,BY_VOID);
  }
  if result==(0 as *BootType){boot_error(ctx,node.token,"cannot infer a value type from a diverging block");return 0 as *BootType;}
  node.ty=result;return result;
 }
 if kind==BN_ARRAY||kind==BN_REPEAT{
  if kind==BN_REPEAT&&node.right!=0 as *BootNode{let extent:*BootType=ce_eval(ctx,node.right,0 as *BootTypeBinding,0 as *BootType,0);if extent==0 as *BootType{boot_error(ctx,node.token,"array repeat requires a concrete constant length");return 0 as *BootType;}node.value=ce_length(ctx,extent,node.token) as i64;if ctx.failed{return 0 as *BootType;}}
  let mut element:*BootType=0 as *BootType;
  if expected!=(0 as *BootType)&&expected.kind==BY_ARRAY{
   if expected.expression==0 as *BootNode&&expected.extent!=(node.value as u64){boot_error(ctx,node.token,"array initializer length mismatch");return 0 as *BootType;}element=expected.inner;
  }
  let mut item:*BootNode=node.params;if kind==BN_REPEAT{item=node.left;}
  while item!=(0 as *BootNode){
   let actual:*BootType=boot_check_expr(ctx,item,element);if ctx.failed{return 0 as *BootType;}
   if element==(0 as *BootType){element=actual;}else{if !boot_expect(ctx,item,actual,element){return 0 as *BootType;}}
   item=item.next;
  }
  if element==(0 as *BootType){boot_error(ctx,node.token,"empty array needs an element type context");return 0 as *BootType;}
  node.ty=boot_array_type(ctx,element,node.value as u64);if !boot_type_valid(ctx,node.ty,node.token,false){return 0 as *BootType;}return node.ty;
 }
 if kind==BN_STRUCT_VALUE {
  if node.ty.kind==BY_TEMPLATE&&expected!=(0 as *BootType)&&expected.base==node.ty{node.ty=expected;}
  if !boot_type_valid(ctx,node.ty,node.token,false) || node.ty.kind!=BY_STRUCT {boot_error(ctx,node.token,"struct initializer requires a struct type");return 0 as *BootType;}
  let mut argument:*BootNode=node.params;
  if node.ty.union_layout && (argument==0 as *BootNode || argument.next!=0 as *BootNode){boot_error(ctx,node.token,"union initializer requires exactly one field");return 0 as *BootType;}
  while argument!=(0 as *BootNode){
   let mut field:*BootNode=node.ty.fields;
   while field!=(0 as *BootNode)&&strcmp(field.name,argument.name)!=0{field=field.next;}
   if field==(0 as *BootNode){boot_error(ctx,argument.token,"unknown struct initializer field");return 0 as *BootType;}
   let mut prior:*BootNode=node.params;while prior!=argument{if strcmp(prior.name,argument.name)==0{boot_error(ctx,argument.token,"duplicate struct initializer field");return 0 as *BootType;}prior=prior.next;}
   argument.decl=field;argument.ty=field.ty;
   let actual:*BootType=boot_check_expr(ctx,argument.left,field.ty);
   if ctx.failed||!boot_expect(ctx,argument,actual,field.ty){return 0 as *BootType;}argument=argument.next;
  }
  if node.ty.union_layout{return node.ty;}
  let mut field:*BootNode=node.ty.fields;
  while field!=(0 as *BootNode){
   let mut found:bool=false;argument=node.params;while argument!=(0 as *BootNode){if argument.decl==field{found=true;}argument=argument.next;}
   if !found{boot_error(ctx,node.token,"missing struct initializer field");return 0 as *BootType;}field=field.next;
  }
  return node.ty;
 }
 if kind==BN_ERRNO {ctx.uses_errno=true;node.ty=boot_type(ctx,BY_I32);return node.ty;}
 if kind==BN_OFFSET{
  if !boot_type_valid(ctx,node.aux,node.token,false) || node.aux.kind!=BY_STRUCT{boot_error(ctx,node.token,"offset_of requires a record type");return 0 as *BootType;}
  let mut field:*BootNode=node.aux.fields;while field!=0 as *BootNode && strcmp(field.name,node.name)!=0{field=field.next;}
  if field==0 as *BootNode{boot_error(ctx,node.token,"unknown layout field");return 0 as *BootType;}
  node.value=field.value;node.ty=boot_type(ctx,BY_U64);return node.ty;
 }
 if kind==BN_SIZEOF||kind==BN_ALIGNOF {
  if !boot_type_valid(ctx,node.aux,node.token,false) { return 0 as *BootType; }
  if !boot_layout(ctx,node.aux,0,node.token){return 0 as *BootType;}
  node.ty=boot_type(ctx,BY_U64);return node.ty;
 }
 if kind==BN_CAST {
  let target:*BootType=node.ty;
  if !boot_type_valid(ctx,target,node.token,false) { return 0 as *BootType; }
  // A positive magnitude can use the full unsigned range in an explicit
  // u64 or raw-pointer cast. Keep signed arithmetic and narrow casts typed
  // independently of their destination (e.g. (-3/2) as u64).
  let mut context:*BootType=0 as *BootType;if target.kind==BY_OWN{context=target.inner;}
  if node.left.kind==BN_INT && (target.kind==BY_U64 || target.kind==BY_PTR) {
   context=boot_type(ctx,BY_U64);
  }
  let source:*BootType=boot_check_expr(ctx,node.left,context);
  if ctx.failed { return 0 as *BootType; }
  let numeric_source:bool=boot_numeric(source) || source.kind==BY_BOOL;
  let numeric_target:bool=boot_numeric(target) || target.kind==BY_BOOL;
  if (target.kind==BY_OWN&&source==target.inner&&source.kind==BY_STRUCT)||(source.kind==BY_OWN&&target==source.inner){
   if ctx.unsafe_depth==0{boot_error(ctx,node.token,"adopting or releasing an owned resource requires unsafe");return 0 as *BootType;}return target;
  }
  if boot_reference(source)&&target.kind==BY_PTR&&source.inner==target.inner&&source.inner.kind!=BY_OWN{return target;}
  if source.kind==BY_MUTREF&&target.kind==BY_REF&&source.inner==target.inner{return target;}
  if (numeric_source && numeric_target) ||
     (source.kind==BY_PTR && (target.kind==BY_PTR || boot_integer(target))) ||
     (boot_integer(source) && target.kind==BY_PTR) { return target; }
  boot_error(ctx,node.token,"invalid scalar or pointer cast");return 0 as *BootType;
 }
 if kind==BN_MEMBER {
  let mut base:*BootType=boot_check_expr(ctx,node.left,0 as *BootType);
  if ctx.failed { return 0 as *BootType; }
  if boot_indirect(base) { base=base.inner; }
  let owned_base:bool=base.kind==BY_OWN;
  base=boot_storage_type(base);
  if base.kind!=BY_STRUCT { boot_error(ctx,node.token,"field access requires a struct");return 0 as *BootType; }
  if base.union_layout && ctx.unsafe_depth==0{boot_error(ctx,node.token,"unsafe block required for union field access");return 0 as *BootType;}
  let mut field:*BootNode=base.fields;
  while field!=(0 as *BootNode) {
   if strcmp(field.name,node.name)==0 {
    if owned_base&&boot_raw_fields(field.ty,0){if ctx.unsafe_depth==0{boot_error(ctx,node.token,"unsafe block is required to expose an owned resource raw pointer field");return 0 as *BootType;}node.flags=node.flags|BF_UNSAFE;}
    node.decl=field;node.ty=field.ty;return node.ty;
   }
   field=field.next;
  }
  boot_error(ctx,node.token,"unknown struct field");return 0 as *BootType;
 }
 if kind==BN_INDEX {
  let mut base:*BootType=boot_check_expr(ctx,node.left,0 as *BootType);
  if !ctx.failed&&boot_reference(base)&&base.inner.kind==BY_ARRAY{
   let deref:*BootNode=boot_node(ctx,BN_UNARY,node.left.token);if deref==0 as *BootNode{return 0 as *BootType;}
   deref.op=42;deref.left=node.left;deref.ty=base.inner;node.left=deref;base=base.inner;
  }
  let index:*BootType=boot_check_expr(ctx,node.right,0 as *BootType);
  if ctx.failed { return 0 as *BootType; }
  if (base.kind!=BY_PTR&&base.kind!=BY_ARRAY) || !boot_integer(index) {
   boot_error(ctx,node.token,"index requires a typed pointer and integer index");return 0 as *BootType;
  }
  node.ty=base.inner;return node.ty;
 }
 if kind==BN_UNARY {
  if node.op==45 && node.left.kind==BN_INT {
   let mut ty:*BootType=expected;if !boot_integer(ty) { ty=boot_type(ctx,BY_I64); }
   if !boot_integer_literal(ctx,node.left,ty,true) { return 0 as *BootType; }
   node.ty=ty;return ty;
  }
  let operand:*BootType=boot_check_expr(ctx,node.left,expected);
  if ctx.failed { return 0 as *BootType; }
  if node.op==38 {
   if !boot_place_addressable(ctx,node.left) { return 0 as *BootType; }
   if (node.flags&1)!=0 && !boot_place_writable(ctx,node.left) { return 0 as *BootType; }
   node.ty=boot_ref_type(ctx,operand,(node.flags&1)!=0);return node.ty;
  }
  if node.op==42 {
   if !boot_indirect(operand) { boot_error(ctx,node.token,"dereference requires a pointer or reference");return 0 as *BootType; }
   node.ty=operand.inner;return node.ty;
  }
  if (node.op==45 && boot_numeric(operand)) || (node.op==33 && operand.kind==BY_BOOL) || (node.op==126 && boot_integer(operand)) {
   node.ty=operand;return operand;
  }
  boot_error(ctx,node.token,"invalid unary operands");return 0 as *BootType;
 }
 if kind==BN_CALL {
  if node.left!=0 as *BootNode{
   let callee:*BootNode=node.left;let mut value:bool=callee.kind!=BN_IDENT;
   if !value&&callee.lookup==0 as *BootModule{let mut binding:*BootBinding=ctx.bindings;while binding!=0 as *BootBinding{if strcmp(binding.name,callee.name)==0{value=true;}binding=binding.next;}}
   if value{let actual:*BootType=boot_check_expr(ctx,callee,0 as *BootType);if ctx.failed||!boot_closure_callee(ctx,node,actual){return 0 as *BootType;}return boot_check_expr(ctx,node,expected);}
   node.left=0 as *BootNode;
  }
  let mut function:*BootNode=node.decl;
  if function==0 as *BootNode||(function.flags&BF_METHOD)==0{function=boot_lookup(ctx,node.name,node.lookup,node.token);}
  if function==(0 as *BootNode) { boot_error(ctx,node.token,"unknown function");return 0 as *BootType; }
  if function.kind!=BN_FN { boot_error(ctx,node.token,"called name is not a function");return 0 as *BootType; }
  if node.lookup==(0 as *BootModule) && boot_find_binding(ctx,node.name,node.token)!=(0 as *BootNode) { boot_error(ctx,node.token,"value binding shadows function name");return 0 as *BootType; }
  if function.generics!=(0 as *BootNode){function=boot_check_generic_call(ctx,node,function,expected);if ctx.failed{return 0 as *BootType;}}
  node.decl=function;
  let mut param:*BootNode=function.params;let mut arg:*BootNode=node.params;
  while param!=(0 as *BootNode) {
   if arg==(0 as *BootNode) { boot_error(ctx,node.token,"too few function arguments");return 0 as *BootType; }
   let actual:*BootType=boot_check_expr(ctx,arg,param.ty);
   if ctx.failed { return 0 as *BootType; }
   if !boot_expect(ctx,arg,actual,param.ty) { return 0 as *BootType; }
   if boot_c_symbol(function)&&boot_contains_callable(actual,0){boot_error(ctx,arg.token,"closure environments have no C ABI");return 0 as *BootType;}
   param=param.next;arg=arg.next;
  }
  if arg!=(0 as *BootNode) && (function.flags&4)==0 { boot_error(ctx,node.token,"too many function arguments");return 0 as *BootType; }
  while arg!=(0 as *BootNode) {
   let actual:*BootType=boot_check_expr(ctx,arg,0 as *BootType);
   if ctx.failed { return 0 as *BootType; }
   if actual.kind==BY_VOID || actual.kind==BY_STRUCT || actual.kind==BY_ARRAY { boot_error(ctx,arg.token,"variadic arguments must be scalar or pointer");return 0 as *BootType; }
   arg=arg.next;
  }
  node.ty=function.ty;return node.ty;
 }
 if kind==BN_BINARY {
  let op:i32=node.op;let mut operand_context:*BootType=expected;
  if op==BT_EQ||op==BT_NE||op==60||op==62||op==BT_LE||op==BT_GE{operand_context=0 as *BootType;}
  if op==BT_AND||op==BT_OR{operand_context=boot_type(ctx,BY_BOOL);}
  let mut left:*BootType=0 as *BootType;let mut right:*BootType=0 as *BootType;
  // Contextual literals inherit their nonliteral peer's type. Checking types
  // does not change runtime evaluation order, which belongs to the emitter.
  if boot_literal_number(node.left) && !boot_literal_number(node.right) {
   right=boot_check_expr(ctx,node.right,operand_context);
   if ctx.failed { return 0 as *BootType; }
   left=boot_check_expr(ctx,node.left,right);
  } else {
   left=boot_check_expr(ctx,node.left,operand_context);
   if ctx.failed { return 0 as *BootType; }
   let mut hint:*BootType=left;
   if left.kind==BY_PTR { hint=0 as *BootType; }
   right=boot_check_expr(ctx,node.right,hint);
  }
  if ctx.failed { return 0 as *BootType; }
  if (op==43 || op==45) && left.kind==BY_PTR && boot_integer(right) {
   node.ty=left;return left;
  }
  if op==BT_AND || op==BT_OR {
   if left.kind!=BY_BOOL || right.kind!=BY_BOOL { boot_error(ctx,node.token,"logical operands must be bool");return 0 as *BootType; }
   node.ty=left;return left;
  }
  if left!=right { boot_error(ctx,node.token,"binary operand types differ");return 0 as *BootType; }
  if op==BT_EQ || op==BT_NE {
   if !boot_numeric(left) && left.kind!=BY_BOOL && left.kind!=BY_PTR { boot_error(ctx,node.token,"values do not support equality");return 0 as *BootType; }
   node.ty=boot_type(ctx,BY_BOOL);return node.ty;
  }
  if op==60 || op==62 || op==BT_LE || op==BT_GE {
   if !boot_numeric(left) && left.kind!=BY_PTR { boot_error(ctx,node.token,"values are not ordered");return 0 as *BootType; }
   node.ty=boot_type(ctx,BY_BOOL);return node.ty;
  }
  if (op==43 || op==45 || op==42 || op==47) && boot_numeric(left) { node.ty=left;return left; }
  if (op==37 || op==38 || op==124 || op==94 || op==BT_SHL || op==BT_SHR) && boot_integer(left) { node.ty=left;return left; }
  boot_error(ctx,node.token,"invalid binary operands");return 0 as *BootType;
 }
 boot_error(ctx,node.token,"unsupported Core expression");return 0 as *BootType;
}

// The bool result means every execution path returns from the function.
fn boot_check_statement(ctx:*BootContext,node:*BootNode)->bool {
 if node!=0 as *BootNode&&node.kind==BN_RANGE_FOR{return boot_check_range(ctx,node);}
 if ctx.failed { return false; }
 let kind:i32=node.kind;
 if kind==BN_BLOCK {
  if (node.flags&BF_UNSAFE)!=0{ctx.unsafe_depth=ctx.unsafe_depth+1;}
  let saved:*BootBinding=ctx.bindings;ctx.depth=ctx.depth+1;
  let mut item:*BootNode=node.body;let mut returned:bool=false;
  while item!=(0 as *BootNode) && !ctx.failed {
   let this_returns:bool=boot_check_statement(ctx,item);
   returned=returned || this_returns;
   item=item.next;
  }
  if (node.flags&BF_UNSAFE)!=0{ctx.unsafe_depth=ctx.unsafe_depth-1;}ctx.depth=ctx.depth-1;ctx.bindings=saved;return returned;
 }
 if kind==BN_LET {
  if node.ty!=0 as *BootType&&node.ty.kind==BY_INFER{
   let actual:*BootType=boot_check_expr(ctx,node.left,0 as *BootType);if ctx.failed{return false;}
   if actual.callable==0 as *BootNode{boot_error(ctx,node.token,"inferred local requires a concrete closure value");return false;}node.ty=actual;
  }
  if !boot_type_valid(ctx,node.ty,node.token,false) { return false; }
  if node.left==(0 as *BootNode) { boot_error(ctx,node.token,"Core let requires an initializer");return false; }
  let actual:*BootType=boot_check_expr(ctx,node.left,node.ty);
  if ctx.failed { return false; }
  if !boot_expect(ctx,node,actual,node.ty) { return false; }
  boot_bind(ctx,node);return false;
 }
 if kind==BN_ASSIGN {
  let target:*BootType=boot_check_expr(ctx,node.left,0 as *BootType);
  if ctx.failed { return false; }
  if !boot_place_writable(ctx,node.left) { return false; }
  node.ty=target;
  if node.op!=0{
   let operation:*BootNode=boot_node(ctx,BN_BINARY,node.token);if operation==(0 as *BootNode){return false;}
   operation.op=node.op;operation.left=node.left;operation.right=node.right;
   let result:*BootType=boot_check_expr(ctx,operation,target);if !ctx.failed{boot_expect(ctx,node,result,target);}return false;
  }
  let value:*BootType=boot_check_expr(ctx,node.right,target);
  if ctx.failed { return false; }
  boot_expect(ctx,node,value,target);return false;
 }
 if kind==BN_YIELD{
  let value:*BootType=boot_check_expr(ctx,node.left,ctx.value_type);if ctx.failed{return false;}
  if ctx.value_type==(0 as *BootType){ctx.value_type=value;}else{boot_expect(ctx,node,value,ctx.value_type);}return true;
 }
 if kind==BN_EXPR { boot_check_expr(ctx,node.left,0 as *BootType);return false; }
 if kind==BN_RETURN {
  let mut expected:*BootType=ctx.function.ty;
  if expected.kind==BY_INFER{
   if node.left==0 as *BootNode{expected=boot_type(ctx,BY_VOID);}else{expected=boot_check_expr(ctx,node.left,0 as *BootType);}
   if ctx.failed{return true;}ctx.function.ty=expected;
  }
  if node.left==(0 as *BootNode) {
   if expected.kind!=BY_VOID { boot_error(ctx,node.token,"return needs a value"); }
  } else {
   let actual:*BootType=boot_check_expr(ctx,node.left,expected);
   if !ctx.failed&&expected.kind==BY_VOID&&actual.kind!=BY_VOID{boot_error(ctx,node.token,"void function cannot return a non-unit value");return true;}
   if !ctx.failed { boot_expect(ctx,node,actual,expected); }
  }
  return true;
 }
 if kind==BN_IF || kind==BN_WHILE {
  let condition:*BootType=boot_check_expr(ctx,node.left,boot_type(ctx,BY_BOOL));
  if ctx.failed { return false; }
  if condition.kind!=BY_BOOL { boot_error(ctx,node.token,"condition must be bool");return false; }
  if kind==BN_WHILE {
   ctx.loop_depth=ctx.loop_depth+1;boot_check_statement(ctx,node.body);ctx.loop_depth=ctx.loop_depth-1;
   return false;
  }
  let then_returns:bool=boot_check_statement(ctx,node.body);
  if node.third==(0 as *BootNode) { return false; }
  let else_returns:bool=boot_check_statement(ctx,node.third);
  return then_returns && else_returns;
 }
 if kind==BN_BREAK || kind==BN_CONTINUE {
  if ctx.loop_depth==0 { boot_error(ctx,node.token,"loop jump outside a loop"); }
  return false;
 }
 boot_error(ctx,node.token,"unsupported Core statement");return false;
}
fn boot_address_base(ctx:*BootContext,node:*BootNode)->bool{
 if node.kind==BN_IDENT && node.decl.kind==BN_STATIC{return true;}
 if node.kind==BN_MEMBER && node.left.ty.kind==BY_STRUCT{return boot_address_base(ctx,node.left);}
 if node.kind==BN_INDEX && node.left.ty.kind==BY_ARRAY && boot_constant_form(node.right){
  if !boot_constant_checked(ctx,node.right){return false;}
  if (node.right.value as u64)>=node.left.ty.extent{boot_error(ctx,node.right.token,"static address index is outside its array");return false;}
  return boot_address_base(ctx,node.left);
 }
 boot_error(ctx,node.token,"static address must refer to fixed global storage");return false;
}
fn boot_static_initializer(ctx:*BootContext,node:*BootNode,packed:bool)->bool {
 // Mach-O chained fixups cannot encode a pointer at every packed byte offset.
 if packed && (node.kind==BN_STRING || (node.kind==BN_UNARY && node.op==38)){ctx.packed_relocation=true;}
 if node.kind==BN_SIZEOF{node.value=node.aux.layout_size as i64;return true;}
 if node.kind==BN_ALIGNOF{node.value=node.aux.layout_align as i64;return true;}
 if node.kind==BN_OFFSET{return true;}
 if boot_constant_form(node){return boot_constant_checked(ctx,node);}
 if node.kind==BN_STRING || node.kind==BN_UNIT{return true;}
 if node.kind==BN_CAST && node.ty.kind==BY_PTR {
  if boot_indirect(node.left.ty){return boot_static_initializer(ctx,node.left,packed);}
  if node.left.kind==BN_INT && node.left.value==0{return true;}
 }
 if node.kind==BN_UNARY && node.op==38{return boot_address_base(ctx,node.left);}
 if node.kind==BN_STRUCT_VALUE || node.kind==BN_ARRAY {
  let mut element:*BootNode=node.params;
  while element!=0 as *BootNode{
   let mut value:*BootNode=element;if node.kind==BN_STRUCT_VALUE{value=element.left;}
   if !boot_static_initializer(ctx,value,packed || node.ty.packed){return false;}element=element.next;
  }
  return true;
 }
 if node.kind==BN_REPEAT{return boot_static_initializer(ctx,node.left,packed);}
 boot_error(ctx,node.token,"static initializer must be a constant value or a global address");return false;
}
fn boot_constant_form(node:*BootNode)->bool {
 if node.kind==BN_CONST_VALUE||node.kind==BN_INT || node.kind==BN_FLOAT || node.kind==BN_BOOL { return true; }
 if node.kind==BN_UNARY && (node.op==45 || node.op==33 || node.op==126) { return boot_constant_form(node.left); }
 return false;
}
// Constants must be representable, even though runtime integer negation wraps.
// Keep the evaluated bit pattern on the node for the shared declaration facts.
fn boot_constant_checked(ctx:*BootContext,node:*BootNode)->bool {
 if node.kind!=BN_UNARY { return true; }
 if !boot_constant_checked(ctx,node.left) { return false; }
 if node.op==33 { node.value=1-node.left.value;return true; }
 if !boot_integer(node.ty) { return true; }
 if node.op==126 {
  let mut value:i64=(-1 as i64)^node.left.value;
  if node.ty.kind==BY_U8 { value=value&255; }
  if node.ty.kind==BY_U16 { value=value&65535; }
  if node.ty.kind==BY_U32 { value=value&4294967295; }
  node.value=value;return true;
 }
 if node.op==45 {
  if boot_signed(node.ty) {
   let mut minimum:i64=-9223372036854775807-1;
   if node.ty.kind==BY_I8 { minimum=-128; }
   if node.ty.kind==BY_I16 { minimum=-32768; }
   if node.ty.kind==BY_I32 { minimum=-2147483647-1; }
   if node.left.kind!=BN_INT && node.left.value==minimum {
    boot_error(ctx,node.token,"constant negation overflows its type");return false;
   }
  } else {
   if node.left.value!=0 { boot_error(ctx,node.token,"constant negation overflows its type");return false; }
  }
  node.value=0-node.left.value;return true;
 }
 return true;
}
fn boot_check_entry(ctx:*BootContext,item:*BootNode)->bool {
 if ctx.no_main || strcmp(item.name,"main")!=0 { return true; }
 if (item.flags&2)!=0||item.generics!=(0 as *BootNode) {boot_error(ctx,item.token,"main requires a non-foreign i32 or void signature");return false;}
 if item.owner!=ctx.root_module {return true;}
 if (item.flags&2)!=0 || (item.flags&4)!=0 || (item.ty.kind!=BY_I32 && item.ty.kind!=BY_VOID) {
  boot_error(ctx,item.token,"main requires a non-foreign i32 or void signature");return false;
 }
 let first:*BootNode=item.params;
 if first==(0 as *BootNode) { return true; }
 let second:*BootNode=first.next;
 if first.ty.kind!=BY_I32 || second==(0 as *BootNode) {
  boot_error(ctx,item.token,"main parameters must be (i32, **u8) or empty");return false;
 }
 let ty:*BootType=second.ty;
 if second.next!=(0 as *BootNode) || ty.kind!=BY_PTR || ty.inner.kind!=BY_PTR || ty.inner.inner.kind!=BY_U8 {
  boot_error(ctx,item.token,"main parameters must be (i32, **u8) or empty");return false;
 }
 return true;
}
pub fn boot_check(ctx:*BootContext)->bool {
 if ctx.failed || ctx.program==(0 as *BootNode) { return false; }
 if !boot_normalize(ctx)||!boot_methods_check(ctx){return false;}
 // Register all declarations before any body, allowing forward calls/types.
 let mut item:*BootNode=ctx.program.body;
 while item!=(0 as *BootNode) && !ctx.failed {
  ctx.module=item.owner;
  let imported:*BootNode=boot_imported(ctx,item.name,item.token);
  if ctx.failed {return false;}
  if imported!=(0 as *BootNode) && !boot_foreign_same(imported,item) {boot_error(ctx,item.token,"local declaration conflicts with imported symbol");return false;}
  let mut prior:*BootNode=ctx.program.body;
  while prior!=item {
   if strcmp(prior.name,item.name)==0 {
    if boot_c_symbol(prior) && boot_c_symbol(item) {
     if !boot_foreign_same(prior,item){boot_error(ctx,item.token,"incompatible cross-module foreign declarations");return false;}
     if (prior.flags&BF_EXPORT)!=0 && (item.flags&BF_EXPORT)!=0{boot_error(ctx,item.token,"duplicate exported definition");return false;}
     if prior.owner==item.owner && (prior.flags&2)!=0 && (item.flags&2)!=0 {boot_error(ctx,item.token,"duplicate top-level name");return false;}
    }else if prior.owner==item.owner{boot_error(ctx,item.token,"duplicate top-level name");return false;}
   }
   prior=prior.next;
  }
  let mut generic:*BootNode=item.generics;
  while generic!=0 as *BootNode{
   if generic.ty.kind==BY_CONST_PARAMETER{generic.ty.inner=boot_normal_type(ctx,generic.ty.inner,0,generic.token);if ctx.failed{return false;}if !ce_integer(generic.ty.inner)&&generic.ty.inner.kind!=BY_BOOL{boot_error(ctx,generic.token,"const parameter requires an integer or bool type");return false;}}
   generic=generic.next;
  }
  if item.kind==BN_ENUM{
   if !boot_check_enum_definition(ctx,item){return false;}item=item.next;continue;
  }
  if item.generics!=(0 as *BootNode){
   if (item.flags&BF_EXPORT)!=0 {boot_error(ctx,item.token,"no_mangle requires a concrete non-generic definition");return false;}
   if item.kind==BN_ALIAS&&!boot_type_shape(ctx,boot_normal_type(ctx,item.ty.inner,0,item.token),item.token,true,0){return false;}
   if item.kind==BN_FN&&!boot_check_entry(ctx,item){return false;}
   if item.kind==BN_FN&&!boot_type_shape(ctx,item.ty,item.token,true,0){return false;}
   let mut field:*BootNode=item.params;if item.kind==BN_STRUCT{field=item.body;}
   let first:*BootNode=field;
   while field!=(0 as *BootNode){
    if !boot_type_shape(ctx,field.ty,field.token,true,0){return false;}
    let mut previous:*BootNode=first;while previous!=field{if strcmp(previous.name,field.name)==0{boot_error(ctx,field.token,"duplicate generic declaration member");return false;}previous=previous.next;}
    field=field.next;
   }
   item=item.next;continue;
  }
  if item.kind==BN_STRUCT {
   if item.ty.union_layout && item.body==0 as *BootNode{boot_error(ctx,item.token,"union requires at least one field");return false;}
   let mut field:*BootNode=item.body;
   while field!=(0 as *BootNode) {
    if !boot_type_valid(ctx,field.ty,field.token,false) { return false; }
    let mut previous:*BootNode=item.body;
    while previous!=field {
     if strcmp(previous.name,field.name)==0 { boot_error(ctx,field.token,"duplicate struct field");return false; }
     previous=previous.next;
    }
    field=field.next;
   }
   if !boot_struct_finite(ctx,item.ty,0 as *BootTypeTrail,item.token) { return false; }
   if !boot_layout(ctx,item.ty,0,item.token){return false;}
  } else {
   if !boot_type_valid(ctx,item.ty,item.token,(item.kind==BN_FN||item.kind==BN_ALIAS)) { return false; }
   if boot_c_symbol(item)&&tp_foreign(item.ty,0){boot_error(ctx,item.token,"tuple values have no stable C ABI");return false;}
   if item.kind==BN_FN {
    if (item.flags&BF_EXPORT)!=0 && strcmp(item.name,"main")==0 && !ctx.no_main {boot_error(ctx,item.token,"exporting the host main symbol requires #![no_main]");return false;}
    if (item.flags&4)!=0 && ((item.flags&2)==0 || item.params==(0 as *BootNode)) {
     boot_error(ctx,item.token,"variadic signature requires a foreign function with a fixed parameter");return false;
    }
    if !boot_check_entry(ctx,item) { return false; }
    if boot_c_symbol(item)&&boot_foreign_enum(item.ty,0){boot_error(ctx,item.token,"foreign enum value ABI is not supported");return false;}
    if boot_c_symbol(item)&&item.ty.kind==BY_ARRAY{boot_error(ctx,item.token,"foreign array value ABI is not supported");return false;}
    let mut param:*BootNode=item.params;
    while param!=(0 as *BootNode) {
     if !boot_type_valid(ctx,param.ty,param.token,false) { return false; }
     if boot_c_symbol(item)&&tp_foreign(param.ty,0){boot_error(ctx,param.token,"tuple values have no stable C ABI");return false;}
     if boot_c_symbol(item)&&param.ty.kind==BY_VOID{boot_error(ctx,param.token,"foreign unit parameter ABI is not supported");return false;}
     if boot_c_symbol(item)&&boot_foreign_enum(param.ty,0){boot_error(ctx,param.token,"foreign enum value ABI is not supported");return false;}
     if boot_c_symbol(item)&&param.ty.kind==BY_ARRAY{boot_error(ctx,param.token,"foreign array value ABI is not supported");return false;}
     let mut previous:*BootNode=item.params;
     while previous!=param {
      if strcmp(previous.name,param.name)==0 { boot_error(ctx,param.token,"duplicate function parameter");return false; }
      previous=previous.next;
     }
     param=param.next;
    }
   }
  }
  item=item.next;
 }
 item=ctx.program.body;
 while item!=(0 as *BootNode) && !ctx.failed {
  ctx.module=item.owner;
  if item.kind==BN_STATIC && item.left!=0 as *BootNode {
   let actual:*BootType=boot_check_expr(ctx,item.left,item.ty);
   if ctx.failed || !boot_expect(ctx,item,actual,item.ty) || !boot_static_initializer(ctx,item.left,false){return false;}
  }
  if item.kind==BN_CONST {
   if ce_integer(item.ty)||item.ty.kind==BY_BOOL{
    let constant:*BootType=ce_eval(ctx,item.left,0 as *BootTypeBinding,item.ty,0);if constant==0 as *BootType||constant.inner!=item.ty{boot_error(ctx,item.token,"constant type mismatch");return false;}
    let literal:*BootNode=boot_node(ctx,BN_CONST_VALUE,item.left.token);if ctx.failed{return false;}literal.ty=item.ty;literal.value=constant.extent as i64;item.left=literal;
   }
   if !boot_constant_form(item.left) { boot_error(ctx,item.token,"Core constants require scalar literals or unary literals");return false; }
   let actual:*BootType=boot_check_expr(ctx,item.left,item.ty);
   if ctx.failed { return false; }
   if !boot_expect(ctx,item,actual,item.ty) { return false; }
   if !boot_constant_checked(ctx,item.left) { return false; }
   item.value=item.left.value;
  }
  if item.kind==BN_FN && (item.flags&(2|BF_CLOSURE_BODY))==0 && item.generics==(0 as *BootNode) {
   if !boot_type_valid(ctx,item.ty,item.token,true){return false;}
   if item.ty.kind!=BY_VOID{boot_value_tail(item.body,BN_RETURN);}
   ctx.function=item;ctx.depth=0;ctx.loop_depth=0;ctx.bindings=0 as *BootBinding;
   let mut param:*BootNode=item.params;
   while param!=(0 as *BootNode) { if !boot_type_valid(ctx,param.ty,param.token,false){return false;}if !boot_bind(ctx,param) { return false; } param=param.next; }
   boot_check_statement(ctx,item.body);
   if !ctx.failed && item.ty.kind!=BY_VOID && (boot_flow(item.body)&1)!=0 { boot_error(ctx,item.token,"function may finish without returning a value"); }
   ctx.bindings=0 as *BootBinding;ctx.function=0 as *BootNode;
  }
  item=item.next;
 }
 if !ctx.failed && boot_borrow_check(ctx) && boot_own_lower(ctx){return boot_check_effects(ctx);}
 return false;
}

fn boot_check_generic_call(ctx:*BootContext,node:*BootNode,function:*BootNode,expected:*BootType)->*BootNode{
 let bindings:*BootTypeBinding=boot_type_bindings(ctx,function.generics);if ctx.failed{return 0 as *BootNode;}
 if (function.flags&BF_METHOD)!=0&&node.aux!=0 as *BootType&&boot_type_concrete(node.aux,0){
  if !boot_infer_type(ctx,function.aux,node.aux,bindings,node.token,0){return 0 as *BootNode;}
 }
 if expected!=(0 as *BootType)&&!boot_infer_type(ctx,function.ty,expected,bindings,node.token,0){return 0 as *BootNode;}
 let mut pass:i32=0;
 while pass<2&&!ctx.failed{
  let mut param:*BootNode=function.params;let mut arg:*BootNode=node.params;
  while param!=(0 as *BootNode)&&arg!=(0 as *BootNode){
   // Infer from typed operands before contextual numeric literals.
   let contextual:bool=boot_contextual_expr(ctx,arg);
   if pass==1||!contextual{
    let hint:*BootType=boot_generic_hint(ctx,param.ty,bindings,arg.token);if ctx.failed{return 0 as *BootNode;}
    let actual:*BootType=boot_check_expr(ctx,arg,hint);if ctx.failed{return 0 as *BootNode;}
    if !boot_infer_type(ctx,param.ty,actual,bindings,arg.token,0){return 0 as *BootNode;}
   }
   param=param.next;arg=arg.next;
  }
  if param!=(0 as *BootNode)||arg!=(0 as *BootNode){boot_error(ctx,node.token,"generic function value argument count mismatch");return 0 as *BootNode;}
  pass=pass+1;
 }
 return boot_function_instance(ctx,function,bindings,node.token);
}

fn boot_contextual_tail(ctx:*BootContext,node:*BootNode)->bool{
 if node==(0 as *BootNode){return false;}
 if node.kind==BN_BLOCK{let mut last:*BootNode=node.body;if last==(0 as *BootNode){return false;}while last.next!=(0 as *BootNode){last=last.next;}return boot_contextual_tail(ctx,last);}
 if node.kind==BN_IF{return boot_contextual_tail(ctx,node.body)&&boot_contextual_tail(ctx,node.third);}
 if node.kind==BN_YIELD{return boot_contextual_expr(ctx,node.left);}
 return node.kind==BN_RETURN||node.kind==BN_WHILE;
}
fn boot_contextual_expr(ctx:*BootContext,node:*BootNode)->bool{
 if node.kind==BN_ENUM_VALUE&&node.ty.kind==BY_TEMPLATE{return true;}
 if boot_literal_number(node){return true;}
