 if pattern.op==PM_BIND{
  pattern.ty=subject;let binding:*BootNode=boot_node(ctx,BN_LET,pattern.token);if ctx.failed{return false;}
  binding.name=pattern.name;binding.ty=subject;binding.left=value;pattern.decl=binding;
  if !boot_bind(ctx,binding){return false;}
  if arm.params==0 as *BootNode{arm.params=binding;}else{let mut tail:*BootNode=arm.params;while tail.next!=0 as *BootNode{tail=tail.next;}tail.next=binding;}return true;
 }
 if pattern.op==PM_LITERAL{
  if !boot_integer(subject)&&subject.kind!=BY_BOOL{boot_error(ctx,pattern.token,"literal pattern requires a matching scalar type");return false;}
  let actual:*BootType=boot_check_expr(ctx,pattern.left,subject);if ctx.failed||!boot_expect(ctx,pattern,actual,subject){return false;}
