fn boot_check_pattern(ctx:*BootContext,pattern:*BootNode,subject:*BootType,value:*BootNode,arm:*BootNode,depth:i32)->bool{
 if ctx.failed{return false;}if depth>256{boot_error(ctx,pattern.token,"pattern nesting exceeds 256");return false;}
