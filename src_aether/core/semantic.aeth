  if !ctx.failed&&(boot_flow(arm.body)&1)!=0{
   if ctx.value_type!=0 as *BootType&&ctx.value_type.kind!=BY_VOID{boot_error(ctx,arm.token,"match arm may finish without a value");}
   else{
    ctx.value_type=boot_type(ctx,BY_VOID);let unit:*BootNode=boot_node(ctx,BN_UNIT,arm.token);let finish:*BootNode=boot_node(ctx,BN_YIELD,arm.token);if ctx.failed{break;}unit.ty=ctx.value_type;finish.left=unit;
    let mut last:*BootNode=arm.body.body;if last==0 as *BootNode{arm.body.body=finish;}else{while last.next!=0 as *BootNode{last=last.next;}last.next=finish;}
   }
  }
  ctx.depth=ctx.depth-1;ctx.bindings=saved;arm=arm.next;
