}
fn boot_result_shape(ty:*BootType)->bool{
 if ty==0 as *BootType||ty.kind!=BY_ENUM{return false;}
 let ok:*BootNode=boot_enum_variant(ty,"Ok");let err:*BootNode=boot_enum_variant(ty,"Err");
 return ok!=0 as *BootNode&&err!=0 as *BootNode&&ok.params!=0 as *BootNode&&err.params!=0 as *BootNode&&ok.params.next==0 as *BootNode&&err.params.next==0 as *BootNode&&ty.fields.next.next==0 as *BootNode;
}
fn boot_check_try(ctx:*BootContext,node:*BootNode)->*BootType{
 let source:*BootType=boot_check_expr(ctx,node.left,0 as *BootType);if ctx.failed{return 0 as *BootType;}
 if ctx.function==0 as *BootNode||!boot_result_shape(source)||!boot_result_shape(ctx.function.ty){boot_error(ctx,node.token,"? requires Ok/Err enum values and an Ok/Err-returning function");return 0 as *BootType;}
 let target:*BootType=ctx.function.ty;let ok:*BootNode=boot_enum_variant(source,"Ok");let error:*BootNode=boot_enum_variant(source,"Err");let target_error:*BootNode=boot_enum_variant(target,"Err");
 if error.params.ty!=target_error.params.ty{boot_error(ctx,node.token,"? requires the same error payload type");return 0 as *BootType;}
 let temporary:*BootNode=boot_node(ctx,BN_LET,node.token);if ctx.failed{return 0 as *BootType;}temporary.ty=source;temporary.left=node.left;
 let failure:*BootNode=boot_node(ctx,BN_IF,node.token);let returned:*BootNode=boot_node(ctx,BN_RETURN,node.token);let value:*BootNode=boot_node(ctx,BN_ENUM_VALUE,node.token);let yielded:*BootNode=boot_node(ctx,BN_YIELD,node.token);let block:*BootNode=boot_node(ctx,BN_BLOCK,node.token);if ctx.failed{return 0 as *BootType;}
 failure.left=boot_enum_test(ctx,temporary,error);failure.body=boot_enum_block(ctx,returned);returned.left=value;value.ty=target;value.decl=target_error;value.params=boot_enum_projection(ctx,temporary,error,error.params);
 yielded.left=boot_enum_projection(ctx,temporary,ok,ok.params);temporary.next=failure;failure.next=yielded;block.body=temporary;
 node.kind=BN_VALUE;node.flags=node.flags|4096;node.ty=ok.params.ty;node.body=block;node.left=0 as *BootNode;return node.ty;
}

fn boot_foreign_enum(ty:*BootType,depth:i32)->bool{
 if depth>256{return true;}if ty.kind==BY_ENUM{return true;}
 if ty.kind==BY_ARRAY{return boot_foreign_enum(ty.inner,depth+1);}
 if ty.kind==BY_STRUCT{let mut field:*BootNode=ty.fields;while field!=0 as *BootNode{if boot_foreign_enum(field.ty,depth+1){return true;}field=field.next;}}
 return false;
}

fn boot_range_name(ctx:*BootContext)->*u8{let name:*u8=boot_alloc(ctx,48) as *u8;if name!=0 as *u8{snprintf(name,48,"@range_%d",boot_id(ctx));}return name;}
fn boot_range_ident(ctx:*BootContext,binding:*BootNode)->*BootNode{let node:*BootNode=boot_node(ctx,BN_IDENT,binding.token);if node!=0 as *BootNode{node.name=binding.name;}return node;}
fn boot_check_range(ctx:*BootContext,node:*BootNode)->bool{
 let mut ty:*BootType=0 as *BootType;let mut end_type:*BootType=0 as *BootType;
 if boot_literal_number(node.left)&&!boot_literal_number(node.right){end_type=boot_check_expr(ctx,node.right,0 as *BootType);ty=boot_check_expr(ctx,node.left,end_type);}
 else{ty=boot_check_expr(ctx,node.left,0 as *BootType);end_type=boot_check_expr(ctx,node.right,ty);}
 if ctx.failed{return false;}if !boot_integer(ty)||ty!=end_type{boot_error(ctx,node.token,"for range requires matching integer endpoint types");return false;}
 let iterator:*BootNode=boot_node(ctx,BN_LET,node.token);let limit:*BootNode=boot_node(ctx,BN_LET,node.token);
 let iteration:*BootNode=boot_node(ctx,BN_WHILE,node.token);let bound:*BootNode=boot_node(ctx,BN_BINARY,node.token);
 let binding:*BootNode=boot_node(ctx,BN_LET,node.token);let advance:*BootNode=boot_node(ctx,BN_ASSIGN,node.token);let one:*BootNode=boot_node(ctx,BN_INT,node.token);
 if ctx.failed{return false;}
 iterator.name=boot_range_name(ctx);iterator.ty=ty;iterator.left=node.left;iterator.flags=1;iterator.next=limit;
 limit.name=boot_range_name(ctx);limit.ty=ty;limit.left=node.right;limit.next=iteration;
 bound.op=60;bound.left=boot_range_ident(ctx,iterator);bound.right=boot_range_ident(ctx,limit);iteration.left=bound;iteration.body=node.body;
 binding.name=node.name;binding.ty=ty;binding.left=boot_range_ident(ctx,iterator);
 one.name="1";let token:*BootToken=boot_alloc(ctx,size_of(BootToken) as u64) as *BootToken;if ctx.failed{return false;}memcpy(token as *void,node.token as *void,size_of(BootToken) as u64);token.text="1";token.length=1;token.kind=BT_INT;one.token=token;
 advance.op=43;advance.left=boot_range_ident(ctx,iterator);advance.right=one;
 binding.next=advance;advance.next=iteration.body.body;iteration.body.body=binding;
