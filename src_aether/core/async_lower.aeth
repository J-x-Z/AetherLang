// Cooperative async is lowered into ordinary checked Core functions and enums.
// Only generated slot transfers are unsafe; user statements keep their context.
use model::*;
use runtime::*;
use type_model::*;
use borrow_model::br_contains;
use async_model::*;
use async_text::*;
use lexer::boot_lex;
use parser::boot_parse;
fn as_task(state:*AsyncState,function:*BootNode)->*AsyncTask{let mut task:*AsyncTask=state.tasks;while task!=0 as *AsyncTask{if task.function==function{return task;}task=task.next;}return 0 as *AsyncTask;}
fn as_alias(state:*AsyncState,ty:*BootType)->*u8{let name:*u8=at_name(state.ctx,"type");let alias:*BootType=boot_named_type(state.ctx,name);if !state.ctx.failed{alias.kind=BY_ALIAS;alias.inner=ty;alias.complete=true;}return name;}
fn as_slot(state:*AsyncState,name:*u8,mut ty:*BootType,mutable:bool,parameter:bool,token:*BootToken)->*AsyncSlot{
 let ctx:*BootContext=state.ctx;let mut old:*AsyncSlot=state.task.slots;while old!=0 as *AsyncSlot{if strcmp(old.name,name)==0{boot_error(ctx,token,"distinct top-level async binding names are required");return 0 as *AsyncSlot;}old=old.next;}
 ty=boot_normal_type(ctx,ty,0,token);if ctx.failed{return 0 as *AsyncSlot;}
 if ty==0 as *BootType||ty.kind==BY_INFER||br_contains(ty,0){boot_error(ctx,token,"async slots require explicit by-value types without checked references");return 0 as *AsyncSlot;}
 let slot:*AsyncSlot=boot_alloc(ctx,size_of(AsyncSlot) as u64) as *AsyncSlot;if ctx.failed{return slot;}slot.name=name;slot.ty=ty;slot.raw=ty;if ty.kind==BY_OWN{slot.raw=ty.inner;}slot.mutable=mutable;slot.parameter=parameter;slot.field=at_name(ctx,"field");slot.slot=at_name(ctx,"slot");
 if state.task.tail==0 as *AsyncSlot{state.task.slots=slot;}else{state.task.tail.next=slot;}state.task.tail=slot;return slot;
}
fn as_validate(ctx:*BootContext,node:*BootNode,loops:i32)->bool{
 let mut item:*BootNode=node;while item!=0 as *BootNode&&!ctx.failed{
  if item.kind==BN_AWAIT{boot_error(ctx,item.token,"await requires a top-level async statement or let initializer");return false;}
  if item.kind==BN_TRY{boot_error(ctx,item.token,"use explicit Result match/return in async functions");return false;}
  if (item.kind==BN_BREAK||item.kind==BN_CONTINUE)&&loops==0{boot_error(ctx,item.token,"loop control requires a user loop");return false;}
  let mut nested:i32=loops;if item.kind==BN_WHILE||item.kind==BN_RANGE_FOR{nested+=1;}
  if !as_validate(ctx,item.left,loops)||!as_validate(ctx,item.right,loops)||!as_validate(ctx,item.third,loops)||!as_validate(ctx,item.params,loops)||!as_validate(ctx,item.body,nested){return false;}item=item.next;
 }return !ctx.failed;
}
fn as_split(state:*AsyncState,task:*AsyncTask,depth:i32)->bool{
 if task.done{return true;}if task.visiting||depth>32{boot_error(state.ctx,task.function.token,"recursive or excessively nested async frames require indirection");return false;}task.visiting=true;
 let ctx:*BootContext=state.ctx;state.task=task;ctx.module=task.function.owner;
 if task.output.kind!=BY_VOID{boot_value_tail(task.function.body,BN_RETURN);if (boot_flow(task.function.body)&1)!=0{boot_error(ctx,task.function.token,"async function may finish without returning a value");return false;}}else if (boot_flow(task.function.body)&1)!=0{
  let returned:*BootNode=boot_node(ctx,BN_RETURN,task.function.token);if ctx.failed{return false;}let mut last:*BootNode=task.function.body.body;if last==0 as *BootNode{task.function.body.body=returned;}else{while last.next!=0 as *BootNode{last=last.next;}last.next=returned;}
 }
 let mut parameter:*BootNode=task.function.params;while parameter!=0 as *BootNode{as_slot(state,parameter.name,parameter.ty,(parameter.flags&1)!=0,true,parameter.token);parameter=parameter.next;}
 let mut part:*AsyncPart=boot_alloc(ctx,size_of(AsyncPart) as u64) as *AsyncPart;if ctx.failed{return false;}task.parts=part;part.incoming=task.tail;let mut tail:*BootNode=0 as *BootNode;let mut item:*BootNode=task.function.body.body;
 while item!=0 as *BootNode&&!ctx.failed{
  let next:*BootNode=item.next;item.next=0 as *BootNode;
  let mut suspension:*BootNode=item.left;if item.kind==BN_ASSIGN{suspension=item.right;}
  if (item.kind==BN_LET||item.kind==BN_EXPR||item.kind==BN_ASSIGN)&&suspension!=0 as *BootNode&&suspension.kind==BN_AWAIT{
   if part.number>=64{boot_error(ctx,item.token,"at most 64 async suspension points");return false;}
   part.awaited=suspension.left;part.last=task.tail;
   if !as_validate(ctx,part.awaited,0){return false;}
   if part.awaited.kind!=BN_CALL||(part.awaited.left!=0 as *BootNode&&part.awaited.left.kind!=BN_IDENT){boot_error(ctx,item.token,"await requires a direct async call or yield_now()");return false;}
   let declaration:*BootNode=boot_lookup(ctx,part.awaited.name,part.awaited.lookup,part.awaited.token);if ctx.failed{return false;}
   if declaration==0 as *BootNode&&strcmp(part.awaited.name,"yield_now")==0{
    if part.awaited.params!=0 as *BootNode{boot_error(ctx,item.token,"yield_now takes no arguments");return false;}
   }else{
    let child:*AsyncTask=as_task(state,declaration);if child==0 as *AsyncTask{boot_error(ctx,item.token,"await requires an async function");return false;}
    if !as_split(state,child,depth+1){return false;}state.task=task;ctx.module=task.function.owner;
    part.child=as_slot(state,at_name(ctx,"child"),boot_owned_type(ctx,child.frame),true,false,item.token);if ctx.failed{return false;}part.child.child=true;
   }
   if item.kind==BN_LET{part.output=as_slot(state,item.name,item.ty,(item.flags&1)!=0,false,item.token);}
   if item.kind==BN_ASSIGN{
    if item.op!=0||item.left.kind!=BN_IDENT{boot_error(ctx,item.token,"await assignment requires a direct Script local");return false;}
    let mut output:*AsyncSlot=task.slots;while output!=0 as *AsyncSlot{if strcmp(output.name,item.left.name)==0{part.output=output;}output=output.next;}
    if part.output==0 as *AsyncSlot{boot_error(ctx,item.token,"await assignment requires initialized typed storage");return false;}
   }
   let following:*AsyncPart=boot_alloc(ctx,size_of(AsyncPart) as u64) as *AsyncPart;if ctx.failed{return false;}following.number=part.number+1;following.incoming=task.tail;part.next=following;part=following;tail=0 as *BootNode;
  }else{
   if !as_validate(ctx,item,0){return false;}
   if item.kind==BN_LET{as_slot(state,item.name,item.ty,(item.flags&1)!=0,false,item.token);}
   if tail==0 as *BootNode{part.statements=item;}else{tail.next=item;}tail=item;
  }item=next;
 }
 part.last=task.tail;task.visiting=false;task.done=true;return !ctx.failed;
}
fn as_placeholder(state:*AsyncState,node:*BootNode,chunk:bool)->*u8{
 let item:*AsyncReplace=boot_alloc(state.ctx,size_of(AsyncReplace) as u64) as *AsyncReplace;if state.ctx.failed{return "";}
 item.name=at_name(state.ctx,"source");item.node=node;item.chunk=chunk;item.next=state.task.replacements;state.task.replacements=item;return item.name;
}
fn as_text(state:*AsyncState,text:*u8){at_text(state.text,text);}
fn as_field(state:*AsyncState,slot:*AsyncSlot){as_text(state,state.task.receiver);as_text(state,".");as_text(state,slot.field);}
fn as_enum(state:*AsyncState,slot:*AsyncSlot,variant:*u8){as_text(state,slot.slot);as_text(state,"::");as_text(state,variant);}
fn as_restore(state:*AsyncState,slot:*AsyncSlot){
 let raw:*u8=at_name(state.ctx,"raw");as_text(state,"let ");if slot.mutable{as_text(state,"mut ");}as_text(state,slot.name);as_text(state,":");as_text(state,as_alias(state,slot.ty));as_text(state,"=unsafe{let ");as_text(state,raw);as_text(state,":");as_text(state,as_alias(state,slot.raw));as_text(state,"=match ");as_field(state,slot);as_text(state,"{");as_enum(state,slot,"Full");as_text(state,"(value)=>value,");as_enum(state,slot,"Empty");as_text(state,"=>{return ");as_text(state,state.task.poll.name);as_text(state,"::Finished;}};");as_field(state,slot);as_text(state,"=");as_enum(state,slot,"Empty");as_text(state,";");as_text(state,raw);if slot.ty.kind==BY_OWN{as_text(state," as ");as_text(state,as_alias(state,slot.ty));}as_text(state,"};\n");
}
fn as_persist(state:*AsyncState,slot:*AsyncSlot){
 as_text(state,"unsafe{");as_field(state,slot);as_text(state,"=");as_enum(state,slot,"Full");as_text(state,"(");as_text(state,slot.name);if slot.ty.kind==BY_OWN{as_text(state," as ");as_text(state,as_alias(state,slot.raw));}as_text(state,");}\n");
}
fn as_phase(state:*AsyncState,phase:i32){as_text(state,"unsafe{");as_text(state,state.task.receiver);as_text(state,".phase=");at_number(state.text,phase);as_text(state,";}");}
fn as_ready_return(ctx:*BootContext,task:*AsyncTask,node:*BootNode){
 let token:*BootToken=node.token;let next:*BootNode=node.next;let value:*BootNode=node.left;
 let binding:*BootNode=boot_node(ctx,BN_LET,token);let phase:*BootNode=boot_node(ctx,BN_ASSIGN,token);let target:*BootNode=boot_node(ctx,BN_MEMBER,token);let receiver:*BootNode=boot_node(ctx,BN_IDENT,token);let number:*BootNode=boot_node(ctx,BN_CONST_VALUE,token);let returned:*BootNode=boot_node(ctx,BN_RETURN,token);let result:*BootNode=boot_node(ctx,BN_ENUM_VALUE,token);let reference:*BootNode=boot_node(ctx,BN_IDENT,token);if ctx.failed{return;}
 binding.name=at_name(ctx,"returned");binding.ty=task.output;binding.left=value;if value==0 as *BootNode{binding.left=boot_node(ctx,BN_UNIT,token);}
 receiver.name=task.receiver;target.left=receiver;target.name="phase";phase.left=target;phase.right=number;number.ty=boot_type(ctx,BY_I32);number.value=-1;
 reference.name=binding.name;result.name="Ready";result.ty=task.poll;result.params=reference;returned.left=result;binding.next=phase;phase.next=returned;
 node.kind=BN_BLOCK;node.left=0 as *BootNode;node.body=binding;node.next=next;
}
fn as_returns(ctx:*BootContext,task:*AsyncTask,node:*BootNode){
 let mut item:*BootNode=node;while item!=0 as *BootNode&&!ctx.failed{
  if item.kind!=BN_CLOSURE{as_returns(ctx,task,item.left);as_returns(ctx,task,item.right);as_returns(ctx,task,item.third);as_returns(ctx,task,item.body);as_returns(ctx,task,item.params);if item.kind==BN_RETURN{as_ready_return(ctx,task,item);}}
  item=item.next;
 }
}
fn as_replace(state:*AsyncState,node:*BootNode){
 let mut item:*BootNode=node;while item!=0 as *BootNode&&!state.ctx.failed{
  let mut replacement:*AsyncReplace=state.task.replacements;let mut found:bool=false;
  while replacement!=0 as *AsyncReplace{
   let mut candidate:*BootNode=item;if replacement.chunk&&item.kind==BN_EXPR{candidate=item.left;}
   if candidate.kind==BN_CALL&&candidate.name!=0 as *u8&&strcmp(candidate.name,replacement.name)==0{
    let next:*BootNode=item.next;if replacement.chunk{
     if replacement.node==0 as *BootNode{item.kind=BN_BLOCK;item.left=0 as *BootNode;item.body=0 as *BootNode;item.next=next;}
     else{memcpy(item as *void,replacement.node as *void,size_of(BootNode) as u64);let mut tail:*BootNode=item;while tail.next!=0 as *BootNode{tail=tail.next;}tail.next=next;}
    }else{memcpy(item as *void,replacement.node as *void,size_of(BootNode) as u64);item.next=next;}found=true;break;
   }replacement=replacement.next;
  }
  if !found{as_replace(state,item.left);as_replace(state,item.right);as_replace(state,item.third);as_replace(state,item.body);as_replace(state,item.params);}item=item.next;
 }
}
fn as_emit(state:*AsyncState)->bool{
 let task:*AsyncTask=state.task;let ctx:*BootContext=state.ctx;ctx.module=task.function.owner;state.text=at_new(ctx);if ctx.failed{return false;}
 let mut slot:*AsyncSlot=task.slots;
 while slot!=0 as *AsyncSlot{as_text(state,"enum ");as_text(state,slot.slot);as_text(state,"{Empty,Full(");as_text(state,as_alias(state,slot.raw));as_text(state,")}\n");slot=slot.next;}
 as_text(state,"enum ");as_text(state,task.poll.name);as_text(state,"{Pending,Ready(");as_text(state,as_alias(state,task.output));as_text(state,"),Finished}\nstruct ");as_text(state,task.frame.name);as_text(state,"{phase:i32,");slot=task.slots;
 while slot!=0 as *AsyncSlot{as_text(state,slot.field);as_text(state,":");as_text(state,slot.slot);as_text(state,",");slot=slot.next;}as_text(state,"}\n");
 if (task.function.flags&8)!=0{as_text(state,"pub ");}as_text(state,"fn ");as_text(state,task.function.name);as_text(state,"(");let mut parameter:*BootNode=task.function.params;
 while parameter!=0 as *BootNode{as_text(state,parameter.name);as_text(state,":");as_text(state,as_alias(state,parameter.ty));as_text(state,",");parameter=parameter.next;}
 as_text(state,")->own ");as_text(state,task.frame.name);as_text(state,"{unsafe{return ");as_text(state,task.frame.name);as_text(state,"{phase:0,");slot=task.slots;
 while slot!=0 as *AsyncSlot{as_text(state,slot.field);as_text(state,":");as_enum(state,slot,"Empty");if slot.parameter{ // Rewrite the just-emitted Empty as Full through a separate expression.
  state.text.length=state.text.length-5;state.text.data[state.text.length]=0;as_text(state,"Full(");as_text(state,slot.name);if slot.ty.kind==BY_OWN{as_text(state," as ");as_text(state,as_alias(state,slot.raw));}as_text(state,")");
 }as_text(state,",");slot=slot.next;}as_text(state,"} as own ");as_text(state,task.frame.name);as_text(state,";}}\n@drop fn ");as_text(state,at_name(ctx,"drop"));as_text(state,"(value:own ");as_text(state,task.frame.name);as_text(state,"){unsafe{");
 // Slot declarations are creation ordered; cleanup is strictly reverse ordered.
 let mut stop:*AsyncSlot=0 as *AsyncSlot;
 while task.slots!=stop{slot=task.slots;while slot.next!=stop{slot=slot.next;}if slot.ty.kind==BY_OWN{as_text(state,"match value.");as_text(state,slot.field);as_text(state,"{");as_enum(state,slot,"Full");as_text(state,"(raw)=>{let child:");as_text(state,as_alias(state,slot.ty));as_text(state,"=raw as ");as_text(state,as_alias(state,slot.ty));as_text(state,";},");as_enum(state,slot,"Empty");as_text(state,"=>{}};");}stop=slot;}
 as_text(state,"}}\nimpl ");as_text(state,task.frame.name);as_text(state,"{pub fn cancel(self:own Self){}pub fn is_finished(self:&own Self)->bool{self.phase<0}pub fn poll(");as_text(state,task.receiver);as_text(state,":&mut own Self)->");as_text(state,task.poll.name);as_text(state,"{loop{");
 let mut part:*AsyncPart=task.parts;
 while part!=0 as *AsyncPart&&!ctx.failed{
  as_text(state,"if ");as_text(state,task.receiver);as_text(state,".phase==");at_number(state.text,part.number*2);as_text(state,"{");
  slot=task.slots;while part.incoming!=0 as *AsyncSlot&&slot!=0 as *AsyncSlot{if !slot.child{as_restore(state,slot);}if slot==part.incoming{break;}slot=slot.next;}
  as_returns(ctx,task,part.statements);as_text(state,as_placeholder(state,part.statements,true));as_text(state,"();");
  if part.awaited!=0 as *BootNode{
   if part.child!=0 as *AsyncSlot{as_returns(ctx,task,part.awaited);as_text(state,"let mut ");as_text(state,part.child.name);as_text(state,":");as_text(state,as_alias(state,part.child.ty));as_text(state,"=");as_text(state,as_placeholder(state,part.awaited,false));as_text(state,"();");}
   slot=task.slots;while part.last!=0 as *AsyncSlot&&slot!=0 as *AsyncSlot{if !slot.child{as_persist(state,slot);}if slot==part.last{break;}slot=slot.next;}
   if part.child!=0 as *AsyncSlot{as_persist(state,part.child);as_phase(state,part.number*2+1);as_text(state,"continue;");}
   else{if part.output!=0 as *AsyncSlot{as_text(state,"unsafe{");as_field(state,part.output);as_text(state,"=");as_enum(state,part.output,"Full");as_text(state,"(());}");}as_phase(state,(part.number+1)*2);as_text(state,"return ");as_text(state,task.poll.name);as_text(state,"::Pending;");}
  }
  as_text(state,"}");
  if part.child!=0 as *AsyncSlot{
   as_text(state,"if ");as_text(state,task.receiver);as_text(state,".phase==");at_number(state.text,part.number*2+1);as_text(state,"{");as_restore(state,part.child);as_text(state,"match ");as_text(state,part.child.name);as_text(state,".poll(){Pending()=>{");as_persist(state,part.child);as_text(state,"return ");as_text(state,task.poll.name);as_text(state,"::Pending;},Ready(value)=>{");
   if part.output!=0 as *AsyncSlot{as_text(state,"unsafe{");as_field(state,part.output);as_text(state,"=");as_enum(state,part.output,"Full");as_text(state,"(value);}");}as_phase(state,(part.number+1)*2);as_text(state,"continue;},Finished()=>{");as_phase(state,-1);as_text(state,"return ");as_text(state,task.poll.name);as_text(state,"::Finished;}}}");
  }part=part.next;
 }
 as_text(state,"return ");as_text(state,task.poll.name);as_text(state,"::Finished;}}}\n");
 as_text(state,"fn ");as_text(state,task.block_name);as_text(state,"(mut task:own ");as_text(state,task.frame.name);as_text(state,")->");as_text(state,as_alias(state,task.output));as_text(state,"{loop{match task.poll(){Pending()=>{},Ready(value)=>{return value;},Finished()=>{");
 let trap:*BootNode=boot_node(ctx,BN_HALT,task.function.token);if ctx.failed{return false;}trap.op=1;as_text(state,as_placeholder(state,trap,true));as_text(state,"();}}}}\n");if ctx.failed{return false;}
 let program:*BootNode=ctx.program;let source:*u8=ctx.source;let length:u64=ctx.length;let tokens:*BootToken=ctx.tokens;let cursor:*BootToken=ctx.cursor;ctx.source=state.text.data;ctx.length=state.text.length;
 if !boot_lex(ctx)||!boot_parse(ctx){return false;}let mut generated:*BootNode=ctx.program.body;ctx.program=program;ctx.source=source;ctx.length=length;ctx.tokens=tokens;ctx.cursor=cursor;
 let mut tail:*BootNode=program.body;while tail.next!=0 as *BootNode{tail=tail.next;}
 while generated!=0 as *BootNode{let next:*BootNode=generated.next;generated.next=0 as *BootNode;as_replace(state,generated);
  if generated.kind==BN_FN&&generated.ty.kind!=BY_VOID&&generated.body!=0 as *BootNode&&generated.body.body!=0 as *BootNode&&generated.body.body.kind==BN_WHILE{
   let last:*BootNode=boot_node(ctx,BN_HALT,generated.token);if ctx.failed{return false;}let mut tail_statement:*BootNode=generated.body.body;while tail_statement.next!=0 as *BootNode{tail_statement=tail_statement.next;}tail_statement.next=last;
  }
  if generated.kind==BN_FN&&strcmp(generated.name,task.function.name)==0{let original_next:*BootNode=task.function.next;let token:*BootToken=task.function.token;let id:i32=task.function.id;memcpy(task.function as *void,generated as *void,size_of(BootNode) as u64);task.function.next=original_next;task.function.token=token;task.function.id=id;}
  else{if generated.kind==BN_FN&&strcmp(generated.name,task.block_name)==0{task.blocker=generated;generated.flags=generated.flags|BF_METHOD;}tail.next=generated;tail=generated;}generated=next;
 }
 task.frame.async_frame=true;task.poll.async_frame=true;return !ctx.failed;
}
pub fn boot_async_lower(ctx:*BootContext)->bool{
 let state:*AsyncState=boot_alloc(ctx,size_of(AsyncState) as u64) as *AsyncState;if ctx.failed{return false;}state.ctx=ctx;let mut item:*BootNode=ctx.program.body;
 while item!=0 as *BootNode{
  if item.kind==BN_FN&&(item.flags&BF_ASYNC)!=0{
   if item.generics!=0 as *BootNode||item.effect_explicit||((item.flags&BF_DROP)!=0||boot_c_symbol(item))||strcmp(item.name,"main")==0{boot_error(ctx,item.token,"async requires an internal non-generic function without entry attributes or effect bounds");return false;}
   let task:*AsyncTask=boot_alloc(ctx,size_of(AsyncTask) as u64) as *AsyncTask;if ctx.failed{return false;}task.function=item;task.output=item.ty;ctx.module=item.owner;task.frame=boot_named_type(ctx,at_name(ctx,"frame"));task.poll=boot_named_type(ctx,at_name(ctx,"Poll"));task.poll.kind=BY_ENUM;task.poll.is_enum=true;task.receiver=at_name(ctx,"receiver");task.block_name=at_name(ctx,"block");task.next=state.tasks;state.tasks=task;item.ty=boot_owned_type(ctx,task.frame);
  }item=item.next;
 }
 if state.tasks==0 as *AsyncTask{return true;}if !boot_normalize(ctx){return false;}
 let mut task:*AsyncTask=state.tasks;while task!=0 as *AsyncTask{if !as_split(state,task,0){return false;}task=task.next;}
 task=state.tasks;while task!=0 as *AsyncTask{state.task=task;if !as_emit(state){return false;}task=task.next;}as_blocking_calls(state,ctx.program.body);return !ctx.failed;
}

fn as_blocking_calls(state:*AsyncState,node:*BootNode){
 let mut item:*BootNode=node;while item!=0 as *BootNode&&!state.ctx.failed{
  if item.kind==BN_FN&&(item.flags&BF_CLOSURE_BODY)!=0&&as_has_blocking(item.body){item.flags=item.flags&((-1 as i32)^BF_CLOSURE_BODY);}
  if item.kind==BN_BLOCK_ON{
   let child:*BootNode=item.left;let function:*BootNode=child.decl;let task:*AsyncTask=as_task(state,function);
   if task==0 as *AsyncTask||task.blocker==0 as *BootNode{boot_error(state.ctx,item.token,"block_on requires a known async constructor");return;}
   item.kind=BN_CALL;item.name=task.blocker.name;item.decl=task.blocker;item.params=child;child.next=0 as *BootNode;item.left=0 as *BootNode;item.ty=task.output;
  }
  as_blocking_calls(state,item.left);as_blocking_calls(state,item.right);as_blocking_calls(state,item.third);as_blocking_calls(state,item.body);as_blocking_calls(state,item.params);item=item.next;
 }
}

fn as_has_blocking(node:*BootNode)->bool{
 let mut item:*BootNode=node;while item!=0 as *BootNode{if item.kind==BN_BLOCK_ON||as_has_blocking(item.left)||as_has_blocking(item.right)||as_has_blocking(item.third)||as_has_blocking(item.body)||as_has_blocking(item.params){return true;}item=item.next;}return false;
}
