// Inherent methods are ordinary checked functions with one canonical receiver
// signature. No backend performs name-based method guesses or implicit casts.
use model::*;
use runtime::*;
use type_model::*;

pub fn boot_method_base(ty:*BootType)->*BootType {
 let mut base:*BootType=ty;
 while base!=0 as *BootType&&base.kind==BY_ALIAS{base=base.inner;}
 if base!=0 as *BootType&&base.base!=0 as *BootType{return base.base;}
 return base;
}
pub fn boot_method_generics(ctx:*BootContext,outer:*BootNode,inner:*BootNode,token:*BootToken)->*BootNode {
 let mut first:*BootNode=0 as *BootNode;let mut tail:*BootNode=0 as *BootNode;let mut item:*BootNode=outer;
 while item!=0 as *BootNode&&!ctx.failed{
  let copy:*BootNode=boot_alloc(ctx,size_of(BootNode) as u64) as *BootNode;if ctx.failed{return first;}
  memcpy(copy as *void,item as *void,size_of(BootNode) as u64);copy.next=0 as *BootNode;
  if tail==0 as *BootNode{first=copy;}else{tail.next=copy;}tail=copy;item=item.next;
 }
 if first==0 as *BootNode{return inner;}tail.next=inner;
 item=inner;
 while item!=0 as *BootNode&&!ctx.failed{
  let mut previous:*BootNode=first;while previous!=item{if strcmp(previous.name,item.name)==0{boot_error(ctx,token,"method generic parameter shadows an impl parameter");return first;}previous=previous.next;}item=item.next;
 }
 return first;
}
pub fn boot_method_register(ctx:*BootContext,function:*BootNode,target:*BootType)->bool {
 let metadata:*BootNode=boot_node(ctx,BN_FIELD,function.token);if ctx.failed{return false;}
 metadata.name=function.name;metadata.aux=target;metadata.decl=function;metadata.body=ctx.type_parameters;metadata.next=ctx.methods;ctx.methods=metadata;
 function.aux=target;function.flags=function.flags|BF_METHOD;
 let name:*u8=boot_alloc(ctx,64) as *u8;if ctx.failed{return false;}
 snprintf(name,64,"@method_%d",function.id);function.name=name;return true;
}
pub fn boot_method_empty(ctx:*BootContext,target:*BootType,parameters:*BootNode,token:*BootToken){
 let metadata:*BootNode=boot_node(ctx,BN_FIELD,token);if ctx.failed{return;}
 metadata.name="";metadata.aux=target;metadata.body=parameters;metadata.next=ctx.methods;ctx.methods=metadata;
}
pub fn boot_methods_check(ctx:*BootContext)->bool {
 let mut item:*BootNode=ctx.methods;
 while item!=0 as *BootNode&&!ctx.failed{
  let target:*BootType=boot_normal_type(ctx,item.aux,0,item.token);if ctx.failed{return false;}item.aux=target;
  let base:*BootType=boot_method_base(target);
  if base==0 as *BootType||!base.complete||(base.kind!=BY_STRUCT&&base.kind!=BY_TEMPLATE)||base.is_enum{boot_error(ctx,item.token,"inherent impl target must be a struct");return false;}
  let mut prior:*BootNode=item.next;
  while prior!=0 as *BootNode{
   if item.decl!=0 as *BootNode&&prior.decl!=0 as *BootNode&&boot_method_base(prior.aux)==base&&strcmp(prior.name,item.name)==0{boot_error(ctx,item.token,"duplicate inherent method on this struct");return false;}prior=prior.next;
  }
  if base.kind==BY_TEMPLATE{
   if target.kind!=BY_APPLICATION{boot_error(ctx,item.token,"generic impl requires the struct's type arguments");return false;}
   let mut arg:*BootTypeArgument=target.arguments;let mut parameter:*BootNode=item.body;let mut formal:*BootNode=base.parameters;
   while formal!=0 as *BootNode&&arg!=0 as *BootTypeArgument&&parameter!=0 as *BootNode{
    if arg.ty!=parameter.ty||arg.ty.kind!=BY_PARAMETER{boot_error(ctx,item.token,"generic impl must cover its type parameters in declaration order");return false;}
    arg=arg.next;parameter=parameter.next;formal=formal.next;
   }
   if formal!=0 as *BootNode||arg!=0 as *BootTypeArgument||parameter!=0 as *BootNode{boot_error(ctx,item.token,"generic impl type parameter count mismatch");return false;}
  }
  if base.kind!=BY_TEMPLATE&&item.body!=0 as *BootNode{boot_error(ctx,item.token,"impl type parameters must be bound by the struct target");return false;}
  if item.decl==0 as *BootNode{item=item.next;continue;}
  let mut parameter:*BootNode=item.decl.params;
  while parameter!=0 as *BootNode{
   if strcmp(parameter.name,"self")==0{
    if parameter!=item.decl.params{boot_error(ctx,parameter.token,"self must be the first method parameter");return false;}
    let mut receiver:*BootType=parameter.ty;if boot_indirect(receiver){receiver=receiver.inner;}
    receiver=boot_normal_type(ctx,receiver,0,parameter.token);
    if receiver!=target{boot_error(ctx,parameter.token,"self parameter must be Self, &Self, &mut Self or *Self");return false;}
   }
   parameter=parameter.next;
  }
  item=item.next;
 }
 return !ctx.failed;
}
fn boot_method_find(ctx:*BootContext,target:*BootType,name:*u8,token:*BootToken)->*BootNode {
 let base:*BootType=boot_method_base(target);let mut method:*BootNode=ctx.methods;
 while method!=0 as *BootNode{
  if boot_method_base(method.aux)==base&&strcmp(method.name,name)==0{
   if method.owner!=ctx.module&&(method.decl.flags&8)==0{boot_error(ctx,token,"inherent method is private to its defining module");return 0 as *BootNode;}
   return method.decl;
  }
  method=method.next;
 }
 boot_error(ctx,token,"unknown inherent method for this struct");return 0 as *BootNode;
}
fn boot_method_place(node:*BootNode)->bool {
 if node.kind==BN_IDENT||(node.kind==BN_UNARY&&node.op==42){return true;}
 if node.kind==BN_MEMBER||node.kind==BN_INDEX{
  if boot_indirect(node.left.ty){return true;}return boot_method_place(node.left);
 }
 return false;
}
fn boot_method_temporary(ctx:*BootContext,node:*BootNode,target:*BootType)->bool {
 let local:*BootNode=boot_node(ctx,BN_LET,node.token);let body:*BootNode=boot_node(ctx,BN_BLOCK,node.token);
 let call:*BootNode=boot_node(ctx,BN_METHOD_CALL,node.token);let yield:*BootNode=boot_node(ctx,BN_YIELD,node.token);
 let receiver:*BootNode=boot_node(ctx,BN_IDENT,node.token);if ctx.failed{return false;}
 let name:*u8=boot_alloc(ctx,64) as *u8;if ctx.failed{return false;}snprintf(name,64,"@receiver_%d",local.id);
 local.name=name;local.ty=target;local.flags=1;local.left=node.left;receiver.name=name;
 call.name=node.name;call.left=receiver;call.params=node.params;yield.left=call;local.next=yield;body.body=local;
 node.kind=BN_VALUE;node.left=0 as *BootNode;node.params=0 as *BootNode;node.body=body;node.ty=0 as *BootType;return true;
}
// The caller has checked the receiver expression once for its canonical type.
// Rewrites only syntax; the normal call checker verifies every final argument.
pub fn boot_method_call(ctx:*BootContext,node:*BootNode,actual:*BootType)->bool {
 if actual.kind==BY_PTR&&strcmp(node.name,"add")==0{
  if node.params==0 as *BootNode||node.params.next!=0 as *BootNode{boot_error(ctx,node.token,"pointer add requires one integer offset");return false;}
  node.kind=BN_BINARY;node.op=43;node.right=node.params;node.params=0 as *BootNode;return true;
 }
 let mut target:*BootType=actual;if boot_indirect(target){target=target.inner;}
 target=boot_normal_type(ctx,target,0,node.token);if ctx.failed{return false;}
 let function:*BootNode=boot_method_find(ctx,target,node.name,node.token);if ctx.failed{return false;}
 let parameter:*BootNode=function.params;
 if parameter==0 as *BootNode||strcmp(parameter.name,"self")!=0{boot_error(ctx,node.token,"associated function requires Type::function syntax");return false;}
 let formal:*BootType=parameter.ty;let mut receiver:*BootNode=node.left;
 if boot_reference(formal){
  if !boot_indirect(actual)&&!boot_method_place(receiver){return boot_method_temporary(ctx,node,target);}
  if actual.kind==BY_PTR{boot_error(ctx,node.token,"raw pointer cannot implicitly become a checked receiver reference");return false;}
  if boot_reference(actual){
   if formal.kind==BY_MUTREF&&actual.kind!=BY_MUTREF{boot_error(ctx,node.token,"mutable method requires a mutable reference");return false;}
   let dereference:*BootNode=boot_node(ctx,BN_UNARY,node.token);if ctx.failed{return false;}dereference.op=42;dereference.left=receiver;receiver=dereference;
  }
  let borrow:*BootNode=boot_node(ctx,BN_UNARY,node.token);if ctx.failed{return false;}borrow.op=38;borrow.left=receiver;if formal.kind==BY_MUTREF{borrow.flags=1;}receiver=borrow;
 }else if actual!=target&&formal.kind!=BY_PTR{
  boot_error(ctx,node.token,"by-value method requires a value receiver; dereference explicitly");return false;
 }
 receiver.next=node.params;node.params=receiver;node.left=0 as *BootNode;node.kind=BN_CALL;node.name=function.name;node.decl=function;node.aux=target;return true;
}
pub fn boot_method_associated(ctx:*BootContext,node:*BootNode)->bool {
 let target:*BootType=boot_normal_type(ctx,node.ty,0,node.token);if ctx.failed{return false;}
 let function:*BootNode=boot_method_find(ctx,target,node.name,node.token);if ctx.failed{return false;}
 node.kind=BN_CALL;node.name=function.name;node.decl=function;node.aux=target;node.ty=0 as *BootType;return true;
}
