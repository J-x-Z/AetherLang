}

fn boot_p_array_count(ctx:*BootContext)->u64{
 if boot_p_kind(ctx)!=BT_INT{boot_error(ctx,ctx.cursor,"Core array length requires a nonnegative integer literal");return 0;}
 let mut count:u64=0;if !boot_integer_value(ctx,ctx.cursor,9223372036854775807,&mut count as *u64){return 0;}boot_p_advance(ctx);return count;
}
fn boot_p_array_value(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let node:*BootNode=boot_node(ctx,BN_ARRAY,token);if node==(0 as *BootNode){return node;}
 let mut tail:*BootNode=0 as *BootNode;let mut count:i64=0;
 while !ctx.failed&&boot_p_kind(ctx)!=93{
  let element:*BootNode=boot_p_expression(ctx,0);if element==(0 as *BootNode){return element;}
  if tail==(0 as *BootNode){node.params=element;}else{tail.next=element;}tail=element;count=count+1;
  if boot_p_take(ctx,59){
   if count!=1{boot_error(ctx,ctx.cursor,"repeat array requires one element");return 0 as *BootNode;}
   node.kind=BN_REPEAT;node.left=element;node.params=0 as *BootNode;node.right=boot_p_expression(ctx,0);count=0;break;
  }
