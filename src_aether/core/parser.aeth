pub fn boot_parse(ctx:*BootContext)->bool {
 ctx.cursor=ctx.tokens;ctx.depth=0;
 let program:*BootNode=boot_node(ctx,BN_PROGRAM,ctx.cursor);
 if program==0 as *BootNode {return false;}
 ctx.program=program;
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=BT_EOF {
  let mut node:*BootNode=0 as *BootNode;
  let mut packed:bool=false;let mut repr:bool=false;let mut destructor:bool=false;let mut exported:bool=false;
  if boot_p_take(ctx,64){
   if boot_p_word(ctx,"no_mangle"){boot_p_advance(ctx);exported=true;}else if boot_p_word(ctx,"drop"){boot_p_advance(ctx);destructor=true;}else{
   if !boot_p_word(ctx,"repr"){boot_error(ctx,ctx.cursor,"expected @drop, @repr(C) or @repr(packed)");return false;}
   boot_p_advance(ctx);if !boot_p_expect(ctx,40,"expected '(' after repr"){return false;}
   packed=boot_p_word(ctx,"packed");if !packed && !boot_p_word(ctx,"C"){boot_error(ctx,ctx.cursor,"unknown record representation");return false;}
   boot_p_advance(ctx);if !boot_p_expect(ctx,41,"expected ')' after representation"){return false;}repr=true;
   }
  }
  if boot_p_take(ctx,35) {
   let inner:bool=boot_p_take(ctx,33);
   if !boot_p_expect(ctx,91,"expected '[' after '#'"){return false;}
   if inner {
    if exported || destructor || repr || ctx.module!=ctx.root_module || tail!=0 as *BootNode{
     boot_error(ctx,ctx.cursor,"root inner attributes must precede declarations");return false;
    }
    if boot_p_word(ctx,"no_std"){
     if ctx.no_std{boot_error(ctx,ctx.cursor,"duplicate no_std attribute");return false;}ctx.no_std=true;
    }else if boot_p_word(ctx,"no_main"){
     if ctx.no_main{boot_error(ctx,ctx.cursor,"duplicate no_main attribute");return false;}ctx.no_main=true;
    }else{boot_error(ctx,ctx.cursor,"expected no_main or no_std inner attribute");return false;}
    boot_p_advance(ctx);if !boot_p_expect(ctx,93,"expected ']' after inner attribute"){return false;}continue;
   }
   if !boot_p_word(ctx,"no_mangle"){boot_error(ctx,ctx.cursor,"unsupported declaration attribute");return false;}
   boot_p_advance(ctx);if !boot_p_expect(ctx,93,"expected ']' after no_mangle"){return false;}
   exported=true;
  }
  let mut public:bool=false;
  if boot_p_word(ctx,"pub") {public=true;boot_p_advance(ctx);}
  if repr && !boot_p_word(ctx,"struct") && !boot_p_word(ctx,"union"){boot_error(ctx,ctx.cursor,"repr requires a struct or union");return false;}
  if boot_p_word(ctx,"impl"){
   if exported||public||destructor{boot_error(ctx,ctx.cursor,"visibility belongs to each inherent method");return false;}
   node=boot_p_impl(ctx);if ctx.failed{return false;}
   if node!=0 as *BootNode{if tail==0 as *BootNode{program.body=node;}else{tail.next=node;}tail=node;while tail.next!=0 as *BootNode{tail=tail.next;}}
   continue;
  }
  if boot_p_word(ctx,"extern") {
   if public || exported || destructor {boot_error(ctx,ctx.cursor,"extern declarations are already public and cannot declare destructors");return false;}
   boot_p_advance(ctx);
   if boot_p_kind(ctx)!=BT_STRING {boot_error(ctx,ctx.cursor,"expected foreign ABI string \"C\"");return false;}
   if ctx.cursor.length!=1 || strcmp(ctx.cursor.text,"C")!=0 {boot_error(ctx,ctx.cursor,"Core supports only extern \"C\"");return false;}
   boot_p_advance(ctx);
   if !boot_p_expect(ctx,123,"expected '{' after foreign ABI") {return false;}
   while !ctx.failed && boot_p_kind(ctx)!=125 {
    let mut annotated:bool=false;let mut mask:i32=0;
    while boot_p_take(ctx,64){
     if boot_p_kind(ctx)!=BT_IDENT{boot_error(ctx,ctx.cursor,"expected a foreign effect annotation");return false;}
     let effect_bits:i32=boot_effect_name(ctx.cursor.text);
     if effect_bits<0{boot_error(ctx,ctx.cursor,"unknown foreign effect annotation");return false;}
     annotated=true;mask=mask|effect_bits;boot_p_advance(ctx);
    }
    if boot_p_word(ctx,"static"){
     if annotated{boot_error(ctx,ctx.cursor,"effect annotation requires a function");return false;}node=boot_p_static(ctx,true);
    }else{node=boot_p_function(ctx,true);if node!=0 as *BootNode && annotated{node.effect_explicit=true;node.effect_limit=node.effect_limit|mask;}}
    if node==0 as *BootNode {return false;}
    if tail==0 as *BootNode {program.body=node;} else {tail.next=node;}
    tail=node;
   }
   if !boot_p_expect(ctx,125,"expected '}' after foreign declarations") {return false;}
  } else {
   if boot_p_word(ctx,"fn") {node=boot_p_function(ctx,false);}
   else if boot_p_word(ctx,"struct") || boot_p_word(ctx,"union") {node=boot_p_struct(ctx,packed);}
   else if boot_p_word(ctx,"enum") {node=boot_p_enum(ctx);}
   else if boot_p_word(ctx,"interface")||boot_p_word(ctx,"trait"){node=boot_p_interface(ctx);}
   else if boot_p_word(ctx,"static") {node=boot_p_static(ctx,false);}
   else if boot_p_word(ctx,"const") {node=boot_p_constant(ctx);}
   else if boot_p_word(ctx,"type") {node=boot_p_alias(ctx);}
   else {boot_error(ctx,ctx.cursor,"expected fn, struct, const or extern \"C\"; construct outside Core v1");return false;}
   if node==0 as *BootNode {return false;}
   if exported {
    if node.kind!=BN_FN && node.kind!=BN_STATIC{boot_error(ctx,node.token,"no_mangle requires a function or static definition");return false;}
    node.flags=node.flags|BF_EXPORT;
   }
   if destructor{if node.kind!=BN_FN{boot_error(ctx,node.token,"@drop requires a function");return false;}node.flags=node.flags|BF_DROP;}
   if public {node.flags=node.flags|8;}
   if tail==0 as *BootNode {program.body=node;} else {tail.next=node;}
   tail=node;
  }
 }
 return !ctx.failed;
}

fn boot_p_struct_value(ctx:*BootContext,node:*BootNode)->*BootNode{
 node.kind=BN_STRUCT_VALUE;node.ty=boot_resolve_type(ctx,node.name,node.lookup,node.token);
 if node.ty==(0 as *BootType){return 0 as *BootNode;}boot_p_advance(ctx);
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed&&boot_p_kind(ctx)!=125{
  let field:*BootToken=boot_p_name(ctx);if field==(0 as *BootToken){return 0 as *BootNode;}
  let member:*BootNode=boot_node(ctx,BN_FIELD,field);if member==(0 as *BootNode){return member;}member.name=field.text;
  if boot_p_take(ctx,58){member.left=boot_p_expression(ctx,0);}else{member.left=boot_node(ctx,BN_IDENT,field);if member.left!=(0 as *BootNode){member.left.name=field.text;}}
  if member.left==(0 as *BootNode){return 0 as *BootNode;}member.tree_depth=member.left.tree_depth+1;
  if tail==(0 as *BootNode){node.params=member;}else{tail.next=member;}tail=member;
  if !boot_p_take(ctx,44){break;}
 }
 if !boot_p_expect(ctx,125,"expected '}' after struct initializer"){return 0 as *BootNode;}
 return node;
}

fn boot_p_alias(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let name:*BootToken=boot_p_name(ctx);if name==(0 as *BootToken){return 0 as *BootNode;}
 let ty:*BootType=boot_named_type(ctx,name.text);if ty==(0 as *BootType){return 0 as *BootNode;}
 if ty.complete{boot_error(ctx,name,"duplicate type definition");return 0 as *BootNode;}
 let saved:*BootNode=ctx.type_parameters;let parameters:*BootNode=boot_p_type_parameters(ctx);ctx.type_parameters=parameters;let mut formal:*BootNode=parameters;while formal!=0 as *BootNode{if formal.ty.kind==BY_CONST_PARAMETER{boot_error(ctx,formal.token,"generic aliases currently accept type parameters only");return 0 as *BootNode;}formal=formal.next;}
 if !boot_p_expect(ctx,61,"expected '=' in type alias"){return 0 as *BootNode;}
 let target:*BootType=boot_p_type(ctx);if target==(0 as *BootType){return 0 as *BootNode;}boot_p_take(ctx,59);
 ty.kind=BY_ALIAS;ty.inner=target;ty.complete=true;if parameters!=0 as *BootNode{ty.kind=BY_TEMPLATE;ty.is_alias=true;ty.parameters=parameters;}ctx.type_parameters=saved;
