use model::*;
use effects::boot_effect_name;
use runtime::*;
use type_model::*;
use const_eval::ce_expression;
use tuple_model::*;
use dynamic::*;
use pattern_model::*;
use methods::{boot_method_generics,boot_method_register,boot_method_empty};
// Recursive-descent declarations/statements and a Pratt expression parser.
// Every accepted construct produces a real AST node; unsupported syntax fails.
fn boot_p_kind(ctx:*BootContext)->i32 {
 if ctx.cursor==0 as *BootToken {return BT_EOF;}
 return ctx.cursor.kind;
}
fn boot_p_word(ctx:*BootContext,text:*u8)->bool {
 if boot_p_kind(ctx)!=BT_IDENT {return false;}
 return strcmp(ctx.cursor.text,text)==0;
}
fn boot_p_advance(ctx:*BootContext) {
 if ctx.cursor!=0 as *BootToken && ctx.cursor.kind!=BT_EOF {ctx.cursor=ctx.cursor.next;}
 return;
}
fn boot_p_take(ctx:*BootContext,kind:i32)->bool {
 if ctx.failed || boot_p_kind(ctx)!=kind {return false;}
 boot_p_advance(ctx);return true;
}
fn boot_p_expect(ctx:*BootContext,kind:i32,message:*u8)->bool {
 if boot_p_take(ctx,kind) {return true;}
 boot_error(ctx,ctx.cursor,message);return false;
}
pub fn boot_p_reserved(text:*u8)->bool {
 if strcmp(text,"fn")==0 || strcmp(text,"let")==0 || strcmp(text,"mut")==0 || strcmp(text,"if")==0 || strcmp(text,"else")==0 {return true;}
 if strcmp(text,"while")==0 || strcmp(text,"return")==0 || strcmp(text,"break")==0 || strcmp(text,"continue")==0 {return true;}
 if strcmp(text,"struct")==0 || strcmp(text,"extern")==0 || strcmp(text,"const")==0 || strcmp(text,"unsafe")==0 {return true;}
 if strcmp(text,"as")==0 || strcmp(text,"true")==0 || strcmp(text,"false")==0 || strcmp(text,"size_of")==0 || strcmp(text,"align_of")==0 {return true;}
 if strcmp(text,"mod")==0 || strcmp(text,"offset_of")==0 || strcmp(text,"union")==0 || strcmp(text,"static")==0 || strcmp(text,"__errno_get")==0 {return true;}
 if strcmp(text,"pub")==0 || strcmp(text,"use")==0 || strcmp(text,"enum")==0 || strcmp(text,"impl")==0 {return true;}
 if strcmp(text,"for")==0 || strcmp(text,"loop")==0 || strcmp(text,"match")==0 || strcmp(text,"type")==0 {return true;}
 return false;
}
fn boot_p_name(ctx:*BootContext)->*BootToken {
 let token:*BootToken=ctx.cursor;
 if boot_p_kind(ctx)!=BT_IDENT {boot_error(ctx,token,"expected identifier");return 0 as *BootToken;}
 if boot_p_reserved(token.text) {boot_error(ctx,token,"keyword cannot be used as an identifier");return 0 as *BootToken;}
 boot_p_advance(ctx);return token;
}
fn boot_p_type(ctx:*BootContext)->*BootType {
 if ctx.failed {return 0 as *BootType;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,ctx.cursor,"type nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootType;}
 let ty:*BootType=boot_p_type_inner(ctx);
 ctx.depth=ctx.depth-1;return ty;
}
fn boot_p_type_inner(ctx:*BootContext)->*BootType {
 if boot_p_word(ctx,"dyn"){boot_p_advance(ctx);return boot_dynamic_marker(ctx,boot_p_type(ctx));}
 if boot_p_word(ctx,"_"){boot_p_advance(ctx);return boot_type(ctx,BY_INFER);}
 if boot_p_word(ctx,"own"){boot_p_advance(ctx);let inner:*BootType=boot_p_type(ctx);if inner==0 as *BootType{return inner;}return boot_owned_type(ctx,inner);}
 if boot_p_take(ctx,91){
  let inner:*BootType=boot_p_type(ctx);if inner==(0 as *BootType){return inner;}
  if !boot_p_expect(ctx,59,"expected ';' in array type"){return 0 as *BootType;}
  let length:*BootNode=boot_p_expression(ctx,0);if ctx.failed{return 0 as *BootType;}
  if !boot_p_expect(ctx,93,"expected ']' after array type"){return 0 as *BootType;}
  return boot_array_expression(ctx,inner,length);
 }
 if boot_p_take(ctx,38) {
  let mutable:bool=boot_p_word(ctx,"mut");if mutable{boot_p_advance(ctx);}
  let inner:*BootType=boot_p_type(ctx);if inner==0 as *BootType{return inner;}
  return boot_ref_type(ctx,inner,mutable);
 }
 if boot_p_take(ctx,42) {
  let inner:*BootType=boot_p_type(ctx);
  if inner==0 as *BootType {return inner;}
  return boot_ptr_type(ctx,inner);
 }
 if boot_p_take(ctx,40) {
  if boot_p_take(ctx,41){return boot_type(ctx,BY_VOID);}
  let first:*BootType=boot_p_type(ctx);if ctx.failed{return first;}
  if !boot_p_take(ctx,44){boot_p_expect(ctx,41,"expected ')' after parenthesized type");return first;}
  let fields:*BootNode=tp_field(ctx,first,0,ctx.cursor);let mut tail:*BootNode=fields;let mut index:u64=1;
  while !ctx.failed&&boot_p_kind(ctx)!=41{
   let token:*BootToken=ctx.cursor;let ty:*BootType=boot_p_type(ctx);if ctx.failed{return 0 as *BootType;}
   let field:*BootNode=tp_field(ctx,ty,index,token);if ctx.failed{return 0 as *BootType;}tail.next=field;tail=field;index=index+1;
   if !boot_p_take(ctx,44){break;}
  }
  if !boot_p_expect(ctx,41,"expected ')' after tuple type"){return 0 as *BootType;}return tp_type(ctx,fields);
 }
 let token:*BootToken=boot_p_name(ctx);
 if token==0 as *BootToken {return 0 as *BootType;}
 let mut name:*u8=token.text;
 let mut lookup:*BootModule=0 as *BootModule;
 if boot_p_take(ctx,58) {
  if !boot_p_expect(ctx,58,"expected :: in imported type") {return 0 as *BootType;}
  lookup=boot_import_module(ctx,name,token); if lookup==(0 as *BootModule) {return 0 as *BootType;}
  let mut member:*BootToken=boot_p_name(ctx);if member==(0 as *BootToken) {return 0 as *BootType;}name=member.text;
  while boot_p_take(ctx,58){
   if !boot_p_expect(ctx,58,"expected :: in nested type"){return 0 as *BootType;}
   lookup=boot_child_module(lookup,name,true);if lookup==0 as *BootModule{boot_error(ctx,member,"unknown or private nested module");return 0 as *BootType;}
   member=boot_p_name(ctx);if ctx.failed{return 0 as *BootType;}name=member.text;
  }
  return boot_p_type_apply(ctx,boot_resolve_type(ctx,name,lookup,token));
 }
 if strcmp(name,"void")==0 {return boot_type(ctx,BY_VOID);}
 if strcmp(name,"bool")==0 {return boot_type(ctx,BY_BOOL);}
 if strcmp(name,"i8")==0 {return boot_type(ctx,BY_I8);}
 if strcmp(name,"u8")==0 {return boot_type(ctx,BY_U8);}
 if strcmp(name,"i16")==0 {return boot_type(ctx,BY_I16);}
 if strcmp(name,"u16")==0 {return boot_type(ctx,BY_U16);}
 if strcmp(name,"i32")==0 {return boot_type(ctx,BY_I32);}
 if strcmp(name,"u32")==0 {return boot_type(ctx,BY_U32);}
 if strcmp(name,"i64")==0 || strcmp(name,"isize")==0 {return boot_type(ctx,BY_I64);}
 if strcmp(name,"u64")==0 || strcmp(name,"usize")==0 {return boot_type(ctx,BY_U64);}
 if strcmp(name,"f32")==0 {return boot_type(ctx,BY_F32);}
 if strcmp(name,"f64")==0 {return boot_type(ctx,BY_F64);}
 return boot_p_type_apply(ctx,boot_resolve_type(ctx,name,0 as *BootModule,token));
}
fn boot_p_bp(kind:i32)->i32 {
 if kind==BT_OR {return 1;}
 if kind==BT_AND {return 2;}
 if kind==124 {return 3;}
 if kind==94 {return 4;}
 if kind==38 {return 5;}
 if kind==BT_EQ || kind==BT_NE {return 6;}
 if kind==60 || kind==62 || kind==BT_LE || kind==BT_GE {return 7;}
 if kind==BT_SHL || kind==BT_SHR {return 8;}
 if kind==43 || kind==45 {return 9;}
 if kind==42 || kind==47 || kind==37 {return 10;}
 return 0;
}
// Pratt parsing uses a loop for left-associative and postfix operations, but
// the resulting AST still nests. Bound the actual tree consumed recursively
// by checking/emission, not only the parser's own call stack.
fn boot_p_tree_depth(ctx:*BootContext,node:*BootNode)->bool {
 if node==0 as *BootNode {return false;}
 let mut depth:i32=0;
 if node.left!=0 as *BootNode {depth=node.left.tree_depth;}
 if node.right!=0 as *BootNode && node.right.tree_depth>depth {depth=node.right.tree_depth;}
 let mut argument:*BootNode=node.params;
 while argument!=0 as *BootNode {
  if argument.tree_depth>depth {depth=argument.tree_depth;}
  argument=argument.next;
 }
 node.tree_depth=depth+1;
 if node.tree_depth>256 {
  boot_error(ctx,node.token,"expression tree depth exceeds 256");return false;
 }
 return true;
}
fn boot_p_expression(ctx:*BootContext,minimum:i32)->*BootNode {
 if ctx.failed {return 0 as *BootNode;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,ctx.cursor,"expression nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootNode;}
 let expression:*BootNode=boot_p_expression_inner(ctx,minimum);
 ctx.depth=ctx.depth-1;return expression;
}
fn boot_p_primary(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;
 let kind:i32=boot_p_kind(ctx);
 if kind==124||kind==BT_OR{return boot_p_closure(ctx);}
 if boot_p_word(ctx,"match"){return boot_p_match(ctx);}
 if kind==91{return boot_p_array_value(ctx);}
 if boot_p_word(ctx,"if")||kind==123{
  let node:*BootNode=boot_node(ctx,BN_VALUE,token);if node==(0 as *BootNode){return node;}
  let saved:bool=ctx.parse_condition;ctx.parse_condition=false;
  if kind==123{node.body=boot_p_block(ctx);}else{node.body=boot_p_if(ctx);}ctx.parse_condition=saved;
  if node.body==(0 as *BootNode){return 0 as *BootNode;}boot_value_tail(node.body,BN_YIELD);return node;
 }
 if kind==BT_INT || kind==BT_FLOAT || kind==BT_STRING {
  let mut node_kind:i32=BN_INT;
  if kind==BT_FLOAT {node_kind=BN_FLOAT;} else if kind==BT_STRING {node_kind=BN_STRING;}
  let node:*BootNode=boot_node(ctx,node_kind,token);
  if node==0 as *BootNode {return node;}
  node.name=token.text;boot_p_advance(ctx);return node;
 }
 if boot_p_word(ctx,"true") || boot_p_word(ctx,"false") {
  let node:*BootNode=boot_node(ctx,BN_BOOL,token);
  if node==0 as *BootNode {return node;}
  if boot_p_word(ctx,"true") {node.value=1;}
  boot_p_advance(ctx);return node;
 }
 if boot_p_word(ctx,"__errno_get") {
  boot_p_advance(ctx);
  if !boot_p_expect(ctx,40,"__errno_get requires ()") || !boot_p_expect(ctx,41,"__errno_get takes no arguments") {return 0 as *BootNode;}
  return boot_node(ctx,BN_ERRNO,token);
 }
 if boot_p_word(ctx,"offset_of"){
  boot_p_advance(ctx);let node:*BootNode=boot_node(ctx,BN_OFFSET,token);
  if ctx.failed || !boot_p_expect(ctx,40,"offset_of requires a type and field"){return 0 as *BootNode;}
  node.aux=boot_p_type(ctx);if ctx.failed || !boot_p_expect(ctx,44,"expected field after layout type"){return 0 as *BootNode;}
  let field:*BootToken=boot_p_name(ctx);if ctx.failed || !boot_p_expect(ctx,41,"expected ')' after layout field"){return 0 as *BootNode;}
  node.name=field.text;return node;
 }
 if boot_p_word(ctx,"size_of")||boot_p_word(ctx,"align_of") {
  let alignment:bool=boot_p_word(ctx,"align_of");boot_p_advance(ctx);
  if !boot_p_expect(ctx,40,"expected '(' after size_of") {return 0 as *BootNode;}
  let ty:*BootType=boot_p_type(ctx);
  if ty==0 as *BootType {return 0 as *BootNode;}
  if !boot_p_expect(ctx,41,"expected ')' after size_of type") {return 0 as *BootNode;}
  let node:*BootNode=boot_node(ctx,BN_SIZEOF,token);
  if node!=0 as *BootNode {node.aux=ty;if alignment{node.kind=BN_ALIGNOF;}}
  return node;
 }
 if kind==45 || kind==33 || kind==126 || kind==42 || kind==38 {
  boot_p_advance(ctx);
  let mut flags:i32=0;
  if kind==38 && boot_p_word(ctx,"mut") {flags=1;boot_p_advance(ctx);}
  let operand:*BootNode=boot_p_expression(ctx,13);
  if operand==0 as *BootNode {return operand;}
  let node:*BootNode=boot_node(ctx,BN_UNARY,token);
  if node!=0 as *BootNode {node.op=kind;node.flags=flags;node.left=operand;}
  return node;
 }
 if boot_p_take(ctx,40) {
  if boot_p_take(ctx,41){return boot_node(ctx,BN_UNIT,token);}
  let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=false;
  let expression:*BootNode=boot_p_expression(ctx,0);
  if expression==0 as *BootNode {ctx.parse_condition=saved_condition;return expression;}
  if !boot_p_take(ctx,44){ctx.parse_condition=saved_condition;if !boot_p_expect(ctx,41,"expected ')' after expression"){return 0 as *BootNode;}return expression;}
  let tuple:*BootNode=boot_node(ctx,BN_TUPLE,token);if ctx.failed{return tuple;}tuple.params=expression;let mut tail:*BootNode=expression;
  while !ctx.failed&&boot_p_kind(ctx)!=41{
   let value:*BootNode=boot_p_expression(ctx,0);if ctx.failed{return 0 as *BootNode;}tail.next=value;tail=value;
   if !boot_p_take(ctx,44){break;}
  }
  ctx.parse_condition=saved_condition;if !boot_p_expect(ctx,41,"expected ')' after tuple value"){return 0 as *BootNode;}return tuple;
 }
 if kind==BT_IDENT {
  let name:*BootToken=boot_p_name(ctx);
  if name==0 as *BootToken {return 0 as *BootNode;}
  let node:*BootNode=boot_node(ctx,BN_IDENT,token);
  if node!=0 as *BootNode {
   node.name=name.text;
   let mut formal:*BootNode=ctx.type_parameters;while formal!=0 as *BootNode{if strcmp(formal.name,node.name)==0&&formal.ty.kind==BY_CONST_PARAMETER{node.aux=formal.ty;}formal=formal.next;}
   if boot_p_take(ctx,58) {
    if !boot_p_expect(ctx,58,"expected :: in imported name") {return 0 as *BootNode;}
    node.lookup=boot_child_module(ctx.module,node.name,false);
    let member:*BootToken=boot_p_name(ctx);if ctx.failed{return 0 as *BootNode;}
    if node.lookup==0 as *BootModule{
     node.ty=boot_resolve_type(ctx,node.name,0 as *BootModule,token);node.kind=BN_ENUM_VALUE;node.name=member.text;
    }else{
     node.name=member.text;
     while boot_p_take(ctx,58){
      if !boot_p_expect(ctx,58,"expected :: in qualified name"){return 0 as *BootNode;}
      let child:*BootModule=boot_child_module(node.lookup,node.name,true);
      let part:*BootToken=boot_p_name(ctx);if ctx.failed{return 0 as *BootNode;}
      if child==0 as *BootModule{
       node.ty=boot_resolve_type(ctx,node.name,node.lookup,token);node.kind=BN_ENUM_VALUE;node.name=part.text;break;
      }
      node.lookup=child;node.name=part.text;
     }
    }
   }
   if node.kind==BN_IDENT&&boot_p_kind(ctx)==123 && !ctx.parse_condition {return boot_p_struct_value(ctx,node);}
  }
  return node;
 }
 boot_error(ctx,token,"expected expression (literal, name, unary operator or parentheses)");
 return 0 as *BootNode;
}
fn boot_p_call(ctx:*BootContext,callee:*BootNode)->*BootNode {

 let node:*BootNode=boot_node(ctx,BN_CALL,callee.token);
 if node==0 as *BootNode {return node;}
 node.name=callee.name;node.lookup=callee.lookup;node.left=callee;if callee.kind==BN_ENUM_VALUE{node.kind=BN_ENUM_VALUE;node.left=0 as *BootNode;node.ty=callee.ty;node.flags=node.flags|8192;}if callee.kind==BN_MEMBER{node.kind=BN_METHOD_CALL;node.left=callee.left;}boot_p_advance(ctx);
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=41 {
  let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=false;
  let argument:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
  if argument==0 as *BootNode {return argument;}
  if tail==0 as *BootNode {node.params=argument;} else {tail.next=argument;}
  tail=argument;
  if !boot_p_take(ctx,44) {break;}
 }
 if !boot_p_expect(ctx,41,"expected ')' after call arguments") {return 0 as *BootNode;}
 return node;
}
fn boot_p_expression_inner(ctx:*BootContext,minimum:i32)->*BootNode {
 let mut left:*BootNode=boot_p_primary(ctx);
 if left==0 as *BootNode {return left;}
 if !boot_p_tree_depth(ctx,left) {return 0 as *BootNode;}
 while !ctx.failed {
  let token:*BootToken=ctx.cursor;
  let kind:i32=boot_p_kind(ctx);
  if kind==63{
   boot_p_advance(ctx);let attempt:*BootNode=boot_node(ctx,BN_TRY,token);if attempt==0 as *BootNode{return attempt;}attempt.left=left;left=attempt;
  } else if kind==40 {
   left=boot_p_call(ctx,left);
   if left==0 as *BootNode {return left;}
  } else if kind==46 {
   boot_p_advance(ctx);
   if boot_p_word(ctx,"pub"){boot_p_advance(ctx);}
   let mut field:*BootToken=ctx.cursor;let mut name:*u8=0 as *u8;
   if field.kind==BT_INT{
    let mut index:u64=0;if !boot_integer_value(ctx,field,9223372036854775807,&mut index as *u64){return 0 as *BootNode;}
    name=boot_alloc(ctx,32) as *u8;if ctx.failed{return 0 as *BootNode;}snprintf(name,32,"%llu",index);boot_p_advance(ctx);
   }else{field=boot_p_name(ctx);if ctx.failed{return 0 as *BootNode;}name=field.text;}
   let node:*BootNode=boot_node(ctx,BN_MEMBER,token);if node==0 as *BootNode{return node;}
   node.left=left;node.name=name;left=node;
  } else if kind==91 {
   boot_p_advance(ctx);
   let index:*BootNode=boot_p_expression(ctx,0);
   if index==0 as *BootNode {return index;}
   if !boot_p_expect(ctx,93,"expected ']' after index") {return 0 as *BootNode;}
   let node:*BootNode=boot_node(ctx,BN_INDEX,token);
   if node==0 as *BootNode {return node;}
   node.left=left;node.right=index;left=node;
  } else if boot_p_word(ctx,"as") {
   if minimum>12 {break;}
   boot_p_advance(ctx);
   let ty:*BootType=boot_p_type(ctx);
   if ty==0 as *BootType {return 0 as *BootNode;}
   let node:*BootNode=boot_node(ctx,BN_CAST,token);
   if node==0 as *BootNode {return node;}
   node.left=left;node.ty=ty;left=node;
  } else {
   let power:i32=boot_p_bp(kind);
   if power==0 || power<minimum {break;}
   boot_p_advance(ctx);
   let right:*BootNode=boot_p_expression(ctx,power+1);
   if right==0 as *BootNode {return right;}
   let node:*BootNode=boot_node(ctx,BN_BINARY,token);
   if node==0 as *BootNode {return node;}
   node.op=kind;node.left=left;node.right=right;left=node;
  }
  if !boot_p_tree_depth(ctx,left) {return 0 as *BootNode;}
 }
 return left;
}
fn boot_p_if(ctx:*BootContext)->*BootNode {
 if ctx.failed {return 0 as *BootNode;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,ctx.cursor,"conditional nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootNode;}
 let node:*BootNode=boot_p_if_inner(ctx);
 ctx.depth=ctx.depth-1;return node;
}
fn boot_p_if_inner(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);
 let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=true;
 let condition:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
 if condition==0 as *BootNode {return condition;}
 let body:*BootNode=boot_p_block(ctx);
 if body==0 as *BootNode {return body;}
 let node:*BootNode=boot_node(ctx,BN_IF,token);
 if node==0 as *BootNode {return node;}
 node.left=condition;node.body=body;
 if boot_p_word(ctx,"else") {
  boot_p_advance(ctx);
  if boot_p_word(ctx,"if") {node.third=boot_p_if(ctx);} else {node.third=boot_p_block(ctx);}
 }
 return node;
}
fn boot_p_statement(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;
 if boot_p_word(ctx,"for"){return boot_p_range_for(ctx);}
 if boot_p_word(ctx,"let") {
  boot_p_advance(ctx);let mut flags:i32=0;
  if boot_p_word(ctx,"mut") {flags=1;boot_p_advance(ctx);}
  let name:*BootToken=boot_p_name(ctx);
  if name==0 as *BootToken {return 0 as *BootNode;}
  if !boot_p_expect(ctx,58,"let requires an explicit ': Type'") {return 0 as *BootNode;}
  let ty:*BootType=boot_p_type(ctx);
  if ty==0 as *BootType {return 0 as *BootNode;}
  if !boot_p_expect(ctx,61,"Core let requires an initializer") {return 0 as *BootNode;}
  let value:*BootNode=boot_p_expression(ctx,0);
  if value==0 as *BootNode {return value;}
  boot_p_take(ctx,59);
  let node:*BootNode=boot_node(ctx,BN_LET,token);
  if node!=0 as *BootNode {node.name=name.text;node.ty=ty;node.left=value;node.flags=flags;}
  return node;
 }
 if boot_p_word(ctx,"if") {let branch:*BootNode=boot_p_if(ctx);if branch!=(0 as *BootNode)&&!boot_p_take(ctx,59){branch.flags=branch.flags|16;}return branch;}
 if boot_p_word(ctx,"loop") {
  boot_p_advance(ctx);let condition:*BootNode=boot_node(ctx,BN_BOOL,token);if condition==(0 as *BootNode){return condition;}condition.value=1;
  let body:*BootNode=boot_p_block(ctx);if body==(0 as *BootNode){return body;}
  let node:*BootNode=boot_node(ctx,BN_WHILE,token);if node!=(0 as *BootNode){node.left=condition;node.body=body;}return node;
 }
 if boot_p_word(ctx,"while") {
  boot_p_advance(ctx);
  let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=true;
 let condition:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
  if condition==0 as *BootNode {return condition;}
  let body:*BootNode=boot_p_block(ctx);
  if body==0 as *BootNode {return body;}
  let node:*BootNode=boot_node(ctx,BN_WHILE,token);
  if node!=0 as *BootNode {node.left=condition;node.body=body;}
  return node;
 }
 if boot_p_word(ctx,"return") {
  boot_p_advance(ctx);let mut value:*BootNode=0 as *BootNode;
  if boot_p_kind(ctx)!=59 && boot_p_kind(ctx)!=125 && boot_p_kind(ctx)!=BT_EOF {value=boot_p_expression(ctx,0);}
  boot_p_take(ctx,59);
  let node:*BootNode=boot_node(ctx,BN_RETURN,token);
  if node!=0 as *BootNode {node.left=value;}
  return node;
 }
 if boot_p_word(ctx,"break") || boot_p_word(ctx,"continue") {
  let mut kind:i32=BN_BREAK;
  if boot_p_word(ctx,"continue") {kind=BN_CONTINUE;}
  boot_p_advance(ctx);
  boot_p_take(ctx,59);
  return boot_node(ctx,kind,token);
 }
 if boot_p_word(ctx,"unsafe") {boot_p_advance(ctx);let block:*BootNode=boot_p_block(ctx);if !ctx.failed{block.flags=block.flags|BF_UNSAFE;}return block;}
 if boot_p_kind(ctx)==123 {let block:*BootNode=boot_p_block(ctx);if block!=(0 as *BootNode)&&!boot_p_take(ctx,59){block.flags=block.flags|16;}return block;}
 let left:*BootNode=boot_p_expression(ctx,0);
 if left==0 as *BootNode {return left;}
 let assignment:i32=boot_p_kind(ctx);
 if assignment==61||assignment>BT_ASSIGN_BASE {
  boot_p_advance(ctx);
  let right:*BootNode=boot_p_expression(ctx,0);
  if right==0 as *BootNode {return right;}
