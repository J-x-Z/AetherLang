 if node==0 as *BootNode {return node;}
 node.name=name.text;
 let saved_parameters:*BootNode=ctx.type_parameters;node.generics=boot_p_type_parameters(ctx);
 if ctx.impl_target!=0 as *BootType{node.generics=boot_method_generics(ctx,saved_parameters,node.generics,node.token);}
