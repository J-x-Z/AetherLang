use model::*;
use runtime::*;
use type_model::*;
// Recursive-descent declarations/statements and a Pratt expression parser.
// Every accepted construct produces a real AST node; unsupported syntax fails.
fn boot_p_kind(ctx:*BootContext)->i32 {
 if ctx.cursor==0 as *BootToken {return BT_EOF;}
 return ctx.cursor.kind;
}
fn boot_p_word(ctx:*BootContext,text:*u8)->bool {
 if boot_p_kind(ctx)!=BT_IDENT {return false;}
 return strcmp(ctx.cursor.text,text)==0;
}
fn boot_p_advance(ctx:*BootContext) {
 if ctx.cursor!=0 as *BootToken && ctx.cursor.kind!=BT_EOF {ctx.cursor=ctx.cursor.next;}
 return;
}
fn boot_p_take(ctx:*BootContext,kind:i32)->bool {
 if ctx.failed || boot_p_kind(ctx)!=kind {return false;}
 boot_p_advance(ctx);return true;
}
fn boot_p_expect(ctx:*BootContext,kind:i32,message:*u8)->bool {
 if boot_p_take(ctx,kind) {return true;}
 boot_error(ctx,ctx.cursor,message);return false;
}
pub fn boot_p_reserved(text:*u8)->bool {
 if strcmp(text,"fn")==0 || strcmp(text,"let")==0 || strcmp(text,"mut")==0 || strcmp(text,"if")==0 || strcmp(text,"else")==0 {return true;}
 if strcmp(text,"while")==0 || strcmp(text,"return")==0 || strcmp(text,"break")==0 || strcmp(text,"continue")==0 {return true;}
 if strcmp(text,"struct")==0 || strcmp(text,"extern")==0 || strcmp(text,"const")==0 || strcmp(text,"unsafe")==0 {return true;}
 if strcmp(text,"as")==0 || strcmp(text,"true")==0 || strcmp(text,"false")==0 || strcmp(text,"size_of")==0 || strcmp(text,"align_of")==0 {return true;}
 if strcmp(text,"static")==0 || strcmp(text,"__errno_get")==0 {return true;}
 if strcmp(text,"pub")==0 || strcmp(text,"use")==0 || strcmp(text,"enum")==0 || strcmp(text,"impl")==0 {return true;}
 if strcmp(text,"for")==0 || strcmp(text,"loop")==0 || strcmp(text,"match")==0 || strcmp(text,"type")==0 {return true;}
 return false;
}
fn boot_p_name(ctx:*BootContext)->*BootToken {
 let token:*BootToken=ctx.cursor;
 if boot_p_kind(ctx)!=BT_IDENT {boot_error(ctx,token,"expected identifier");return 0 as *BootToken;}
 if boot_p_reserved(token.text) {boot_error(ctx,token,"keyword cannot be used as an identifier");return 0 as *BootToken;}
 boot_p_advance(ctx);return token;
}
fn boot_p_type(ctx:*BootContext)->*BootType {
 if ctx.failed {return 0 as *BootType;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,ctx.cursor,"type nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootType;}
 let ty:*BootType=boot_p_type_inner(ctx);
 ctx.depth=ctx.depth-1;return ty;
}
fn boot_p_type_inner(ctx:*BootContext)->*BootType {
 if boot_p_take(ctx,91){
  let inner:*BootType=boot_p_type(ctx);if inner==(0 as *BootType){return inner;}
  if !boot_p_expect(ctx,59,"expected ';' in array type"){return 0 as *BootType;}
  let count:u64=boot_p_array_count(ctx);if ctx.failed{return 0 as *BootType;}
  if !boot_p_expect(ctx,93,"expected ']' after array type"){return 0 as *BootType;}
  return boot_array_type(ctx,inner,count);
 }
 if boot_p_take(ctx,42) {
  let inner:*BootType=boot_p_type(ctx);
  if inner==0 as *BootType {return inner;}
  return boot_ptr_type(ctx,inner);
 }
 if boot_p_take(ctx,40) {
  if !boot_p_expect(ctx,41,"only unit () is supported in a parenthesized type") {return 0 as *BootType;}
  return boot_type(ctx,BY_VOID);
 }
 let token:*BootToken=boot_p_name(ctx);
 if token==0 as *BootToken {return 0 as *BootType;}
 let mut name:*u8=token.text;
 let mut lookup:*BootModule=0 as *BootModule;
 if boot_p_take(ctx,58) {
  if !boot_p_expect(ctx,58,"expected :: in imported type") {return 0 as *BootType;}
  lookup=boot_import_module(ctx,name,token); if lookup==(0 as *BootModule) {return 0 as *BootType;}
  let member:*BootToken=boot_p_name(ctx);if member==(0 as *BootToken) {return 0 as *BootType;}name=member.text;
  return boot_p_type_apply(ctx,boot_resolve_type(ctx,name,lookup,token));
 }
 if strcmp(name,"void")==0 {return boot_type(ctx,BY_VOID);}
 if strcmp(name,"bool")==0 {return boot_type(ctx,BY_BOOL);}
 if strcmp(name,"i8")==0 {return boot_type(ctx,BY_I8);}
 if strcmp(name,"u8")==0 {return boot_type(ctx,BY_U8);}
 if strcmp(name,"i16")==0 {return boot_type(ctx,BY_I16);}
 if strcmp(name,"u16")==0 {return boot_type(ctx,BY_U16);}
 if strcmp(name,"i32")==0 {return boot_type(ctx,BY_I32);}
 if strcmp(name,"u32")==0 {return boot_type(ctx,BY_U32);}
 if strcmp(name,"i64")==0 || strcmp(name,"isize")==0 {return boot_type(ctx,BY_I64);}
 if strcmp(name,"u64")==0 || strcmp(name,"usize")==0 {return boot_type(ctx,BY_U64);}
 if strcmp(name,"f32")==0 {return boot_type(ctx,BY_F32);}
 if strcmp(name,"f64")==0 {return boot_type(ctx,BY_F64);}
 return boot_p_type_apply(ctx,boot_resolve_type(ctx,name,0 as *BootModule,token));
}
fn boot_p_bp(kind:i32)->i32 {
 if kind==BT_OR {return 1;}
 if kind==BT_AND {return 2;}
 if kind==124 {return 3;}
 if kind==94 {return 4;}
 if kind==38 {return 5;}
 if kind==BT_EQ || kind==BT_NE {return 6;}
 if kind==60 || kind==62 || kind==BT_LE || kind==BT_GE {return 7;}
 if kind==BT_SHL || kind==BT_SHR {return 8;}
 if kind==43 || kind==45 {return 9;}
 if kind==42 || kind==47 || kind==37 {return 10;}
 return 0;
}
// Pratt parsing uses a loop for left-associative and postfix operations, but
// the resulting AST still nests. Bound the actual tree consumed recursively
// by checking/emission, not only the parser's own call stack.
fn boot_p_tree_depth(ctx:*BootContext,node:*BootNode)->bool {
 if node==0 as *BootNode {return false;}
 let mut depth:i32=0;
 if node.left!=0 as *BootNode {depth=node.left.tree_depth;}
 if node.right!=0 as *BootNode && node.right.tree_depth>depth {depth=node.right.tree_depth;}
 let mut argument:*BootNode=node.params;
 while argument!=0 as *BootNode {
  if argument.tree_depth>depth {depth=argument.tree_depth;}
  argument=argument.next;
 }
 node.tree_depth=depth+1;
 if node.tree_depth>256 {
  boot_error(ctx,node.token,"expression tree depth exceeds 256");return false;
 }
 return true;
}
fn boot_p_expression(ctx:*BootContext,minimum:i32)->*BootNode {
 if ctx.failed {return 0 as *BootNode;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,ctx.cursor,"expression nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootNode;}
 let expression:*BootNode=boot_p_expression_inner(ctx,minimum);
 ctx.depth=ctx.depth-1;return expression;
}
fn boot_p_primary(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;
 let kind:i32=boot_p_kind(ctx);
 if kind==91{return boot_p_array_value(ctx);}
 if boot_p_word(ctx,"if")||kind==123{
  let node:*BootNode=boot_node(ctx,BN_VALUE,token);if node==(0 as *BootNode){return node;}
  let saved:bool=ctx.parse_condition;ctx.parse_condition=false;
  if kind==123{node.body=boot_p_block(ctx);}else{node.body=boot_p_if(ctx);}ctx.parse_condition=saved;
  if node.body==(0 as *BootNode){return 0 as *BootNode;}boot_value_tail(node.body,BN_YIELD);return node;
 }
 if kind==BT_INT || kind==BT_FLOAT || kind==BT_STRING {
  let mut node_kind:i32=BN_INT;
  if kind==BT_FLOAT {node_kind=BN_FLOAT;} else if kind==BT_STRING {node_kind=BN_STRING;}
  let node:*BootNode=boot_node(ctx,node_kind,token);
  if node==0 as *BootNode {return node;}
  node.name=token.text;boot_p_advance(ctx);return node;
 }
 if boot_p_word(ctx,"true") || boot_p_word(ctx,"false") {
  let node:*BootNode=boot_node(ctx,BN_BOOL,token);
  if node==0 as *BootNode {return node;}
  if boot_p_word(ctx,"true") {node.value=1;}
  boot_p_advance(ctx);return node;
 }
 if boot_p_word(ctx,"__errno_get") {
  boot_p_advance(ctx);
  if !boot_p_expect(ctx,40,"__errno_get requires ()") || !boot_p_expect(ctx,41,"__errno_get takes no arguments") {return 0 as *BootNode;}
  return boot_node(ctx,BN_ERRNO,token);
 }
 if boot_p_word(ctx,"size_of")||boot_p_word(ctx,"align_of") {
  let alignment:bool=boot_p_word(ctx,"align_of");boot_p_advance(ctx);
  if !boot_p_expect(ctx,40,"expected '(' after size_of") {return 0 as *BootNode;}
  let ty:*BootType=boot_p_type(ctx);
  if ty==0 as *BootType {return 0 as *BootNode;}
  if !boot_p_expect(ctx,41,"expected ')' after size_of type") {return 0 as *BootNode;}
  let node:*BootNode=boot_node(ctx,BN_SIZEOF,token);
  if node!=0 as *BootNode {node.aux=ty;if alignment{node.kind=BN_ALIGNOF;}}
  return node;
 }
 if kind==45 || kind==33 || kind==126 || kind==42 || kind==38 {
  boot_p_advance(ctx);
  let mut flags:i32=0;
  if kind==38 && boot_p_word(ctx,"mut") {flags=1;boot_p_advance(ctx);}
  let operand:*BootNode=boot_p_expression(ctx,13);
  if operand==0 as *BootNode {return operand;}
  let node:*BootNode=boot_node(ctx,BN_UNARY,token);
  if node!=0 as *BootNode {node.op=kind;node.flags=flags;node.left=operand;}
  return node;
 }
 if boot_p_take(ctx,40) {
  if boot_p_take(ctx,41){return boot_node(ctx,BN_UNIT,token);}
  let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=false;
  let expression:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
  if expression==0 as *BootNode {return expression;}
  if !boot_p_expect(ctx,41,"expected ')' after expression") {return 0 as *BootNode;}
  return expression;
 }
 if kind==BT_IDENT {
  let name:*BootToken=boot_p_name(ctx);
  if name==0 as *BootToken {return 0 as *BootNode;}
  let node:*BootNode=boot_node(ctx,BN_IDENT,token);
  if node!=0 as *BootNode {
   node.name=name.text;
   if boot_p_take(ctx,58) {
    if !boot_p_expect(ctx,58,"expected :: in imported name") {return 0 as *BootNode;}
    node.lookup=boot_import_module(ctx,node.name,token);if node.lookup==(0 as *BootModule) {return 0 as *BootNode;}
    let member:*BootToken=boot_p_name(ctx);if member==(0 as *BootToken) {return 0 as *BootNode;}node.name=member.text;
   }
   if boot_p_kind(ctx)==123 && !ctx.parse_condition {return boot_p_struct_value(ctx,node);}
  }
  return node;
 }
 boot_error(ctx,token,"expected expression (literal, name, unary operator or parentheses)");
 return 0 as *BootNode;
}
fn boot_p_call(ctx:*BootContext,callee:*BootNode)->*BootNode {
 if callee.kind!=BN_IDENT {boot_error(ctx,ctx.cursor,"Core calls require a function name");return 0 as *BootNode;}
 let node:*BootNode=boot_node(ctx,BN_CALL,callee.token);
 if node==0 as *BootNode {return node;}
 node.name=callee.name;node.lookup=callee.lookup;boot_p_advance(ctx);
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=41 {
  let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=false;
  let argument:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
  if argument==0 as *BootNode {return argument;}
  if tail==0 as *BootNode {node.params=argument;} else {tail.next=argument;}
  tail=argument;
  if !boot_p_take(ctx,44) {break;}
 }
 if !boot_p_expect(ctx,41,"expected ')' after call arguments") {return 0 as *BootNode;}
 return node;
}
fn boot_p_expression_inner(ctx:*BootContext,minimum:i32)->*BootNode {
 let mut left:*BootNode=boot_p_primary(ctx);
 if left==0 as *BootNode {return left;}
 if !boot_p_tree_depth(ctx,left) {return 0 as *BootNode;}
 while !ctx.failed {
  let token:*BootToken=ctx.cursor;
  let kind:i32=boot_p_kind(ctx);
  if kind==40 {
   left=boot_p_call(ctx,left);
   if left==0 as *BootNode {return left;}
  } else if kind==46 {
   boot_p_advance(ctx);
   if boot_p_word(ctx,"pub"){boot_p_advance(ctx);}
  let field:*BootToken=boot_p_name(ctx);
   if field==0 as *BootToken {return 0 as *BootNode;}
   let node:*BootNode=boot_node(ctx,BN_MEMBER,token);
   if node==0 as *BootNode {return node;}
   node.left=left;node.name=field.text;left=node;
  } else if kind==91 {
   boot_p_advance(ctx);
   let index:*BootNode=boot_p_expression(ctx,0);
   if index==0 as *BootNode {return index;}
   if !boot_p_expect(ctx,93,"expected ']' after index") {return 0 as *BootNode;}
   let node:*BootNode=boot_node(ctx,BN_INDEX,token);
   if node==0 as *BootNode {return node;}
   node.left=left;node.right=index;left=node;
  } else if boot_p_word(ctx,"as") {
   if minimum>12 {break;}
   boot_p_advance(ctx);
   let ty:*BootType=boot_p_type(ctx);
   if ty==0 as *BootType {return 0 as *BootNode;}
   let node:*BootNode=boot_node(ctx,BN_CAST,token);
   if node==0 as *BootNode {return node;}
   node.left=left;node.ty=ty;left=node;
  } else {
   let power:i32=boot_p_bp(kind);
   if power==0 || power<minimum {break;}
   boot_p_advance(ctx);
   let right:*BootNode=boot_p_expression(ctx,power+1);
   if right==0 as *BootNode {return right;}
   let node:*BootNode=boot_node(ctx,BN_BINARY,token);
   if node==0 as *BootNode {return node;}
   node.op=kind;node.left=left;node.right=right;left=node;
  }
  if !boot_p_tree_depth(ctx,left) {return 0 as *BootNode;}
 }
 return left;
}
fn boot_p_if(ctx:*BootContext)->*BootNode {
 if ctx.failed {return 0 as *BootNode;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,ctx.cursor,"conditional nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootNode;}
 let node:*BootNode=boot_p_if_inner(ctx);
 ctx.depth=ctx.depth-1;return node;
}
fn boot_p_if_inner(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);
 let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=true;
 let condition:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
 if condition==0 as *BootNode {return condition;}
 let body:*BootNode=boot_p_block(ctx);
 if body==0 as *BootNode {return body;}
 let node:*BootNode=boot_node(ctx,BN_IF,token);
 if node==0 as *BootNode {return node;}
 node.left=condition;node.body=body;
 if boot_p_word(ctx,"else") {
  boot_p_advance(ctx);
  if boot_p_word(ctx,"if") {node.third=boot_p_if(ctx);} else {node.third=boot_p_block(ctx);}
 }
 return node;
}
fn boot_p_statement(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;
 if boot_p_word(ctx,"let") {
  boot_p_advance(ctx);let mut flags:i32=0;
  if boot_p_word(ctx,"mut") {flags=1;boot_p_advance(ctx);}
  let name:*BootToken=boot_p_name(ctx);
  if name==0 as *BootToken {return 0 as *BootNode;}
  if !boot_p_expect(ctx,58,"let requires an explicit ': Type'") {return 0 as *BootNode;}
  let ty:*BootType=boot_p_type(ctx);
  if ty==0 as *BootType {return 0 as *BootNode;}
  if !boot_p_expect(ctx,61,"Core let requires an initializer") {return 0 as *BootNode;}
  let value:*BootNode=boot_p_expression(ctx,0);
  if value==0 as *BootNode {return value;}
  boot_p_take(ctx,59);
  let node:*BootNode=boot_node(ctx,BN_LET,token);
  if node!=0 as *BootNode {node.name=name.text;node.ty=ty;node.left=value;node.flags=flags;}
  return node;
 }
 if boot_p_word(ctx,"if") {let branch:*BootNode=boot_p_if(ctx);if branch!=(0 as *BootNode)&&!boot_p_take(ctx,59){branch.flags=branch.flags|16;}return branch;}
 if boot_p_word(ctx,"loop") {
  boot_p_advance(ctx);let condition:*BootNode=boot_node(ctx,BN_BOOL,token);if condition==(0 as *BootNode){return condition;}condition.value=1;
  let body:*BootNode=boot_p_block(ctx);if body==(0 as *BootNode){return body;}
  let node:*BootNode=boot_node(ctx,BN_WHILE,token);if node!=(0 as *BootNode){node.left=condition;node.body=body;}return node;
 }
 if boot_p_word(ctx,"while") {
  boot_p_advance(ctx);
  let saved_condition:bool=ctx.parse_condition;ctx.parse_condition=true;
 let condition:*BootNode=boot_p_expression(ctx,0);ctx.parse_condition=saved_condition;
  if condition==0 as *BootNode {return condition;}
  let body:*BootNode=boot_p_block(ctx);
  if body==0 as *BootNode {return body;}
  let node:*BootNode=boot_node(ctx,BN_WHILE,token);
  if node!=0 as *BootNode {node.left=condition;node.body=body;}
  return node;
 }
 if boot_p_word(ctx,"return") {
  boot_p_advance(ctx);let mut value:*BootNode=0 as *BootNode;
  if boot_p_kind(ctx)!=59 && boot_p_kind(ctx)!=125 && boot_p_kind(ctx)!=BT_EOF {value=boot_p_expression(ctx,0);}
  boot_p_take(ctx,59);
  let node:*BootNode=boot_node(ctx,BN_RETURN,token);
  if node!=0 as *BootNode {node.left=value;}
  return node;
 }
 if boot_p_word(ctx,"break") || boot_p_word(ctx,"continue") {
  let mut kind:i32=BN_BREAK;
  if boot_p_word(ctx,"continue") {kind=BN_CONTINUE;}
  boot_p_advance(ctx);
  boot_p_take(ctx,59);
  return boot_node(ctx,kind,token);
 }
 if boot_p_word(ctx,"unsafe") {boot_p_advance(ctx);return boot_p_block(ctx);}
 if boot_p_kind(ctx)==123 {let block:*BootNode=boot_p_block(ctx);if block!=(0 as *BootNode)&&!boot_p_take(ctx,59){block.flags=block.flags|16;}return block;}
 let left:*BootNode=boot_p_expression(ctx,0);
 if left==0 as *BootNode {return left;}
 let assignment:i32=boot_p_kind(ctx);
 if assignment==61||assignment>BT_ASSIGN_BASE {
  boot_p_advance(ctx);
  let right:*BootNode=boot_p_expression(ctx,0);
  if right==0 as *BootNode {return right;}
  boot_p_take(ctx,59);
  let node:*BootNode=boot_node(ctx,BN_ASSIGN,token);
  if node!=0 as *BootNode {node.left=left;node.right=right;if assignment>BT_ASSIGN_BASE{node.op=assignment-BT_ASSIGN_BASE;}}
  return node;
 }
 let semicolon:bool=boot_p_take(ctx,59);
 let node:*BootNode=boot_node(ctx,BN_EXPR,token);
 if node!=0 as *BootNode {node.left=left;if !semicolon {node.flags=node.flags|16;}}
 return node;
}
fn boot_p_block(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;
 if !boot_p_expect(ctx,123,"expected '{' to start block") {return 0 as *BootNode;}
 ctx.depth=ctx.depth+1;
 if ctx.depth>256 {boot_error(ctx,token,"block nesting exceeds 256");ctx.depth=ctx.depth-1;return 0 as *BootNode;}
 let node:*BootNode=boot_node(ctx,BN_BLOCK,token);
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=125 {
  if boot_p_kind(ctx)==BT_EOF {boot_error(ctx,ctx.cursor,"unterminated block");break;}
  if boot_p_take(ctx,59) {continue;}
  let statement:*BootNode=boot_p_statement(ctx);
  if statement==0 as *BootNode {break;}
  if tail==0 as *BootNode {node.body=statement;} else {tail.next=statement;}
  tail=statement;
 }
 let closed:bool=boot_p_expect(ctx,125,"expected '}' to end block");
 ctx.depth=ctx.depth-1;
 if !closed {return 0 as *BootNode;}
 return node;
}
fn boot_p_function(ctx:*BootContext,foreign:bool)->*BootNode {
 let token:*BootToken=ctx.cursor;
 if !boot_p_word(ctx,"fn") {boot_error(ctx,token,"expected function declaration");return 0 as *BootNode;}
 boot_p_advance(ctx);
 let name:*BootToken=boot_p_name(ctx);
 if name==0 as *BootToken {return 0 as *BootNode;}
 let node:*BootNode=boot_node(ctx,BN_FN,token);
 if node==0 as *BootNode {return node;}
 node.name=name.text;
 let saved_parameters:*BootNode=ctx.type_parameters;node.generics=boot_p_type_parameters(ctx);ctx.type_parameters=node.generics;
 if foreign&&node.generics!=(0 as *BootNode){boot_error(ctx,name,"foreign generic functions are not supported");return 0 as *BootNode;}
 if foreign {node.flags=2;}
 if !boot_p_expect(ctx,40,"expected '(' after function name") {return 0 as *BootNode;}
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=41 {
  if boot_p_take(ctx,BT_ELLIPSIS) {
   if !foreign {boot_error(ctx,ctx.cursor,"only foreign functions may be variadic");return 0 as *BootNode;}
   if tail==0 as *BootNode {boot_error(ctx,ctx.cursor,"variadic function needs a fixed parameter");return 0 as *BootNode;}
   node.flags=node.flags|4;
   if boot_p_kind(ctx)!=41 {boot_error(ctx,ctx.cursor,"variadic marker must be last");return 0 as *BootNode;}
   break;
  }
  let mut flags:i32=0;
  if boot_p_word(ctx,"mut") {flags=1;boot_p_advance(ctx);}
  let parameter:*BootToken=boot_p_name(ctx);
  if parameter==0 as *BootToken {return 0 as *BootNode;}
  if !boot_p_expect(ctx,58,"expected ':' in parameter") {return 0 as *BootNode;}
  let ty:*BootType=boot_p_type(ctx);
  if ty==0 as *BootType {return 0 as *BootNode;}
  let param:*BootNode=boot_node(ctx,BN_PARAM,parameter);
  if param==0 as *BootNode {return param;}
  param.name=parameter.text;param.ty=ty;param.flags=flags;
  if tail==0 as *BootNode {node.params=param;} else {tail.next=param;}
  tail=param;
  if !boot_p_take(ctx,44) {break;}
 }
 if !boot_p_expect(ctx,41,"expected ')' after parameters") {return 0 as *BootNode;}
 node.ty=boot_type(ctx,BY_VOID);
 if boot_p_take(ctx,BT_ARROW) {node.ty=boot_p_type(ctx);}
 if ctx.failed {return 0 as *BootNode;}
 if foreign {
  if boot_p_kind(ctx)==123 {boot_error(ctx,ctx.cursor,"foreign function requires ';', not a body");return 0 as *BootNode;}
  boot_p_take(ctx,59);
 } else {node.body=boot_p_block(ctx);}
 ctx.type_parameters=saved_parameters;return node;
}
fn boot_p_struct(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);
 let name:*BootToken=boot_p_name(ctx);
 if name==0 as *BootToken {return 0 as *BootNode;}
 let ty:*BootType=boot_named_type(ctx,name.text);
 if ty==0 as *BootType {return 0 as *BootNode;}
 if ty.complete {boot_error(ctx,name,"duplicate struct definition");return 0 as *BootNode;}
 let node:*BootNode=boot_node(ctx,BN_STRUCT,token);
 if node==0 as *BootNode {return node;}
 node.name=name.text;node.ty=ty;
 let saved_parameters:*BootNode=ctx.type_parameters;node.generics=boot_p_type_parameters(ctx);ctx.type_parameters=node.generics;
 if node.generics!=(0 as *BootNode){ty.kind=BY_TEMPLATE;ty.parameters=node.generics;}
 if !boot_p_expect(ctx,123,"expected '{' after struct name") {return 0 as *BootNode;}
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=125 {
  if boot_p_word(ctx,"pub"){boot_p_advance(ctx);}
  let field:*BootToken=boot_p_name(ctx);
  if field==0 as *BootToken {return 0 as *BootNode;}
  if !boot_p_expect(ctx,58,"expected ':' after field name") {return 0 as *BootNode;}
  let field_type:*BootType=boot_p_type(ctx);
  if field_type==0 as *BootType {return 0 as *BootNode;}
  let member:*BootNode=boot_node(ctx,BN_FIELD,field);
  if member==0 as *BootNode {return member;}
  member.name=field.text;member.ty=field_type;
  if tail==0 as *BootNode {node.body=member;} else {tail.next=member;}
  tail=member;
  if !boot_p_take(ctx,44) {break;}
 }
 if !boot_p_expect(ctx,125,"expected '}' after fields") {return 0 as *BootNode;}
 ty.fields=node.body;ty.complete=true;ctx.type_parameters=saved_parameters;return node;
}
fn boot_p_constant(ctx:*BootContext)->*BootNode {
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);
 let name:*BootToken=boot_p_name(ctx);
 if name==0 as *BootToken {return 0 as *BootNode;}
 if !boot_p_expect(ctx,58,"constant requires an explicit type") {return 0 as *BootNode;}
 let ty:*BootType=boot_p_type(ctx);
 if ty==0 as *BootType {return 0 as *BootNode;}
 if !boot_p_expect(ctx,61,"expected '=' in constant") {return 0 as *BootNode;}
 let value:*BootNode=boot_p_expression(ctx,0);
 if value==0 as *BootNode {return value;}
 boot_p_take(ctx,59);
 let node:*BootNode=boot_node(ctx,BN_CONST,token);
 if node!=0 as *BootNode {node.name=name.text;node.ty=ty;node.left=value;}
 return node;
}
fn boot_p_static(ctx:*BootContext,foreign:bool)->*BootNode {
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);
 let node:*BootNode=boot_node(ctx,BN_STATIC,token);
 if node==0 as *BootNode{return node;}
 if boot_p_word(ctx,"mut"){node.flags=1;boot_p_advance(ctx);}
 let name:*BootToken=boot_p_name(ctx);
 if ctx.failed || !boot_p_expect(ctx,58,"static requires a declared type"){return 0 as *BootNode;}
 node.name=name.text;node.ty=boot_p_type(ctx);
 if foreign {node.flags=node.flags|2;}
 else if boot_p_take(ctx,61){node.left=boot_p_expression(ctx,0);}
 if !boot_p_expect(ctx,59,"expected ';' after static declaration"){return 0 as *BootNode;}
 return node;
}
pub fn boot_parse(ctx:*BootContext)->bool {
 ctx.cursor=ctx.tokens;ctx.depth=0;
 let program:*BootNode=boot_node(ctx,BN_PROGRAM,ctx.cursor);
 if program==0 as *BootNode {return false;}
 ctx.program=program;
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed && boot_p_kind(ctx)!=BT_EOF {
  let mut node:*BootNode=0 as *BootNode;
  let mut exported:bool=false;
  if boot_p_take(ctx,35) {
   let inner:bool=boot_p_take(ctx,33);
   if !boot_p_expect(ctx,91,"expected '[' after '#'"){return false;}
   if inner {
    if ctx.module!=ctx.root_module || tail!=0 as *BootNode || ctx.no_main || !boot_p_word(ctx,"no_main"){
     boot_error(ctx,ctx.cursor,"expected a single root #![no_main] before declarations");return false;
    }
    boot_p_advance(ctx);if !boot_p_expect(ctx,93,"expected ']' after no_main"){return false;}
    ctx.no_main=true;continue;
   }
   if !boot_p_word(ctx,"no_mangle"){boot_error(ctx,ctx.cursor,"unsupported declaration attribute");return false;}
   boot_p_advance(ctx);if !boot_p_expect(ctx,93,"expected ']' after no_mangle"){return false;}
   exported=true;
  }
  let mut public:bool=false;
  if boot_p_word(ctx,"pub") {public=true;boot_p_advance(ctx);}
  if boot_p_word(ctx,"extern") {
   if public || exported {boot_error(ctx,ctx.cursor,"extern declarations are already public");return false;}
   boot_p_advance(ctx);
   if boot_p_kind(ctx)!=BT_STRING {boot_error(ctx,ctx.cursor,"expected foreign ABI string \"C\"");return false;}
   if ctx.cursor.length!=1 || strcmp(ctx.cursor.text,"C")!=0 {boot_error(ctx,ctx.cursor,"Core supports only extern \"C\"");return false;}
   boot_p_advance(ctx);
   if !boot_p_expect(ctx,123,"expected '{' after foreign ABI") {return false;}
   while !ctx.failed && boot_p_kind(ctx)!=125 {
    if boot_p_word(ctx,"static"){node=boot_p_static(ctx,true);}else{node=boot_p_function(ctx,true);}
    if node==0 as *BootNode {return false;}
    if tail==0 as *BootNode {program.body=node;} else {tail.next=node;}
    tail=node;
   }
   if !boot_p_expect(ctx,125,"expected '}' after foreign declarations") {return false;}
  } else {
   if boot_p_word(ctx,"fn") {node=boot_p_function(ctx,false);}
   else if boot_p_word(ctx,"struct") {node=boot_p_struct(ctx);}
   else if boot_p_word(ctx,"static") {node=boot_p_static(ctx,false);}
   else if boot_p_word(ctx,"const") {node=boot_p_constant(ctx);}
   else if boot_p_word(ctx,"type") {node=boot_p_alias(ctx);}
   else {boot_error(ctx,ctx.cursor,"expected fn, struct, const or extern \"C\"; construct outside Core v1");return false;}
   if node==0 as *BootNode {return false;}
   if exported {
    if node.kind!=BN_FN && node.kind!=BN_STATIC{boot_error(ctx,node.token,"no_mangle requires a function or static definition");return false;}
    node.flags=node.flags|BF_EXPORT;
   }
   if public {node.flags=node.flags|8;}
   if tail==0 as *BootNode {program.body=node;} else {tail.next=node;}
   tail=node;
  }
 }
 return !ctx.failed;
}

fn boot_p_struct_value(ctx:*BootContext,node:*BootNode)->*BootNode{
 node.kind=BN_STRUCT_VALUE;node.ty=boot_resolve_type(ctx,node.name,node.lookup,node.token);
 if node.ty==(0 as *BootType){return 0 as *BootNode;}boot_p_advance(ctx);
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed&&boot_p_kind(ctx)!=125{
  let field:*BootToken=boot_p_name(ctx);if field==(0 as *BootToken){return 0 as *BootNode;}
  let member:*BootNode=boot_node(ctx,BN_FIELD,field);if member==(0 as *BootNode){return member;}member.name=field.text;
  if boot_p_take(ctx,58){member.left=boot_p_expression(ctx,0);}else{member.left=boot_node(ctx,BN_IDENT,field);if member.left!=(0 as *BootNode){member.left.name=field.text;}}
  if member.left==(0 as *BootNode){return 0 as *BootNode;}member.tree_depth=member.left.tree_depth+1;
  if tail==(0 as *BootNode){node.params=member;}else{tail.next=member;}tail=member;
  if !boot_p_take(ctx,44){break;}
 }
 if !boot_p_expect(ctx,125,"expected '}' after struct initializer"){return 0 as *BootNode;}
 return node;
}

fn boot_p_alias(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let name:*BootToken=boot_p_name(ctx);if name==(0 as *BootToken){return 0 as *BootNode;}
 let ty:*BootType=boot_named_type(ctx,name.text);if ty==(0 as *BootType){return 0 as *BootNode;}
 if ty.complete{boot_error(ctx,name,"duplicate type definition");return 0 as *BootNode;}
 if !boot_p_expect(ctx,61,"expected '=' in type alias"){return 0 as *BootNode;}
 let target:*BootType=boot_p_type(ctx);if target==(0 as *BootType){return 0 as *BootNode;}boot_p_take(ctx,59);
 ty.kind=BY_ALIAS;ty.inner=target;ty.complete=true;
 let node:*BootNode=boot_node(ctx,BN_ALIAS,token);if node!=(0 as *BootNode){node.name=name.text;node.ty=ty;}return node;
}

fn boot_p_array_count(ctx:*BootContext)->u64{
 if boot_p_kind(ctx)!=BT_INT{boot_error(ctx,ctx.cursor,"Core array length requires a nonnegative integer literal");return 0;}
 let mut count:u64=0;if !boot_integer_value(ctx,ctx.cursor,9223372036854775807,&mut count as *u64){return 0;}boot_p_advance(ctx);return count;
}
fn boot_p_array_value(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let node:*BootNode=boot_node(ctx,BN_ARRAY,token);if node==(0 as *BootNode){return node;}
 let mut tail:*BootNode=0 as *BootNode;let mut count:i64=0;
 while !ctx.failed&&boot_p_kind(ctx)!=93{
  let element:*BootNode=boot_p_expression(ctx,0);if element==(0 as *BootNode){return element;}
  if tail==(0 as *BootNode){node.params=element;}else{tail.next=element;}tail=element;count=count+1;
  if boot_p_take(ctx,59){
   if count!=1{boot_error(ctx,ctx.cursor,"repeat array requires one element");return 0 as *BootNode;}
   node.kind=BN_REPEAT;node.left=element;node.params=0 as *BootNode;count=boot_p_array_count(ctx) as i64;break;
  }
  if !boot_p_take(ctx,44){break;}
 }
 if !boot_p_expect(ctx,93,"expected ']' after array value"){return 0 as *BootNode;}node.value=count;return node;
}

// In a type argument context >> and >= end a type list one byte at a time.
fn boot_p_type_close(ctx:*BootContext)->bool{
 if boot_p_take(ctx,62){return true;}
 let token:*BootToken=ctx.cursor;let kind:i32=boot_p_kind(ctx);let mut remainder:i32=0;
 if kind==BT_SHR{remainder=62;}if kind==BT_GE{remainder=61;}if kind==BT_ASSIGN_BASE+BT_SHR{remainder=BT_GE;}
 if remainder==0{return false;}
 let rest:*BootToken=boot_alloc(ctx,size_of(BootToken) as u64) as *BootToken;if rest==(0 as *BootToken){return false;}
 memcpy(rest as *void,token as *void,size_of(BootToken) as u64);rest.kind=remainder;rest.text=token.text+1;rest.length=token.length-1;rest.column=token.column+1;ctx.cursor=rest;return true;
}
fn boot_p_type_arguments(ctx:*BootContext)->*BootTypeArgument{
 if !boot_p_expect(ctx,60,"expected '<' before type arguments"){return 0 as *BootTypeArgument;}
 let mut result:*BootTypeArgument=0 as *BootTypeArgument;let mut tail:*BootTypeArgument=0 as *BootTypeArgument;
 while !ctx.failed{
  let ty:*BootType=boot_p_type(ctx);if ty==(0 as *BootType){return result;}
  let arg:*BootTypeArgument=boot_type_argument(ctx,ty);if ctx.failed{return result;}
  if tail==(0 as *BootTypeArgument){result=arg;}else{tail.next=arg;}tail=arg;
  if boot_p_type_close(ctx){return result;}
  if !boot_p_expect(ctx,44,"expected ',' or '>' in type arguments"){return result;}
  if boot_p_type_close(ctx){return result;}
 }return result;
}
fn boot_p_type_apply(ctx:*BootContext,base:*BootType)->*BootType{
 if base==(0 as *BootType)||boot_p_kind(ctx)!=60{return base;}
 let args:*BootTypeArgument=boot_p_type_arguments(ctx);if ctx.failed{return 0 as *BootType;}return boot_apply_type(ctx,base,args);
}
fn boot_p_type_parameters(ctx:*BootContext)->*BootNode{
 if !boot_p_take(ctx,60){return 0 as *BootNode;}
 let mut result:*BootNode=0 as *BootNode;let mut tail:*BootNode=0 as *BootNode;let mut count:i32=0;
 while !ctx.failed{
  let name:*BootToken=boot_p_name(ctx);if name==(0 as *BootToken){return result;}
  let mut previous:*BootNode=result;while previous!=(0 as *BootNode){if strcmp(previous.name,name.text)==0{boot_error(ctx,name,"duplicate generic parameter");return result;}previous=previous.next;}
  count=count+1;if count>64{boot_error(ctx,name,"generic parameter count exceeds 64");return result;}
  let parameter:*BootNode=boot_node(ctx,BN_TYPE_PARAMETER,name);let ty:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;if ctx.failed{return result;}
  ty.kind=BY_PARAMETER;ty.id=boot_id(ctx);ty.name=name.text;ty.owner=ctx.module;ty.next=ctx.types;ctx.types=ty;parameter.ty=ty;parameter.name=name.text;
  if tail==(0 as *BootNode){result=parameter;}else{tail.next=parameter;}tail=parameter;
  if boot_p_type_close(ctx){return result;}
  if !boot_p_expect(ctx,44,"expected ',' or '>' in generic parameters"){return result;}
  if boot_p_type_close(ctx){return result;}
 }return result;
}
