  let label:*BootToken=boot_p_name(ctx);if label==0 as *BootToken{return 0 as *BootNode;}
  let variant:*BootNode=boot_node(ctx,BN_VARIANT,label);if ctx.failed{return variant;}variant.name=label.text;variant.value=tag;tag=tag+1;
  if boot_p_take(ctx,40){
