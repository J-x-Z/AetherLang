 }
 if !boot_p_expect(ctx,125,"expected '}' after enum variants"){return 0 as *BootNode;}
 if tag==0{boot_error(ctx,token,"empty enum is not supported");return 0 as *BootNode;}
 ty.fields=node.body;ty.complete=true;ctx.type_parameters=saved;return node;
}
fn boot_p_match(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let node:*BootNode=boot_node(ctx,BN_MATCH,token);if ctx.failed{return node;}
 let saved:bool=ctx.parse_condition;ctx.parse_condition=true;node.left=boot_p_expression(ctx,0);ctx.parse_condition=saved;
 if ctx.failed||!boot_p_expect(ctx,123,"expected '{' after match subject"){return 0 as *BootNode;}
 let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed&&boot_p_kind(ctx)!=125{
  let arm:*BootNode=boot_node(ctx,BN_ARM,ctx.cursor);if ctx.failed{return arm;}
  arm.left=boot_p_pattern(ctx,0);if ctx.failed{return 0 as *BootNode;}
  if boot_p_word(ctx,"if"){boot_p_advance(ctx);arm.right=boot_p_expression(ctx,0);}
  if !boot_p_expect(ctx,BT_FAT_ARROW,"expected '=>' after match pattern"){return 0 as *BootNode;}
  if boot_p_kind(ctx)==123{arm.body=boot_p_block(ctx);boot_value_tail(arm.body,BN_YIELD);}
  else{arm.body=boot_node(ctx,BN_YIELD,ctx.cursor);if ctx.failed{return 0 as *BootNode;}arm.body.left=boot_p_expression(ctx,0);}
  if tail==0 as *BootNode{node.params=arm;}else{tail.next=arm;}tail=arm;
  if !boot_p_take(ctx,44)&&boot_p_kind(ctx)!=125{boot_error(ctx,ctx.cursor,"expected ',' between match arms");return 0 as *BootNode;}
 }
 if !boot_p_expect(ctx,125,"expected '}' after match arms"){return 0 as *BootNode;}return node;
}

fn boot_p_impl(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);
 let saved_parameters:*BootNode=ctx.type_parameters;let saved_target:*BootType=ctx.impl_target;
 ctx.type_parameters=boot_p_type_parameters(ctx);let parameters:*BootNode=ctx.type_parameters;let mut target:*BootType=boot_p_type(ctx);if ctx.failed{return 0 as *BootNode;}
 let mut implementation:*BootDynImplementation=0 as *BootDynImplementation;
 if boot_p_word(ctx,"for"){boot_p_advance(ctx);let contract:*BootType=target;target=boot_p_type(ctx);if ctx.failed{return 0 as *BootNode;}if parameters!=0 as *BootNode{boot_error(ctx,token,"dynamic implementations require concrete record types");return 0 as *BootNode;}implementation=boot_dynamic_impl(ctx,contract,target,token);}
 ctx.impl_target=target;
 if !boot_p_expect(ctx,123,"expected '{' after inherent impl target"){return 0 as *BootNode;}
 let mut first:*BootNode=0 as *BootNode;let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed&&boot_p_kind(ctx)!=125{
  let mut public:bool=false;if boot_p_word(ctx,"pub"){public=true;boot_p_advance(ctx);}
  let function:*BootNode=boot_p_function(ctx,false);if ctx.failed{return 0 as *BootNode;}
  if public{function.flags=function.flags|8;}
  let method_name:*u8=function.name;
  if !boot_method_register(ctx,function,target){return 0 as *BootNode;}
  if implementation!=0 as *BootDynImplementation{boot_dynamic_method(ctx,implementation,function,method_name);}
  if tail==0 as *BootNode{first=function;}else{tail.next=function;}tail=function;
 }
 boot_p_expect(ctx,125,"expected '}' after inherent methods");ctx.type_parameters=saved_parameters;ctx.impl_target=saved_target;
 if first==0 as *BootNode&&!ctx.failed{boot_method_empty(ctx,target,parameters,token);}return first;
}

fn boot_p_range_for(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let name:*BootToken=boot_p_name(ctx);if ctx.failed{return 0 as *BootNode;}
 if !boot_p_word(ctx,"in"){boot_error(ctx,ctx.cursor,"expected in after for binding");return 0 as *BootNode;}boot_p_advance(ctx);
 let node:*BootNode=boot_node(ctx,BN_RANGE_FOR,token);if ctx.failed{return node;}node.name=name.text;
 let saved:bool=ctx.parse_condition;ctx.parse_condition=true;node.left=boot_p_expression(ctx,0);
 if boot_p_kind(ctx)!=BT_RANGE{boot_error(ctx,ctx.cursor,"Core for requires an integer range");return 0 as *BootNode;}
 boot_p_advance(ctx);node.right=boot_p_expression(ctx,0);ctx.parse_condition=saved;
 node.body=boot_p_block(ctx);return node;
}

fn boot_p_closure(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;let empty:bool=boot_p_kind(ctx)==BT_OR;boot_p_advance(ctx);
 let node:*BootNode=boot_node(ctx,BN_CLOSURE,token);if ctx.failed{return node;}
 let mut tail:*BootNode=0 as *BootNode;
 while !empty&&!ctx.failed&&boot_p_kind(ctx)!=124{
  let mutable:bool=boot_p_word(ctx,"mut");if mutable{boot_p_advance(ctx);}let name:*BootToken=boot_p_name(ctx);
  if ctx.failed||!boot_p_expect(ctx,58,"closure parameters require explicit types"){return 0 as *BootNode;}
  let parameter:*BootNode=boot_node(ctx,BN_PARAM,name);if ctx.failed{return node;}parameter.name=name.text;parameter.ty=boot_p_type(ctx);if mutable{parameter.flags=1;}
  if tail==0 as *BootNode{node.params=parameter;}else{tail.next=parameter;}tail=parameter;
  if !boot_p_take(ctx,44){break;}
 }
 if !empty&&!boot_p_expect(ctx,124,"expected '|' after closure parameters"){return 0 as *BootNode;}
 node.ty=boot_type(ctx,BY_INFER);if boot_p_take(ctx,BT_ARROW){node.ty=boot_p_type(ctx);}
 let saved:bool=ctx.parse_condition;ctx.parse_condition=false;
 if boot_p_kind(ctx)==123{node.body=boot_p_block(ctx);boot_value_tail(node.body,BN_RETURN);}else{
  let value:*BootNode=boot_p_expression(ctx,0);let body:*BootNode=boot_node(ctx,BN_BLOCK,token);let result:*BootNode=boot_node(ctx,BN_RETURN,token);
  if !ctx.failed{result.left=value;body.body=result;node.body=body;}
 }
 ctx.parse_condition=saved;return node;
}

fn boot_p_interface(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let name:*BootToken=boot_p_name(ctx);if ctx.failed{return 0 as *BootNode;}
 let node:*BootNode=boot_node(ctx,BN_INTERFACE,token);let ty:*BootType=boot_named_type(ctx,name.text);if ctx.failed{return node;}
 if ty.complete{boot_error(ctx,name,"duplicate interface definition");return 0 as *BootNode;}ty.kind=BY_INTERFACE;ty.complete=true;node.name=name.text;node.ty=ty;
 if !boot_p_expect(ctx,123,"expected '{' after interface name"){return 0 as *BootNode;}
 let saved:*BootType=ctx.impl_target;ctx.impl_target=ty;let mut tail:*BootNode=0 as *BootNode;
 while !ctx.failed&&boot_p_kind(ctx)!=125{let method:*BootNode=boot_p_function(ctx,true);if ctx.failed{return 0 as *BootNode;}if tail==0 as *BootNode{node.body=method;ty.fields=method;}else{tail.next=method;}tail=method;}
 ctx.impl_target=saved;if !boot_p_expect(ctx,125,"expected '}' after interface"){return 0 as *BootNode;}return node;
}
fn boot_p_pattern(ctx:*BootContext,depth:i32)->*BootNode{
 if depth>256{boot_error(ctx,ctx.cursor,"pattern nesting exceeds 256");return 0 as *BootNode;}
 let token:*BootToken=ctx.cursor;let pattern:*BootNode=boot_node(ctx,BN_PATTERN,token);if ctx.failed{return pattern;}
 if boot_p_word(ctx,"_"){boot_p_advance(ctx);pattern.op=PM_WILD;return pattern;}
 let value:*BootNode=boot_p_primary(ctx);if ctx.failed{return 0 as *BootNode;}
 if value.kind==BN_INT||value.kind==BN_BOOL||(value.kind==BN_UNARY&&value.op==45&&value.left.kind==BN_INT){
  pattern.op=PM_LITERAL;pattern.left=value;return pattern;
 }
 if value.kind==BN_IDENT&&value.lookup==0 as *BootModule&&boot_p_kind(ctx)!=40{pattern.op=PM_BIND;pattern.name=value.name;return pattern;}
 if value.kind!=BN_ENUM_VALUE&&value.kind!=BN_IDENT{boot_error(ctx,token,"pattern requires a literal, binding, wildcard or enum variant");return 0 as *BootNode;}
 pattern.op=PM_VARIANT;pattern.name=value.name;pattern.ty=value.ty;
 if boot_p_take(ctx,40){
  let mut tail:*BootNode=0 as *BootNode;
  while !ctx.failed&&boot_p_kind(ctx)!=41{
   let child:*BootNode=boot_p_pattern(ctx,depth+1);if ctx.failed{return 0 as *BootNode;}
   if tail==0 as *BootNode{pattern.params=child;}else{tail.next=child;}tail=child;if !boot_p_take(ctx,44){break;}
  }
  if !boot_p_expect(ctx,41,"expected ')' after pattern fields"){return 0 as *BootNode;}
 }return pattern;
}
