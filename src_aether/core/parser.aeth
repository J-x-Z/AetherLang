}

fn boot_p_enum(ctx:*BootContext)->*BootNode{
 let token:*BootToken=ctx.cursor;boot_p_advance(ctx);let name:*BootToken=boot_p_name(ctx);if name==0 as *BootToken{return 0 as *BootNode;}
 let ty:*BootType=boot_named_type(ctx,name.text);if ctx.failed{return 0 as *BootNode;}
 if ty.complete{boot_error(ctx,name,"duplicate enum definition");return 0 as *BootNode;}
 let node:*BootNode=boot_node(ctx,BN_ENUM,token);if ctx.failed{return node;}node.name=name.text;node.ty=ty;
 let saved:*BootNode=ctx.type_parameters;node.generics=boot_p_type_parameters(ctx);ctx.type_parameters=node.generics;
