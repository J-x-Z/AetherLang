// Native target identity and errno ABI, shared by both platform modules.
use model::*;use runtime::*;use host_platform::platform_info;
pub fn boot_host_info(ctx:*BootContext)->*u8{if ctx.host_info==0 as *u8{ctx.host_info=platform_info(ctx);}return ctx.host_info;}
pub fn boot_errno_target(ctx:*BootContext)->bool {
 if ctx.errno_name!=0 as *u8 {return true;}
 let info:*u8=boot_host_info(ctx);if ctx.failed{return false;}
 if strcmp(info,"Darwin")==0 {ctx.errno_name="__error";}
 else if strcmp(info,"Linux")==0 {ctx.errno_name="__errno_location";}
 else if strcmp(info,"Windows")==0{ctx.errno_name="_errno";}
 else {boot_error(ctx,ctx.cursor,"unsupported native errno ABI");return false;}
 let mut item:*BootNode=ctx.program.body;
 while item!=0 as *BootNode {
  if boot_c_symbol(item) && strcmp(item.name,ctx.errno_name)==0 {
   if item.kind!=BN_FN || (item.flags&BF_EXPORT)!=0{boot_error(ctx,item.token,"reserved native errno accessor must remain a libc function");return false;}
   if item.params!=0 as *BootNode || (item.flags&4)!=0 || item.ty.kind!=BY_PTR || item.ty.inner.kind!=BY_I32 {
    boot_error(ctx,item.token,"foreign declaration conflicts with native errno ABI");return false;
   }
   ctx.errno_declared=true;
  }
  item=item.next;
 }
 return true;
}
