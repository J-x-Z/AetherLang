use model::*;
use runtime::*;
use enum_model::boot_enum_payload;
pub fn boot_array_type(ctx:*BootContext,inner:*BootType,count:u64)->*BootType {
 let mut ty:*BootType=ctx.types;
 while ty!=(0 as *BootType){if ty.kind==BY_ARRAY&&ty.inner==inner&&ty.extent==count{return ty;}ty=ty.next;}
 let created:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;if created==(0 as *BootType){return created;}
 created.kind=BY_ARRAY;created.id=boot_id(ctx);created.inner=inner;created.extent=count;created.complete=true;
 created.next=ctx.types;ctx.types=created;return created;
}
pub fn boot_normal_type(ctx:*BootContext,ty:*BootType,depth:i32,token:*BootToken)->*BootType {
 if ty==(0 as *BootType)||ctx.failed{return ty;}
 if depth>256{boot_error(ctx,token,"cyclic or excessively deep type alias");return 0 as *BootType;}
 if ty.kind==BY_APPLICATION{return boot_expand_type(ctx,ty,depth+1,token);}
 if ty.kind==BY_ALIAS{return boot_normal_type(ctx,ty.inner,depth+1,token);}
 if boot_indirect(ty)||ty.kind==BY_ARRAY{
  let inner:*BootType=boot_normal_type(ctx,ty.inner,depth+1,token);if inner==(0 as *BootType){return inner;}
  if ty.kind==BY_PTR{return boot_ptr_type(ctx,inner);}if boot_reference(ty){return boot_ref_type(ctx,inner,ty.kind==BY_MUTREF);}return boot_array_type(ctx,inner,ty.extent);
 }
 return ty;
}
fn boot_normal_nodes(ctx:*BootContext,node:*BootNode){
 let mut item:*BootNode=node;
 while item!=(0 as *BootNode)&&!ctx.failed{
  item.ty=boot_normal_type(ctx,item.ty,0,item.token);item.aux=boot_normal_type(ctx,item.aux,0,item.token);
  boot_normal_nodes(ctx,item.left);boot_normal_nodes(ctx,item.right);boot_normal_nodes(ctx,item.third);
  boot_normal_nodes(ctx,item.body);boot_normal_nodes(ctx,item.params);item=item.next;
 }
}
pub fn boot_normalize(ctx:*BootContext)->bool{
 let mut ty:*BootType=ctx.types;
 while ty!=(0 as *BootType)&&!ctx.failed{
  if ty.kind==BY_STRUCT||ty.kind==BY_ENUM{boot_normal_nodes(ctx,ty.fields);}ty=ty.next;
 }
 boot_normal_nodes(ctx,ctx.program.body);if ctx.failed{return false;}
 // Retire pre-normalization array entries so C never emits stale alias fields.
 ty=ctx.types;while ty!=(0 as *BootType)&&!ctx.failed{
  if ty.kind==BY_ARRAY{let canonical:*BootType=boot_normal_type(ctx,ty,0,ctx.cursor);if canonical!=ty{ty.kind=BY_ALIAS;ty.inner=canonical;}}
  ty=ty.next;
 }
 return !ctx.failed;
}
// Layout of the currently supported 64-bit host ABI. The two emitters use this
// only to reject impossible object sizes; native C/LLVM still lay out objects.
pub fn boot_layout(ctx:*BootContext,ty:*BootType,depth:i32,token:*BootToken)->bool{
 if ctx.failed{return false;}if ty.layout_align!=0{return true;}
 if depth>256{boot_error(ctx,token,"recursive or excessively deep value layout");return false;}
 let mut size:u64=0;let mut alignment:u64=1;let limit:u64=9223372036854775807;
 if ty.kind==BY_BOOL||ty.kind==BY_I8||ty.kind==BY_U8{size=1;}
 if ty.kind==BY_I16||ty.kind==BY_U16{size=2;alignment=2;}
 if ty.kind==BY_I32||ty.kind==BY_U32||ty.kind==BY_F32{size=4;alignment=4;}
 if ty.kind==BY_I64||ty.kind==BY_U64||ty.kind==BY_F64||boot_indirect(ty){size=8;alignment=8;}
 if ty.kind==BY_ARRAY{
  if !boot_layout(ctx,ty.inner,depth+1,token){return false;}
  alignment=ty.inner.layout_align;
  if ty.inner.layout_size!=0&&ty.extent>limit/ty.inner.layout_size{boot_error(ctx,token,"array object exceeds signed address space");return false;}
  size=ty.inner.layout_size*ty.extent;
 }
 if ty.kind==BY_STRUCT{
  let mut field:*BootNode=ty.fields;
  while field!=(0 as *BootNode){
   if !boot_layout(ctx,field.ty,depth+1,field.token){return false;}
   let field_align:u64=field.ty.layout_align;if field_align>alignment{alignment=field_align;}
   let padding:u64=(field_align-size%field_align)%field_align;
   if padding>limit-size||field.ty.layout_size>limit-size-padding{boot_error(ctx,token,"struct object exceeds signed address space");return false;}
   size=size+padding+field.ty.layout_size;field=field.next;
  }
  let padding:u64=(alignment-size%alignment)%alignment;
  if padding>limit-size{boot_error(ctx,token,"struct object exceeds signed address space");return false;}size=size+padding;
 }
 if ty.kind==BY_ENUM{
  let mut variant:*BootNode=ty.fields;let mut payload_size:u64=0;let mut payload_align:u64=1;
  while variant!=0 as *BootNode{
   let payload:*BootType=boot_enum_payload(ctx,variant);if ctx.failed||!boot_layout(ctx,payload,depth+1,variant.token){return false;}
   if payload.layout_size>payload_size{payload_size=payload.layout_size;}
   if payload.layout_align>payload_align{payload_align=payload.layout_align;}variant=variant.next;
  }
  payload_size=payload_size+(payload_align-payload_size%payload_align)%payload_align;
  alignment=payload_align;if alignment<4{alignment=4;}
  let prefix:u64=4+(payload_align-4%payload_align)%payload_align;
  if payload_size>limit-prefix-alignment{boot_error(ctx,token,"enum object exceeds signed address space");return false;}
  size=prefix+payload_size;size=size+(alignment-size%alignment)%alignment;
  ty.extent=payload_size/payload_align;ty.inner=boot_type(ctx,BY_U8);
  if payload_align==2{ty.inner=boot_type(ctx,BY_U16);}if payload_align==4{ty.inner=boot_type(ctx,BY_U32);}if payload_align==8{ty.inner=boot_type(ctx,BY_U64);}
 }
 ty.layout_size=size;ty.layout_align=alignment;return true;
}
// Reachable exits: fallthrough=1, return=2, break=4, continue=8. Loop-local exits
// are consumed by their own loop, and unreachable statements do not add exits.
pub fn boot_flow(node:*BootNode)->i32{
 if node==(0 as *BootNode){return 1;}
 if node.kind==BN_EXPR&&node.left.kind==BN_VALUE{
  let flow:i32=boot_flow(node.left.body);if (flow&16)!=0{return (flow&(-17 as i32))|1;}return flow;
 }
 if node.kind==BN_YIELD{return 16;}
 if node.kind==BN_RETURN{return 2;}if node.kind==BN_BREAK{return 4;}if node.kind==BN_CONTINUE{return 8;}
 if node.kind==BN_BLOCK{
  let mut result:i32=1;let mut item:*BootNode=node.body;
  while item!=(0 as *BootNode)&&(result&1)!=0{result=(result&(-2 as i32))|boot_flow(item);item=item.next;}return result;
 }
 if node.kind==BN_IF{
  if node.left.kind==BN_BOOL{if node.left.value!=0{return boot_flow(node.body);}return boot_flow(node.third);}
  return boot_flow(node.body)|boot_flow(node.third);
 }
 if node.kind==BN_WHILE{
  if node.left.kind==BN_BOOL&&node.left.value==0{return 1;}
  let body:i32=boot_flow(node.body);let mut result:i32=body&2;
  if (body&4)!=0||node.left.kind!=BN_BOOL||node.left.value==0{result=result|1;}return result;
 }
 return 1;
}

// Rewriting return tails requires the resolved return type, after aliases.
pub fn boot_value_tail(node:*BootNode,kind:i32){
 if node==(0 as *BootNode){return;}
 if node.kind==BN_BLOCK{
  let mut last:*BootNode=node.body;if last==(0 as *BootNode){return;}
  while last.next!=(0 as *BootNode){last=last.next;}
  if (last.flags&16)!=0{boot_value_tail(last,kind);}return;
 }
 if node.kind==BN_IF{boot_value_tail(node.body,kind);boot_value_tail(node.third,kind);return;}
 if node.kind==BN_EXPR&&(node.flags&16)!=0{node.kind=kind;}
}

pub fn boot_type_arguments_same(a:*BootTypeArgument,b:*BootTypeArgument)->bool{
 let mut left:*BootTypeArgument=a;let mut right:*BootTypeArgument=b;
 while left!=(0 as *BootTypeArgument)&&right!=(0 as *BootTypeArgument){if left.ty!=right.ty{return false;}left=left.next;right=right.next;}
 return left==(0 as *BootTypeArgument)&&right==(0 as *BootTypeArgument);
}
pub fn boot_type_argument(ctx:*BootContext,ty:*BootType)->*BootTypeArgument{
 let arg:*BootTypeArgument=boot_alloc(ctx,size_of(BootTypeArgument) as u64) as *BootTypeArgument;if arg!=(0 as *BootTypeArgument){arg.ty=ty;}return arg;
}
pub fn boot_apply_type(ctx:*BootContext,base:*BootType,arguments:*BootTypeArgument)->*BootType{
 let mut existing:*BootType=ctx.types;
 while existing!=(0 as *BootType){if existing.base==base&&boot_type_arguments_same(existing.arguments,arguments){return existing;}existing=existing.next;}
 let ty:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;if ty==(0 as *BootType){return ty;}
 ty.kind=BY_APPLICATION;ty.id=boot_id(ctx);ty.name=base.name;ty.owner=base.owner;ty.base=base;ty.arguments=arguments;
 ty.next=ctx.types;ctx.types=ty;return ty;
}
pub fn boot_type_concrete(ty:*BootType,depth:i32)->bool{
 if ty==(0 as *BootType)||depth>256{return false;}
 if ty.kind==BY_PARAMETER||ty.kind==BY_TEMPLATE||ty.kind==BY_APPLICATION{return false;}
 if boot_indirect(ty)||ty.kind==BY_ARRAY{return boot_type_concrete(ty.inner,depth+1);}return true;
}
pub fn boot_type_bindings(ctx:*BootContext,parameters:*BootNode)->*BootTypeBinding{
 let mut result:*BootTypeBinding=0 as *BootTypeBinding;let mut tail:*BootTypeBinding=0 as *BootTypeBinding;let mut parameter:*BootNode=parameters;
 while parameter!=(0 as *BootNode){
  let binding:*BootTypeBinding=boot_alloc(ctx,size_of(BootTypeBinding) as u64) as *BootTypeBinding;if binding==(0 as *BootTypeBinding){return result;}
  binding.formal=parameter.ty;if tail==(0 as *BootTypeBinding){result=binding;}else{tail.next=binding;}tail=binding;parameter=parameter.next;
 }return result;
}
pub fn boot_substitute_type(ctx:*BootContext,ty:*BootType,bindings:*BootTypeBinding,depth:i32,token:*BootToken)->*BootType{
 if ctx.failed||ty==(0 as *BootType){return ty;}if depth>256{boot_error(ctx,token,"generic type nesting exceeds 256");return 0 as *BootType;}
 if ty.kind==BY_PARAMETER{let mut binding:*BootTypeBinding=bindings;while binding!=(0 as *BootTypeBinding){if binding.formal==ty&&binding.actual!=(0 as *BootType){return binding.actual;}binding=binding.next;}return ty;}
 if ty.kind==BY_ALIAS{return boot_substitute_type(ctx,ty.inner,bindings,depth+1,token);}
 if boot_indirect(ty)||ty.kind==BY_ARRAY{
  let inner:*BootType=boot_substitute_type(ctx,ty.inner,bindings,depth+1,token);if inner==(0 as *BootType){return inner;}
  if ty.kind==BY_PTR{return boot_ptr_type(ctx,inner);}if boot_reference(ty){return boot_ref_type(ctx,inner,ty.kind==BY_MUTREF);}return boot_array_type(ctx,inner,ty.extent);
 }
 if ty.kind==BY_APPLICATION{
  let mut args:*BootTypeArgument=0 as *BootTypeArgument;let mut tail:*BootTypeArgument=0 as *BootTypeArgument;let mut old:*BootTypeArgument=ty.arguments;
  while old!=(0 as *BootTypeArgument){
   let arg:*BootTypeArgument=boot_type_argument(ctx,boot_substitute_type(ctx,old.ty,bindings,depth+1,token));if ctx.failed{return 0 as *BootType;}
   if tail==(0 as *BootTypeArgument){args=arg;}else{tail.next=arg;}tail=arg;old=old.next;
  }
  return boot_normal_type(ctx,boot_apply_type(ctx,ty.base,args),depth+1,token);
 }
 return ty;
}
fn boot_expand_type(ctx:*BootContext,ty:*BootType,depth:i32,token:*BootToken)->*BootType{
 let base:*BootType=ty.base;
 if base.kind!=BY_TEMPLATE||!base.complete{boot_error(ctx,token,"type arguments require a defined generic type");return 0 as *BootType;}
 let mut parameter:*BootNode=base.parameters;let mut actual:*BootTypeArgument=ty.arguments;
 let mut arguments:*BootTypeArgument=0 as *BootTypeArgument;let mut tail:*BootTypeArgument=0 as *BootTypeArgument;let mut concrete:bool=true;
 while parameter!=(0 as *BootNode)&&actual!=(0 as *BootTypeArgument){
  let value:*BootType=boot_normal_type(ctx,actual.ty,depth+1,token);if ctx.failed{return 0 as *BootType;}
  if !boot_type_concrete(value,0){concrete=false;}
  let arg:*BootTypeArgument=boot_type_argument(ctx,value);if ctx.failed{return 0 as *BootType;}
  if tail==(0 as *BootTypeArgument){arguments=arg;}else{tail.next=arg;}tail=arg;
  parameter=parameter.next;actual=actual.next;
 }
 if parameter!=(0 as *BootNode)||actual!=(0 as *BootTypeArgument){boot_error(ctx,token,"generic type argument count mismatch");return 0 as *BootType;}
 let instance:*BootType=boot_apply_type(ctx,base,arguments);if !concrete||instance.kind!=BY_APPLICATION{return instance;}
 // Publish the nominal identity before fields, so Node<T> may point to itself.
 instance.kind=BY_STRUCT;instance.complete=true;instance.is_enum=base.is_enum;if base.is_enum{instance.kind=BY_ENUM;}
 let bindings:*BootTypeBinding=boot_type_bindings(ctx,base.parameters);let mut binding:*BootTypeBinding=bindings;actual=arguments;
 while binding!=(0 as *BootTypeBinding){binding.actual=actual.ty;binding=binding.next;actual=actual.next;}
 let mut source:*BootNode=base.fields;let mut last:*BootNode=0 as *BootNode;
 while source!=(0 as *BootNode)&&!ctx.failed{
  let field:*BootNode=boot_node(ctx,BN_FIELD,source.token);if field==(0 as *BootNode){return 0 as *BootType;}
  field.owner=source.owner;field.name=source.name;field.flags=source.flags;
  if base.is_enum{
   field.kind=BN_VARIANT;field.value=source.value;let mut member:*BootNode=source.params;let mut end:*BootNode=0 as *BootNode;
   while member!=0 as *BootNode{
    let copy:*BootNode=boot_node(ctx,BN_FIELD,member.token);if ctx.failed{return 0 as *BootType;}
    copy.name=member.name;copy.ty=boot_substitute_type(ctx,member.ty,bindings,depth+1,member.token);copy.ty=boot_normal_type(ctx,copy.ty,depth+1,member.token);
    if end==0 as *BootNode{field.params=copy;}else{end.next=copy;}end=copy;member=member.next;
   }
  }else{field.ty=boot_substitute_type(ctx,source.ty,bindings,depth+1,source.token);field.ty=boot_normal_type(ctx,field.ty,depth+1,source.token);}
  if last==(0 as *BootNode){instance.fields=field;}else{last.next=field;}last=field;source=source.next;
 }
 return instance;
}
