use model::*;
use runtime::*;
pub fn boot_array_type(ctx:*BootContext,inner:*BootType,count:u64)->*BootType {
 let mut ty:*BootType=ctx.types;
 while ty!=(0 as *BootType){if ty.kind==BY_ARRAY&&ty.inner==inner&&ty.extent==count{return ty;}ty=ty.next;}
 let created:*BootType=boot_alloc(ctx,size_of(BootType) as u64) as *BootType;if created==(0 as *BootType){return created;}
 created.kind=BY_ARRAY;created.id=boot_id(ctx);created.inner=inner;created.extent=count;created.complete=true;
 created.next=ctx.types;ctx.types=created;return created;
}
pub fn boot_normal_type(ctx:*BootContext,ty:*BootType,depth:i32,token:*BootToken)->*BootType {
 if ty==(0 as *BootType)||ctx.failed{return ty;}
 if depth>256{boot_error(ctx,token,"cyclic or excessively deep type alias");return 0 as *BootType;}
 if ty.kind==BY_ALIAS{return boot_normal_type(ctx,ty.inner,depth+1,token);}
 if ty.kind==BY_PTR||ty.kind==BY_ARRAY{
  let inner:*BootType=boot_normal_type(ctx,ty.inner,depth+1,token);if inner==(0 as *BootType){return inner;}
  if ty.kind==BY_PTR{return boot_ptr_type(ctx,inner);}return boot_array_type(ctx,inner,ty.extent);
 }
 return ty;
}
fn boot_normal_nodes(ctx:*BootContext,node:*BootNode){
 let mut item:*BootNode=node;
 while item!=(0 as *BootNode)&&!ctx.failed{
  item.ty=boot_normal_type(ctx,item.ty,0,item.token);item.aux=boot_normal_type(ctx,item.aux,0,item.token);
  boot_normal_nodes(ctx,item.left);boot_normal_nodes(ctx,item.right);boot_normal_nodes(ctx,item.third);
  boot_normal_nodes(ctx,item.body);boot_normal_nodes(ctx,item.params);item=item.next;
 }
}
pub fn boot_normalize(ctx:*BootContext)->bool{
 let mut ty:*BootType=ctx.types;
 while ty!=(0 as *BootType)&&!ctx.failed{
  if ty.kind==BY_STRUCT{boot_normal_nodes(ctx,ty.fields);}ty=ty.next;
 }
 boot_normal_nodes(ctx,ctx.program.body);if ctx.failed{return false;}
 // Retire pre-normalization array entries so C never emits stale alias fields.
 ty=ctx.types;while ty!=(0 as *BootType)&&!ctx.failed{
  if ty.kind==BY_ARRAY{let canonical:*BootType=boot_normal_type(ctx,ty,0,ctx.cursor);if canonical!=ty{ty.kind=BY_ALIAS;ty.inner=canonical;}}
  ty=ty.next;
 }
 return !ctx.failed;
}
// Layout of the currently supported 64-bit host ABI. The two emitters use this
// only to reject impossible object sizes; native C/LLVM still lay out objects.
pub fn boot_layout(ctx:*BootContext,ty:*BootType,depth:i32,token:*BootToken)->bool{
 if ctx.failed{return false;}if ty.layout_align!=0{return true;}
 if depth>256{boot_error(ctx,token,"recursive or excessively deep value layout");return false;}
 let mut size:u64=0;let mut alignment:u64=1;let limit:u64=9223372036854775807;
 if ty.kind==BY_BOOL||ty.kind==BY_I8||ty.kind==BY_U8{size=1;}
 if ty.kind==BY_I16||ty.kind==BY_U16{size=2;alignment=2;}
 if ty.kind==BY_I32||ty.kind==BY_U32||ty.kind==BY_F32{size=4;alignment=4;}
 if ty.kind==BY_I64||ty.kind==BY_U64||ty.kind==BY_F64||ty.kind==BY_PTR{size=8;alignment=8;}
 if ty.kind==BY_ARRAY{
  if !boot_layout(ctx,ty.inner,depth+1,token){return false;}
  alignment=ty.inner.layout_align;
  if ty.inner.layout_size!=0&&ty.extent>limit/ty.inner.layout_size{boot_error(ctx,token,"array object exceeds signed address space");return false;}
  size=ty.inner.layout_size*ty.extent;
 }
 if ty.kind==BY_STRUCT{
  let mut field:*BootNode=ty.fields;
  while field!=(0 as *BootNode){
   if !boot_layout(ctx,field.ty,depth+1,field.token){return false;}
   let field_align:u64=field.ty.layout_align;if field_align>alignment{alignment=field_align;}
   let padding:u64=(field_align-size%field_align)%field_align;
   if padding>limit-size||field.ty.layout_size>limit-size-padding{boot_error(ctx,token,"struct object exceeds signed address space");return false;}
   size=size+padding+field.ty.layout_size;field=field.next;
  }
  let padding:u64=(alignment-size%alignment)%alignment;
  if padding>limit-size{boot_error(ctx,token,"struct object exceeds signed address space");return false;}size=size+padding;
 }
 ty.layout_size=size;ty.layout_align=alignment;return true;
}
// Reachable exits: fallthrough=1, return=2, break=4, continue=8. Loop-local exits
// are consumed by their own loop, and unreachable statements do not add exits.
pub fn boot_flow(node:*BootNode)->i32{
 if node==(0 as *BootNode){return 1;}
 if node.kind==BN_YIELD{return 16;}
 if node.kind==BN_RETURN{return 2;}if node.kind==BN_BREAK{return 4;}if node.kind==BN_CONTINUE{return 8;}
 if node.kind==BN_BLOCK{
  let mut result:i32=1;let mut item:*BootNode=node.body;
  while item!=(0 as *BootNode)&&(result&1)!=0{result=(result&(-2 as i32))|boot_flow(item);item=item.next;}return result;
 }
 if node.kind==BN_IF{
  if node.left.kind==BN_BOOL{if node.left.value!=0{return boot_flow(node.body);}return boot_flow(node.third);}
  return boot_flow(node.body)|boot_flow(node.third);
 }
 if node.kind==BN_WHILE{
  if node.left.kind==BN_BOOL&&node.left.value==0{return 1;}
  let body:i32=boot_flow(node.body);let mut result:i32=body&2;
  if (body&4)!=0||node.left.kind!=BN_BOOL||node.left.value==0{result=result|1;}return result;
 }
 return 1;
}

// Rewriting return tails requires the resolved return type, after aliases.
pub fn boot_value_tail(node:*BootNode,kind:i32){
 if node==(0 as *BootNode){return;}
 if node.kind==BN_BLOCK{
  let mut last:*BootNode=node.body;if last==(0 as *BootNode){return;}
  while last.next!=(0 as *BootNode){last=last.next;}
  if (last.flags&16)!=0{boot_value_tail(last,kind);}return;
 }
 if node.kind==BN_IF{boot_value_tail(node.body,kind);boot_value_tail(node.third,kind);return;}
 if node.kind==BN_EXPR&&(node.flags&16)!=0{node.kind=kind;}
}
