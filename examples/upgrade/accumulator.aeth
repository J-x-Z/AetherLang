// A persistent line protocol service. All protocol parsing, state transitions,
// limits, journal writes and resource cleanup are implemented in Aether Core.
// Commands: add <signed decimal>, get, reset, quit. Run: accumulator JOURNAL.
use parse_int::parse_bounded_i64;
extern "C" {
    fn malloc(size: u64) -> *void;
    fn free(ptr: *void);
    fn fopen(path: *u8, mode: *u8) -> *void;
    fn fdopen(fd: i32, mode: *u8) -> *void;
    fn fclose(file: *void) -> i32;
    fn fgets(buffer: *u8, capacity: i32, file: *void) -> *u8;
    fn ferror(file: *void) -> i32;
    fn fflush(file: *void) -> i32;
    fn fwrite(buffer: *void, size: u64, count: u64, file: *void) -> u64;
    fn printf(format: *u8, ...) -> i32;
    fn strcmp(a: *u8, b: *u8) -> i32;
    fn strncmp(a: *u8, b: *u8, count: u64) -> i32;
    fn strlen(text: *u8) -> u64;
    fn perror(text: *u8);
}
fn same_command(line: *u8, plain: *u8, newline: *u8) -> bool {
    return strcmp(line, plain) == 0 || strcmp(line, newline) == 0;
}
fn main(argc: i32, argv: **u8) -> i32 {
    if argc != 2 { printf("usage: accumulator JOURNAL\n\0" as *u8); return 2; }
    let buffer: *u8 = malloc(4096) as *u8;
    if buffer == (0 as *u8) { return 3; }
    let journal: *void = fopen(argv[1], "ab\0" as *u8);
    if journal == (0 as *void) { perror(argv[1]); free(buffer as *void); return 4; }
    let input: *void = fdopen(0, "r\0" as *u8);
    if input == (0 as *void) { fclose(journal); free(buffer as *void); return 5; }
    let mut total: i64 = 0;
    let mut accepted: i64 = 0;
    let mut status: i32 = 0;
    if printf("READY\n\0" as *u8) < 0 { status = 8; }
    if fflush(0 as *void) != 0 && status == 0 { status = 8; }
    while status == 0 {
        if fgets(buffer, 4096, input) == (0 as *u8) {
            if ferror(input) != 0 { status = 6; }
            break;
        }
        let length: u64 = strlen(buffer);
        if length == 4095 && buffer[length - 1] != 10 {
            // Drain the rest of an oversized command without accepting fragments.
            while fgets(buffer, 4096, input) != (0 as *u8) {
                let n: u64 = strlen(buffer);
                if n < 4095 || buffer[n - 1] == 10 { break; }
            }
            if ferror(input) != 0 { status = 6; break; }
            if printf("ERR too-long\n\0" as *u8) < 0 { status = 8; break; }
        } else if same_command(buffer, "quit\0" as *u8, "quit\n\0" as *u8) {
            if printf("BYE %lld %lld\n\0" as *u8, total, accepted) < 0 { status = 8; break; }
            break;
        } else if same_command(buffer, "get\0" as *u8, "get\n\0" as *u8) {
            if printf("VALUE %lld %lld\n\0" as *u8, total, accepted) < 0 { status = 8; break; }
        } else if same_command(buffer, "reset\0" as *u8, "reset\n\0" as *u8) {
            total = 0;
            accepted = 0;
            if printf("RESET\n\0" as *u8) < 0 { status = 8; break; }
        } else if strncmp(buffer, "add \0" as *u8, 4) == 0 {
            let mut value: i64 = 0;
            if !parse_bounded_i64(buffer + 4, 1000000000, &value as *i64) {
                if printf("ERR number\n\0" as *u8) < 0 { status = 8; break; }
            } else if total + value > 1000000000000 || total + value < -1000000000000 {
                if printf("ERR limit\n\0" as *u8) < 0 { status = 8; break; }
            } else {
                if fwrite(buffer as *void, 1, length, journal) != length || fflush(journal) != 0 {
                    status = 7;
                    break;
                }
                total = total + value;
                accepted = accepted + 1;
                if printf("OK %lld\n\0" as *u8, total) < 0 { status = 8; break; }
            }
        } else {
            if printf("ERR command\n\0" as *u8) < 0 { status = 8; break; }
        }
        if fflush(0 as *void) != 0 { status = 8; break; }
    }
    // Every exit path flushes output; cleanup never replaces the first failure.
    if fflush(0 as *void) != 0 && status == 0 { status = 8; }
    if fclose(input) != 0 && status == 0 { status = 9; }
    if fclose(journal) != 0 && status == 0 { status = 10; }
    free(buffer as *void);
    return status;
}
