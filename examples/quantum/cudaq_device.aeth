use quantum::{Circuit, QuantumState, Q_X, quantum_new, quantum_free, quantum_gate, quantum_state_free};
use quantum_cudaq::quantum_cudaq;
use result::Result;

extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn puts(text: *u8) -> i32;
    fn strcmp(a: *u8, b: *u8) -> i32;
}

fn near(value: f64, expected: f64) -> bool {
    let delta: f64 = value - expected;
    delta > -0.000000000001 && delta < 0.000000000001
}

fn main(argc: i32, argv: **u8) -> i32 {
    let mut required: i32 = -1;
    if argc == 3 && strcmp(argv[1], "--require") == 0 {
        if strcmp(argv[2], "cpu") == 0 { required = 0; }
        if strcmp(argv[2], "gpu") == 0 { required = 1; }
    }
    if argc != 1 && required == -1 {
        puts("usage: cudaq-device [--require cpu|gpu]");
        return 2;
    }

    let circuit: *Circuit = match quantum_new(1) {
        Result::Ok(c) => c,
        Result::Err(code) => { printf("cannot allocate circuit (%d)\n", code); return 1; }
    };
    let gate_status: i32 = quantum_gate(circuit, Q_X, 0, 0, 0.0);
    if gate_status != 0 {
        quantum_free(circuit);
        printf("cannot add X gate (%d)\n", gate_status);
        return 1;
    }
    let mut error: [u8; 512] = [0; 512];
    let mut gpu: i32 = -1;
    let result: Result<*QuantumState, i32> =
        quantum_cudaq(circuit, 1, &mut error[0] as *u8, 512, &mut gpu as *i32);
    quantum_free(circuit);
    let state: *QuantumState = match result {
        Result::Ok(s) => s,
        Result::Err(code) => { printf("CUDA-Q error %d: %s\n", code, &error[0] as *u8); return 1; }
    };
    let valid: bool = state.length == 2 &&
        near(state.amplitudes[0].re, 0.0) && near(state.amplitudes[0].im, 0.0) &&
        near(state.amplitudes[1].re, 1.0) && near(state.amplitudes[1].im, 0.0);
    quantum_state_free(state);
    if !valid || (gpu != 0 && gpu != 1) {
        puts("CUDA-Q returned an invalid X state or placement");
        return 1;
    }
    if gpu == 1 { puts("cudaq state_location=gpu precision=fp64 qubits=1"); }
    else { puts("cudaq state_location=cpu precision=fp64 qubits=1"); }
    if required != -1 && gpu != required {
        puts("CUDA-Q state placement differs from --require");
        return 1;
    }
    0
}
