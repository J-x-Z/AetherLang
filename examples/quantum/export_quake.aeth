use quantum::{Circuit, Q_H, Q_X, Q_Y, Q_Z, Q_RX, Q_RY, Q_RZ, Q_CX, Q_CZ, Q_SWAP,
              quantum_new, quantum_gate, quantum_free};
use quantum_quake::{QuakeText, quantum_export_quake, quantum_quake_free};
use result::Result;
extern "C" {
    fn printf(format:*u8,...)->i32;
    fn fflush(stream:*void)->i32;
    fn write(fd:i32, data:*u8, length:usize)->isize;
    fn strlen(text:*u8)->usize;
}

fn fill(c:*Circuit)->bool {
    return quantum_gate(c,Q_H,2,0,0.0)==0 &&
           quantum_gate(c,Q_X,1,0,0.0)==0 &&
           quantum_gate(c,Q_Y,0,0,0.0)==0 &&
           quantum_gate(c,Q_Z,2,0,0.0)==0 &&
           quantum_gate(c,Q_RX,2,0,0.625)==0 &&
           quantum_gate(c,Q_RY,1,0,-0.375)==0 &&
           quantum_gate(c,Q_RZ,0,0,0.125)==0 &&
           quantum_gate(c,Q_CX,0,2,0.0)==0 &&
           quantum_gate(c,Q_CZ,2,0,0.0)==0 &&
           quantum_gate(c,Q_SWAP,1,0,0.0)==0;
}

fn main()->i32 {
    let c:*Circuit=match quantum_new(3){Result::Ok(value)=>value,Result::Err(e)=>{return e;}};
    if !fill(c) {quantum_free(c);return 1;}
    let mut error:[u8;256]=[0;256];
    let exported:Result<QuakeText,i32>=quantum_export_quake(c,1048576,&mut error[0] as *u8,256);
    quantum_free(c);
    let mut text:QuakeText=match exported {
        Result::Ok(value)=>value,
        Result::Err(e)=>{
            write(2,&error[0] as *u8,strlen(&error[0] as *u8));
            write(2,"\n",1);
            return e;
        }
    };
    let printed:i32=printf("%s",text.data);
    quantum_quake_free(&mut text as *QuakeText);
    if printed<0 || fflush(0 as *void)!=0 {return 1;}
    return 0;
}
